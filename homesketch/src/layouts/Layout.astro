---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'HomeSketch adalah studio arsitektur dan interior premium untuk hunian bespoke dan ruang komersial kelas atas di Jakarta, Bali, dan mancanegara. Berlandaskan gaya hidup, material lokal, dan akuntabilitas terpadu.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://homesketch.studio');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | HomeSketch Studio</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | HomeSketch Studio`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="id_ID" />

    <!-- Google Fonts: Cinzel (Heading) & DM Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="atmosphere-canvas bg-[var(--color-canvas-light)] text-[var(--color-ink-primary)]">
    <Navbar />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
