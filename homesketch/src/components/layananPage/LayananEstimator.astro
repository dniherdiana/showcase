---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import CostEstimator from '../islands/CostEstimator.svelte';
import { layananEstimatorData } from './LayananEstimator.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-surface)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={layananEstimatorData.heading}
      subtitle={layananEstimatorData.subheading}
      level="h2"
    />

    <!-- Interactive Island -->
    <CostEstimator client:visible />
  </Container>
</section>
