---
import { Image } from 'astro:assets';
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import imgWorkshop from '../../assets/images/architect-workshop.jpg';
import { tentangTeamCredentialsData } from './TentangTeamCredentials.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-light)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={tentangTeamCredentialsData.heading}
      subtitle={tentangTeamCredentialsData.subheading}
      level="h2"
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <!-- Left: Artisan Workshop Image (6 cols) -->
      <figure class="lg:col-span-6 flex flex-col gap-3">
        <div class="relative overflow-hidden aspect-[4/3] bg-[var(--color-canvas-surface)] border border-[var(--color-border-hairline)] shadow-xs">
          <Image
            src={imgWorkshop}
            alt="Bengkel Kerja Kolaborasi Artisan Kayu dan Arsitek HomeSketch"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
        <figcaption class="text-xs text-[var(--color-ink-muted)]">
          Fabrikasi joinery bespoke dan pengujian kekuatan serat kayu jati solid bersama master artisan.
        </figcaption>
      </figure>

      <!-- Right: Roles List (6 cols) -->
      <div class="lg:col-span-6 flex flex-col divide-y divide-[var(--color-border-hairline)] border-y border-[var(--color-border-hairline)]">
        {tentangTeamCredentialsData.roles.map((role) => (
          <article class="py-6 flex flex-col gap-1.5">
            <h3 class="font-serif text-lg font-bold text-[var(--color-ink-primary)]">
              {role.title}
            </h3>
            <span class="text-[11px] uppercase tracking-widest text-[var(--color-accent-terracotta)] font-semibold">
              {role.credential}
            </span>
            <p class="text-xs sm:text-sm text-[var(--color-ink-muted)] leading-relaxed">
              {role.responsibility}
            </p>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
