---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import { tentangPhilosophyData } from './TentangPhilosophy.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-surface)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <div class="lg:col-span-5">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold leading-[1.18] tracking-tight text-[var(--color-ink-primary)]">
          {tentangPhilosophyData.heading}
        </h2>
      </div>
      <div class="lg:col-span-7 flex flex-col gap-5 text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed">
        {tentangPhilosophyData.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <HairlineDivider />

    <!-- Commitments -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {tentangPhilosophyData.commitments.map((item) => (
        <article class="flex flex-col gap-2 border-t border-[var(--color-border-hairline)] pt-6">
          <h3 class="font-serif text-lg font-bold text-[var(--color-ink-primary)]">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-[var(--color-ink-muted)] leading-relaxed">
            {item.desc}
          </p>
        </article>
      ))}
    </div>
  </Container>
</section>
