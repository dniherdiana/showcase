---
import { Image } from 'astro:assets';
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import imgLab from '../../assets/images/monochrome-lab.jpg';
import { tentangMaterialEthicsData } from './TentangMaterialEthics.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-dark-hairline)] bg-[var(--color-canvas-dark)] text-[var(--color-ink-light)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={tentangMaterialEthicsData.heading}
      subtitle={tentangMaterialEthicsData.subheading}
      level="h2"
      dark={true}
    />

    <!-- Asymmetric 8/4 or 6/6 Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <!-- Left: 4 Pillars (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-8">
        {tentangMaterialEthicsData.pillars.map((p) => (
          <article class="flex flex-col gap-2 border-t border-[var(--color-border-dark-hairline)] pt-5">
            <h3 class="font-serif text-base sm:text-lg font-bold text-[var(--color-ink-light)]">
              {p.title}
            </h3>
            <span class="text-[10px] uppercase tracking-widest text-[var(--color-accent-sage)] font-semibold">
              {p.tag}
            </span>
            <p class="text-xs text-[var(--color-ink-light-muted)] leading-relaxed">
              {p.desc}
            </p>
          </article>
        ))}
      </div>

      <!-- Right: Lab & Material Study Image (5 cols) -->
      <figure class="lg:col-span-5 flex flex-col gap-3">
        <div class="relative overflow-hidden aspect-[4/3] border border-[var(--color-border-dark-hairline)] bg-[var(--color-canvas-dark-surface)] shadow-md">
          <Image
            src={imgLab}
            alt="Laboratorium Pengujian Sampel Material dan Pencahayaan HomeSketch"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
        <figcaption class="text-xs text-[var(--color-ink-light-muted)]">
          Pengujian respon pantulan cahaya dan ketahanan permukaan material pada laboratorium studio.
        </figcaption>
      </figure>
    </div>
  </Container>
</section>
