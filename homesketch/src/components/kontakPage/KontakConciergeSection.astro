---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import ConsultationConcierge from '../islands/ConsultationConcierge.svelte';
import { kontakConciergeSectionData } from './KontakConciergeSection.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-surface)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={kontakConciergeSectionData.heading}
      subtitle={kontakConciergeSectionData.subheading}
      level="h2"
    />

    <!-- Interactive Concierge Island -->
    <ConsultationConcierge client:visible />
  </Container>
</section>
