---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import { kontakServiceAreaData } from './KontakServiceArea.data.js';
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-light)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={kontakServiceAreaData.heading}
      subtitle={kontakServiceAreaData.subheading}
      level="h2"
    />

    <!-- Locations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {kontakServiceAreaData.locations.map((loc) => (
        <article class="flex flex-col gap-3 border-t border-[var(--color-border-hairline)] pt-6">
          <h3 class="font-serif text-xl font-bold text-[var(--color-ink-primary)]">
            {loc.name}
          </h3>
          <span class="text-[11px] uppercase tracking-widest text-[var(--color-accent-terracotta)] font-semibold">
            {loc.area}
          </span>
          <p class="text-xs sm:text-sm text-[var(--color-ink-muted)] leading-relaxed">
            {loc.desc}
          </p>
          <span class="text-xs text-[var(--color-ink-primary)] font-medium pt-2 border-t border-[var(--color-border-hairline)]">
            {loc.details}
          </span>
        </article>
      ))}
    </div>

    <HairlineDivider />

    <!-- Direct Channels Bar -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm text-[var(--color-ink-muted)] bg-[var(--color-canvas-surface)] p-6 sm:p-8 border border-[var(--color-border-hairline)]">
      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-widest text-[var(--color-ink-primary)] font-semibold mb-1">
          WhatsApp Resmi
        </span>
        <a
          href={kontakServiceAreaData.channels.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-serif text-lg font-bold text-[var(--color-accent-terracotta)] hover:underline"
        >
          {kontakServiceAreaData.channels.whatsapp}
        </a>
      </div>

      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-widest text-[var(--color-ink-primary)] font-semibold mb-1">
          Surat Elektronik
        </span>
        <span class="font-serif text-lg font-bold text-[var(--color-ink-primary)]">
          {kontakServiceAreaData.channels.email}
        </span>
      </div>

      <div class="flex flex-col">
        <span class="text-xs uppercase tracking-widest text-[var(--color-ink-primary)] font-semibold mb-1">
          Waktu Operasional
        </span>
        <span class="text-xs">
          {kontakServiceAreaData.channels.hours}
        </span>
      </div>
    </div>
  </Container>
</section>
