---
import Container from '../base/Container.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import { kontakHeroData } from './KontakHero.data.js';
---

<section class="pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-light)]">
  <Container size="xl" as="div" class="flex flex-col gap-12 lg:gap-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <div class="lg:col-span-8 flex flex-col gap-6">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-[1.14] tracking-tight text-[var(--color-ink-primary)]">
          {kontakHeroData.heading}
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-[62ch]">
          {kontakHeroData.subheading}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col gap-4 border-t lg:border-t-0 lg:border-l border-[var(--color-border-hairline)] pt-6 lg:pt-0 lg:pl-8">
        <span class="text-xs uppercase tracking-widest text-[var(--color-ink-primary)] font-semibold">
          Protokol Privasi & Layanan
        </span>
        <ul class="flex flex-col gap-3 text-xs text-[var(--color-ink-muted)]">
          {kontakHeroData.commitments.map((item) => (
            <li class="flex flex-col">
              <span class="font-semibold text-[var(--color-ink-primary)]">{item.title}</span>
              <span class="leading-normal">{item.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>
