---
import Container from '../base/Container.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import { Compass, Layers, ShieldCheck } from 'lucide-astro';
import { homeManifestoData } from './HomeManifesto.data.js';

const iconMap = {
  Compass,
  Layers,
  ShieldCheck,
};
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-surface)]">
  <Container size="xl" as="div" class="flex flex-col gap-16">
    <!-- Section Heading & Manifesto Intro -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <div class="lg:col-span-6">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold leading-[1.18] tracking-tight text-[var(--color-ink-primary)]">
          {homeManifestoData.heading}
        </h2>
      </div>
      <div class="lg:col-span-6">
        <p class="text-base sm:text-lg text-[var(--color-ink-muted)] leading-relaxed">
          {homeManifestoData.intro}
        </p>
      </div>
    </div>

    <HairlineDivider />

    <!-- Three Pillars as Open Editorial Rows with Semantic Lucide Icons -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">
      {homeManifestoData.pillars.map((pillar) => {
        const IconComponent = iconMap[pillar.icon as keyof typeof iconMap] || Compass;
        return (
          <article class="flex flex-col items-start gap-4">
            <div class="p-3 bg-[var(--color-canvas-light)] text-[var(--color-accent-terracotta)] border border-[var(--color-border-hairline)] shadow-2xs">
              <IconComponent class="w-6 h-6" stroke-width={1.75} />
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-semibold text-[var(--color-ink-primary)]">
              {pillar.title}
            </h3>
            <p class="text-sm text-[var(--color-ink-muted)] leading-relaxed">
              {pillar.description}
            </p>
          </article>
        );
      })}
    </div>
  </Container>
</section>
