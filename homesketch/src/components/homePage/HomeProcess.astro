---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import HairlineDivider from '../base/HairlineDivider.astro';
import { Compass, DraftingCompass, FileText, Hammer } from 'lucide-astro';
import { homeProcessData } from './HomeProcess.data.js';

const iconMap = {
  Compass,
  DraftingCompass,
  FileText,
  Hammer,
};
---

<section class="py-20 lg:py-28 border-b border-[var(--color-border-hairline)] bg-[var(--color-canvas-light)]">
  <Container size="xl" as="div" class="flex flex-col gap-14 lg:gap-16">
    <!-- Header -->
    <SectionHeader
      title={homeProcessData.heading}
      subtitle={homeProcessData.subheading}
      level="h2"
    />

    <!-- Process Stages as Open Ruled List with Semantic Icons -->
    <ul class="flex flex-col divide-y divide-[var(--color-border-hairline)] border-y border-[var(--color-border-hairline)]">
      {homeProcessData.stages.map((stg) => {
        const IconComponent = iconMap[stg.icon as keyof typeof iconMap] || Compass;
        return (
          <li class="py-8 sm:py-10 grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-10 items-start">
            <!-- Col 1: Icon & Name (4 cols) -->
            <div class="md:col-span-4 flex items-start gap-4">
              <div class="p-3 bg-[var(--color-canvas-surface)] text-[var(--color-accent-terracotta)] border border-[var(--color-border-hairline)] shrink-0">
                <IconComponent class="w-5 h-5" stroke-width={1.75} />
              </div>
              <div class="flex flex-col">
                <h3 class="font-serif text-lg font-bold text-[var(--color-ink-primary)]">
                  {stg.stageName}
                </h3>
                <span class="text-xs text-[var(--color-accent-terracotta)] font-medium mt-1">
                  Luaran: {stg.deliverable}
                </span>
              </div>
            </div>

            <!-- Col 2: Explanation (8 cols) -->
            <div class="md:col-span-8 flex flex-col justify-center">
              <p class="text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed">
                {stg.description}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
