---
import { Image } from "astro:assets";
import Container from "../base/Container.astro";
import Button from "../base/Button.astro";
import heroImage from "../../assets/images/hero-architecture.jpg";
import { homeHeroData } from "./HomeHero.data.js";
---

<section
	class="relative min-h-[90vh] lg:min-h-[95vh] flex items-center pt-24 pb-20 lg:pt-12 lg:pb-18 border-b border-[var(--color-border-dark-hairline)] overflow-hidden bg-[var(--color-canvas-dark)] text-white"
>
	<!-- Full-Bleed Background Image with Subtle Dark Overlay -->
	<div class="absolute inset-0 z-0">
		<Image
			src={heroImage}
			alt="Karya Arsitektur Tropis Modern HomeSketch di Bali dan Jakarta"
			class="w-full h-full object-cover object-center scale-102"
			loading="eager"
			quality="high"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/50 to-black/80"
		>
		</div>
	</div>

	<!-- Content Container -->
	<Container
		size="xl"
		as="div"
		class="relative z-10 flex flex-col gap-12 lg:gap-16 w-full"
	>
		<!-- Top Editorial Header & Intro -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
			<!-- Title & H1 (7 cols) -->
			<div class="lg:col-span-7 flex flex-col gap-6">
				<h1
					class="text-2xl sm:text-3xl lg:text-4xl font-bold leading-[1.12] tracking-tight text-white drop-shadow-[0_2px_16px_rgba(0,0,0,0.9)] [text-shadow:_0_2px_12px_rgba(0,0,0,0.8),_0_4px_24px_rgba(0,0,0,0.6)]"
				>
					{homeHeroData.heading}
				</h1>
				<p
					class="text-base sm:text-lg text-white/90 leading-relaxed max-w-[56ch] drop-shadow-[0_1px_8px_rgba(0,0,0,0.8)] [text-shadow:_0_1px_6px_rgba(0,0,0,0.7)]"
				>
					{homeHeroData.subheading}
				</p>

				<!-- CTA Buttons -->
				<div
					class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
				>
					<Button
						href={homeHeroData.primaryCta.href}
						variant="dark"
						size="lg"
						target="_blank"
						rel="noopener noreferrer"
						class="!bg-[var(--color-accent-terracotta)] !text-white hover:!bg-[var(--color-accent-terracotta-hover)] shadow-xl"
					>
						{homeHeroData.primaryCta.label}
					</Button>
					<Button
						href={homeHeroData.secondaryCta.href}
						variant="secondary"
						size="lg"
						class="!bg-white/10 !text-white !border-white/30 backdrop-blur-sm hover:!bg-white/20 hover:!border-white/60 shadow-md"
					>
						{homeHeroData.secondaryCta.label}
					</Button>
				</div>
			</div>

			<!-- Right Editorial Annotation (5 cols) -->
			<div
				class="lg:col-span-5 flex flex-col justify-between self-stretch border-t lg:border-t-0 lg:border-l border-white/20 pt-6 lg:pt-0 lg:pl-10 text-sm text-white/85 gap-6 drop-shadow-[0_1px_6px_rgba(0,0,0,0.7)] [text-shadow:_0_1px_4px_rgba(0,0,0,0.6)]"
			>
				<div class="flex flex-col gap-3">
					<span
						class="text-xs uppercase tracking-widest text-white font-semibold"
					>
						Prinsip Desain HomeSketch
					</span>
					<p class="leading-relaxed">
						Pasar hunian mewah sering kali dipenuhi katalog massal: marmer
						seragam dan ornamen impor yang tidak mencerminkan pemiliknya. Kami
						merancang dari pola privasi, sirkulasi harian, dan material lokal
						alami seperti jati tua, andesit, serta teraso artisan.
					</p>
				</div>
				<div
					class="text-xs text-[var(--color-accent-sage)] font-medium [text-shadow:_0_1px_4px_rgba(0,0,0,0.6)]"
				>
					Layanan Arsitektur, Interior, dan Pengawasan Lapangan
				</div>
			</div>
		</div>

		<!-- Verified Metrics Rail -->
		<div
			class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-6 border-t border-white/20"
		>
			{
				homeHeroData.metrics.map((m, idx) => (
					<div class="flex flex-col border-l border-white/25 pl-4 drop-shadow-[0_1px_6px_rgba(0,0,0,0.8)]">
						<span class="font-serif text-xl sm:text-2xl font-bold text-white leading-tight [text-shadow:_0_2px_10px_rgba(0,0,0,0.8)]">
							{m.value}
						</span>
						<span class="text-xs text-white/80 mt-1 [text-shadow:_0_1px_4px_rgba(0,0,0,0.6)]">
							{m.label}
						</span>
					</div>
				))
			}
		</div>
	</Container>
</section>
