---
const { items = [], className = '' } = Astro.props;
---
<div class={`relative flex overflow-hidden ${className}`} aria-hidden="true">
	<div class="flex w-max animate-marquee gap-10 whitespace-nowrap px-5">
		{[...items, ...items].map((item, i) => (
			<span key={i} class="flex items-center gap-10">
				<span class="font-display text-5xl font-bold uppercase tracking-tight md:text-6xl">{item}</span>
				<span class="size-3 shrink-0 rounded-full bg-current opacity-40">●</span>
			</span>
		))}
	</div>
</div>