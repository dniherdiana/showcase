---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import DataNote from '../components/DataNote.astro';

const destinations = [
	{
		img: 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?q=80&w=900&auto=format&fit=crop',
		alt: 'Menara Eiffel Paris di sore hari',
		place: 'Paris, Prancis',
		tag: 'Eropa',
		title: 'Menyusuri romantika kota cahaya',
		desc: 'Kami urus semuanya — dari visa, hotel, sampai kursi terbaik untuk menikmati sunset di tepi Seine.',
	},
	{
		img: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=900&auto=format&fit=crop',
		alt: 'Mobil traveling melintasi jalan raya di pegunungan',
		place: 'Road Trip Indonesia',
		tag: 'Self-Drive',
		title: 'Kebebasan penuh di atas roda',
		desc: 'Rute custom yang dirancang per harinya — berhenti di mana pun kamu mau, tanpa terjebak paket tur.',
	},
	{
		img: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=900&auto=format&fit=crop',
		alt: 'Danau pegunungan yang tenang di bawah puncak salju',
		place: 'Nusa Dua & Lombok',
		tag: 'Relaksasi',
		title: 'Pulang dengan hati yang tenang',
		desc: 'Honeymoon, family trip, atau healing sendiri — paket kami disesuaikan dengan ritme kamu.',
	},
];

const bento = [
	{
		title: 'Paket Liburan',
		desc: 'Domestik & internasional, lengkap dengan akomodasi dan aktivitas.',
		icon: '✈',
		span: 'md:col-span-3 md:row-span-2',
	},
	{
		title: 'Corporate Travel',
		desc: 'Perjalanan bisnis & MICE dengan approval cepat.',
		icon: '⌂',
		span: 'md:col-span-3',
	},
	{
		title: 'Honeymoon & Umroh',
		desc: 'Momen sekali seumur hidup, kami rakit detail demi detail.',
		icon: '◈',
		span: 'md:col-span-3',
	},
	{
		title: 'Visa & Dokumen',
		desc: 'Urusan administrasi jadi urusan kami.',
		icon: '✍',
		span: 'md:col-span-2',
	},
	{
		title: 'Transport & Hotel',
		desc: 'Harga bersaing, stok pasti.',
		icon: '◉',
		span: 'md:col-span-2',
	},
];
---
<Layout title="i-Travel — Perjalanan Berbasis Bukti, Bukan Janji">
	<!-- ══════════ HERO — asymm, showroom, full-bleed ══════════ -->
	<section class="relative overflow-hidden bg-tide text-cream">
		<div class="container-px mx-auto grid items-center gap-10 pt-32 pb-16 md:grid-cols-12 md:pt-40">
			<div class="relative z-10 md:col-span-7">
				<p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-cream/25 bg-cream/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em]">
					<span class="size-2 rounded-full bg-peach"></span> 10 Tahun · 450+ Klien
				</p>
				<h1 class="reveal display-hero text-[clamp(3rem,8vw,6.5rem)]">
					Perjalanan<br />
					<span class="serif font-medium italic text-peach">berbasis bukti,</span><br />
					bukan janji.
				</h1>
				<p class="reveal mt-6 max-w-md text-lg text-cream/80">
					i-Travel hadir sejak 2014 untuk merakit perjalanan yang benar-benar sampai.
					Client adalah aset berharga kami — kepuasan kamu, prioritas kami.
				</p>
				<div class="reveal mt-9 flex flex-wrap items-center gap-4">
					<a href="/layanan" class="group inline-flex items-center gap-3 rounded-full bg-peach px-7 py-4 font-display text-base font-bold text-ink shadow-xl shadow-ink/20 transition-transform hover:-translate-y-1">
						Mulai Rencanakan Perjalanan
						<span class="transition-transform group-hover:translate-x-1">→</span>
					</a>
					<a href="tel:+6281234567890" class="inline-flex items-center gap-2 font-semibold text-cream underline decoration-peach decoration-2 underline-offset-8 hover:text-peach">
						Atau telepon langsung →
					</a>
				</div>
			</div>

			<div class="relative z-10 md:col-span-5">
				<figure class="reveal relative">
					<img
						src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?q=80&w=900&auto=format&fit=crop"
						alt="Resor tropis dengan kolam renang menghadap laut"
						class="aspect-[4/5] w-full rounded-blob object-cover shadow-2xl shadow-ink/40"
						loading="eager"
					/>
					<div class="animate-float absolute -left-6 bottom-16 rounded-2xl bg-cream px-5 py-4 text-ink shadow-xl">
						<p class="font-display text-3xl font-bold">450+</p>
						<p class="text-xs font-semibold text-ink/60">klien bahagia</p>
					</div>
					<div class="absolute -right-4 top-8 rounded-full bg-ink px-5 py-3 font-display text-sm font-bold shadow-lg">
						<i class="serif not-italic text-peach">✈</i> 100% tersusun rapi
					</div>
				</figure>
			</div>
		</div>

		<div class="relative border-t border-cream/15">
			<div class="container-px mx-auto flex flex-wrap items-center justify-between gap-4 py-5 text-xs font-semibold uppercase tracking-[0.2em] text-cream/60">
				<span>Honeymoon</span><span class="text-peach">●</span>
				<span>Corporate Trip</span><span class="text-peach">●</span>
				<span>Family Vacation</span><span class="text-peach">●</span>
				<span>Umroh</span><span class="text-peach">●</span>
				<span>Group Tour</span>
			</div>
		</div>
	</section>

	<!-- ══════════ MARQUEE ══════════ -->
	<Marquee items={['Bali', 'Yogyakarta', 'Lombok', 'Paris', 'Tokyo', 'Dubai', 'Labuan Bajo', 'Singapura']} className="bg-ink py-8 text-peach" />

	<!-- ══════════ BUKTI — stat band (Home treatment: 3 angka besar) ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="grid gap-6 md:grid-cols-12">
			<div class="md:col-span-4">
				<h2 class="reveal display-hero text-4xl md:text-5xl">
					Angka yang<br /><span class="serif italic text-tide">bercerita.</span>
				</h2>
				<p class="reveal mt-5 max-w-xs text-ink/60">
					Di sini kami tidak suka basa-basi. Ini bukti-bukti yang bisa kamu pegang.
				</p>
			</div>
			<div class="grid gap-4 md:col-span-8 md:grid-cols-3">
				{[['10', 'Tahun berdiri sejak 2014', 'bg-tide text-cream'], ['450+', 'Klien yang sudah diberangkatkan', 'bg-ink text-cream'], ['98%', 'Klien kembali memesan', 'bg-peach-soft text-ink']].map(([num, label, cls], i) => (
					<div key={i} class={`reveal group relative overflow-hidden rounded-blob p-8 ${cls}`}>
						<p class="font-display text-6xl font-bold tracking-tight">{num}</p>
						<p class="mt-3 max-w-[12rem] text-sm font-medium opacity-80">{label}</p>
						<span class="absolute -bottom-6 -right-4 font-display text-8xl font-bold opacity-10 transition-transform group-hover:scale-110">{num === '98%' ? '♥' : num}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ LAYANAN — bento asymm ══════════ -->
	<section class="bg-sand py-20 md:py-28">
		<div class="container-px mx-auto">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<div>
					<p class="reveal text-xs font-bold uppercase tracking-[0.25em] text-tide">Apa yang kami urus</p>
					<h2 class="reveal display-hero mt-3 text-4xl md:text-6xl">Satu pintu,<br />semua <span class="serif italic text-peach">urusannya.</span></h2>
				</div>
				<a href="/layanan" class="reveal rounded-full border-2 border-ink px-6 py-3 font-display text-sm font-bold transition-colors hover:bg-ink hover:text-cream">Lihat semua layanan →</a>
			</div>

			<div class="mt-14 grid gap-4 md:grid-cols-6">
				<div class="reveal col-span-6 flex flex-col justify-between overflow-hidden rounded-blob bg-tide p-8 text-cream md:col-span-3 md:row-span-2 md:p-10">
					<div>
						<span class="grid size-14 place-items-center rounded-2xl bg-cream/15 text-2xl">✈</span>
						<h3 class="mt-6 font-display text-3xl font-bold">Paket Liburan</h3>
						<p class="mt-3 max-w-sm text-cream/80">Domestik maupun internasional — tiket, hotel, aktivitas, semuanya dirangkai dalam satu harga yang transparan.</p>
					</div>
					<div class="mt-8 rounded-2xl bg-cream/10 p-5">
						<p class="font-display text-sm font-bold uppercase tracking-widest text-peach">Mulai dari</p>
						<p class="mt-1 font-display text-2xl font-bold">Rp1.250.000 <span class="text-sm text-cream/60">/ orang</span></p>
					</div>
				</div>
				{[['Corporate Travel', 'Perjalanan bisnis, incentive, dan MICE — dengan approval yang cepat dan akuntabel.', '⌂', 'md:col-span-3', 'bg-ink text-cream'],
					['Honeymoon & Umroh', 'Momen sekali seumur hidup dirakit detail demi detail, sampai kamu lupa mengurus apa pun.', '◈', 'md:col-span-3', 'bg-peach text-ink'],
					['Visa & Dokumen', 'Urusan administrasi jadi urusan kami — pengurusan visa sampai asuransi perjalanan.', '✍', 'md:col-span-2', 'bg-cream text-ink border border-ink/10'],
					['Transport & Hotel', 'Harga bersaing, stok pasti, dan kualitas terverifikasi.', '◉', 'md:col-span-2', 'bg-cream text-ink border border-ink/10'],
					['Dari kami, Anda', 'tinggal packing — sisanya kami yang urus.', '☀', 'md:col-span-2', 'bg-tide text-cream']].map(([t, d, icon, span, cls], i) => (
					<div key={i} class={`reveal flex flex-col justify-between rounded-blob p-7 ${span} ${cls}`}>
						<div class="flex items-start justify-between">
							<h3 class="font-display text-xl font-bold leading-snug">{t}</h3>
							<span class="text-2xl">{icon}</span>
						</div>
						<p class="mt-4 text-sm opacity-75">{d}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ DESTINATION SHOWCASE — editorial asymm ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="flex items-end justify-between gap-6">
			<h2 class="reveal display-hero text-4xl md:text-6xl">Kemana kita<br /><span class="serif italic text-tide">minggu ini?</span></h2>
			<p class="reveal hidden max-w-xs text-ink/60 md:block">Setiap rute dipilih sendiri oleh tim kami, bukan dari katalog pabrikan.</p>
		</div>

		<div class="mt-14 grid gap-5 md:grid-cols-12">
			<article class="reveal group relative overflow-hidden rounded-blob md:col-span-7">
				<img src={destinations[0].img} alt={destinations[0].alt} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
				<div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent" />
				<div class="absolute inset-x-0 bottom-0 p-8 text-cream">
					<span class="rounded-full bg-peach px-3 py-1 text-xs font-bold uppercase tracking-widest text-ink">{destinations[0].tag}</span>
					<h3 class="mt-3 font-display text-3xl font-bold">{destinations[0].title}</h3>
					<p class="mt-2 max-w-md text-sm text-cream/75">{destinations[0].desc}</p>
					<p class="mt-4 font-display text-sm font-bold text-peach">{destinations[0].place}</p>
				</div>
			</article>
			<article class="reveal group relative overflow-hidden rounded-blob md:col-span-5 md:mt-16">
				<img src={destinations[1].img} alt={destinations[1].alt} loading="lazy" class="aspect-[4/5] h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
				<div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent" />
				<div class="absolute inset-x-0 bottom-0 p-8 text-cream">
					<span class="rounded-full bg-cream px-3 py-1 text-xs font-bold uppercase tracking-widest text-ink">{destinations[1].tag}</span>
					<h3 class="mt-3 font-display text-2xl font-bold">{destinations[1].title}</h3>
					<p class="mt-2 text-sm text-cream/75">{destinations[1].desc}</p>
					<p class="mt-4 font-display text-sm font-bold text-peach">{destinations[1].place}</p>
				</div>
			</article>
			<article class="reveal group relative overflow-hidden rounded-blob md:col-span-5">
				<img src={destinations[2].img} alt={destinations[2].alt} loading="lazy" class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
				<div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent" />
				<div class="absolute inset-x-0 bottom-0 p-8 text-cream">
					<span class="rounded-full bg-peach px-3 py-1 text-xs font-bold uppercase tracking-widest text-ink">{destinations[2].tag}</span>
					<h3 class="mt-3 font-display text-2xl font-bold">{destinations[2].title}</h3>
					<p class="mt-2 text-sm text-cream/75">{destinations[2].desc}</p>
					<p class="mt-4 font-display text-sm font-bold text-peach">{destinations[2].place}</p>
				</div>
			</article>
			<a href="/galeri" class="reveal group flex flex-col items-center justify-center gap-3 rounded-blob border-2 border-dashed border-ink/25 text-center transition-colors hover:border-tide hover:bg-tide/5 md:col-span-7">
				<span class="grid size-16 place-items-center rounded-full bg-ink text-cream transition-transform group-hover:rotate-45">→</span>
				<p class="font-display text-lg font-bold">Lihat galeri perjalanan →</p>
			</a>
		</div>
	</section>

	<!-- ══════════ TESTIMONI — bukti dari klien (placeholder) ══════════ -->
	<section class="bg-ink py-20 text-cream md:py-28">
		<div class="container-px mx-auto grid gap-12 md:grid-cols-12">
			<div class="md:col-span-4">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-peach">Kata mereka</p>
				<h2 class="display-hero mt-3 text-4xl md:text-5xl">Bukti nyata<br />dari <span class="serif italic">perjalanan.</span></h2>
				<p class="mt-5 text-cream/70">450+ klien berangkat bersama kami. Ini sebagian cerita yang mereka tinggalkan.</p>
			</div>
			<div class="md:col-span-8">
				<div class="data-note rounded-blob p-6 font-display text-lg font-bold">
					[PERLU DATA CLIENT: testimoni klien — nama, foto, dan cerita perjalanan]
				</div>
				<div class="mt-6 grid gap-4 md:grid-cols-2">
					{[0, 1, 2, 3].map((i) => (
						<div key={i} class="rounded-2xl border-2 border-dashed border-peach bg-cream p-6">
							<div class="flex gap-1 text-peach" aria-label="bintang">★★★★★</div>
							<p class="mt-4 text-sm font-semibold text-ink/80">[PERLU DATA CLIENT: isi testimoni #{i + 1}]</p>
							<div class="mt-5 flex items-center gap-3">
								<span class="grid size-10 place-items-center rounded-full bg-ink/10 font-display text-xs font-bold text-ink">—</span>
								<span class="rounded-md bg-ink px-2 py-1 text-xs font-bold text-cream">[Nama Klien #{i + 1}]</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ CTA ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="relative overflow-hidden rounded-blob bg-tide px-8 py-16 text-center text-cream md:py-24">
			<span class="pointer-events-none absolute -left-10 -top-10 font-display text-[16rem] font-bold text-cream/5">✈</span>
			<span class="pointer-events-none absolute -bottom-16 right-0 font-display text-[16rem] font-bold text-cream/5">✈</span>
			<h2 class="reveal display-hero relative mx-auto max-w-3xl text-4xl md:text-6xl">
				Liburan berikutnya menunggu. <span class="serif italic text-peach">Biar kami yang sibuk.</span>
			</h2>
			<p class="reveal relative mx-auto mt-5 max-w-xl text-cream/80">
				Kirim rencana liburanmu, dapatkan rincian harga lengkap dalam 24 jam — tanpa komitmen.
			</p>
			<div class="reveal relative mt-9 flex flex-wrap items-center justify-center gap-4">
				<a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="rounded-full bg-peach px-8 py-4 font-display font-bold text-ink shadow-xl shadow-ink/20 transition-transform hover:-translate-y-1">Order via WhatsApp →</a>
				<a href="/kontak" class="rounded-full border-2 border-cream/50 px-8 py-4 font-display font-bold text-cream transition-colors hover:bg-cream hover:text-ink">Isi booking form</a>
			</div>
		</div>
	</section>
</Layout>
