---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';

const timeline = [
	{ year: '2014', title: 'Awal dari satu meja', desc: 'i-Travel lahir dari meja kecil di rumah. Saat itu kami hanya mendampingi 3 keluarga berangkat ke Bali.' },
	{ year: '2016', title: 'Percaya mulai datang', desc: 'Klien pertama yang kembali memesan rujuk kami ke kawan-kawannya. Tanpa iklan, pesanan mengalir dari mulut ke mulut.' },
	{ year: '2018', title: 'Melangkah ke internasional', desc: 'Dari domestik, kami membuka rute ke negara tetangga dan Eropa — lengkap dengan pengurusan visa sendiri.' },
	{ year: '2020', title: 'Ujian tersulit', desc: 'Pandemi menahan semua perjalanan. Kami tak pergi kemana-mana, tapi tetap mengawal setiap klien yang tertahan sampai pulang aman.' },
	{ year: '2022', title: 'Bangkit kembali', desc: 'Permintaan melonjak. Annual klien terdakwa kembali, dan nama i-Travel makin dipercaya perusahaan-perusahaan besar.' },
	{ year: '2024', title: '450+ klien dan terus bertambah', desc: 'Sepuluh tahun berlalu. Kami tidak berubah prinsip: bukti di atas janji, kepuasan di atas perapalan.' },
];

const values = [
	{ icon: '☑', title: 'Bukti, bukan janji', desc: 'Setiap paket disertai rincian nyata — harga, hotel, itinerary — sebelum kamu memutuskan.' },
	{ icon: '♥', title: 'Client sebagai aset', desc: 'Kami memperlakukan setiap nama sebagai aset jangka panjang, bukan transaksi sekali jalan.' },
	{ icon: '◉', title: 'Kepuasan di atas segalanya', desc: 'Prioritas utama kami sederhana: kamu pulang dengan cerita yang bahagia.' },
];
---
<Layout title="Tentang Kami — Cerita di Balik i-Travel">
	<!-- ══════════ HERO — editorial, dark, "di balik layar" ══════════ -->
	<section class="relative overflow-hidden bg-ink pb-20 pt-32 text-cream md:pt-44">
		<span class="pointer-events-none absolute right-0 top-20 font-display text-[22rem] font-bold leading-none text-white/5">10</span>
		<div class="container-px mx-auto grid items-end gap-10 md:grid-cols-12">
			<div class="md:col-span-7">
				<p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-cream/20 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em]">
					<span class="size-2 rounded-full bg-peach"></span> Kisah kami sejak 2014
				</p>
				<h1 class="reveal display-hero text-[clamp(2.6rem,7vw,5.5rem)]">
					Di balik tiap<br />
					<span class="serif italic text-peach">keberangkatan</span><br />
					ada tangan kami.
				</h1>
			</div>
			<div class="md:col-span-5">
				<p class="reveal text-lg leading-relaxed text-cream/70">
					Kami bukan perusahaan perjalanan yang tiba-tiba besar. Kami tumbuh satu klien bahagia dalam sekali waktu — dan sepanjang perjalanan itu, satu hal yang tidak pernah berubah: <em class="serif italic text-peach">setiap nama yang kami layani kami perlakukan sebagai aset jangka panjang.</em>
				</p>
			</div>
		</div>
	</section>

	<!-- ══════════ STORY — portrait + narasi asymm ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="grid items-center gap-12 md:grid-cols-12">
			<div class="relative md:col-span-6">
				<div class="reveal overflow-hidden rounded-blob">
					<img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=900&auto=format&fit=crop" alt="Founder i-Travel tersenyum" loading="lazy" class="aspect-[4/5] w-full object-cover" />
				</div>
				<div class="animate-float absolute -right-4 -bottom-6 max-w-[15rem] rounded-2xl bg-tide p-5 text-cream shadow-xl">
					<p class="font-display text-sm font-bold leading-snug">"Perjalanan bukan soal sampai, tapi soal dipercaya."</p>
					<p class="mt-2 flex items-center gap-1.5 text-xs text-cream/70">— <span class="data-note rounded-md px-1.5 py-0.5 text-[10px] font-bold">[PERLU DATA CLIENT: nama founder]</span></p>
				</div>
			</div>
			<div class="md:col-span-6">
				<p class="reveal text-xs font-bold uppercase tracking-[0.25em] text-tide">Siapa kami</p>
				<h2 class="reveal display-hero mt-3 text-4xl md:text-5xl">Bukan sekadar agen,<br />ini <span class="serif italic text-tide">rumah perjalanan.</span></h2>
				<div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-ink/70">
					<p>Mulai dari ruang tamu kecil, i-Travel tumbuh menjadi tim yang menangani ratusan klien setiap tahun — tapi cara kami bekerja tidak pernah berubah.</p>
					<p>Kami tidak jual paket. Kami memastikan kamu tahu sebelum berangkat: hotel apa, rute apa, berapa persisnya. Karena di i-Travel, <strong class="text-ink">kepuasan client adalah prioritas kami</strong> — bukan sekadar janji di brosur.</p>
				</div>
				<div class="reveal mt-8 grid grid-cols-3 gap-4 border-t border-ink/10 pt-6">
					{[['10', 'Tahun berdiri'], ['450+', 'Klien puas'], ['98%', 'Kepuasan pelanggan']].map(([n, l]) => (
						<div><p class="font-display text-3xl font-bold text-tide">{n}</p><p class="mt-1 text-xs font-semibold text-ink/50">{l}</p></div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ TIMELINE — unik untuk halaman Tentang ══════════ -->
	<section class="bg-sand py-20 md:py-28">
		<div class="container-px mx-auto">
			<p class="reveal text-center text-xs font-bold uppercase tracking-[0.25em] text-tide">Perjalanan 10 tahun</p>
			<h2 class="reveal display-hero mt-3 text-center text-4xl md:text-5xl">Satu dekade, banyak cerita.</h2>

			<div class="relative mx-auto mt-16 max-w-3xl">
				<div class="absolute left-5 top-0 h-full w-px bg-tide/30 md:left-1/2" aria-hidden="true"></div>
				<div class="space-y-12">
					{timeline.map((t, i) => (
						<div key={t.year} class={`reveal relative flex items-start gap-8 md:w-1/2 ${i % 2 ? 'md:ml-auto md:pl-0 md:pr-12' : 'md:pr-12'} pl-8 md:pl-0`}>
							<span class:list={["absolute left-5 top-2 grid size-4 -translate-x-1/2 place-items-center rounded-full ring-4 ring-sand", "bg-tide", i % 2 ? 'md:left-auto md:right-0 md:translate-x-1/2' : 'md:left-0']} aria-hidden="true"></span>
							<div>
								<p class="font-display text-4xl font-bold text-tide">{t.year}</p>
								<h3 class="mt-2 font-display text-xl font-bold">{t.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink/60">{t.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ VALUES — grid 3, treatment beda ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="grid gap-6 md:grid-cols-12">
			<div class="md:col-span-3">
				<h2 class="reveal display-hero text-3xl md:text-4xl">Prinsip yang<br />kami <span class="serif italic text-tide">pegang.</span></h2>
				<p class="reveal mt-4 text-ink/60">Sistem bisa berubah, tapi nilai ini tidak.</p>
			</div>
			{values.map((v, i) => (
				<div key={i} class:list={[
					'reveal flex flex-col justify-between gap-6 rounded-blob p-8',
					i === 0 ? 'bg-ink text-cream' : '',
					i === 1 ? 'bg-tide text-cream' : '',
					i === 2 ? 'bg-peach-soft text-ink' : '',
				]}>
					<span class="grid size-14 place-items-center rounded-full text-2xl bg-cream/15">{v.icon}</span>
					<div>
						<h3 class="font-display text-2xl font-bold">{v.title}</h3>
						<p class="mt-3 text-sm leading-relaxed opacity-75">{v.desc}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- ══════════ MARQUEE dark ══════════ -->
	<Marquee items={['Dipercaya sejak 2014', '450+ klien bahagia', 'Bukti yang bisa dipegang', 'Kepuasan yang membuat kembali']} className="bg-tide py-6 text-cream" />

	<!-- ══════════ CTA ══════════ -->
	<section class="container-px mx-auto py-20 md:py-28">
		<div class="flex flex-col items-center gap-8 overflow-hidden rounded-blob bg-ink px-8 py-16 text-center text-cream md:flex-row md:justify-between md:text-left">
			<div>
				<h2 class="display-hero text-3xl md:text-5xl">Kenal kami lebih dekat,<br /><span class="serif italic text-peach">lewat perjalanan nyata.</span></h2>
				<p class="mt-4 max-w-md text-cream/70">Percayakan jadwalmu pada tim yang sudah 10 tahun di jalanan.</p>
			</div>
			<div class="flex flex-col gap-3 sm:flex-row">
				<a href="/kontak" class="rounded-full bg-peach px-7 py-4 font-display font-bold text-ink transition-transform hover:-translate-y-1">Sapa tim kami →</a>
				<a href="/galeri" class="rounded-full border-2 border-cream/40 px-7 py-4 font-display font-bold transition-colors hover:bg-cream hover:text-ink">Lihat galeri</a>
			</div>
		</div>
	</section>
</Layout>