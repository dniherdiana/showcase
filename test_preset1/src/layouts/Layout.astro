---
const { title = 'i-Travel' } = Astro.props;
const { pathname } = Astro.url;
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/tentang', label: 'Tentang' },
	{ href: '/layanan', label: 'Layanan' },
	{ href: '/galeri', label: 'Galeri' },
	{ href: '/kontak', label: 'Kontak' },
];
---
<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="i-Travel — biro perjalanan 10 tahun, 450+ klien puas. Kami menawarkan bukti, bukan janji." />
		<title>{title}</title>
		<link rel="stylesheet" href="/src/styles/global.css" />
	</head>
	<body class="min-h-screen">
		<header class="fixed inset-x-0 top-0 z-50 transition-all" id="site-header">
			<div class="container-px mx-auto flex items-center justify-between py-4">
				<a href="/" class="group flex items-center gap-2.5" aria-label="i-Travel home">
					<span class="grid size-11 place-items-center rounded-full bg-tide text-cream font-display text-xl font-bold shadow-lg shadow-tide/30 transition-transform group-hover:rotate-12">i</span>
					<span class="font-display text-xl font-bold tracking-tight">i-Travel</span>
				</a>

				<nav aria-label="Utama" class="hidden lg:flex items-center gap-1 rounded-full border border-ink/10 bg-cream/80 px-2 py-1.5 backdrop-blur">
					{
						nav.map((item) => (
							<a
								href={item.href}
								class:list={[
									'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
									pathname === item.href ? 'bg-ink text-cream' : 'text-ink/70 hover:bg-sand',
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					href="https://wa.me/6281234567890"
					target="_blank"
					rel="noopener"
					class="hidden lg:inline-flex items-center gap-2 rounded-full bg-peach px-5 py-2.5 text-sm font-bold text-ink shadow-lg shadow-peach/40 transition-transform hover:-translate-y-0.5 hover:bg-peach-soft"
				>
					<svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
					Order via WA
				</a>

				<button id="menu-toggle" class="lg:hidden grid size-11 place-items-center rounded-full border border-ink/10 bg-cream" aria-label="Buka menu" aria-expanded="false">
					<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"/></svg>
				</button>
			</div>
		</header>

		<div id="mobile-menu" class="fixed inset-0 z-40 hidden flex-col bg-ink pt-28 pb-10 lg:hidden">
			<nav class="container-px flex flex-col gap-2" aria-label="Utama mobile">
				{
					nav.map((item) => (
						<a
							href={item.href}
							class:list={[
								'rounded-2xl px-5 py-4 font-display text-3xl font-bold tracking-tight transition-colors',
								pathname === item.href ? 'bg-peach text-ink' : 'text-cream hover:bg-white/10',
							]}
						>
							{item.label}
						</a>
					))
				}
			</nav>
			<div class="container-px mt-8">
				<a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-peach px-6 py-3.5 font-bold text-ink">Order via WhatsApp</a>
			</div>
		</div>

		<main>
			<slot />
		</main>

		<footer class="mt-0 bg-ink text-cream">
			<div class="container-px mx-auto grid gap-12 py-16 md:grid-cols-12">
				<div class="md:col-span-5">
					<div class="flex items-center gap-2.5">
						<span class="grid size-11 place-items-center rounded-full bg-peach font-display text-lg font-bold text-ink">i</span>
						<span class="font-display text-2xl font-bold">i-Travel</span>
					</div>
					<p class="mt-5 max-w-xs text-cream/70">Sepuluh tahun menemani perjalanan. Bukti bukan janji — itulah cara kami membangun perjalanan yang kamu percaya.</p>
					<div class="mt-6 flex gap-3">
						{[['IG','M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zM.02 0h4.96v10H.02V0zm17.98 9.4c0-2.4-1.32-3.65-3.42-3.65-1.46 0-2.31.67-2.74 1.6v-1.35H7.03V10h1.82v-4.8c.43-1.3 1.44-1.96 2.65-1.96 1.5 0 2.48.89 2.48 2.79V10h2.02V9.4z'],['FB','M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z'],['TT','M24 4.56a9.94 9.94 0 0 1-2.83.78 4.95 4.95 0 0 0 2.17-2.72c-.95.57-2 1-3.13 1.22a4.92 4.92 0 0 0-8.39 4.48A13.98 13.98 0 0 1 1.67 3.15a4.92 4.92 0 0 0 1.52 6.57c-.8-.03-1.55-.25-2.21-.61v.06a4.92 4.92 0 0 0 3.95 4.83 4.9 4.9 0 0 1-2.22.08 4.93 4.93 0 0 0 4.6 3.42A9.87 9.87 0 0 1 0 19.54a13.94 13.94 0 0 0 7.55 2.21c9.05 0 14-7.5 14-14 0-.21 0-.42-.02-.63A10 10 0 0 0 24 4.56z']].map(([label, d]) => (
							<a key={label} href="#" aria-label={label} class="grid size-10 place-items-center rounded-full bg-white/10 transition-colors hover:bg-peach hover:text-ink">
								<svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d={d}/></svg>
							</a>
						))}
					</div>
				</div>
				<div class="md:col-span-3">
					<h4 class="font-display font-bold uppercase tracking-widest text-cream/50 text-xs">Jelajahi</h4>
					<ul class="mt-4 space-y-3 text-sm">
						<li><a href="/" class="hover:text-peach transition-colors">Home</a></li>
						<li><a href="/tentang" class="hover:text-peach transition-colors">Tentang Kami</a></li>
						<li><a href="/layanan" class="hover:text-peach transition-colors">Layanan</a></li>
						<li><a href="/galeri" class="hover:text-peach transition-colors">Galeri</a></li>
						<li><a href="/kontak" class="hover:text-peach transition-colors">Kontak</a></li>
					</ul>
				</div>
				<div class="md:col-span-4">
					<h4 class="font-display font-bold uppercase tracking-widest text-cream/50 text-xs">Hubungi kami</h4>
					<ul class="mt-4 space-y-3 text-sm text-cream/70">
						<li class="flex items-start gap-3"><span class="mt-0.5 text-peach">✆</span> <a href="tel:+6281234567890" class="hover:text-peach">+62 812-3456-7890</a></li>
						<li class="flex items-start gap-3"><span class="mt-0.5 text-peach">✉</span> <a href="mailto:halo@i-travel.id" class="hover:text-peach">halo@i-travel.id</a></li>
						<li class="flex items-start gap-3"><span class="mt-0.5 text-peach">◎</span> <span class="data-note rounded-md px-2 py-0.5 text-xs font-bold">[PERLU DATA CLIENT: alamat kantor]</span></li>
					</ul>
				</div>
			</div>
			<div class="border-t border-white/10">
				<div class="container-px mx-auto flex flex-col gap-2 py-6 text-xs text-cream/50 md:flex-row md:items-center md:justify-between">
					<p>© {new Date().getFullYear()} i-Travel. Semua hak dilindungi.</p>
					<p class="serif italic">Dibuat dengan semangat jalan-jalan ✈</p>
				</div>
			</div>
		</footer>

		<script>
			// Header elevation on scroll
			const header = document.getElementById('site-header');
			const onScroll = () => {
				if (window.scrollY > 24) {
					header.classList.add('bg-cream/85', 'backdrop-blur', 'shadow-lg', 'shadow-ink/5');
				} else {
					header.classList.remove('bg-cream/85', 'backdrop-blur', 'shadow-lg', 'shadow-ink/5');
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// Mobile menu
			const toggle = document.getElementById('menu-toggle');
			const menu = document.getElementById('mobile-menu');
			toggle.addEventListener('click', () => {
				const opening = menu.classList.contains('hidden');
				menu.classList.toggle('hidden');
				menu.classList.toggle('flex');
				toggle.setAttribute('aria-expanded', String(opening));
				document.body.style.overflow = opening ? 'hidden' : '';
			});

			// Scroll reveal
			const io = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('is-in');
							io.unobserve(e.target);
						}
					});
				},
				{ threshold: 0.12 }
			);
			document.querySelectorAll('.reveal').forEach((el, i) => {
				el.style.transitionDelay = `${(i % 4) * 90}ms`;
				io.observe(el);
			});
		</script>
	</body>
</html>
