---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="AURA Aesthetic & Beauty Lounge | Home Showcase"
  description="Pengalaman perawatan kecantikan yang mewah, nyaman, dan personal didukung oleh terapis profesional & produk premium di AURA Beauty Lounge."
>
  <!-- 1. Hero Section: Asymmetric Digital Magazine Cover -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden py-12 lg:py-20">
    <!-- Glowing background blurs -->
    <div class="absolute -top-24 -left-24 w-[500px] h-[500px] bg-pink-600/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 right-0 w-[400px] h-[400px] bg-purple-600/20 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Magazine Header & Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-3">
            <span class="magazine-badge">DIGITAL ISSUE #08</span>
            <span class="text-xs font-bold text-pink-300/80 tracking-widest uppercase border-b border-pink-500/30 pb-0.5">
              Beauty Salon & Aesthetic Care
            </span>
          </div>

          <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.05]">
            Kemewahan <br />
            <span class="text-gradient-vibrant">Perawatan Personal</span> <br />
            Untuk Kulit Impian.
          </h1>

          <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl">
            Kami menghadirkan pengalaman perawatan kecantikan yang mewah, nyaman, dan personal dengan didukung oleh terapis profesional, produk premium, serta standar kebersihan yang tinggi. Setiap treatment dirancang untuk memberikan hasil optimal sekaligus pengalaman relaksasi yang berkesan.
          </p>

          <!-- CTAs & Trust Badges -->
          <div class="flex flex-wrap items-center gap-4 pt-4">
            <button
              onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
              class="px-8 py-4 text-xs font-black uppercase tracking-widest text-white bg-gradient-to-r from-[#E6007A] via-[#8B5CF6] to-[#F59E0B] rounded-full shadow-xl shadow-pink-600/30 hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer flex items-center gap-3"
            >
              <span>Booking Sekarang</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <a
              href="/treatment"
              class="px-8 py-4 text-xs font-black uppercase tracking-widest text-pink-300 bg-pink-950/40 border border-pink-500/40 rounded-full hover:bg-pink-900/40 hover:text-white transition-all duration-300"
            >
              Lihat Treatment
            </a>
          </div>

          <!-- Hero Metrics Bar -->
          <div class="pt-8 grid grid-cols-3 gap-4 border-t border-pink-950/60 max-w-xl">
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold font-serif text-white">10+ Thn</span>
              <span class="text-xs text-gray-400 font-semibold">Pengalaman</span>
            </div>
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold font-serif text-pink-400">15.000+</span>
              <span class="text-xs text-gray-400 font-semibold">Pelanggan Puas</span>
            </div>
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold font-serif text-amber-400">4.9 / 5★</span>
              <span class="text-xs text-gray-400 font-semibold">Rating Klien</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Showcase Frame with Overlay Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Decorative Backing Frame -->
            <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-[#E6007A] via-[#8B5CF6] to-[#F59E0B] opacity-30 blur-xl"></div>
            
            <div class="relative rounded-3xl overflow-hidden border border-pink-500/30 shadow-2xl bg-[#14101B]">
              <img
                src="https://images.unsplash.com/photo-1560750588-73207b1ef5b8?w=800&auto=format&fit=crop&q=80"
                alt="Pengalaman Perawatan Kecantikan Mewah AURA Salon"
                class="w-full h-[480px] object-cover hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0C0A10] via-transparent to-transparent"></div>

              <!-- Floating Glass Card 1 -->
              <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-glass border border-white/10 shadow-xl">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-pink-600/30 flex items-center justify-center text-pink-300 font-bold">
                    ★
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-white">Signature Diamond Laser</h4>
                    <p class="text-xs text-gray-300">Hasil Kulit Glowing & Lifted Instan</p>
                  </div>
                </div>
              </div>

              <!-- Floating Tag -->
              <div class="absolute top-6 left-6 px-3 py-1.5 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-bold tracking-widest text-amber-300 border border-amber-500/40 uppercase">
                ✦ Terapis Bersertifikat Board
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Marquee Ticker Strip -->
  <section class="bg-gradient-to-r from-[#E6007A] via-[#8B5CF6] to-[#F59E0B] py-3.5 overflow-hidden text-white font-bold text-xs uppercase tracking-widest shadow-lg">
    <div class="animate-marquee whitespace-nowrap flex items-center gap-8">
      <span>✦ 10+ Tahun Berpengalaman</span>
      <span>✦ 15.000+ Pelanggan Puas</span>
      <span>✦ 25+ Terapis Profesional</span>
      <span>✦ 50+ Treatment Tersedia</span>
      <span>✦ 4.9/5 Rating Pelanggan</span>
      <span>✦ Standar Kebersihan Higienis Medis</span>
      <span>✦ Produk Premium Bersertifikat</span>
      <span>✦ 10+ Tahun Berpengalaman</span>
      <span>✦ 15.000+ Pelanggan Puas</span>
      <span>✦ 25+ Terapis Profesional</span>
      <span>✦ 50+ Treatment Tersedia</span>
      <span>✦ 4.9/5 Rating Pelanggan</span>
    </div>
  </section>

  <!-- 3. Editorial Split Intro (Asymmetric 2-column layout) -->
  <section class="py-20 bg-[#0E0B14] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Split Left: Huge Pull Quote -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-bold text-pink-400 uppercase tracking-widest">Filosofi Perawatan</span>
          <blockquote class="font-serif text-2xl sm:text-3xl lg:text-4xl italic text-white leading-snug border-l-4 border-pink-500 pl-6">
            “Kecantikan yang memancar berasal dari kombinasi teknologi estetika modern dan sentuhan relaksasi personal.”
          </blockquote>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider pl-6">
            — Tim Estetika Senior AURA Beauty Lounge
          </p>
        </div>

        <!-- Split Right: Narrative Explanation -->
        <div class="lg:col-span-7 space-y-6 bg-[#161220] p-8 lg:p-10 rounded-3xl border border-pink-950/60 shadow-xl">
          <h2 class="font-serif text-3xl font-extrabold text-white">
            Mengapa AURA Menjadi Pilihan <span class="text-gradient-vibrant">15.000+ Klien</span>
          </h2>
          <p class="text-sm text-gray-300 leading-relaxed editorial-dropcap">
            Kami menghadirkan pengalaman perawatan kecantikan yang mewah, nyaman, dan personal dengan didukung oleh terapis profesional, produk premium, serta standar kebersihan yang tinggi. Setiap treatment dirancang untuk memberikan hasil optimal sekaligus pengalaman relaksasi yang berkesan.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="p-4 rounded-xl bg-pink-950/30 border border-pink-500/20">
              <h4 class="text-sm font-bold text-pink-300 mb-1">✓ 25+ Terapis Profesional</h4>
              <p class="text-xs text-gray-400">Terapis berpengalaman dengan sertifikasi pelatihan berkala.</p>
            </div>
            <div class="p-4 rounded-xl bg-purple-950/30 border border-purple-500/20">
              <h4 class="text-sm font-bold text-purple-300 mb-1">✓ 50+ Treatment Lengkap</h4>
              <p class="text-xs text-gray-400">Mulai dari Acne Therapy, Laser Glow hingga Aroma Spa.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Highlighted Signature Treatments Bento Grid -->
  <section class="py-20 bg-[#0C0A10] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Shell Header (Left aligned editorial header, NOT standard center badge) -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6 border-b border-pink-950/60 pb-6">
        <div>
          <span class="magazine-badge mb-2">Pilihan Unggulan</span>
          <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-white mt-1">
            Treatment Unggulan Terfavorit
          </h2>
        </div>
        <a href="/treatment" class="text-xs font-bold text-pink-400 hover:text-white uppercase tracking-widest flex items-center gap-2">
          <span>Lihat Semua 50+ Treatment</span>
          <span>→</span>
        </a>
      </div>

      <!-- Bento Grid (Asymmetric card sizing) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Large Card 1 (Spans 2 columns on md) -->
        <div class="md:col-span-2 group relative rounded-3xl overflow-hidden bg-[#15121E] border border-pink-950/80 hover:border-pink-500/50 transition-all duration-500 shadow-xl flex flex-col justify-end min-h-[380px] p-8">
          <img
            src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=900&auto=format&fit=crop&q=80"
            alt="Aura Diamond Laser Glow"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-60"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C0A10] via-[#0C0A10]/70 to-transparent"></div>
          
          <div class="relative z-10 space-y-3">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 bg-pink-600 text-white font-extrabold text-[10px] uppercase rounded-full">TERPOPULER</span>
              <span class="text-xs font-semibold text-amber-300">★ 4.9 (1.200+ Review)</span>
            </div>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">
              Aura Diamond Laser Glow
            </h3>
            <p class="text-xs sm:text-sm text-gray-300 max-w-xl">
              Teknologi laser non-invasif tercanggih untuk mencerahkan noda hitam, mengecilkan pori-pori, dan menstimulasi kolagen secara instan tanpa rasa sakit.
            </p>
            <div class="flex items-center justify-between pt-2">
              <span class="text-lg font-bold text-pink-400">Rp 1.250.000 <span class="text-xs font-normal text-gray-400">/ 75 Menit</span></span>
              <button
                onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
                class="px-5 py-2 text-xs font-bold text-white bg-pink-600 rounded-full hover:bg-pink-500 transition-colors"
              >
                Booking Sesi
              </button>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="group relative rounded-3xl overflow-hidden bg-[#15121E] border border-pink-950/80 hover:border-pink-500/50 transition-all duration-500 shadow-xl flex flex-col justify-end min-h-[380px] p-6">
          <img
            src="https://images.unsplash.com/photo-1512290900673-70020108990c?w=600&auto=format&fit=crop&q=80"
            alt="Acne Care Purifying Therapy"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-50"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C0A10] via-[#0C0A10]/80 to-transparent"></div>

          <div class="relative z-10 space-y-3">
            <span class="px-3 py-1 bg-purple-600 text-white font-extrabold text-[10px] uppercase rounded-full">BEBAS JERAWAT</span>
            <h3 class="font-serif text-xl font-bold text-white">
              Acne Care Purifying
            </h3>
            <p class="text-xs text-gray-300">
              Perawatan pembersihan mendalam dengan serapan serum anti-bakteri untuk meredakan peradangan jerawat secara efektif.
            </p>
            <div class="pt-2 flex items-center justify-between border-t border-white/10">
              <span class="text-base font-bold text-purple-300">Rp 650.000</span>
              <button
                onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
                class="px-4 py-1.5 text-xs font-bold text-white bg-purple-600 rounded-full hover:bg-purple-500"
              >
                Pilih
              </button>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="group relative rounded-3xl overflow-hidden bg-[#15121E] border border-pink-950/80 hover:border-pink-500/50 transition-all duration-500 shadow-xl flex flex-col justify-end min-h-[340px] p-6">
          <img
            src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=600&auto=format&fit=crop&q=80"
            alt="Aroma Spa Relaxing Massage"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-50"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0C0A10] via-[#0C0A10]/80 to-transparent"></div>

          <div class="relative z-10 space-y-3">
            <span class="px-3 py-1 bg-amber-600 text-white font-extrabold text-[10px] uppercase rounded-full">RELAKSASI TOTAL</span>
            <h3 class="font-serif text-xl font-bold text-white">
              Aroma Spa Body Therapy
            </h3>
            <p class="text-xs text-gray-300">
              Pijatan aromaterapi lavender & jojoba oil 90 menit untuk meredakan ketegangan otot dan stres pikiran.
            </p>
            <div class="pt-2 flex items-center justify-between border-t border-white/10">
              <span class="text-base font-bold text-amber-300">Rp 550.000</span>
              <button
                onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
                class="px-4 py-1.5 text-xs font-bold text-white bg-amber-600 rounded-full hover:bg-amber-500"
              >
                Pilih
              </button>
            </div>
          </div>
        </div>

        <!-- Card 4 (Spans 2 columns on md) -->
        <div class="md:col-span-2 group relative rounded-3xl overflow-hidden bg-gradient-to-r from-purple-950/40 to-pink-950/40 border border-pink-500/30 p-8 flex flex-col justify-between">
          <div class="space-y-3">
            <span class="magazine-badge">INOVASI ESTETIKA</span>
            <h3 class="font-serif text-2xl font-bold text-white">
              HIFU Collagen Lifting & V-Shape Facial
            </h3>
            <p class="text-xs sm:text-sm text-gray-300 max-w-lg">
              Pengencangan pipi dan kontur wajah tanpa jarum atau bedah. Mengaktifkan produksi kolagen alami di lapisan SMAS kulit.
            </p>
          </div>
          <div class="pt-6 flex flex-wrap items-center justify-between gap-4">
            <div>
              <span class="text-xs text-gray-400 block">Harga Spesial Promo</span>
              <span class="text-xl font-extrabold text-pink-400">Rp 1.850.000 <span class="line-through text-xs text-gray-500">Rp 2.500.000</span></span>
            </div>
            <button
              onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
              class="px-6 py-2.5 text-xs font-bold text-white uppercase tracking-wider bg-gradient-to-r from-[#E6007A] to-[#8B5CF6] rounded-full shadow-lg"
            >
              Klaim Penawaran Ini
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. Interactive Before & After Reveal Slider Component -->
  <section class="py-20 bg-[#0A080F] relative overflow-hidden border-y border-pink-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Shell Header (Split numbers) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
        <div class="lg:col-span-4">
          <span class="text-5xl font-black font-serif text-pink-500/30 block">01 / PROOF</span>
          <h2 class="font-serif text-3xl font-extrabold text-white mt-2">
            Hasil Nyata Perawatan
          </h2>
          <p class="text-xs text-gray-400 mt-2">
            Geser slider untuk melihat transformasi nyata sebelum & sesudah treatment Acne Purifying & Diamond Laser.
          </p>
          <div class="mt-4">
            <div class="client-data-badge">
              ⚠️ [PERLU DATA CLIENT: Foto Before & After Perawatan]
            </div>
          </div>
        </div>

        <!-- Interactive Comparison Slider Box -->
        <div class="lg:col-span-8">
          <div id="before-after-container" class="relative w-full h-[400px] rounded-3xl overflow-hidden border border-pink-500/30 shadow-2xl select-none cursor-ew-resize">
            
            <!-- After Image (Background) -->
            <img
              src="https://images.unsplash.com/photo-1522337094846-8a838592e371?w=1000&auto=format&fit=crop&q=80"
              alt="Setelah Perawatan Glow Facial AURA Salon"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute top-4 right-4 bg-pink-600 text-white font-bold text-xs px-3 py-1 rounded-full z-10 shadow">
              SESUDAH (GLOWING)
            </div>

            <!-- Before Image (Clipped overlay) -->
            <div id="before-image-wrapper" class="absolute inset-0 w-1/2 overflow-hidden border-r-2 border-white">
              <img
                src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=1000&auto=format&fit=crop&q=80"
                alt="Sebelum Perawatan AURA Salon"
                class="absolute top-0 left-0 w-full max-w-none h-full object-cover"
                id="before-img"
              />
              <div class="absolute top-4 left-4 bg-gray-900 text-white font-bold text-xs px-3 py-1 rounded-full z-10 shadow">
                SEBELUM
              </div>
            </div>

            <!-- Slider Control Handle -->
            <div id="slider-handle" class="absolute top-0 bottom-0 left-1/2 -ml-4 w-8 flex items-center justify-center pointer-events-none z-20">
              <div class="w-8 h-8 rounded-full bg-pink-500 text-white flex items-center justify-center shadow-lg font-bold text-xs">
                ↔
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 6. Client Data Placeholders for Brand Partners & Testimonials -->
  <section class="py-20 bg-[#0E0B14] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Brand Partners Strip -->
      <div class="mb-16 p-8 rounded-3xl bg-[#161220] border border-pink-950/60 text-center space-y-4">
        <span class="text-xs font-bold text-pink-400 uppercase tracking-widest">Brand Partner Premium</span>
        <h3 class="font-serif text-xl font-bold text-white">Dukungan Produk & Formulasi Terbaik Dunia</h3>
        <div class="pt-2">
          <div class="client-data-badge">
            ⚠️ [PERLU DATA CLIENT: Daftar Brand Partner Skincare]
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-4 opacity-60">
          <div class="p-3 bg-white/5 rounded-xl text-xs font-bold tracking-widest text-gray-300">SKINCEUTICALS (PH)</div>
          <div class="p-3 bg-white/5 rounded-xl text-xs font-bold tracking-widest text-gray-300">DERMALOGICA (PH)</div>
          <div class="p-3 bg-white/5 rounded-xl text-xs font-bold tracking-widest text-gray-300">LA ROCHE-POSAY (PH)</div>
          <div class="p-3 bg-white/5 rounded-xl text-xs font-bold tracking-widest text-gray-300">ZO SKIN HEALTH (PH)</div>
        </div>
      </div>

      <!-- Testimonials Header -->
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="magazine-badge">Testimoni Klien</span>
        <h2 class="font-serif text-3xl font-extrabold text-white">
          Apa Kata <span class="text-gradient-vibrant">15.000+ Pelanggan Setia</span>
        </h2>
        <div class="pt-1">
          <div class="client-data-badge">
            ⚠️ [PERLU DATA CLIENT: Detail Testimoni Klien]
          </div>
        </div>
      </div>

      <!-- Testimonial Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-[#15121E] border border-pink-950/80 shadow-xl space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs text-gray-300 italic leading-relaxed">
            “Sudah 3 tahun berlangganan di AURA. Hasil Diamond Laser-nya tidak pernah mengecewakan, kulit langsung cerah dan terapisnya sangat teliti serta ramah.”
          </p>
          <div class="flex items-center gap-3 pt-2 border-t border-white/10">
            <div class="w-10 h-10 rounded-full bg-pink-600/30 flex items-center justify-center text-pink-300 font-bold text-xs">
              AD
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Anindya Devina</h4>
              <span class="text-[10px] text-gray-400">Member VIP Gold</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-[#15121E] border border-pink-950/80 shadow-xl space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs text-gray-300 italic leading-relaxed">
            “Tempatnya sangat bersih dan higienis. Suka sekali dengan suasana aroma terapi spa-nya, bener-bener tempat relaksasi favorit setelah kerja.”
          </p>
          <div class="flex items-center gap-3 pt-2 border-t border-white/10">
            <div class="w-10 h-10 rounded-full bg-purple-600/30 flex items-center justify-center text-purple-300 font-bold text-xs">
              RM
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Rania Maheswari</h4>
              <span class="text-[10px] text-gray-400">Pelanggan Sejak 2022</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-[#15121E] border border-pink-950/80 shadow-xl space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-xs text-gray-300 italic leading-relaxed">
            “Acne Purifying therapy-nya sangat ampuh memudarkan jerawat membandel. Konsultasi dokternya juga sangat mendalam dan informatif.”
          </p>
