---
import Layout from '../layouts/Layout.astro';

const treatmentCases = [
  {
    title: "Studi Kasus 1: Penyembuhan Jerawat Inflamasi (Acne Care)",
    beforeImg: "https://images.unsplash.com/photo-1515377905703-c4788e51af15?w=800&auto=format&fit=crop&q=80",
    afterImg: "https://images.unsplash.com/photo-1522337094846-8a838592e371?w=800&auto=format&fit=crop&q=80",
    sessions: "4 Sesi Treatment",
    result: "Reduksi 85% peradangan jerawat & tekstur kulit halus."
  },
  {
    title: "Studi Kasus 2: Pengencangan V-Shape & Kolagen (Anti-Aging)",
    beforeImg: "https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=800&auto=format&fit=crop&q=80",
    afterImg: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80",
    sessions: "2 Sesi HIFU Lifting",
    result: "Garis pipi lebih tegas & produksi kolagen meningkat."
  }
];
---

<Layout
  title="Signature Treatments | AURA Aesthetic & Beauty Lounge"
  description="Perawatan kecantikan tingkat tinggi: Laser Glow, Acne Purifying, dan HIFU Lifting dengan konsultasi rekomendasi otomatis."
>
  <!-- 1. Hero: Editorial Split Spotlight -->
  <section class="py-20 bg-[#0A080F] border-b border-pink-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="magazine-badge">SPOTLIGHT TREATMENT OF THE MONTH</span>
          <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-white">
            Aura Diamond <br />
            <span class="text-gradient-vibrant">Laser Glow Therapy</span>
          </h1>
          <p class="text-base text-gray-300 leading-relaxed">
            Pengalaman perawatan kecantikan yang mewah, nyaman, dan personal dengan didukung oleh terapis profesional, produk premium, serta standar kebersihan yang tinggi. Setiap treatment dirancang untuk memberikan hasil optimal sekaligus pengalaman relaksasi yang berkesan.
          </p>

          <div class="grid grid-cols-2 gap-4 py-2 border-y border-pink-950/60 max-w-lg">
            <div>
              <span class="block text-xs font-bold text-pink-400 uppercase">Target Skin</span>
              <span class="text-xs text-white">Pori-pori besar, flek hitam, warna tidak merata</span>
            </div>
            <div>
              <span class="block text-xs font-bold text-pink-400 uppercase">Down Time</span>
              <span class="text-xs text-white">Tanpa Down Time (Langsung glowing)</span>
            </div>
          </div>

          <div class="pt-2 flex items-center gap-4">
            <button
              onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
              class="px-8 py-3.5 text-xs font-bold text-white uppercase tracking-wider bg-gradient-to-r from-[#E6007A] to-[#8B5CF6] rounded-full shadow-lg hover:scale-105 transition-transform"
            >
              Booking Treatment Ini
            </button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-pink-500/30 shadow-2xl bg-[#15121E]">
            <img
              src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&auto=format&fit=crop&q=80"
              alt="Diamond Laser Therapy"
              class="w-full h-[400px] object-cover"
            />
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-glass border border-white/10 text-xs">
              <span class="font-bold text-amber-300">✦ Teknologi FDA Approved</span>
              <p class="text-gray-300 mt-0.5">Penetrasi gelombang laser presisi mikron tanpa merusak jaringan kulit atas.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Interactive Skin Consultation Estimator Tool Widget -->
  <section class="py-20 bg-[#0E0B14] relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-[#15121E] border border-pink-500/30 rounded-3xl p-8 shadow-2xl space-y-6">
        <div class="text-center space-y-2">
          <span class="magazine-badge">KALKULATOR & ESTIMATOR INTERAKTIF</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-white">
            Rekomendasi Treatment Otomatis
          </h2>
          <p class="text-xs text-gray-300">
            Pilih keluhan utama kulit Anda di bawah ini untuk melihat perkiraan treatment dan harga yang paling cocok.
          </p>
        </div>

        <!-- Question Buttons -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-pink-300 mb-3 text-center">
            Apa Masalah Kulit Utama Anda?
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="concern-selector">
            <button data-concern="acne" class="concern-btn active p-3 text-xs font-bold rounded-2xl border border-pink-500 bg-pink-600 text-white cursor-pointer">
              Jerawat & Komedo
            </button>
            <button data-concern="dull" class="concern-btn p-3 text-xs font-bold rounded-2xl border border-pink-950/60 bg-[#0C0A10] text-gray-300 hover:text-white cursor-pointer">
              Kusam & Flek
            </button>
            <button data-concern="aging" class="concern-btn p-3 text-xs font-bold rounded-2xl border border-pink-950/60 bg-[#0C0A10] text-gray-300 hover:text-white cursor-pointer">
              Kerutan & Kendur
            </button>
            <button data-concern="spa" class="concern-btn p-3 text-xs font-bold rounded-2xl border border-pink-950/60 bg-[#0C0A10] text-gray-300 hover:text-white cursor-pointer">
              Pegal & Stres
            </button>
          </div>
        </div>

        <!-- Result Box -->
        <div id="estimator-result" class="p-6 rounded-2xl bg-[#0C0A10] border border-pink-500/30 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-pink-400 uppercase">Rekomendasi Terbaik</span>
            <span id="res-price" class="text-base font-bold text-amber-300">Rp 650.000</span>
          </div>
          <h3 id="res-title" class="font-serif text-xl font-bold text-white">Acne Care Purifying Therapy</h3>
          <p id="res-desc" class="text-xs text-gray-300 leading-relaxed">
            Formulasi pembersihan mendalam komedo, ekstraksi medis higienis, dan sinar LED biru pembunuh bakteri penyebab jerawat.
          </p>
          <div class="pt-2 text-center">
            <button
              onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
              class="px-6 py-2 text-xs font-bold text-white uppercase tracking-wider bg-pink-600 rounded-full hover:bg-pink-500"
            >
              Booking Treatment Hasil Rekomendasi
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Interactive Before & After Case Study Tabs -->
  <section class="py-20 bg-[#0C0A10] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="magazine-badge">BEFORE & AFTER GALLERY</span>
        <h2 class="font-serif text-3xl font-extrabold text-white">
          Studi Kasus & Transformasi
        </h2>
        <div class="pt-1">
          <div class="client-data-badge">
            ⚠️ [PERLU DATA CLIENT: Foto Before & After Perawatan]
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {treatmentCases.map((item) => (
          <div class="bg-[#15121E] border border-pink-950/80 rounded-3xl p-6 shadow-xl space-y-4">
            <h3 class="font-serif text-lg font-bold text-white">{item.title}</h3>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="relative rounded-2xl overflow-hidden border border-white/10 h-48">
                <img src={item.beforeImg} alt="Before" class="w-full h-full object-cover" />
                <span class="absolute top-2 left-2 bg-black/80 text-white font-bold text-[10px] px-2 py-0.5 rounded">BEFORE</span>
              </div>
              <div class="relative rounded-2xl overflow-hidden border border-pink-500/40 h-48">
                <img src={item.afterImg} alt="After" class="w-full h-full object-cover" />
                <span class="absolute top-2 right-2 bg-pink-600 text-white font-bold text-[10px] px-2 py-0.5 rounded">AFTER</span>
              </div>
            </div>

            <div class="p-3 bg-pink-950/30 rounded-xl text-xs space-y-1">
              <span class="font-bold text-pink-300 block">✦ Durasi: {item.sessions}</span>
              <span class="text-gray-300 block">Hasil: {item.result}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<script>
  // Interactive Estimator Tool Logic
  const concernBtns = document.querySelectorAll('.concern-btn');
  const resTitle = document.getElementById('res-title');
  const resPrice = document.getElementById('res-price');
  const resDesc = document.getElementById('res-desc');

  const data = {
    acne: {
      title: "Acne Care Purifying Therapy",
      price: "Rp 650.000",
      desc: "Formulasi pembersihan mendalam komedo, ekstraksi medis higienis, dan sinar LED biru pembunuh bakteri jerawat."
    },
    dull: {
      title: "Aura Diamond Laser Glow",
      price: "Rp 1.250.000",
      desc: "Perawatan mencerahkan flek hitam, meratakan warna kulit, dan mengecilkan pori-pori dengan laser presisi tinggi."
    },
    aging: {
      title: "HIFU V-Shape Collagen Lifting",
      price: "Rp 1.850.000",
      desc: "Pengencangan kulit kendur dan pembentukan kontur V-shape tanpa rasa sakit dengan ultrasound berfokus tinggi."
    },
    spa: {
      title: "Aroma Spa Relaxing Massage",
      price: "Rp 550.000",
      desc: "Pijatan tubuh menyeluruh menggunakan minyak aromaterapi lavender organik untuk meredakan pegal dan stres."
    }
  };

  concernBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      concernBtns.forEach(b => {
        b.classList.remove('bg-pink-600', 'text-white', 'border-pink-500');
        b.classList.add('bg-[#0C0A10]', 'text-gray-300', 'border-pink-950/60');
      });
      btn.classList.add('bg-pink-600', 'text-white', 'border-pink-500');
      btn.classList.remove('bg-[#0C0A10]', 'text-gray-300', 'border-pink-950/60');

      const key = btn.getAttribute('data-concern') as keyof typeof data;
      if (key && data[key] && resTitle && resPrice && resDesc) {
        resTitle.textContent = data[key].title;
        resPrice.textContent = data[key].price;
        resDesc.textContent = data[key].desc;
      }
    });
  });
</script>
