---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    title: "5 Cara Efektif Mengatasi Flek Hitam & Kulit Kusam Pascamudik",
    category: "Skin Care",
    date: "4 Agustus 2026",
    readTime: "5 Min Read",
    author: "Dr. Clarissa Larasati",
    excerpt: "Paparan sinar UV berlebih dapat merusak lapisan stratum korneum. Pelajari kombinasi serum vitamin C dan laser glow therapy untuk hasil optimal.",
    img: "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600&auto=format&fit=crop&q=80"
  },
  {
    title: "Mengenal Teknologi HIFU: Alternatif Tanam Benang Tanpa Rasa Sakit",
    category: "Anti-Aging",
    date: "1 Agustus 2026",
    readTime: "7 Min Read",
    author: "Tim Estetika AURA",
    excerpt: "High-Intensity Focused Ultrasound menembus lapisan SMAS untuk memicu neokolagenesis alami tanpa memerlukan waktu pemulihan (down time).",
    img: "https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=600&auto=format&fit=crop&q=80"
  },
  {
    title: "Rahasia Perawatan Scalp Spa Untuk Rambut Rontok Berkelanjutan",
    category: "Hair Care",
    date: "28 Juli 2026",
    readTime: "4 Min Read",
    author: "Sinta Rahmawati",
    excerpt: "Kesehatan folikel rambut sangat dipengaruhi oleh mikrobioma kulit kepala. Pahami rutinitas pembersihan ekstraksi ketombe yang tepat.",
    img: "https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=600&auto=format&fit=crop&q=80"
  },
  {
    title: "Pentingnya Menggunakan Sunscreen Berdasarkan Tipe Kulit Tropis",
    category: "Beauty Trends",
    date: "20 Juli 2026",
    readTime: "6 Min Read",
    author: "Maya Kartika",
    excerpt: "Memilih antara physical vs chemical sunscreen di iklim lembab Indonesia untuk mencegah timbulnya komedo penyumbat pori.",
    img: "https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=600&auto=format&fit=crop&q=80"
  }
];

const quickTips = [
  "Selalu gunakan sunscreen Re-apply setiap 3 jam sekali di luar ruangan.",
  "Minum air putih minimal 2.5 Liter untuk kelembapan alami sel kulit.",
  "Gunakan sarung bantal sutra untuk mencegah gesekan garis kerutan wajah.",
  "Lakukan double cleansing setiap malam sebelum mengaplikasikan night cream.",
  "Jadwalkan facial purifying rutin 1x dalam sebulan untuk eksfoliasi."
];
---

<Layout
  title="Blog Tips Kecantikan & Estetika | AURA Beauty Lounge"
  description="Artikel edukasi kecantikan terpercaya: rutinitas skincare, perawatan anti-aging, kesehatan rambut, dan tren estetika modern."
>
  <!-- 1. Hero: Featured Magazine Article Header -->
  <section class="py-20 bg-[#0A080F] border-b border-pink-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-3">
            <span class="magazine-badge">FEATURED ARTICLE</span>
            <span class="text-xs text-pink-300 font-semibold">5 Min Read • 5 Agustus 2026</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Panduan Lengkap Merawat Barrier Kulit Dari Polusi Perkotaan
          </h1>

          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed editorial-dropcap">
            Polusi udara dan radikal bebas dapat mempercepat penuaan dini dan merusak perlindungan sel alami wajah. Ketahui langkah proteksi terbaik dengan terapi antioksidan medis dan perawatan harian yang teruji klinis.
          </p>

          <div class="flex items-center gap-4 pt-2">
            <a
              href="#read-featured"
              class="px-6 py-3 text-xs font-bold text-white uppercase tracking-wider bg-gradient-to-r from-[#E6007A] to-[#8B5CF6] rounded-full shadow-lg"
            >
              Baca Artikel Lengkap
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-pink-500/30 shadow-2xl h-80 lg:h-96">
            <img
              src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=800&auto=format&fit=crop&q=80"
              alt="Featured Skincare Article"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0C0A10] via-transparent to-transparent"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Main Blog Editorial Grid & Quick Tips Sidebar -->
  <section class="py-20 bg-[#0E0B14] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Main Articles Column -->
        <div class="lg:col-span-8 space-y-8">
          <div class="flex items-center justify-between border-b border-pink-950/60 pb-4">
            <h2 class="font-serif text-2xl font-bold text-white">Artikel Terbaru</h2>
            <span class="text-xs text-pink-400 font-semibold">Total 4 Artikel</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {articles.map((item) => (
              <article class="bg-[#15121E] border border-pink-950/80 rounded-3xl overflow-hidden shadow-xl flex flex-col justify-between hover:border-pink-500/40 transition-all">
                <div>
                  <div class="h-48 overflow-hidden relative">
                    <img src={item.img} alt={item.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-3 left-3 bg-pink-600 text-white font-bold text-[10px] uppercase px-3 py-1 rounded-full">
                      {item.category}
                    </span>
                  </div>
                  <div class="p-6 space-y-2">
                    <div class="flex items-center justify-between text-[10px] text-gray-400">
                      <span>{item.date}</span>
                      <span>⏱ {item.readTime}</span>
                    </div>
                    <h3 class="font-serif text-lg font-bold text-white leading-snug">{item.title}</h3>
                    <p class="text-xs text-gray-300 leading-relaxed">{item.excerpt}</p>
                  </div>
                </div>

                <div class="p-6 pt-0 flex items-center justify-between border-t border-white/10">
                  <span class="text-[10px] text-pink-400 font-bold">Oleh: {item.author}</span>
                  <a href="#" class="text-xs font-bold text-white hover:text-pink-400">Baca →</a>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Sidebar: Quick Beauty Tips & Newsletter -->
        <div class="lg:col-span-4 space-y-8">
          
          <!-- Quick Tips Box -->
          <div class="bg-[#15121E] border border-pink-500/30 rounded-3xl p-6 shadow-xl space-y-4">
            <span class="magazine-badge">QUICK TIPS</span>
            <h3 class="font-serif text-lg font-bold text-white">5 Tips Harian Kulit Glowing</h3>
            <ul class="space-y-3 text-xs text-gray-300">
              {quickTips.map((tip, index) => (
                <li class="flex items-start gap-2 border-b border-white/5 pb-2">
                  <span class="font-bold text-pink-400">{index + 1}.</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Newsletter Widget -->
          <div class="bg-gradient-to-br from-pink-950/60 to-purple-950/60 border border-pink-500/40 rounded-3xl p-6 shadow-2xl space-y-4">
            <h3 class="font-serif text-lg font-bold text-white">Langganan Beauty Newsletter</h3>
            <p class="text-xs text-gray-300">
              Dapatkan artikel tips kecantikan mingguan & promo rahasia langsung ke email Anda.
            </p>
            <form onsubmit="event.preventDefault(); alert('Terima kasih telah mendaftar newsletter AURA!');" class="space-y-3">
              <input
                type="email"
                required
                placeholder="Masukkan email Anda..."
                class="w-full bg-[#0C0A10] border border-pink-950/80 rounded-xl px-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-pink-500"
              />
              <button
                type="submit"
                class="w-full py-2.5 bg-pink-600 hover:bg-pink-500 text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-colors"
              >
                Langganan Sekarang
              </button>
            </form>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>
