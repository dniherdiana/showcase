---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Tentang Kami', href: '/tentang-kami' },
  { name: 'Layanan', href: '/layanan' },
  { name: 'Treatment', href: '/treatment' },
  { name: 'Promo', href: '/promo', badge: 'HOT' },
  { name: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 bg-[#0C0A10]/85 backdrop-blur-xl border-b border-pink-950/40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#E6007A] via-[#8B5CF6] to-[#F59E0B] p-[2px] shadow-lg shadow-pink-500/20 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-[#0C0A10] rounded-[10px] flex items-center justify-center">
          <span class="font-serif text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-300">A</span>
        </div>
      </div>
      <div>
        <span class="font-serif text-2xl font-extrabold tracking-tight text-white group-hover:text-pink-400 transition-colors">
          AURA
        </span>
        <span class="block text-[9px] font-bold tracking-[0.25em] text-pink-400/80 uppercase -mt-1">
          Beauty & Aesthetic
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 ${
              isActive
                ? 'text-white bg-pink-950/60 border border-pink-500/30 shadow-sm'
                : 'text-gray-300 hover:text-white hover:bg-white/5'
            }`}
          >
            {item.name}
            {item.badge && (
              <span class="ml-1.5 px-1.5 py-0.5 text-[9px] font-black bg-gradient-to-r from-pink-500 to-purple-600 text-white rounded-full animate-pulse">
                {item.badge}
              </span>
            )}
            {isActive && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-pink-500 rounded-full glow-magenta"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="https://wa.me/6281234567890?text=Halo%20Aura%20Beauty,%20saya%20ingin%20konsultasi%20gratis"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold text-pink-300 hover:text-white transition-colors px-3 py-2 border border-pink-500/30 rounded-full hover:border-pink-500"
      >
        Konsultasi Gratis
      </a>
      <button
        onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
        class="relative inline-flex items-center justify-center px-6 py-2.5 text-xs font-bold text-white uppercase tracking-wider bg-gradient-to-r from-[#E6007A] to-[#8B5CF6] rounded-full overflow-hidden shadow-lg shadow-pink-600/30 hover:shadow-pink-600/50 hover:scale-[1.02] active:scale-95 transition-all duration-300 group cursor-pointer"
      >
        <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
        <span class="relative flex items-center gap-2">
          <span>Booking Sekarang</span>
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </span>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center md:hidden gap-3">
      <button
        onclick="document.getElementById('booking-modal')?.classList.remove('hidden')"
        class="px-3 py-1.5 text-xs font-bold text-white bg-gradient-to-r from-[#E6007A] to-[#8B5CF6] rounded-full"
      >
        Booking
      </button>
      <button
        id="mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-gray-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#0C0A10]/98 border-b border-pink-950/60 px-4 pt-3 pb-6 space-y-2">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block px-4 py-3 rounded-xl text-base font-medium transition-colors ${
          pathname === item.href ? 'bg-pink-950/80 text-pink-300 font-bold border border-pink-500/30' : 'text-gray-300 hover:bg-white/5 hover:text-white'
        }`}
      >
        <div class="flex items-center justify-between">
          <span>{item.name}</span>
          {item.badge && (
            <span class="px-2 py-0.5 text-[10px] font-extrabold bg-pink-600 text-white rounded-full">
              {item.badge}
            </span>
          )}
        </div>
      </a>
    ))}
    <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
      <a
        href="https://wa.me/6281234567890?text=Halo%20Aura%20Beauty,%20saya%20ingin%20konsultasi%20gratis"
        target="_blank"
        class="w-full py-3 text-center text-sm font-bold text-pink-300 bg-pink-950/40 rounded-xl border border-pink-500/30"
      >
        Konsultasi Gratis via WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
