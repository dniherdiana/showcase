---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const { 
  title = "i-Travel — Bukti Bukan Janji | Tour & Travel Agent Terpercaya", 
  description = "i-Travel berpengalaman 10+ tahun melayani 450+ klien corporat & personal. Kepuasan klien adalah prioritas kami.",
  activeNav = "home"
} = Astro.props;

const navItems = [
  { name: 'Home', href: '/', key: 'home' },
  { name: 'Tentang', href: '/tentang', key: 'tentang' },
  { name: 'Layanan', href: '/layanan', key: 'layanan' },
  { name: 'Galeri', href: '/galeri', key: 'galeri' },
  { name: 'Kontak', href: '/kontak', key: 'kontak' },
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>" />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen selection:bg-sky-200 selection:text-slate-900">
    
    <!-- Top Announcement Bar -->
    <div class="bg-slate-900 text-slate-200 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-7xl mx-mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2 text-center sm:text-left">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span><strong>10 Tahun Berdiri</strong> • 450+ Klien Puas Menyaksikan Bukti Bukan Janji</span>
        </div>
        <div class="flex items-center gap-4 text-slate-300">
          <a href="tel:+6281234567890" class="hover:text-sky-400 transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span>(021) 555-8899</span>
          </a>
          <span class="hidden md:inline">•</span>
          <span class="hidden md:inline-flex items-center gap-1 text-slate-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Sen - Sab (08:00 - 18:00 WIB)
          </span>
        </div>
      </div>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 via-sky-400 to-rose-400 flex items-center justify-center text-white font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
              iT
            </div>
            <div class="flex flex-col">
              <span class="font-extrabold text-2xl tracking-tight text-slate-900 group-hover:text-sky-600 transition-colors">i-Travel</span>
              <span class="text-[10px] font-semibold text-rose-500 -mt-1 tracking-widest uppercase">Bukti Bukan Janji</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center gap-1 bg-slate-100/80 p-1.5 rounded-full border border-slate-200/60">
            {navItems.map((item) => {
              const isActive = activeNav === item.key;
              return (
                <a
                  href={item.href}
                  class:list={[
                    "px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200",
                    isActive 
                      ? "bg-slate-900 text-white shadow-sm" 
                      : "text-slate-600 hover:text-slate-900 hover:bg-white/60"
                  ]}
                >
                  {item.name}
                </a>
              );
            })}
          </nav>

          <!-- Action Buttons -->
          <div class="hidden lg:flex items-center gap-3">
            <a 
              href="tel:+6281234567890" 
              class="px-4 py-2 text-sm font-bold text-slate-700 hover:text-sky-600 transition-colors flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <span>Telepon</span>
            </a>
            
            <a 
              href="https://wa.me/6281234567890?text=Halo%20i-Travel%2C%20saya%20ingin%20konsultasi%20booking%20paket%20wisata" 
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-md hover:shadow-emerald-500/25 transition-all flex items-center gap-2 group active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>WA Order</span>
            </a>
          </div>

          <!-- Mobile menu button -->
          <div class="flex items-center md:hidden">
            <button 
              id="mobile-menu-btn" 
              type="button" 
              class="p-2.5 rounded-xl text-slate-700 hover:text-sky-600 hover:bg-slate-100 focus:outline-none transition-colors"
              aria-label="Buka Menu"
            >
              <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 shadow-xl">
        <div class="flex flex-col gap-1 mb-4">
          {navItems.map((item) => {
            const isActive = activeNav === item.key;
            return (
              <a
                href={item.href}
                class:list={[
                  "px-4 py-3 text-base font-semibold rounded-xl transition-all",
                  isActive ? "bg-sky-50 text-sky-600 font-bold" : "text-slate-700 hover:bg-slate-50"
                ]}
              >
                {item.name}
              </a>
            );
          })}
        </div>
        <div class="flex flex-col gap-2 pt-3 border-t border-slate-100">
          <a 
            href="https://wa.me/6281234567890?text=Halo%20i-Travel%2C%20saya%20ingin%20konsultasi%20paket%20wisata" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold shadow-sm"
          >
            💬 WA Order Langsung
          </a>
          <a 
            href="/kontak" 
            class="w-full text-center py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold shadow-sm"
          >
            📋 Booking Form Online
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-300 pt-16 pb-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
          
          <!-- Col 1: Brand Info -->
          <div class="lg:col-span-2 flex flex-col gap-4">
            <div class="flex items-center gap-2">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-400 to-rose-400 flex items-center justify-center text-white font-bold text-lg">
                iT
              </div>
              <span class="font-extrabold text-2xl text-white">i-Travel</span>
            </div>
            
            <p class="text-sm text-slate-400 leading-relaxed max-w-md">
              Membangun pengalaman perjalanan tak terlupakan sejak 10 tahun lalu. <strong>Kami menawarkan bukti bukan janji</strong> — kepuasan dan keselamatan Anda adalah prioritas utama kami.
            </p>

            <div class="flex items-center gap-3 pt-2">
              <span class="px-3 py-1 bg-sky-950/80 border border-sky-800/80 text-sky-400 text-xs font-semibold rounded-full">
                🏆 10+ Tahun Berdiri
              </span>
              <span class="px-3 py-1 bg-rose-950/80 border border-rose-800/80 text-rose-300 text-xs font-semibold rounded-full">
                🤝 450+ Klien Terlayani
              </span>
            </div>
          </div>

          <!-- Col 2: Navigasi Cepat -->
          <div>
            <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Navigasi</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/" class="hover:text-sky-400 transition-colors">Beranda</a></li>
              <li><a href="/tentang" class="hover:text-sky-400 transition-colors">Tentang Kami</a></li>
              <li><a href="/layanan" class="hover:text-sky-400 transition-colors">Paket & Layanan</a></li>
              <li><a href="/galeri" class="hover:text-sky-400 transition-colors">Galeri Dokumentasi</a></li>
              <li><a href="/kontak" class="hover:text-sky-400 transition-colors">Kontak & Booking</a></li>
            </ul>
          </div>

          <!-- Col 3: Layanan Unggulan -->
          <div>
            <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Layanan</h4>
            <ul class="space-y-2.5 text-sm text-slate-400">
              <li>Corporate Gathering & Outing</li>
              <li>Open Trip & Private Custom Tour</li>
              <li>Incentive Trip Luar Negeri</li>
              <li>Tiket Pesawat & Visa Service</li>
              <li>Sewa Bus Luxury & VIP Tour</li>
            </ul>
          </div>

          <!-- Col 4: Kontak & Legal -->
          <div>
            <h4 class="text-white font-bold text-sm tracking-wider uppercase mb-4">Hubungi Kami</h4>
            <ul class="space-y-3 text-sm">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-sky-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>Jl. Utama Boulevard No. 88, Jakarta Selatan</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <a href="tel:+6281234567890" class="hover:text-emerald-400">0812-3456-7890</a>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <span>info@itravel.co.id</span>
              </li>
            </ul>

            <div class="mt-4 pt-3">
              <!-- Placeholder Tag for Client Legal License -->
              <div class="client-data-tag">
                ⚠️ [PERLU DATA CLIENT: Nomor Izin Usaha / PPIU Travel]
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Footer Bar -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} i-Travel. Hak Cipta Dilindungi Undang-Undang.</p>
          <div class="flex items-center gap-6">
            <span>Client Adalah Aset Berharga Kami</span>
            <span>•</span>
            <span>Kepuasan Client Adalah Prioritas Kami</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Vanilla JS Script for Interactivity -->
    <script>
      // Mobile menu toggle
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');

      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
          openIcon?.classList.toggle('hidden');
          closeIcon?.classList.toggle('hidden');
        });
      }

      // Simple intersection observer for scroll reveal animation
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('fade-up-active');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.fade-up-init').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
