---
import Layout from '../layouts/Layout.astro';
---

<Layout title="i-Travel — Bukti Bukan Janji | Travel Agent Terpercaya 10+ Tahun" activeNav="home">

  <!-- SECTION 1: ASYMMETRIC HERO WITH FLOATING WIDGET -->
  <section class="relative overflow-hidden bg-slate-900 text-white pt-12 pb-24 lg:pt-20 lg:pb-32">
    <!-- Gradient & Graphic Accents -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-sky-900/60 via-slate-900 to-slate-950"></div>
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left fade-up-init">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-sky-300 text-xs sm:text-sm font-semibold">
            <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
            <span>Corporate Clean & Playful Travel Experience</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
            Jelajahi Dunia Bersama <span class="bg-gradient-to-r from-sky-400 via-rose-300 to-amber-300 bg-clip-text text-transparent">i-Travel</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 max-w-2xl font-light leading-relaxed">
            <strong>Kami menawarkan bukti bukan janji.</strong> Selama lebih dari 10 tahun, kami merancang perjalanan korporat dan pribadi dengan standar kenyamanan tertinggi karena <em>client adalah aset berharga kami</em>.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
            <a 
              href="https://wa.me/6281234567890?text=Halo%20i-Travel%2C%20saya%20ingin%20konsultasi%20paket%20tour"
              target="_blank"
              class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-base shadow-lg shadow-emerald-500/25 transition-all flex items-center justify-center gap-3 transform hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.754zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>Konsultasi WA Order</span>
            </a>
            
            <a 
              href="/kontak"
              class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/10 hover:bg-white/20 border border-white/30 text-white font-bold text-base transition-all flex items-center justify-center gap-2 backdrop-blur-md"
            >
              <span>Booking Form Direct</span>
              <svg class="w-4 h-4 text-rose-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>

          <!-- Highlight Stats Quick Bar -->
          <div class="pt-6 grid grid-cols-3 gap-4 border-t border-slate-800 text-left">
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold text-sky-400">10 Thn</span>
              <span class="text-xs text-slate-400">Tahun Berdiri</span>
            </div>
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold text-rose-400">450+</span>
              <span class="text-xs text-slate-400">Jumlah Klien</span>
            </div>
            <div>
              <span class="block text-2xl sm:text-3xl font-extrabold text-amber-300">100%</span>
              <span class="text-xs text-slate-400">Prioritas Kepuasan</span>
            </div>
          </div>
        </div>

        <!-- Right Hero Visual Composite -->
        <div class="lg:col-span-5 relative">
          <!-- Main Image Frame -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/20 transform lg:rotate-2 hover:rotate-0 transition-transform duration-500">
            <img 
              src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1000&q=80" 
              alt="Destinasi pantai tropis indah i-Travel" 
              class="w-full h-[450px] object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="px-3 py-1 bg-rose-500 text-xs font-bold uppercase rounded-md tracking-wider">Paling Populer</span>
              <h3 class="text-xl font-bold mt-2">Raja Ampat & Bali Luxury Outing</h3>
              <p class="text-xs text-slate-300">Paket spesial korporat dengan dokumentasi drone gratis</p>
            </div>
          </div>

          <!-- Floating Secondary Badge Card -->
          <div class="absolute -bottom-6 -left-6 bg-white text-slate-900 p-4 rounded-2xl shadow-2xl border border-slate-100 max-w-[240px] hidden sm:flex items-center gap-3 animate-float">
            <img 
              src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=200&q=80" 
              alt="Petualang i-Travel di pegunungan" 
              class="w-14 h-14 rounded-xl object-cover"
            />
            <div>
              <span class="text-xs font-extrabold text-sky-600 block">VIP Personal Guide</span>
              <span class="text-[11px] text-slate-500 leading-tight block mt-0.5">Jaminan Kepuasan & Keamanan Klien</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 2: PROOF POINTS & STATS ROW -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-sky-500 via-sky-600 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="grid md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-white/20">
          <div class="pt-4 md:pt-0">
            <div class="text-4xl sm:text-5xl font-extrabold text-amber-300">10 Tahun</div>
            <div class="text-sm font-semibold text-sky-100 mt-2">Tahun Berdiri Sejak 2016</div>
            <p class="text-xs text-sky-200/80 mt-1">Pengalaman matang mengelola ribuan penerbangan & tur.</p>
          </div>

          <div class="pt-4 md:pt-0">
            <div class="text-4xl sm:text-5xl font-extrabold text-rose-300">450+</div>
            <div class="text-sm font-semibold text-sky-100 mt-2">Jumlah Klien Perusahaan & Komunitas</div>
            <p class="text-xs text-sky-200/80 mt-1">Kepercayaan dari BUMN, multinasional, hingga rombongan keluarga.</p>
          </div>

          <div class="pt-4 md:pt-0">
            <div class="text-4xl sm:text-5xl font-extrabold text-emerald-300">100%</div>
            <div class="text-sm font-semibold text-sky-100 mt-2">Bukti Nyata Transparansi</div>
            <p class="text-xs text-sky-200/80 mt-1">Tanpa biaya tersembunyi, pendampingan full service 24/7.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: BENTO GRID - DIFERENSIATOR UNGGULAN -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="px-4 py-1.5 rounded-full bg-sky-100 text-sky-700 text-xs font-bold tracking-widest uppercase">
          Mengapa Memilih i-Travel?
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">
          Kami Menawarkan Bukti Bukan Janji
        </h2>
        <p class="text-slate-600 text-base">
          Sebagai mitra perjalanan terpercaya, <strong>kepuasan client adalah prioritas kami</strong>. Kami percaya bahwa <strong>client adalah aset berharga kami</strong> yang berhak mendapatkan penanganan paling prima.
        </p>
      </div>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Bento Card 1: Large Card (2 Cols) -->
        <div class="md:col-span-2 bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between group">
          <div class="relative z-10">
            <span class="w-12 h-12 rounded-2xl bg-sky-500 text-white flex items-center justify-center font-bold text-xl mb-6 shadow-md shadow-sky-500/20">
              01
            </span>
            <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-sky-600 transition-colors">
              Manajemen Corporate Outing & Gathering Tanpa Celah
            </h3>
            <p class="text-slate-600 leading-relaxed max-w-xl">
              Kami memegang komitmen penuh bahwa <strong>client adalah aset berharga kami</strong>. Dari rundown acara, penginapan VIP, konsumsi higienis, hingga games team building—semua dikelola oleh tim pro bersertifikat.
            </p>
          </div>
          <div class="mt-8 rounded-2xl overflow-hidden h-48 border border-slate-100">
            <img 
              src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=800&q=80" 
              alt="Tim korporat menikmati outbound bersama i-Travel" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>

        <!-- Bento Card 2: Tall Card -->
        <div class="bg-gradient-to-b from-slate-900 to-slate-950 text-white rounded-3xl p-8 border border-slate-800 shadow-sm flex flex-col justify-between relative overflow-hidden">
          <div class="space-y-4">
            <span class="w-12 h-12 rounded-2xl bg-rose-500 text-white flex items-center justify-center font-bold text-xl shadow-md shadow-rose-500/30">
              02
            </span>
            <h3 class="text-xl font-bold text-white">
              Private & Custom Tour Terpersonalisasi
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              Setiap detil perjalanan dirancang khusus sesuai ritme dan preferensi Anda. Tanpa jadwal terburu-buru.
            </p>
          </div>
          <div class="mt-6">
            <img 
              src="https://images.unsplash.com/photo-1503220317375-aaad61436b1b?auto=format&fit=crop&w=600&q=80" 
              alt="Wisata kustom pegunungan i-Travel" 
              class="w-full h-40 object-cover rounded-xl border border-white/10"
            />
          </div>
        </div>

        <!-- Bento Card 3: Standard Card -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
          <span class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-bold text-xl mb-6 shadow-md shadow-emerald-500/20">
            03
          </span>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Akomodasi & Transportasi Terjamin
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Mitra hotel berbintang dan armada bus VIP terawat. Keamanan dan kepuasan rombongan garansi 100%.
          </p>
        </div>

        <!-- Bento Card 4: Large Card (2 Cols) -->
        <div class="md:col-span-2 bg-gradient-to-r from-sky-50 via-rose-50 to-amber-50 rounded-3xl p-8 border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center gap-6">
          <div class="flex-1 space-y-3">
            <span class="px-3 py-1 rounded-full bg-rose-500 text-white text-xs font-bold">Layanan Prioritas</span>
            <h3 class="text-2xl font-bold text-slate-900">
              Layanan Darurat & Pendampingan 24 Jam Nonstop
            </h3>
            <p class="text-slate-700 text-sm leading-relaxed">
              Karena <strong>kepuasan client adalah prioritas kami</strong>, Tour Leader dan Customer Care kami selalu siap merespons perubahan rencana penerbangan maupun kebutuhan mendesak selama di lapangan.
            </p>
          </div>
          <div class="w-full sm:w-48 h-36 shrink-0 rounded-2xl overflow-hidden shadow-md">
            <img 
              src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=500&q=80" 
              alt="Resort mewah mitra i-Travel" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 4: DESTINASI POPULER SHOWCASE -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-rose-500 uppercase tracking-widest block mb-2">Destinasi Terfavorit</span>
          <h2 class="text-3xl font-extrabold text-slate-900">Paket Wisata Paling Banyak Dipilih</h2>
        </div>
        <a href="/layanan" class="inline-flex items-center gap-2 text-sky-600 font-bold text-sm hover:underline">
          <span>Lihat Semua Paket Layanan</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card Destinasi 1 -->
        <div class="group bg-slate-50 rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=800&q=80" 
              alt="Wisata Eksotis Bali & Nusa Penida" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 px-3 py-1 bg-slate-900/80 backdrop-blur-md text-white text-xs font-semibold rounded-full">Domestic Tour</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Exotic Bali & Island Hopping 4D3N</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Nikmati pantai privat, dinner seafood Jimbaran, dan pendampingan guide lokal berpengalaman.</p>
            <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-xs text-slate-500">Mulai dari</span>
              <span class="text-lg font-extrabold text-emerald-600">Rp 3.850.000 <span class="text-xs font-normal text-slate-500">/pax</span></span>
            </div>
          </div>
        </div>

        <!-- Card Destinasi 2 -->
        <div class="group bg-slate-50 rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80" 
              alt="Perjalanan Eropa Barat Paris" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 px-3 py-1 bg-rose-600 text-white text-xs font-semibold rounded-full">International VIP</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Romantic West Europe 10D7N</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Perjalanan impian menyusuri Paris, Amsterdam, dan Swiss dengan penerbangan bintang lima.</p>
            <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-xs text-slate-500">Mulai dari</span>
              <span class="text-lg font-extrabold text-emerald-600">Rp 28.500.000 <span class="text-xs font-normal text-slate-500">/pax</span></span>
            </div>
          </div>
        </div>

        <!-- Card Destinasi 3 -->
        <div class="group bg-slate-50 rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <div class="relative h-64 overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1506973035872-a4ec16b8e8d9?auto=format&fit=crop&w=800&q=80" 
              alt="Sydney Australia Tour" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <span class="absolute top-4 left-4 px-3 py-1 bg-sky-600 text-white text-xs font-semibold rounded-full">Incentive Corporate</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">Australia Scenic Coastal 7D5N</h3>
            <p class="text-slate-600 text-sm leading-relaxed">Pilihan tepat untuk trip apresiasi karyawan korporat dengan fasilitas gala dinner istimewa.</p>
            <div class="pt-3 border-t border-slate-200/80 flex items-center justify-between">
              <span class="text-xs text-slate-500">Mulai dari</span>
              <span class="text-lg font-extrabold text-emerald-600">Rp 19.900.000 <span class="text-xs font-normal text-slate-500">/pax</span></span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 5: TESTIMONI SLOT (EMPTY / READY TO FILL COMPONENT AS REQUESTED) -->
  <section class="py-20 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full uppercase tracking-wider">Testimoni Klien</span>
        <h2 class="text-3xl font-extrabold text-slate-900 mt-3">Suara Kepuasan Mitra Perjalanan Kami</h2>
        <p class="text-slate-600 text-sm mt-2">Komponen testimoni disiapkan untuk diisi dengan ulasan nyata dari 450+ klien kami.</p>
      </div>

      <!-- Empty Component Container Tagged for Client Data -->
      <div class="grid md:grid-cols-3 gap-6">
        
        <!-- Slot 1 -->
        <div class="bg-white p-8 rounded-3xl border-2 border-dashed border-amber-300 relative shadow-sm">
          <div class="mb-4">
            <div class="client-data-tag">
              ⚠️ [PERLU DATA CLIENT: Nama & Testimoni Klien Korporat 1]
            </div>
          </div>
          <div class="space-y-3 opacity-60">
            <div class="flex text-amber-400 gap-1 text-lg">★★★★★</div>
            <p class="text-slate-600 text-sm italic">
              "Placeholder kutipan ulasan klien akan ditampilkan di sini setelah dikirim oleh klien (mis. ulasan perjalanan gathering PT ABC ke Bali)."
            </p>
            <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-500">K1</div>
              <div>
                <h4 class="font-bold text-slate-800 text-sm">[Nama Klien]</h4>
                <p class="text-xs text-slate-500">[Jabatan / Perusahaan]</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Slot 2 -->
        <div class="bg-white p-8 rounded-3xl border-2 border-dashed border-amber-300 relative shadow-sm">
          <div class="mb-4">
            <div class="client-data-tag">
              ⚠️ [PERLU DATA CLIENT: Nama & Testimoni Klien Korporat 2]
            </div>
          </div>
          <div class="space-y-3 opacity-60">
            <div class="flex text-amber-400 gap-1 text-lg">★★★★★</div>
            <p class="text-slate-600 text-sm italic">
              "Placeholder ulasan perjalanan open trip / private tour keluarga. Membuktikan bahwa kepuasan client adalah prioritas kami."
            </p>
            <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-500">K2</div>
              <div>
                <h4 class="font-bold text-slate-800 text-sm">[Nama Klien]</h4>
                <p class="text-xs text-slate-500">[Instansi / Komunitas]</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Slot 3 -->
        <div class="bg-white p-8 rounded-3xl border-2 border-dashed border-amber-300 relative shadow-sm">
          <div class="mb-4">
            <div class="client-data-tag">
              ⚠️ [PERLU DATA CLIENT: Nama & Testimoni Klien Korporat 3]
            </div>
          </div>
          <div class="space-y-3 opacity-60">
