---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontak & Booking — i-Travel | Form Pemesanan & Customer Support 24/7" activeNav="kontak">

  <!-- SECTION 1: CLEAN CONVERSION HERO -->
  <section class="bg-slate-900 text-white py-16 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <span class="px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold uppercase tracking-widest">
        Respon Cepat 24/7
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white">
        Hubungi Tim i-Travel Sekarang
      </h1>
      <p class="text-slate-300 text-base max-w-xl mx-auto font-light">
        Siap membantu segala kebutuhan konsultasi paket wisata, penawaran corporate gathering, hingga pemesanan tiket penerbangan.
      </p>
    </div>
  </section>

  <!-- SECTION 2: DIRECT CONTACT CARDS -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-6">
        
        <!-- WhatsApp Card -->
        <a 
          href="https://wa.me/6281234567890?text=Halo%20i-Travel%2C%20saya%20ingin%20konsultasi%20booking" 
          target="_blank"
          class="p-6 rounded-3xl bg-emerald-50 border border-emerald-200 hover:border-emerald-400 transition-all flex items-start gap-4 group"
        >
          <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-bold text-2xl shrink-0 group-hover:scale-110 transition-transform">
            💬
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition-colors">WhatsApp Order</h3>
            <p class="text-xs text-slate-600 mt-1">Respon tercepat dalam 5 menit.</p>
            <span class="text-sm font-extrabold text-emerald-600 block mt-2">0812-3456-7890</span>
          </div>
        </a>

        <!-- Phone Card -->
        <a 
          href="tel:+6281234567890" 
          class="p-6 rounded-3xl bg-sky-50 border border-sky-200 hover:border-sky-400 transition-all flex items-start gap-4 group"
        >
          <div class="w-12 h-12 rounded-2xl bg-sky-500 text-white flex items-center justify-center font-bold text-2xl shrink-0 group-hover:scale-110 transition-transform">
            📞
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-lg group-hover:text-sky-700 transition-colors">Telepon Kantor</h3>
            <p class="text-xs text-slate-600 mt-1">Jam operasional 08:00 - 18:00 WIB.</p>
            <span class="text-sm font-extrabold text-sky-600 block mt-2">(021) 555-8899</span>
          </div>
        </a>

        <!-- Email Card -->
        <div class="p-6 rounded-3xl bg-rose-50 border border-rose-200 flex items-start gap-4">
          <div class="w-12 h-12 rounded-2xl bg-rose-500 text-white flex items-center justify-center font-bold text-2xl shrink-0">
            ✉️
          </div>
          <div>
            <h3 class="font-bold text-slate-900 text-lg">Email Official</h3>
            <p class="text-xs text-slate-600 mt-1">Pengiriman berkas proposal formal.</p>
            <span class="text-sm font-extrabold text-rose-600 block mt-2">info@itravel.co.id</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 3: BOOKING FORM & OFFICE LOCATION SPLIT (UNIQUE STRUCTURAL ELEMENT) -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12">
        
        <!-- Left: Interactive Multi-Step Booking Form -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-md">
          <div class="mb-6 space-y-1">
            <span class="text-xs font-bold text-sky-600 uppercase tracking-widest">Form Konsultasi & Booking</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Rencanakan Perjalanan Anda</h2>
            <p class="text-slate-600 text-xs">Isi formulir di bawah ini, tim i-Travel akan menghubungi Anda dengan rincian proposal harga.</p>
          </div>

          <form id="booking-form" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap *</label>
                <input type="text" required placeholder="Contoh: Budi Santoso" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nomor WhatsApp / HP *</label>
                <input type="tel" required placeholder="0812xxxxxxx" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Kategori Perjalanan *</label>
                <select required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500">
                  <option value="">-- Pilih Jenis Layanan --</option>
                  <option value="corporate">Corporate Outing / Gathering</option>
                  <option value="opentrip">Open Trip</option>
                  <option value="custom">Custom Private Luxury Tour</option>
                  <option value="incentive">Incentive Trip Luar Negeri</option>
                  <option value="visa">Pengurusan Visa & Tiket</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Estimasi Jumlah Peserta *</label>
                <input type="number" min="1" placeholder="Misal: 45 orang" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Destinasi Tujuan</label>
                <input type="text" placeholder="Misal: Bali / Swiss / Jepang" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Rencana Tanggal Keberangkatan</label>
                <input type="date" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Tambahan & Request Spesifik</label>
              <textarea rows="3" placeholder="Tuliskan jika ada kebutuhan hotel khusus, budget target, atau acara gala dinner..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"></textarea>
            </div>

            <button type="submit" class="w-full py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-base shadow-lg transition-all flex items-center justify-center gap-2">
              <span>Kirim Formulir Booking Online</span>
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </form>

          <!-- Form Success Alert Placeholder -->
          <div id="form-success" class="hidden mt-4 p-4 rounded-xl bg-emerald-100 border border-emerald-300 text-emerald-900 text-sm font-semibold text-center">
            🎉 Terima kasih! Data booking Anda telah diterima. Tim konsultan i-Travel akan segera menghubungi WhatsApp Anda.
          </div>
        </div>

        <!-- Right: Office Info & Map Location Placeholder -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-xl font-bold text-slate-900">Kantor Operasional i-Travel</h3>
            
            <div class="rounded-2xl overflow-hidden h-52 border border-slate-200">
              <img 
                src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=800&q=80" 
                alt="Kantor i-Travel" 
                class="w-full h-full object-cover"
              />
            </div>

            <div class="space-y-3 text-sm text-slate-700">
              <div class="flex items-start gap-3">
                <span class="text-sky-600 font-bold text-base">📍</span>
                <div>
                  <strong>Alamat Utama:</strong>
                  <p class="text-xs text-slate-500">Jl. Utama Boulevard No. 88, Jakarta Selatan, 12930</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-sky-600 font-bold text-base">🕒</span>
                <div>
                  <strong>Jam Operasional Kantor:</strong>
                  <p class="text-xs text-slate-500">Senin – Sabtu: 08.00 – 18.00 WIB (Layanan WA 24 Jam)</p>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
              <div class="client-data-tag">
                ⚠️ [PERLU DATA CLIENT: Koordinat Google Maps & Peta Interaktif]
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECTION 4: FAQ ACCORDION -->
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12 space-y-2">
        <span class="text-xs font-bold text-sky-600 uppercase tracking-widest">Pertanyaan Umum</span>
        <h2 class="text-3xl font-extrabold text-slate-900">FAQ (Frequently Asked Questions)</h2>
      </div>

      <div class="space-y-4" id="faq-accordion">
        
        <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
          <button class="faq-btn w-full text-left font-bold text-slate-900 text-base flex justify-between items-center">
            <span>Bagaimana mekanisme pembayaran paket wisata di i-Travel?</span>
            <span class="text-sky-600 text-xl font-bold">+</span>
          </button>
          <div class="faq-content hidden mt-3 pt-3 border-t border-slate-200 text-sm text-slate-600 leading-relaxed">
            Pembayaran dapat dilakukan melalui DP (Down Payment) sebesar 30% saat penerbitan kontrak kesepakatan, dan pelunasan H-7 sebelum keberangkatan. Kami menggunakan rekening resmi perusahaan untuk kepastian keamanan 100%.
          </div>
        </div>

        <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
          <button class="faq-btn w-full text-left font-bold text-slate-900 text-base flex justify-between items-center">
            <span>Apakah i-Travel melayani invoice resmi dan faktur pajak perusahaan?</span>
            <span class="text-sky-600 text-xl font-bold">+</span>
          </button>
          <div class="faq-content hidden mt-3 pt-3 border-t border-slate-200 text-sm text-slate-600 leading-relaxed">
            Ya, tentu. Kami memiliki legalitas resmi lengkap dan memfasilitasi kebutuhan administrasi keuangan corporate client termasuk invoice formal, faktur pajak, dan kwitansi berstempel resmi.
          </div>
        </div>

        <div class="border border-slate-200 rounded-2xl p-5 bg-slate-50">
          <button class="faq-btn w-full text-left font-bold text-slate-900 text-base flex justify-between items-center">
            <span>Bagaimana jika terjadi cuaca buruk atau kondisi darurat di lapangan?</span>
            <span class="text-sky-600 text-xl font-bold">+</span>
          </button>
          <div class="faq-content hidden mt-3 pt-3 border-t border-slate-200 text-sm text-slate-600 leading-relaxed">
            Sesuai prinsip bahwa <strong>kepuasan client adalah prioritas kami</strong>, Tour Leader kami memiliki protokol penanganan darurat teruji dan akan memberikan opsi itinerari alternatif yang setara tanpa biaya tersembunyi.
          </div>
        </div>

      </div>

    </div>
  </section>

  <script>
    // Booking form submit handler
    const form = document.getElementById('booking-form');
    const successMsg = document.getElementById('form-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
        (form as HTMLFormElement).reset();
      }
    });

    // FAQ Accordion
    const faqBtns = document.querySelectorAll('.faq-btn');
    faqBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling as HTMLElement;
        const icon = btn.querySelector('span:last-child');
        if (content) {
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden');
          if (icon) icon.textContent = isHidden ? '-' : '+';
        }
      });
    });
  </script>

</Layout>
