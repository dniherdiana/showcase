---
---

<footer class="bg-neutral-950 text-neutral-300 pt-24 pb-12 border-t border-neutral-900 overflow-hidden relative">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-40 right-1/4 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <!-- Big Callout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-16 border-b border-neutral-800/70">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-mono tracking-widest text-amber-400 uppercase">Elevate Event Organizer</span>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-light text-white leading-tight">
          Siap Merancang Event Berkelas Dunia Bersama Tim Profesional Kami?
        </h2>
        <p class="text-neutral-400 text-base max-w-xl font-light leading-relaxed">
          Menangani event dari konsep hingga eksekusi dengan tim kreatif dan operasional dalam satu manajemen terpadu. Pendekatan berbasis tujuan bisnis client dengan dokumentasi kualitas tinggi.
        </p>
        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="/contact"
            class="px-6 py-3 text-xs font-semibold tracking-wider text-neutral-950 uppercase bg-amber-400 hover:bg-amber-300 transition-colors rounded-full shadow-lg"
          >
            Konsultasi Event Gratis
          </a>
          <a
            href="https://wa.me/6281234567890"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 text-xs font-semibold tracking-wider text-white border border-neutral-700 hover:border-amber-400/50 hover:text-amber-300 transition-colors rounded-full"
          >
            WhatsApp Direct Hotline
          </a>
        </div>
      </div>

      <!-- Quick Nav & Direct Specs -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-mono tracking-widest text-neutral-400 uppercase font-semibold">Navigasi Halaman</h3>
        <ul class="space-y-3 font-sans text-sm">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home Studio</a></li>
          <li><a href="/portfolio" class="hover:text-amber-400 transition-colors">Portfolio Dokumentasi</a></li>
          <li><a href="/services" class="hover:text-amber-400 transition-colors">Layanan & Spesifikasi</a></li>
          <li><a href="/about" class="hover:text-amber-400 transition-colors">Tentang Kami & Filosofi</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Kontak & Hubungi Tim</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-mono tracking-widest text-neutral-400 uppercase font-semibold">Kantor & Kontak</h3>
        <div class="space-y-2 text-xs leading-relaxed text-neutral-400">
          <p class="text-white font-medium">Headquarters Studio:</p>
          <p>Sudirman Central Business District (SCBD) Tower B, Lt. 18</p>
          <p>Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan 12190</p>
          <div class="pt-2 space-y-1 font-mono">
            <p>Email: hello@elevate-eo.co.id</p>
            <p>Hotline: +62 21 5558 9012</p>
            <p>Jam Kerja: Sen - Sab (08:30 - 18:00 WIB)</p>
          </div>
          <div class="pt-2">
            <span class="data-client-badge">
              [PERLU DATA CLIENT: alamat cabang daerah]
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Proof Points Footer Bar -->
    <div class="py-8 border-b border-neutral-900 grid grid-cols-2 md:grid-cols-4 gap-6 text-center md:text-left">
      <div>
        <div class="font-serif text-2xl font-bold text-amber-400">2015</div>
        <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider">Berdiri & Berpengalaman</div>
      </div>
      <div>
        <div class="font-serif text-2xl font-bold text-amber-400">350+</div>
        <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider">Event Sukses Diselenggarakan</div>
      </div>
      <div>
        <div class="font-serif text-2xl font-bold text-amber-400">120+</div>
        <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider">Perusahaan Mempercayai</div>
      </div>
      <div>
        <div class="font-serif text-2xl font-bold text-amber-400">4.9 / 5</div>
        <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider">
          Kepuasan Klien <span class="data-client-badge ml-1">[PERLU DATA CLIENT: rating platform]</span>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
      <p>© 2026 Elevate Event Organizer. All rights reserved.</p>
      <div class="flex items-center gap-6 font-mono text-[11px]">
        <span>Corporate Events</span>
        <span>•</span>
        <span>Wedding & Gala</span>
        <span>•</span>
        <span>Exhibition & MICE</span>
      </div>
    </div>
  </div>
</footer>
