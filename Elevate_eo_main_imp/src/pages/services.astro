---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: 'corporate',
    number: '01',
    title: 'Corporate Event & Conference',
    description: 'Penyelenggaraan summit eksekutif, rapat umum pemegang saham (RUPS), konferensi pers, dan awarding gala dengan sistem keamanan VVIP & protokol registrasi RFID.',
    image: 'https://images.unsplash.com/photo-1431540015161-0bf868a2d407?auto=format&fit=crop&w=800&q=80',
    deliverables: ['Panggung 3D Custom', 'VVIP Guest Control & RFID', 'Multi-Language Audio System', 'Broadcast Live Streaming 4K']
  },
  {
    id: 'wedding',
    number: '02',
    title: 'Royal & Destination Wedding Organizer',
    description: 'Manajemen pernikahan mewah dari konsep budaya tradisional hingga pesta internasional di Bali & tempat eksotis nasional dengan integrasi tim orkestra dan instalasi flora.',
    image: 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=800&q=80',
    deliverables: ['Full Wedding Flow & Rundown', 'Glass Dome & Outdoor Shield', 'Destination VVIP Hospitality', 'Cinematic Photography Package']
  },
  {
    id: 'exhibition',
    number: '03',
    title: 'Exhibition & Trade Expo',
    description: 'Perancangan master layout hall pameran skala ribuan meter persegi, konstruksi booth modular ramah lingkungan, dan manajemen keamanan alur pengunjung.',
    image: 'https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?auto=format&fit=crop&w=800&q=80',
    deliverables: ['Master Planning & Zoning', 'Construction 100+ Booths', 'Directional Audio & Acoustic', 'Media Center Suite']
  },
  {
    id: 'launching',
    number: '04',
    title: 'Product Launching & Reveal',
    description: 'Momen peluncuran produk baru berdaya pukul tinggi—otomotif, elektronik, hingga fashion—dengan mekanika reveal spektakuler dan proyeksi hologram 3D.',
    image: 'https://images.unsplash.com/photo-1551818255-e6e10975bc17?auto=format&fit=crop&w=800&q=80',
    deliverables: ['Creative Reveal Mechanism', 'Holographic Projection', 'Media & Influencer Suite', 'SPK Conversion Setup']
  },
  {
    id: 'activation',
    number: '05',
    title: 'Brand Activation & Experiential Pop-up',
    description: 'Menciptakan ruang pop-up dan aktivitas imersif yang merangsang seluruh panca indra audiens untuk membangun ikatan emosional kuat dengan brand Anda.',
    image: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=800&q=80',
    deliverables: ['Sensory Installation Architecture', 'KINETIC Lighting Setup', 'Audience Engagement Tracking', 'Pop-up Booth Construction']
  },
  {
    id: 'gathering',
    number: '06',
    title: 'Company Gathering & Executive Retreat',
    description: 'Merancang program apresiasi karyawan dan konsolidasi kepemimpinan dengan aktivitas luar ruangan berenergi tinggi serta acara malam keakraban berkesan.',
    image: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=800&q=80',
    deliverables: ['3-Day Custom Itinerary', 'Team Building Synergies', 'Sunset Awarding Ceremony', 'Full Logistics Concierge']
  },
  {
    id: 'mice',
    number: '07',
    title: 'MICE (Meeting, Incentive, Convention, Exhibition)',
    description: 'Layanan terpadu pengelolaan program MICE internasional dengan pemenuhan standar protokol diplomatik, akomodasi, dan transportasi delegasi.',
    image: 'https://images.unsplash.com/photo-1561489413-985b06da5bee?auto=format&fit=crop&w=800&q=80',
    deliverables: ['International Delegation Control', 'Airport VVIP Fast-Track', 'Simultaneous Interpretation', 'Post-Conference Excursions']
  },
  {
    id: 'production',
    number: '08',
    title: 'Event Production & Technical Rigging',
    description: 'Dukungan penuh tim teknis: persewaan & instalasi LED display high-refresh rate, tata cahaya panggung konser, tata suara akustik, dan rigging baja.',
    image: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&w=800&q=80',
    deliverables: ['LED Wall High-Refresh Rate', 'Concert Grade Line Array Audio', 'Steel Truss Rigging Structure', 'Redundant Power Generator']
  }
];
---

<Layout
  title="Layanan & Spesifikasi Eksekusi — Elevate Event Organizer"
  description="Layanan lengkap event organizer: Corporate Event, Wedding, Exhibition MICE, Product Launching, Brand Activation, Gathering, hingga Event Production teknis."
  currentPath="/services"
>
  <!-- HERO SERVICES: Right-Aligned Punchy Header (Asymmetrical Blueprint) -->
  <section class="pt-36 pb-20 bg-neutral-950 border-b border-neutral-900 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5 space-y-4">
        <span class="text-xs font-mono text-amber-400 uppercase tracking-widest">Katalog Layanan & Spesifikasi</span>
        <div class="p-6 bg-neutral-900 border border-neutral-800 rounded-2xl space-y-4">
          <p class="text-xs font-mono text-neutral-400 uppercase">Jaminan Standar Kerja:</p>
          <div class="space-y-2 text-xs text-neutral-300">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>
              <span>Menangani event dari konsep hingga eksekusi</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>
              <span>Tim kreatif & operasional 1 komando</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>
              <span>Pendekatan berbasis tujuan bisnis client</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>
              <span>Dokumentasi profesional terintegrasi</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <h1 class="font-serif text-4xl sm:text-6xl text-white font-light leading-tight">
          Solusi <span class="italic text-amber-300">End-to-End</span> Untuk Setiap Kategori Event Berkelas.
        </h1>
        <p class="text-neutral-300 text-sm sm:text-base font-light leading-relaxed">
          Kami menolak pengkotak-kotakan layanan generik. Setiap spesifikasi dirancang khusus sesuai skala audiens, karakter lokasi, dan KPI yang ingin dicapai oleh klien.
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES LIST (Digital Magazine Layout) -->
  <section class="py-24 bg-neutral-950 relative">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-20">
      {services.map((item, idx) => (
        <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center border-b border-neutral-900 pb-20 ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <!-- Image Column (5 cols) -->
          <div class={`lg:col-span-5 relative group overflow-hidden rounded-2xl border border-neutral-800 ${idx % 2 === 1 ? 'lg:order-2' : 'lg:order-1'}`}>
            <div class="aspect-[4/3] bg-neutral-900">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <span class="absolute top-4 left-4 font-serif text-4xl text-amber-400 font-bold bg-black/80 px-4 py-1 rounded-lg">
              {item.number}
            </span>
          </div>

          <!-- Description Column (7 cols) -->
          <div class={`lg:col-span-7 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : 'lg:order-2'}`}>
            <span class="text-xs font-mono text-amber-400 uppercase tracking-widest">Kategori #{item.number}</span>
            <h2 class="font-serif text-3xl sm:text-4xl text-white font-medium">
              {item.title}
            </h2>
            <p class="text-neutral-300 text-sm leading-relaxed font-light">
              {item.description}
            </p>

            <!-- Deliverables Pills -->
            <div class="space-y-3 pt-2">
              <h4 class="text-xs font-mono text-neutral-400 uppercase tracking-widest font-semibold">Cakupan Output Utamnya:</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {item.deliverables.map((deliv) => (
                  <div class="flex items-center gap-2 text-xs text-neutral-200 bg-neutral-900/90 border border-neutral-800 px-3.5 py-2.5 rounded-lg">
                    <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span>
                    {deliv}
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-4">
              <a
                href="/contact"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-amber-400 hover:text-amber-300 transition-colors"
              >
                Konsultasikan Spesifikasi Event Ini
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- RARE SECTION: COMPARISON TABLE (Standard Vendor vs Elevate Approach) -->
  <section class="py-24 bg-neutral-900 border-t border-neutral-800 relative">
    <div class="max-w-6xl mx-auto px-6 md:px-12 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs font-mono text-amber-400 uppercase tracking-widest">Matriks Perbandingan Pendekatan</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-white font-light">
          Mengapa Pendekatan Elevate Berbeda Dari Vendor Biasa?
        </h2>
      </div>

      <!-- Comparison Matrix Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[600px]">
          <thead>
            <tr class="border-b border-neutral-800 text-xs font-mono uppercase tracking-widest text-neutral-400">
              <th class="py-4 px-6 w-1/3">Aspek Standar Eksekusi</th>
              <th class="py-4 px-6 w-1/3 text-neutral-400">Vendor EO Generic</th>
              <th class="py-4 px-6 w-1/3 text-amber-400 bg-amber-400/5 rounded-t-xl">Elevate Event Organizer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-800/60 text-xs text-neutral-300">
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Struktur Manajemen</td>
              <td class="py-5 px-6 text-neutral-400">Sub-kontraktor terpisah tanpa koordinasi terpusat.</td>
              <td class="py-5 px-6 text-amber-300 font-medium bg-amber-400/5">Tim kreatif & operasional dalam 1 manajemen terpadu.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Landasan Konsep</td>
              <td class="py-5 px-6 text-neutral-400">Meniru template dekorasi yang sudah ada sebelumnya.</td>
              <td class="py-5 px-6 text-amber-300 font-medium bg-amber-400/5">Pendekatan kustom berbasis tujuan bisnis & brand story client.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Layanan Dokumentasi</td>
              <td class="py-5 px-6 text-neutral-400">Tambahan biaya terpisah (opsional).</td>
              <td class="py-5 px-6 text-amber-300 font-medium bg-amber-400/5">Dokumentasi profesional sinematik 4K sebagai bagian inti dari layanan.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Penanganan VVIP</td>
              <td class="py-5 px-6 text-neutral-400">Manual check-in standar, risiko antrean.</td>
              <td class="py-5 px-6 text-amber-300 font-medium bg-amber-400/5">Smart RFID Check-in & Protokol Pengamanan Khusus VVIP.</td>
            </tr>
            <tr>
              <td class="py-5 px-6 font-semibold text-white">Jaminan Risiko Teknis</td>
              <td class="py-5 px-6 text-neutral-400">Reaksi penanganan saat kendala sudah terjadi.</td>
              <td class="py-5 px-6 text-amber-300 font-medium bg-amber-400/5 rounded-b-xl">Sistem kelistrikan & audio redundant teruji zero glitch.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA BAND FOR SERVICES -->
  <section class="py-24 bg-neutral-950 text-center relative">
    <div class="max-w-4xl mx-auto px-6 space-y-8">
      <h2 class="font-serif text-3xl sm:text-5xl text-white font-light">
        Butuh Penyesuaian Ruang Lingkup Event Spesifik?
      </h2>
      <p class="text-neutral-300 text-sm max-w-xl mx-auto font-light leading-relaxed">
        Diskusi langsung dengan Show Director kami untuk merancang RAB dan timeline eksekusi yang realistis.
      </p>
      <div class="pt-4">
        <a
          href="/contact"
          class="px-8 py-4 bg-amber-400 hover:bg-amber-300 text-neutral-950 font-semibold text-xs uppercase tracking-widest rounded-full transition-all shadow-xl"
        >
          Konsultasikan Rencana Layanan
        </a>
      </div>
    </div>
  </section>
</Layout>
