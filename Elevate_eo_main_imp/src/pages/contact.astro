---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.svelte';
---

<Layout
  title="Hubungi & Konsultasi Event — Elevate Event Organizer"
  description="Jadwalkan meeting atau konsultasikan rencana event Anda bersama Elevate Event Organizer. Kantor SCBD Jakarta & respon WhatsApp cepat."
  currentPath="/contact"
>
  <!-- HERO CONTACT: Split Layout with Direct Details & Interactive Form -->
  <section class="pt-36 pb-24 bg-neutral-950 relative overflow-hidden">
    <!-- Ambient Background Light -->
    <div class="absolute top-1/4 left-10 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column Contact Info (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-400/10 border border-amber-400/30 text-amber-300 text-xs font-mono uppercase tracking-widest rounded-full">
            Fast Response Hotline
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl text-white font-light leading-tight">
            Mari Merancang <span class="italic text-amber-300">Event Berkesan</span> Bersama Kami.
          </h1>
          <p class="text-neutral-300 text-sm font-light leading-relaxed">
            Tim Business Development Elevate Event Organizer siap mendengarkan kebutuhan, tujuan bisnis, dan anggaran event Anda.
          </p>
        </div>

        <!-- Contact Channels Cards -->
        <div class="space-y-4 pt-2">
          <!-- WhatsApp Hotline -->
          <a
            href="https://wa.me/6281234567890"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-5 bg-neutral-900 border border-neutral-800 hover:border-amber-400/60 rounded-xl transition-all group"
          >
            <div class="flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-[10px] font-mono text-amber-400 uppercase tracking-widest">Direct WhatsApp</span>
                <div class="text-white font-mono text-base font-semibold group-hover:text-amber-300 transition-colors">
                  +62 812-3456-7890
                </div>
                <p class="text-xs text-neutral-400">Respon dalam 15 menit pada jam kerja</p>
              </div>
              <span class="text-amber-400 font-mono text-xl group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <!-- Email Direct -->
          <a
            href="mailto:hello@elevate-eo.co.id"
            class="block p-5 bg-neutral-900 border border-neutral-800 hover:border-amber-400/60 rounded-xl transition-all group"
          >
            <div class="flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-[10px] font-mono text-amber-400 uppercase tracking-widest">Email Official Inquiry</span>
                <div class="text-white font-mono text-base font-semibold group-hover:text-amber-300 transition-colors">
                  hello@elevate-eo.co.id
                </div>
                <p class="text-xs text-neutral-400">Untuk pengiriman RFP / Proposal resmi</p>
              </div>
              <span class="text-amber-400 font-mono text-xl group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </div>

        <!-- Headquarters Address Details -->
        <div class="p-6 bg-neutral-900/60 border border-neutral-800 rounded-xl space-y-3 text-xs text-neutral-300">
          <div class="text-xs font-mono text-amber-400 uppercase tracking-widest font-semibold">Lokasi Studio Utama</div>
          <p class="font-medium text-white">Sudirman Central Business District (SCBD) Tower B, Lt. 18</p>
          <p class="text-neutral-400">Jl. Jend. Sudirman Kav. 52-53, Jakarta Selatan 12190</p>
          <div class="pt-2 border-t border-neutral-800 space-y-1 font-mono text-[11px] text-neutral-400">
            <p>Telepon: +62 21 5558 9012</p>
            <p>Jam Kerja: Senin – Sabtu (08:30 – 18:00 WIB)</p>
          </div>
        </div>
      </div>

      <!-- Right Column Interactive Form (7 cols) -->
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <!-- GOOGLE MAPS PLACEHOLDER & LOCATION EMBED -->
  <section class="py-16 bg-neutral-900 border-t border-neutral-800 relative">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono text-amber-400 uppercase tracking-widest">Peta Kunjungan Studio</span>
          <h2 class="font-serif text-2xl text-white font-medium">Lokasi Headquarter Jakarta</h2>
        </div>
        <div>
          <span class="data-client-badge">
            [PERLU DATA CLIENT: Google Maps Embed API Key / URL]
          </span>
        </div>
      </div>

      <!-- Styled Map Frame -->
      <div class="relative aspect-[21/9] rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-950 flex items-center justify-center">
        <img
          src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80"
          alt="SCBD Jakarta Tower"
          class="w-full h-full object-cover opacity-40 filter grayscale"
        />
        <div class="absolute inset-0 bg-neutral-950/60 backdrop-blur-xs flex flex-col items-center justify-center p-6 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-amber-400 text-neutral-950 flex items-center justify-center font-bold text-xl shadow-xl">
            📍
          </div>
          <h3 class="font-serif text-2xl text-white">Elevate Event Organizer Headquarters</h3>
          <p class="text-xs text-neutral-300 max-w-md">
            SCBD Tower B Lt. 18, Jakarta Selatan • Parkir VVIP & Helipad Access Available
          </p>
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2 bg-neutral-900 border border-neutral-700 hover:border-amber-400 text-xs font-mono text-amber-300 rounded-full transition-colors"
          >
            Buka Peta Google Maps →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
