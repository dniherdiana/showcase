---
import '../styles/global.css';
import Navbar from '../components/Navbar.svelte';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Elevate Event Organizer — Creative Studio & Event Management",
  description = "Elevate Event Organizer menangani event corporate skala nasional, gala wedding, exhibition, product launch, hingga brand activation dari konsep hingga eksekusi dengan dokumentasi sinematik profesional.",
  currentPath = "/"
} = Astro.props;
---

<!usr/bin/env html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Event Organizer, Corporate Event Jakarta, Wedding Organizer, Exhibition MICE, Brand Activation, Launching Product, Elevate EO" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1200&q=80" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans selection:bg-amber-400 selection:text-neutral-950 antialiased min-h-screen flex flex-col">
    <!-- Fixed Navigation Bar -->
    <Navbar client:load currentPath={currentPath} />

    <!-- Main Page Content Canvas -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
