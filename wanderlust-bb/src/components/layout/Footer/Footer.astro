---
import { siteConfig } from "../site.config.js";
import { footerData, socialLinks } from "./footer.data.js";
---

<!-- Light Warm Linen & Deep Navy Luxury Footer -->
<footer
  class="relative z-10 border-t border-[#1e2d40] bg-[#0a131d] px-[5%] pt-16 pb-12 text-slate-300"
>
  <div class="mx-auto mb-12 max-w-7xl space-y-10">
    <!-- Top Grid: Brand & Contact Info + Navigation Links -->
    <div
      class="grid grid-cols-1 items-start gap-10 md:grid-cols-2 lg:grid-cols-5 lg:gap-8"
    >
      <!-- Column 1: Brand Info & Social Media Links -->
      <div class="space-y-5">
        <a
          href="/"
          class="inline-block font-serif text-2xl font-bold tracking-tight text-white"
        >
          {siteConfig.logoText}<span class="text-[#b88a2a]"
            >{siteConfig.logoAccent}</span
          >.
        </a>

        <p
          data-i18n-key="footerBrandDesc"
          data-i18n-en={footerData.brandDescription}
          data-i18n-id={footerData.brandDescription_id}
          class="font-sans text-xs leading-relaxed text-slate-300/80"
        >
          {footerData.brandDescription}
        </p>

        <!-- Social Media Icons Row -->
        <div class="space-y-2 pt-1">
          <h3
            class="text-[#b88a2a] font-mono text-[11px] font-bold tracking-widest uppercase"
            data-i18n-en="Follow Our Journeys"
            data-i18n-id="Ikuti Perjalanan Kami"
          >
            Follow Our Journeys
          </h3>
          <div class="flex flex-wrap items-center gap-2">
            {
              socialLinks.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.name}
                  title={item.name}
                  class="group hover:border-[#b88a2a] hover:bg-[#b88a2a] flex h-8 w-8 items-center justify-center rounded-none border border-white/20 bg-slate-900 text-slate-200 shadow-md transition-all duration-300 hover:text-slate-950"
                >
                  {item.id === "fb" && (
                    <svg
                      class="h-3.5 w-3.5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                    </svg>
                  )}
                  {item.id === "instagram" && (
                    <svg
                      class="h-3.5 w-3.5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  )}
                  {item.id === "x" && (
                    <svg
                      class="h-3.5 w-3.5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {item.id === "youtube" && (
                    <svg
                      class="h-3.5 w-3.5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                  {item.id === "tiktok" && (
                    <svg
                      class="h-3.5 w-3.5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97v7.2c.01 1.76-.43 3.53-1.35 5.04-1.22 1.98-3.32 3.39-5.61 3.79-2.02.35-4.14-.07-5.88-1.16-2.14-1.34-3.59-3.64-3.86-6.16-.27-2.52.48-5.06 2.08-7.01 1.55-1.89 3.86-3.03 6.32-3.15.34-.01.68.01 1.02.04v4.06c-.72-.1-1.46-.04-2.15.19-.94.31-1.74.96-2.22 1.82-.48.86-.58 1.88-.29 2.82.29.94.97 1.7 1.87 2.11.9.41 1.95.42 2.86.03.91-.39 1.61-1.14 1.95-2.08.19-.53.28-1.1.28-1.67V.02z" />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Column 2: SCBD Lounge HQ Contact Info -->
      <div class="space-y-3.5">
        <h3
          class="font-serif text-sm font-bold tracking-wide text-white uppercase"
          data-i18n-en="SCBD Lounge HQ"
          data-i18n-id="Kantor SCBD Jakarta"
        >
          SCBD Lounge HQ
        </h3>

        <div class="space-y-2.5 font-sans text-xs text-slate-300/80">
          <div class="flex items-start gap-2">
            <svg
              class="text-[#b88a2a] mt-0.5 h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span
              data-i18n-en={siteConfig.officeAddress}
              data-i18n-id={siteConfig.officeAddress_id}
              class="leading-relaxed"
            >
              {siteConfig.officeAddress}
            </span>
          </div>

          <div class="flex items-center gap-2">
            <svg
              class="text-[#b88a2a] h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>{siteConfig.contactPhone}</span>
          </div>

          <div class="flex items-center gap-2">
            <svg
              class="text-[#b88a2a] h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>{siteConfig.contactEmail}</span>
          </div>

          <div class="flex items-center gap-2 pt-0.5">
            <svg
              class="text-[#b88a2a] h-4 w-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span
              data-i18n-en={siteConfig.officeHours}
              data-i18n-id={siteConfig.officeHours_id}
            >
              {siteConfig.officeHours}
            </span>
          </div>
        </div>
      </div>

      <!-- Columns 3, 4, 5: Navigation Link Sections -->
      {
        footerData.sections.map((sec) => (
          <div class="space-y-3.5">
            <h3
              data-i18n-en={sec.title}
              data-i18n-id={sec.title_id}
              class="font-serif text-sm font-bold tracking-wide text-white uppercase"
            >
              {sec.title}
            </h3>
            <ul class="space-y-2 font-sans text-xs">
              {sec.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    data-i18n-en={link.name}
                    data-i18n-id={link.name_id}
                    class="hover:text-[#b88a2a] block text-slate-300/80 transition-colors"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Full-Width Horizontal Magazine Newsletter Banner -->
    <div
      class="w-full border-t border-[#1e2d40] pt-8"
    >
      <div
        class="flex flex-col items-center justify-between gap-6 lg:flex-row lg:gap-8"
      >
        <!-- Left Side: Category Badge, Header & Description Info -->
        <div class="max-w-sm space-y-1.5 text-center lg:text-left xl:max-w-md">
          <span
            class="block font-mono text-[11px] font-bold tracking-widest text-teal-300 uppercase"
            data-i18n-en="Weekly Dispatch"
            data-i18n-id="Buletin Mingguan"
          >
            Weekly Dispatch
          </span>

          <h3
            data-i18n-key="footerNewsletterTitle"
            data-i18n-en={footerData.newsletter.title}
            data-i18n-id={footerData.newsletter.title_id}
            class="font-serif text-lg font-bold tracking-wide text-white uppercase sm:text-xl"
          >
            {footerData.newsletter.title}
          </h3>

          <p
            data-i18n-en={footerData.newsletter.description}
            data-i18n-id={footerData.newsletter.description_id}
            class="font-sans text-xs leading-relaxed font-light text-slate-300/80"
          >
            {footerData.newsletter.description}
          </p>
        </div>

        <!-- Right Side: Inline Form without Pill Buttons -->
        <form
          class="w-full shrink-0 space-y-2 lg:w-auto"
          onsubmit="event.preventDefault(); alert('Thank you for subscribing to Wanderlust Journal!');"
        >
          <div
            class="flex w-full flex-col items-center gap-2.5 sm:flex-row lg:w-145"
          >
            <input
              type="email"
              data-i18n-en={footerData.newsletter.placeholder}
              data-i18n-id={footerData.newsletter.placeholder_id}
              placeholder={footerData.newsletter.placeholder}
              required
              class="focus:border-[#b88a2a] w-full flex-1 rounded-none border border-[#1e2d40] bg-slate-900 px-5 py-3 font-mono text-xs text-white placeholder:text-white/40 focus:outline-none"
            />
            <button
              type="submit"
              data-i18n-key="footerSubscribe"
              data-i18n-en={footerData.newsletter.btnText}
              data-i18n-id={footerData.newsletter.btnText_id}
              class="bg-[#b88a2a] hover:bg-[#c49533] w-full shrink-0 cursor-pointer rounded-none px-8 py-3 text-xs font-mono font-extrabold tracking-widest text-slate-950 uppercase shadow-md transition-all sm:w-auto"
            >
              {footerData.newsletter.btnText}
            </button>
          </div>

          <!-- Trust Reassurance -->
          <div
            class="flex items-center justify-center gap-1.5 font-sans text-[10px] text-slate-400 lg:justify-start"
          >
            <svg
              class="text-[#b88a2a] h-3.5 w-3.5 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8"
              ></path>
            </svg>
            <span
              data-i18n-en="Zero Spam • Unsubscribe Anytime • 100% Confidential"
              data-i18n-id="Bebas Spam • Berhenti Kapan Saja • 100% Rahasia"
            >
              Zero Spam • Unsubscribe Anytime • 100% Confidential
            </span>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer Bottom Bar & Legal Links -->
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 border-t border-[#1e2d40] pt-8 font-sans text-xs text-white/50 md:flex-row"
  >
    <div
      class="flex flex-wrap items-center gap-1.5 text-center font-sans text-xs text-slate-400 md:text-left"
    >
      <span
        >© {new Date().getFullYear()} Wanderlust Travel Agency &bull; Design & Develop
        by:</span
      >
      <a
        href="/"
        class="brand inline-flex items-center text-xs font-light tracking-wide text-white transition-opacity hover:opacity-90"
      >
        <span
          class="rounded-l-xs border border-r-0 border-green-700 bg-green-800 px-1.5 py-0.5 font-semibold text-white"
          >dni</span
        ><span
          class="rounded-r-xs border border-green-800 bg-slate-950/60 px-1.5 py-0.5 font-semibold text-white"
          >WebCraft</span
        >
      </a>
    </div>
  </div>
</footer>
