---
/* Interactive Luxury Destination Highlights Quick View Modal */
---

<div
	id="destination-quick-modal"
	class="pointer-events-none fixed inset-0 z-100 flex items-center justify-center overflow-y-auto bg-slate-950/80 p-4 pt-20 pb-6 opacity-0 transition-opacity duration-300 sm:p-6 sm:pt-24"
	data-lenis-prevent
	aria-modal="true"
	role="dialog"
	aria-label="Destination Quick View Highlights"
	aria-labelledby="modal-title"
>
	<div
		id="destination-modal-container"
		class="border-gold/40 relative my-auto max-h-[calc(100vh-140px)] w-full max-w-xl scale-95 transform space-y-5 overflow-y-auto rounded-lg border bg-[#0e1622] p-6 text-white shadow-2xl transition-all sm:p-8"
	>
		<!-- Close Button -->
		<button
			id="close-dest-modal-btn"
			type="button"
			aria-label="Close Modal"
			class="hover:text-gold absolute top-4 right-4 cursor-pointer p-2 text-white/60 transition-colors"
		>
			<svg
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>

		<!-- Modal Content Header -->
		<div class="space-y-2 border-b border-white/10 pr-6 pb-4">
			<div class="flex flex-wrap items-center gap-2 font-mono text-[11px]">
				<span
					id="modal-category"
					class="text-gold font-bold tracking-widest uppercase"></span>
				<span class="text-white/30">•</span>
				<span id="modal-country" class="font-semibold text-teal-400"></span>
				<span class="text-white/30">•</span>
				<span id="modal-rating" class="font-bold text-amber-300"></span>
			</div>

			<h2
				id="modal-title"
				class="font-serif text-2xl leading-snug font-bold tracking-tight text-white uppercase sm:text-3xl"
			>
			</h2>
		</div>

		<!-- Quick Specs Metadata Ribbon -->
		<div
			class="grid grid-cols-3 gap-2 rounded border border-white/10 bg-[#142030] p-3 text-center font-mono text-xs"
		>
			<div>
				<span class="block text-[9px] tracking-widest text-white/40 uppercase"
					>Duration</span
				>
				<span id="modal-duration" class="text-gold font-bold"></span>
			</div>
			<div class="border-x border-white/10">
				<span class="block text-[9px] tracking-widest text-white/40 uppercase"
					>Capacity</span
				>
				<span id="modal-capacity" class="font-bold text-teal-400"></span>
			</div>
			<div>
				<span class="block text-[9px] tracking-widest text-white/40 uppercase"
					>Price</span
				>
				<span id="modal-price-top" class="font-extrabold text-amber-300"></span>
			</div>
		</div>

		<!-- Highlights Only Section -->
		<div
			class="space-y-4 font-sans text-xs leading-relaxed text-slate-300 sm:text-sm"
		>
			<p id="modal-overview" class="line-clamp-3 font-light text-white/80"></p>

			<div class="space-y-2.5 border-t border-white/10 pt-3">
				<span
					class="block font-mono text-[10px] font-bold tracking-widest text-teal-400 uppercase"
				>
					✦ Tour Package Highlights
				</span>
				<div id="modal-highlights-list" class="space-y-2 text-xs"></div>
			</div>
		</div>

		<!-- Price & Action Footer -->
		<div
			class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-5 sm:flex-row"
		>
			<div>
				<span
					class="block font-mono text-[9px] font-bold tracking-widest text-white/40 uppercase"
					>Investment</span
				>
				<div class="flex items-baseline gap-1 font-mono">
					<span id="modal-price" class="text-gold text-2xl font-extrabold"
					></span>
					<span class="text-xs text-white/50">/ person</span>
				</div>
			</div>

			<div class="flex w-full items-center gap-2.5 sm:w-auto">
				<a
					id="modal-wa-btn"
					href="#"
					target="_blank"
					rel="noopener noreferrer"
					class="bg-gold hover:bg-gold-light inline-flex flex-1 items-center justify-center gap-2 px-5 py-3 font-mono text-xs font-bold tracking-widest text-slate-950 uppercase shadow-lg transition-all sm:flex-none"
				>
					<span>💬 Inquiry</span>
				</a>
				<a
					id="modal-detail-link"
					href="#"
					class="hover:border-gold inline-flex flex-1 items-center justify-center gap-2 border border-white/20 px-5 py-3 font-mono text-xs font-bold tracking-tight text-white uppercase transition-all sm:flex-none"
				>
					<span>View Details →</span>
				</a>
			</div>
		</div>
	</div>
</div>

<script>
	function initDestinationModal() {
		const modal = document.getElementById("destination-quick-modal");
		const container = document.getElementById("destination-modal-container");
		const closeBtn = document.getElementById("close-dest-modal-btn");

		if (!modal || !container || !closeBtn) return;

		const modalEl = modal;
		const containerEl = container;
		// const closeBtnEl = closeBtn;

		function closeModal() {
			modalEl.classList.add("opacity-0", "pointer-events-none");
			modalEl.classList.remove("opacity-100");
			containerEl.classList.add("scale-95");
			containerEl.classList.remove("scale-100");
			document.body.style.overflow = "";
		}

		closeBtn.addEventListener("click", closeModal);
		modal.addEventListener("click", (e) => {
			if (e.target === modal) closeModal();
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeModal();
		});

		window.addEventListener("wanderlust:opendestmodal", (e: any) => {
			const data = e.detail;
			if (!data) return;

			const lang =
				(localStorage.getItem("wanderlust_lang") as "id" | "en") || "en";

			const catEl = document.getElementById("modal-category");
			const countryEl = document.getElementById("modal-country");
			const ratingEl = document.getElementById("modal-rating");
			const titleEl = document.getElementById("modal-title");
			const durationEl = document.getElementById("modal-duration");
			const capacityEl = document.getElementById("modal-capacity");
			const priceTopEl = document.getElementById("modal-price-top");
			const overviewEl = document.getElementById("modal-overview");
			const highlightsList = document.getElementById("modal-highlights-list");
			const priceEl = document.getElementById("modal-price");
			const waBtn = document.getElementById(
				"modal-wa-btn",
			) as HTMLAnchorElement | null;
			const detailLink = document.getElementById(
				"modal-detail-link",
			) as HTMLAnchorElement | null;

			if (catEl)
				catEl.textContent =
					lang === "id" ? data.category_id || data.category : data.category;
			if (countryEl)
				countryEl.textContent =
					lang === "id" ? data.country_id || data.country : data.country;
			if (ratingEl) ratingEl.textContent = `★ ${data.rating}`;
			if (titleEl)
				titleEl.textContent =
					lang === "id" ? data.title_id || data.title : data.title;
			if (durationEl)
				durationEl.textContent =
					lang === "id" ? data.duration_id || data.duration : data.duration;
			if (capacityEl)
				capacityEl.textContent =
					lang === "id" ? data.groupSize_id || data.groupSize : data.groupSize;
			if (priceTopEl) priceTopEl.textContent = data.price;
			if (overviewEl)
				overviewEl.textContent =
					lang === "id" ? data.overview_id || data.overview : data.overview;

			if (highlightsList) {
				const hls =
					(lang === "id" ? data.highlights_id : data.highlights) ||
					data.highlights ||
					[];
				highlightsList.innerHTML = hls
					.map(
						(h: string) =>
							`<div class="flex items-start gap-2 text-slate-200"><span class="text-gold font-bold shrink-0 mt-0.5">✦</span><span>${h}</span></div>`,
					)
					.join("");
			}

			if (priceEl) priceEl.textContent = data.price;

			if (waBtn) {
				const msg = `Hello Wanderlust Concierge, I would like to inquire about ${data.title} (${data.price}). Please share details.`;
				waBtn.href = `https://wa.me/6281234567890?text=${encodeURIComponent(msg)}`;
			}

			if (detailLink) {
				detailLink.href = `/destinations/${data.slug}`;
			}

			modal.classList.remove("opacity-0", "pointer-events-none");
			modal.classList.add("opacity-100");
			container.classList.remove("scale-95");
			container.classList.add("scale-100");
			document.body.style.overflow = "hidden";
		});
	}

	document.addEventListener("DOMContentLoaded", initDestinationModal);
	document.addEventListener("astro:page-load", initDestinationModal);
</script>
