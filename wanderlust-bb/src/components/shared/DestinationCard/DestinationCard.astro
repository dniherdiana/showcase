---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	id?: number;
	slug?: string;
	title: string;
	title_id?: string;
	country: string;
	country_id?: string;
	region?: string;
	category: string;
	category_id?: string;
	hotelName?: string;
	hotelName_id?: string;
	hotelLocation?: string;
	hotelTier?: string;
	hotelTier_id?: string;
	hotelAmenities?: string[];
	hotelAmenities_id?: string[];
	price: string;
	rating: number;
	duration?: string;
	duration_id?: string;
	groupSize?: string;
	groupSize_id?: string;
	overview?: string;
	overview_id?: string;
	highlights?: string[];
	highlights_id?: string[];
	image: ImageMetadata;
	featured?: boolean;
}

const {
	slug = "amalfi-coast-sanctuary",
	title,
	title_id = title,
	country,
	country_id = country,
	region = "Europe",
	category,
	category_id = category,
	hotelName = title,
	hotelName_id = title_id,
	hotelLocation = country,
	hotelTier = "5-Star Luxury Resort",
	hotelTier_id = "Resor Mewah 5 Bintang",
	hotelAmenities = [],
	hotelAmenities_id = [],
	price,
	rating,
	duration = "5 Days / 4 Nights",
	duration_id = duration,
	groupSize = "Private Escorted",
	groupSize_id = groupSize,
	overview = "",
	overview_id = "",
	highlights = [],
	highlights_id = [],
	image,
	featured = false,
} = Astro.props;

const cardJson = JSON.stringify({
	slug,
	title,
	title_id,
	country,
	country_id,
	region,
	category,
	category_id,
	hotelName,
	hotelName_id,
	hotelLocation,
	hotelTier,
	hotelTier_id,
	hotelAmenities,
	hotelAmenities_id,
	price,
	rating,
	duration,
	duration_id,
	groupSize,
	groupSize_id,
	overview,
	overview_id,
	highlights,
	highlights_id,
});
---

<!-- Cinematic Fluid Magazine Editorial Destination Item -->
<div
	data-destination-category={category}
	data-destination-region={region}
	data-destination-title={title.toLowerCase()}
	data-destination-country={country.toLowerCase()}
	data-destination-json={cardJson}
	class="destination-card-item story-scroll-item group hover:border-gold/60 relative flex flex-col justify-between overflow-hidden border-b border-white/10 bg-transparent pb-6 transition-all duration-500 hover:-translate-y-1"
>
	<!-- Top Gold Hairline Accent -->
	<div
		class="from-gold/60 absolute top-0 right-0 left-0 z-20 h-px bg-linear-to-r via-amber-300/40 to-transparent opacity-40 transition-opacity group-hover:opacity-100"
	>
	</div>

	<div>
		<a
			href={`/destinations/${slug}`}
			class="relative block aspect-4/3 w-full overflow-hidden rounded-lg bg-slate-950"
		>
			<Image
				src={image}
				alt={title}
				widths={[360, 640, 800]}
				sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
				quality={75}
				format="webp"
				class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
				loading="lazy"
				decoding="async"
			/>
			<!-- Cinematic Vignette -->
			<div
				class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/20 to-transparent opacity-90"
			>
			</div>

			<!-- Top Editorial Metadata (No Pill Badges) -->
			<div class="absolute top-4 left-4 z-10 flex flex-wrap items-center gap-3">
				<span
					data-i18n-en={category}
					data-i18n-id={category_id}
					class="text-gold bg-dark/60 rounded-b-lg p-1 font-mono text-[10px] font-bold tracking-[2px] uppercase drop-shadow-md"
				>
					— {category}
				</span>

				{
					featured && (
						<span
							data-i18n-en="Top Pick"
							data-i18n-id="Pilihan Utama"
							class="bg-dark/60 rounded-b-md border-l border-amber-300/40 p-1 pl-2.5 font-mono text-[10px] font-bold tracking-widest text-amber-300 uppercase"
						>
							✦ Top Pick
						</span>
					)
				}
			</div>

			<!-- Top Right Rating Metadata -->
			<div
				class="bg-dark/60 absolute top-4 right-4 z-10 flex items-center gap-1 rounded-b-lg p-1 font-mono text-xs font-bold text-amber-300"
			>
				<span>★</span>
				<span>{rating}</span>
			</div>

			<!-- Bottom Image Info Bar -->
			<div
				class="absolute right-4 bottom-3 left-4 z-10 flex items-center justify-between font-mono text-[11px]"
			>
				<span
					data-i18n-en={`📍 ${country}`}
					data-i18n-id={`📍 ${country_id}`}
					class="font-semibold text-white/90 drop-shadow-sm"
				>
					📍 {country}
				</span>

				<span
					data-i18n-en={`⏱ ${duration}`}
					data-i18n-id={`⏱ ${duration_id}`}
					class="text-gold font-bold drop-shadow-sm"
				>
					⏱ {duration}
				</span>
			</div>
		</a>

		<!-- Main Editorial Text Section -->
		<div class="space-y-4 px-1 pt-5">
			<!-- Serif Title -->
			<h3
				class="group-hover:text-gold line-clamp-1 font-serif text-xl leading-snug font-bold text-white transition-colors sm:text-2xl"
			>
				<a
					href={`/destinations/${slug}`}
					data-i18n-en={title}
					data-i18n-id={title_id}
				>
					{title}
				</a>
			</h3>

			<!-- Hotel Partner Subtitle -->
			<p
				class="line-clamp-1 flex items-center gap-1 font-mono text-xs text-teal-400/90"
			>
				<span>🏨</span>
				<span data-i18n-en={hotelName} data-i18n-id={hotelName_id}
					>{hotelName}</span
				>
			</p>

			<!-- Price & Group Capacity Row -->
			<div
				class="flex items-center justify-between border-b border-white/10 pb-3"
			>
				<div class="space-y-0.5">
					<span
						class="block font-mono text-[9px] tracking-widest text-white/40 uppercase"
						data-i18n-en="Starting From"
						data-i18n-id="Mulai Dari">Starting From</span
					>
					<div class="flex items-baseline gap-1 font-mono">
						<span class="text-gold text-xl font-extrabold">{price}</span>
						<span
							class="font-sans text-xs text-white/50"
							data-i18n-key="perPerson">/ person</span
						>
					</div>
				</div>

				<div class="space-y-0.5 text-right">
					<span
						class="block font-mono text-[9px] tracking-widest text-white/40 uppercase"
						data-i18n-en="Capacity"
						data-i18n-id="Kapasitas">Capacity</span
					>
					<span
						data-i18n-en={groupSize}
						data-i18n-id={groupSize_id}
						class="font-mono text-xs font-semibold text-teal-400"
					>
						{groupSize}
					</span>
				</div>
			</div>

			<!-- Highlights Preview -->
			{
				highlights && highlights.length > 0 && (
					<div class="space-y-2 pt-1">
						<span
							class="block font-mono text-[9px] font-bold tracking-widest text-teal-400 uppercase"
							data-i18n-en="Journey Highlights"
							data-i18n-id="Keunggulan Perjalanan"
						>
							Journey Highlights
						</span>
						<div class="space-y-1.5">
							{highlights.slice(0, 2).map((hItem, hIdx) => {
								const hItem_id = highlights_id?.[hIdx] || hItem;
								return (
									<div class="flex items-start gap-2 font-sans text-xs leading-tight text-slate-300">
										<span class="text-gold shrink-0 font-bold">✓</span>
										<span
											data-i18n-en={hItem}
											data-i18n-id={hItem_id}
											class="line-clamp-1 font-light"
										>
											{hItem}
										</span>
									</div>
								);
							})}
						</div>
					</div>
				)
			}
		</div>
	</div>

	<!-- Action Editorial Footer -->
	<div class="px-1 pt-4">
		<div
			class="flex items-center justify-between gap-3 border-t border-white/10 pt-3 text-xs"
		>
			<button
				type="button"
				class="dest-quick-view-btn flex cursor-pointer items-center gap-1.5 font-mono text-[11px] font-bold tracking-wider text-teal-400 uppercase transition-colors hover:text-white"
			>
				<span>🔍</span>
				<span data-i18n-en="View Highlights" data-i18n-id="Lihat Keunggulan"
					>View Highlights</span
				>
			</button>

			<a
				href={`/destinations/${slug}`}
				class="text-gold inline-flex items-center gap-2 font-mono text-xs font-bold tracking-widest uppercase transition-all group-hover:translate-x-1 hover:text-amber-200"
			>
				<span data-i18n-key="viewDetails">View Details</span>
				<span>→</span>
			</a>
		</div>
	</div>
</div>

<script>
	function initQuickViewTrigger() {
		const cards = document.querySelectorAll(".destination-card-item");
		cards.forEach((card) => {
			const btn = card.querySelector(".dest-quick-view-btn");
			if (!btn) return;

			btn.addEventListener("click", () => {
				const rawJson = card.getAttribute("data-destination-json");
				if (!rawJson) return;
				try {
					const data = JSON.parse(rawJson);
					window.dispatchEvent(
						new CustomEvent("wanderlust:opendestmodal", { detail: data }),
					);
				} catch (err) {
					console.error("Error parsing destination JSON", err);
				}
			});
		});
	}

	document.addEventListener("DOMContentLoaded", initQuickViewTrigger);
	document.addEventListener("astro:page-load", initQuickViewTrigger);
</script>
