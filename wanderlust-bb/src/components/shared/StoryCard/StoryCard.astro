---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	slug?: string;
	title: string;
	title_id?: string;
	author: string;
	readTime: string;
	date: string;
	category?: string;
	excerpt: string;
	excerpt_id?: string;
	image: ImageMetadata;
	horizontal?: boolean;
}

const {
	slug = "slow-travel-japan-tea-villages",
	title,
	title_id = title,
	author,
	readTime,
	date,
	category = "Cultural Heritage",
	excerpt,
	excerpt_id = excerpt,
	image,
	horizontal = false,
} = Astro.props;
---

<!-- Deep Obsidian Slate Editorial Story Card -->
<article data-story-category={category} class={`story-card-item story-scroll-item group border-b border-white/10 pb-8 transition-all duration-500 hover:border-gold/60 ${horizontal ? "flex flex-col sm:flex-row gap-6 items-start" : "flex flex-col gap-4"}`}>
	<!-- Editorial Image Frame -->
	<a href={`/stories/${slug}`} class={`overflow-hidden rounded-lg relative block w-full bg-slate-950 ${horizontal ? "sm:w-2/5 aspect-[16/10]" : "aspect-[16/10]"}`}>
		<Image
			src={image}
			alt={title}
			widths={[360, 640, 800]}
			sizes="(max-width: 768px) 100vw, 50vw"
			quality={75}
			format="webp"
			class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
			loading="lazy"
			decoding="async"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

		<!-- Editorial Category Tag (No Pill Badge) -->
		<span data-category-badge={category} class="absolute top-3 left-3 font-mono font-bold text-[10px] uppercase text-gold tracking-[2px] drop-shadow-md">
			— {category}
		</span>
	</a>

	<!-- Magazine Article Typography Section -->
	<div class={`w-full ${horizontal ? "sm:w-3/5 space-y-2" : "space-y-2"} flex flex-col justify-between`}>
		<div>
			<div class="flex items-center gap-2 text-xs font-mono text-white/50 tracking-wide">
				<span><span data-i18n-key="byAuthor">By</span> {author}</span>
				<span>•</span>
				<span>{readTime}</span>
				<span>•</span>
				<span class="text-gold">{date}</span>
			</div>

			<h3 class="font-serif text-xl sm:text-2xl font-bold text-white group-hover:text-gold transition-colors leading-snug mt-1">
				<a
					href={`/stories/${slug}`}
					data-i18n-en={title}
					data-i18n-id={title_id}
				>
					{title}
				</a>
			</h3>

			<p
				data-i18n-en={excerpt}
				data-i18n-id={excerpt_id}
				class="text-xs sm:text-sm text-slate-300 line-clamp-2 leading-relaxed font-sans font-light mt-2"
			>
				{excerpt}
			</p>
		</div>

		<div class="pt-3">
			<a
				href={`/stories/${slug}`}
				data-i18n-key="readStory"
				class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-gold hover:text-amber-200 group-hover:translate-x-1 transition-all"
			>
				Read Story →
			</a>
		</div>
	</div>
</article>
