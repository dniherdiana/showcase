---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  duration: string;
  groupSize: string;
  tag: string;
  description: string;
  image: ImageMetadata;
}

const { title, duration, groupSize, tag, description, image } = Astro.props;
---

<div class="story-scroll-item group relative flex flex-col justify-between overflow-hidden bg-transparent border-b border-white/10 pb-6 transition-all duration-500 hover:-translate-y-1 hover:border-gold/60">
  <div>
    <!-- Cover Image Frame -->
    <div class="relative h-64 w-full overflow-hidden rounded-lg bg-slate-950">
      <Image
        src={image}
        alt={title}
        widths={[360, 640, 800]}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
        quality={75}
        format="webp"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
      
      <!-- Top Left Editorial Tag (No Pill Badges) -->
      <span class="absolute top-4 left-4 font-mono text-[10px] font-bold uppercase tracking-[2px] text-gold drop-shadow-md">
        — {tag}
      </span>
    </div>

    <!-- Editorial Details -->
    <div class="pt-5 px-1 space-y-3">
      <div class="flex items-center gap-3 font-mono text-xs text-white/60">
        <span class="flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 16 14"></polyline></svg>
          {duration}
        </span>
        <span class="text-white/30">•</span>
        <span class="flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          {groupSize}
        </span>
      </div>

      <h3 class="font-serif text-2xl font-bold text-white group-hover:text-gold transition-colors leading-snug">
        {title}
      </h3>

      <p class="text-xs text-slate-300 line-clamp-2 leading-relaxed font-sans font-light">
        {description}
      </p>
    </div>
  </div>

  <div class="pt-5 px-1">
    <a
      href="/destinations"
      class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-gold hover:text-amber-200 group-hover:translate-x-1 transition-all"
    >
      Reserve Experience
      <span>→</span>
    </a>
  </div>
</div>
