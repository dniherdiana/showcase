---
import { Image } from "astro:assets";
import { featuredStoryData } from "../data/index.js";

interface Props {
	story?: typeof featuredStoryData;
}

const { story = featuredStoryData } = Astro.props;
---

<div data-story-category={story.category} class="story-card-item border-b border-white/15 pb-16 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center group story-scroll-item">
	<a href={`/stories/${story.slug}`} class="lg:col-span-7 aspect-[16/10] overflow-hidden rounded relative block">
		<Image
			src={story.image}
			alt={story.title}
			class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
			widths={[480, 768, 1024]}
			sizes="(min-width: 1024px) 700px, 100vw"
			quality={40}
			fetchpriority="high"
		/>
		<span data-category-badge={story.category} class="absolute top-4 left-4 bg-[#0A0F15]/90 text-[#0D9488] border border-[#0D9488]/40 font-mono font-bold text-[10px] uppercase px-3 py-1 rounded tracking-wider">
			{story.category}
		</span>
	</a>

	<div class="lg:col-span-5 space-y-4">
		<div class="flex items-center gap-3 text-xs text-white/50 font-sans tracking-wide">
			<span><span data-i18n-key="byAuthor">By</span> {story.author}</span>
			<span>•</span>
			<span>{story.readTime}</span>
			<span>•</span>
			<span class="text-gold font-mono">{story.date}</span>
		</div>

		<h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white leading-tight uppercase group-hover:text-gold transition-colors">
			<a href={`/stories/${story.slug}`} data-i18n-en={story.title} data-i18n-id={story.title_id}>
				{story.title}
			</a>
		</h2>

		<p data-i18n-en={story.excerpt} data-i18n-id={story.excerpt_id} class="text-base text-white/70 leading-relaxed font-sans font-normal">
			{story.excerpt}
		</p>

		<div class="pt-4 border-t border-white/10 flex items-center justify-between">
			<a
				href={`/stories/${story.slug}`}
				class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-gold hover:text-gold-light transition-colors"
			>
				<span data-i18n-key="readCoverStory">Read Cover Story</span>
				<span class="transition-transform group-hover:translate-x-1">→</span>
			</a>
			<span data-i18n-key="coverStoryBadge" class="text-[10px] font-mono text-white/40 uppercase">Cover Story</span>
		</div>
	</div>
</div>
