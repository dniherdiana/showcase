---
import { storiesData } from "../data/index.js";

interface Props {
	stories?: typeof storiesData;
}

const { stories = storiesData } = Astro.props;
const editorPicks = stories.slice(0, 3);
---

<aside class="lg:col-span-4 space-y-10 lg:pl-6 lg:border-l border-white/10">
	<!-- Editor's Picks List -->
	<div class="space-y-6">
		<h4 data-i18n-key="editorsPicks" class="font-heading text-base font-extrabold uppercase text-white border-b border-white/10 pb-3 tracking-wider">
			Editor's Picks
		</h4>

		<div class="space-y-6">
			{
				editorPicks.map((item, idx) => (
					<div class="border-b border-white/10 pb-5 space-y-2 group">
						<div class="flex items-center justify-between text-xs">
							<span class="font-mono font-bold text-gold">0{idx + 1}</span>
							<span data-category-badge={item.category} class="text-[10px] font-mono text-[#0D9488] uppercase">{item.category}</span>
						</div>
						<h5 class="font-heading text-sm font-bold text-white group-hover:text-gold transition-colors leading-snug">
							<a href={`/stories/${item.slug}`} data-i18n-en={item.title} data-i18n-id={item.title_id}>
								{item.title}
							</a>
						</h5>
						<p class="text-xs text-white/50 font-sans">{item.author} &bull; {item.readTime}</p>
					</div>
				))
			}
		</div>
	</div>

	<!-- Newsletter Dispatch Box (Magazine Minimal Style) -->
	<div class="border border-white/15 p-6 rounded space-y-4 bg-slate-950/60">
		<span data-i18n-key="privateClubBadge" class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#0D9488]">Private Club</span>
		<h4 data-i18n-key="weeklyDispatchTitle" class="font-heading text-lg font-bold uppercase text-white">Weekly Travel Dispatch</h4>
		<p data-i18n-key="weeklyDispatchDesc" class="text-xs text-white/60 leading-relaxed font-sans">
			Receive curated photo essays, hidden itineraries, and exclusive invitations directly in your inbox.
		</p>
		<div class="space-y-2 pt-1">
			<input
				type="email"
				data-i18n-key="emailPlaceholder"
				placeholder="Enter your email"
				class="w-full px-3 py-2 bg-white/5 border border-white/15 rounded text-xs text-white placeholder:text-white/40 focus:outline-none focus:border-gold transition-colors font-sans"
			/>
			<button
				type="button"
				data-i18n-key="subscribeBtn"
				class="w-full py-2.5 bg-gold text-slate-950 font-bold text-xs uppercase tracking-wider rounded hover:bg-gold-light transition-colors cursor-pointer"
			>
				Subscribe Dispatch
			</button>
		</div>
	</div>
</aside>
