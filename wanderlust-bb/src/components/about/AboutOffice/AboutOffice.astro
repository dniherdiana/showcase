---
import { aboutData } from "../data/index.js";
---

<div class="story-scroll-item space-y-8 border-t border-white/10 pt-16">
	<div class="mx-auto max-w-2xl space-y-3 text-center">
		<span
			class="font-mono text-xs font-bold tracking-widest text-[#0D9488] uppercase"
			data-i18n-en="Easy Access & Concierge Desk"
			data-i18n-id="Akses Mudah & Layanan Konsierge"
			>✦ Easy Access & Concierge Desk</span
		>
		<h2
			class="font-serif text-2xl font-bold text-white uppercase sm:text-4xl"
			data-i18n-key="aboutOfficeTitle"
		>
			Visit Our Private Lounge & HQ
		</h2>
		<p
			class="mx-auto max-w-lg font-sans text-xs text-slate-300"
			data-i18n-en="We welcome you to visit our private lounge in Jakarta for a relaxed face-to-face itinerary consultation over gourmet coffee."
			data-i18n-id="Kami menyambut Anda untuk berkunjung ke lounge privat kami di Jakarta untuk konsultasi tatap muka sambil menikmati kopi berkualitas."
		>
			We welcome you to visit our private lounge in Jakarta for a relaxed
			face-to-face itinerary consultation over gourmet coffee.
		</p>
	</div>

	<div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
		<!-- Left Office Address Details -->
		<div
			class="flex flex-col justify-between space-y-6 rounded-lg border border-white/10 bg-[#0c141f] p-8 shadow-lg lg:col-span-7"
		>
			<div class="space-y-4">
				<div
					class="flex items-center justify-between border-b border-white/10 pb-4"
				>
					<div class="space-y-1">
						<span
							class="text-gold font-mono text-[10px] font-bold tracking-widest uppercase"
							data-i18n-en="Headquarters & Private Lounge"
							data-i18n-id="Kantor Pusat & Lounge Privat"
							>Headquarters & Private Lounge</span
						>
						<h3
							class="font-serif text-xl font-bold text-white uppercase"
							data-i18n-en={aboutData.officeDetails.title}
							data-i18n-id={aboutData.officeDetails.title_id}
						>
							{aboutData.officeDetails.title}
						</h3>
					</div>
					<span
						class="border border-teal-400/30 px-2.5 py-1 font-mono text-[10px] font-bold text-teal-400 uppercase"
						data-i18n-en="OPEN FOR VISITORS"
						data-i18n-id="TERBUKA UNTUK KUNJUNGAN"
					>
						OPEN FOR VISITORS
					</span>
				</div>

				<div
					class="grid grid-cols-1 gap-6 pt-2 font-sans text-xs text-slate-300 sm:grid-cols-2"
				>
					<div class="space-y-1">
						<span
							class="block font-mono text-[10px] text-white/40 uppercase"
							data-i18n-en="Office Location"
							data-i18n-id="Lokasi Kantor">Office Location</span
						>
						<p class="leading-relaxed font-medium text-white">
							{aboutData.officeDetails.address}
						</p>
					</div>

					<div class="space-y-1">
						<span
							class="block font-mono text-[10px] text-white/40 uppercase"
							data-i18n-en="Lounge Hours & Emergency"
							data-i18n-id="Jam Lounge & Layanan Darurat"
							>Lounge Hours & Emergency</span
						>
						<p
							class="font-medium text-white"
							data-i18n-en={aboutData.officeDetails.hours}
							data-i18n-id={aboutData.officeDetails.hours_id}
						>
							{aboutData.officeDetails.hours}
						</p>
						<p
							class="text-gold pt-1 font-mono text-[11px]"
							data-i18n-en={aboutData.officeDetails.emergencyService}
							data-i18n-id={aboutData.officeDetails.emergencyService_id}
						>
							{aboutData.officeDetails.emergencyService}
						</p>
					</div>
				</div>
			</div>

			<!-- Quick Contact Action Bar -->
			<div
				class="grid grid-cols-1 gap-3 border-t border-white/10 pt-6 sm:grid-cols-3"
			>
				<a
					href={`tel:${aboutData.officeDetails.phoneRaw}`}
					class="flex items-center justify-center gap-2 rounded-none border border-white/15 bg-white/10 px-4 py-3 font-mono text-xs font-bold tracking-wider text-white uppercase transition-colors hover:bg-white/20"
				>
					<svg
						class="text-gold h-4 w-4 shrink-0"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
						></path>
					</svg>
					<span data-i18n-en="Office Phone" data-i18n-id="Telepon Kantor"
						>Office Phone</span
					>
				</a>

				<a
					href={`https://wa.me/${aboutData.officeDetails.whatsappNumber}?text=${encodeURIComponent("Hello Wanderlust, I would like to schedule a visit to your Jakarta Concierge Lounge.")}`}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center gap-2 rounded-none bg-teal-600 px-4 py-3 font-mono text-xs font-bold tracking-wider text-white uppercase transition-colors hover:bg-teal-500"
				>
					<span>💬</span>
					<span data-i18n-en="WhatsApp VIP" data-i18n-id="WhatsApp VIP"
						>WhatsApp VIP</span
					>
				</a>

				<a
					href={aboutData.officeDetails.googleMapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="bg-gold hover:bg-gold-light flex items-center justify-center gap-2 rounded-none px-4 py-3 font-mono text-xs font-bold tracking-wider text-slate-950 uppercase transition-colors"
				>
					<span>📍</span>
					<span data-i18n-en="Google Maps" data-i18n-id="Google Maps"
						>Google Maps</span
					>
				</a>
			</div>
		</div>

		<!-- Right Fast Assistance Card -->
		<div
			class="flex flex-col justify-between space-y-6 rounded-lg border border-white/10 bg-[#0c141f] p-8 lg:col-span-5"
		>
			<div class="space-y-4">
				<span
					class="font-mono text-[10px] font-bold tracking-widest text-[#0D9488] uppercase"
					data-i18n-en="24/7 Guest Care Desk"
					data-i18n-id="Layanan Tamu 24/7">24/7 Guest Care Desk</span
				>
				<h3
					class="font-serif text-xl font-bold text-white uppercase"
					data-i18n-en="Direct Contact Channels"
					data-i18n-id="Saluran Kontak Langsung"
				>
					Direct Contact Channels
				</h3>
				<p
					class="font-sans text-xs leading-relaxed text-slate-300"
					data-i18n-en="Whether you need an immediate booking inquiry, a custom itinerary revision, or active trip assistance, our team is reachable through multiple channels."
					data-i18n-id="Baik Anda membutuhkan informasi pemesanan cepat, revisi jadwal perjalanan kustom, atau bantuan saat liburan, tim kami siap dihubungi melalui berbagai saluran."
				>
					Whether you need an immediate booking inquiry, a custom itinerary
					revision, or active trip assistance, our team is reachable through
					multiple channels.
				</p>

				<div class="space-y-3 pt-2 font-sans text-xs">
					<div
						class="flex items-center justify-between border border-white/10 bg-white/5 p-3"
					>
						<span
							class="text-white/50"
							data-i18n-en="Office Line :"
							data-i18n-id="Telepon Kantor:">Office Line :</span
						>
						<span class="font-mono font-bold text-white"
							>{aboutData.officeDetails.phone}</span
						>
					</div>

					<div
						class="flex items-center justify-between border border-white/10 bg-white/5 p-3"
					>
						<span
							class="text-white/50"
							data-i18n-en="Concierge WhatsApp:"
							data-i18n-id="WhatsApp Konsierge:">Concierge WhatsApp:</span
						>
						<span class="font-mono font-bold text-teal-400"
							>{aboutData.officeDetails.conciergeHotline}</span
						>
					</div>

					<div
						class="flex items-center justify-between border border-white/10 bg-white/5 p-3"
					>
						<span
							class="text-white/50"
							data-i18n-en="Official Email:"
							data-i18n-id="Email Resmi:">Official Email:</span
						>
						<span class="text-gold font-mono font-bold"
							>{aboutData.officeDetails.email}</span
						>
					</div>
				</div>
			</div>

			<p
				class="pt-2 text-center font-mono text-[10px] text-white/40"
				data-i18n-en="No complex phone menus • Direct connection to senior travel specialists"
				data-i18n-id="Tanpa menu telepon rumit • Terhubung langsung dengan spesialis perjalanan senior"
			>
				No complex phone menus • Direct connection to senior travel specialists
			</p>
		</div>
	</div>
</div>
