---
import { faqData } from "../data/index.js";
---

<div class="space-y-10 story-scroll-item border-t border-white/10 pt-16">
	<div class="text-center max-w-2xl mx-auto space-y-3">
		<span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0D9488]" data-i18n-key="aboutFaqBadge">
			Frequently Asked Questions
		</span>
		<h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white uppercase" data-i18n-key="aboutFaqTitle">
			Real-World Travel Assistance & Clarity
		</h2>
		<p class="text-xs text-white/60 font-sans max-w-lg mx-auto leading-relaxed" data-i18n-key="aboutFaqSubtitle">
			Clear answers to real-world travel situations, visas, safety, flight changes, and personalized care.
		</p>
	</div>

	<div class="max-w-4xl mx-auto space-y-4">
		{
			faqData.map((item, idx) => (
				<details class="faq-item group rounded-xl glass-card border border-white/15 overflow-hidden transition-all duration-300 open:border-gold/60 open:bg-slate-900/95 open:shadow-2xl open:shadow-gold/10">
					<summary class="flex items-center justify-between p-6 cursor-pointer select-none text-left gap-4 list-none [&::-webkit-details-marker]:hidden group-hover:bg-white/[0.02] transition-colors">
						<div class="flex items-center gap-4 sm:gap-5">
							<!-- Icon Indicator Circle -->
							<div class="w-10 h-10 rounded-full bg-slate-900 border border-gold/40 text-gold flex items-center justify-center flex-shrink-0 shadow-md group-open:bg-gold group-open:text-slate-950 transition-colors">
								{idx === 0 && (
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
									</svg>
								)}
								{idx === 1 && (
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								)}
								{idx === 2 && (
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
									</svg>
								)}
								{idx === 3 && (
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
									</svg>
								)}
								{idx === 4 && (
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V55a2 2 0 002 2h2a2 2 0 002-2M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								)}
							</div>

							<div>
								<div class="flex items-center gap-2 flex-wrap mb-1">
									<span
										data-i18n-en={item.category}
										data-i18n-id={item.category_id}
										class="text-[10px] font-mono text-[#0D9488] uppercase tracking-wider font-semibold"
									>
										{item.category}
									</span>
									<span class="text-white/20">•</span>
									<span
										data-i18n-en={item.badge}
										data-i18n-id={item.badge_id}
										class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-gold/10 text-gold border border-gold/30 font-semibold"
									>
										{item.badge}
									</span>
								</div>
								<h3
									data-i18n-en={item.question}
									data-i18n-id={item.question_id}
									class="font-heading text-base sm:text-lg font-bold text-white group-hover:text-gold transition-colors leading-snug"
								>
									{item.question}
								</h3>
							</div>
						</div>

						<div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/70 group-open:rotate-180 group-open:bg-gold/20 group-open:border-gold/40 group-open:text-gold transition-all duration-300 flex-shrink-0">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</div>
					</summary>

					<div class="px-6 pb-6 pt-3 border-t border-white/10 text-xs sm:text-sm text-white/80 font-sans leading-relaxed font-light pl-6 sm:pl-20 space-y-3">
						<p data-i18n-en={item.answer} data-i18n-id={item.answer_id}>
							{item.answer}
						</p>

						<div class="pt-2 flex items-center gap-2 text-[11px] text-gold font-mono font-semibold">
							<span>✓</span>
							<span data-i18n-en={`Verified policy for: ${item.category}`} data-i18n-id={`Jaminan layanan resmi: ${item.category_id}`}>
								Verified policy for: {item.category}
							</span>
						</div>
					</div>
				</details>
			))
		}
	</div>
</div>
