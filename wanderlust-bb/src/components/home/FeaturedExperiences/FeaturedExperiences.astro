---
import ExperienceCard from "../../shared/ExperienceCard/ExperienceCard.astro";
import { experiencesData } from "./data.js";
import type { ImageMetadata } from "astro";

interface Props {
	badge?: string;
	title?: string;
	actionText?: string;
	actionHref?: string;
}

interface Experience {
	title: string;
	duration: string;
	groupSize: string;
	tag: string;
	description: string;
	image: ImageMetadata;
	featured?: boolean;
}

const {
	badge = "Unrivaled Expeditions",
	title = "Signature Experiences",
	actionText = "View All Experiences",
	actionHref = "/destinations",
} = Astro.props;

const featuredExperiences = experiencesData.filter(
	(e: Experience) => e.featured,
) as Experience[];
---

<section
	class="mx-auto max-w-7xl space-y-12 border-t border-white/10 px-[5%] py-20"
>
	<div
		class="story-scroll-item flex flex-col justify-between gap-4 border-b border-white/10 pb-6 md:flex-row md:items-end"
	>
		<div class="space-y-2">
			<h2
				class="font-serif text-3xl font-extrabold tracking-tight text-white uppercase sm:text-5xl"
			>
				{badge}
			</h2>
		</div>
		<a
			href={actionHref}
			class="text-gold inline-flex items-center gap-2 font-mono text-xs font-bold tracking-widest uppercase transition-colors hover:text-amber-200"
		>
			{actionText}
			<span>→</span>
		</a>
	</div>

	<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
		{featuredExperiences.map((exp: Experience) => <ExperienceCard {...exp} />)}
	</div>
</section>
