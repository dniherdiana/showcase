---
import { statsData } from "./data.js";
---

<section class="relative z-10 w-full py-16 px-[5%] bg-[#0c141f]/90 border-y border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-12 relative z-10">
    <!-- Header -->
    <div class="text-center">
      <h2
        class="font-serif text-2xl sm:text-3xl font-extrabold text-white tracking-tight"
        data-i18n-en="Why Choose Us?"
        data-i18n-id="Kenapa Harus Kami?"
      >
        Why Choose Us?
      </h2>
    </div>

    <!-- Unified Responsive Timeline (Single Code Block) -->
    <div class="relative pt-4 pb-4">
      <!-- Horizontal Timeline Track Line for Desktop -->
      <div class="hidden md:block absolute top-12 left-[10%] right-[10%] h-0.5 bg-linear-to-r from-gold/30 via-amber-400/60 to-teal-400/30 z-0"></div>

      <!-- Single Unified Grid Loop -->
      <ul class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8 relative z-10 list-none">
        {
          statsData.map((stat, idx) => (
            <li class="group flex flex-row md:flex-col items-start md:items-center text-left md:text-center gap-5 md:gap-3 relative">
              <!-- Timeline Node Icon Circle -->
              <div class="relative shrink-0 flex items-center justify-center">
                <!-- Vertical Line Connector to Next Item for Mobile (NOT rendered on last index) -->
                {idx < statsData.length - 1 && (
                  <div class="md:hidden absolute top-14 left-1/2 -translate-x-1/2 w-0.5 h-[calc(100%+2.5rem)] bg-linear-to-b from-gold/50 via-amber-400/50 to-teal-400/30 z-0 pointer-events-none"></div>
                )}

                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#142030] border-2 border-gold/70 group-hover:border-gold flex items-center justify-center shadow-lg group-hover:scale-110 transition-all duration-300 z-10 relative">
                  {stat.icon === "globe" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7 text-gold">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                      <path d="M2 12h20"/>
                    </svg>
                  )}
                  {stat.icon === "compass" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7 text-gold">
                      <circle cx="12" cy="12" r="10"/>
                      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                    </svg>
                  )}
                  {stat.icon === "users" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7 text-gold">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                  {stat.icon === "star" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 sm:w-7 sm:h-7 text-gold">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  )}
                </div>
              </div>

              <!-- Node Content -->
              <div class="flex flex-col items-start md:items-center text-left md:text-center space-y-1.5 pt-0.5 md:pt-1 max-w-xs md:mx-auto">
                <span class="font-serif text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-gold via-amber-200 to-amber-400 block group-hover:scale-105 transition-transform">
                  {stat.value}
                </span>

                <h3
                  class="font-heading text-sm font-extrabold text-white uppercase tracking-wider group-hover:text-gold transition-colors"
                  data-i18n-en={stat.label}
                  data-i18n-id={stat.label_id}
                >
                  {stat.label}
                </h3>

                {stat.desc && (
                  <p
                    class="text-xs text-slate-300 font-sans leading-relaxed font-light"
                    data-i18n-en={stat.desc}
                    data-i18n-id={stat.desc_id}
                  >
                    {stat.desc}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
