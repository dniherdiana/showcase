	<!-- Fullscreen Lightbox Zoom Modal -->
	<div
		id="gallery-lightbox-modal"
		class="pointer-events-none fixed inset-0 z-100 flex items-center justify-center bg-slate-950/98 p-4 opacity-0 transition-all duration-300 sm:p-8"
	>
