---
import Layout from "../../layouts/Layout.astro";
import DestinationCard from "../../components/shared/DestinationCard/DestinationCard.astro";
import BookingBanner from "../../components/shared/BookingBanner/BookingBanner.astro";
import { Image, getImage } from "astro:assets";
import { destinationsData } from "../../components/destinations/data/index.js";
import { siteConfig } from "../../components/layout/site.config.js";

export async function getStaticPaths() {
	return destinationsData.map((dest) => ({
		params: { slug: dest.slug },
		props: { destination: dest },
	}));
}

const { destination } = Astro.props;
const galleryImages = destination.gallery || [destination.image];
const galleryFull = await Promise.all(
	galleryImages.map((img) =>
		getImage({ src: img, width: 1600, format: "webp", quality: 60 }),
	),
);

const galleryPreviews = await Promise.all(
	galleryImages.map((img) =>
		getImage({ src: img, width: 1024, format: "webp", quality: 40 }),
	),
);

const heroPreload = await getImage({
	src: destination.image,
	width: 1024,
	format: "webp",
	quality: 15,
});
const relatedDestinations = destinationsData
	.filter((d) => d.slug !== destination.slug)
	.slice(0, 3);

// Default Pre-filled Email Subject & Body for Booking Inquiry
const emailSubject = `Inquiry / Booking Request: ${destination.title} Package (${destination.price})`;
const emailBody = `Hello Wanderlust Concierge Team,

I would like to inquire about booking the following luxury travel package:

- Package Name: ${destination.title}
- Destination Country: ${destination.country}
- Category: ${destination.category}
- Duration: ${destination.duration}
- Group Size: ${destination.groupSize}
- Price: ${destination.price} / person

Please contact me back with available travel dates, custom options, and detailed pricing.

Thank you!`;

const mailtoUrl = `mailto:${siteConfig.contactEmail}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello Wanderlust, I would like to inquire about booking the ${destination.title} package (${destination.price}).`)}`;
const customWhatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello Wanderlust Concierge, I love the ${destination.title} package, but I would like to request a customized tailor-made itinerary (custom travel dates, extra nights, or private luxury add-ons).`)}`;
const telUrl = `tel:${siteConfig.contactPhoneRaw}`;
---

<Layout
	title={`${destination.title} Tour Package — Wanderlust`}
	currentPath="/destinations"
>
	<Fragment slot="head">
		<link
			rel="preload"
			as="image"
			href={heroPreload.src}
			fetchpriority="high"
			type="image/webp"
		/>
	</Fragment>

	<!-- Hero Banner -->
	<div class="relative h-[82vh] min-h-135 w-full overflow-hidden bg-slate-950">
		<!-- Cinematic Background Image -->
		<div class="absolute inset-0 z-0">
			<Image
				src={destination.image}
				alt={destination.title}
				class="hero-kenburns h-full w-full object-cover object-center"
				widths={[480, 768, 1024]}
				sizes="100vw"
				quality={15}
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
			<!-- Magazine Vignette Layers -->
			<div
				class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/40 to-slate-950/20"
			>
			</div>
			<div
				class="absolute inset-0 bg-linear-to-r from-slate-950/80 via-slate-950/25 to-transparent"
			>
			</div>
			<div
				class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgba(8,12,20,0.65)_100%)]"
			>
			</div>
		</div>

		<!-- Editorial Content -->
		<div
			class="relative z-10 mx-auto flex h-full w-full max-w-7xl items-end px-[5%] pt-28 pb-14 sm:pb-16"
		>
			<div class="w-full max-w-4xl space-y-7">
				<!-- Breadcrumb / Kicker -->
				<div
					class="story-scroll-item flex flex-wrap items-center gap-3 font-mono text-[11px] font-bold tracking-[3px] uppercase"
				>
					<a
						href="/destinations"
						class="hover:text-gold text-white/60 transition-colors"
						>← All Destinations</a
					>
					<span class="bg-gold/50 h-px w-8"></span>
					<span
						class="text-gold"
						data-i18n-en={destination.category}
						data-i18n-id={destination.category_id || destination.category}
						>{destination.category}</span
					>
				</div>

				<!-- Editorial Title -->
				<h1
					data-i18n-en={destination.title}
					data-i18n-id={destination.title_id || destination.title}
					class="travel-soul-heading max-w-3xl text-4xl leading-[1.08] font-bold uppercase sm:text-5xl lg:text-6xl"
				>
					{destination.title}
				</h1>

				<!-- Quick Facts Stat Strip -->
				<div class="story-scroll-item" style="transition-delay: 240ms">
					<div
						class="inline-flex flex-wrap items-center gap-x-8 gap-y-3 rounded-xl border border-white/15 bg-slate-950/60 px-5 py-3.5 backdrop-blur-md"
					>
						<div class="space-y-0.5">
							<span
								class="block font-mono text-[9px] tracking-widest text-white/45 uppercase"
								>Traveler Rating</span
							>
							<span class="font-mono text-sm font-bold text-amber-300"
								>★ {destination.rating} / 5.0</span
							>
						</div>
						<div class="hidden h-9 w-px bg-white/10 sm:block"></div>
						<div class="space-y-0.5">
							<span
								class="block font-mono text-[9px] tracking-widest text-white/45 uppercase"
								data-i18n-en="Duration"
								data-i18n-id="Durasi">Duration</span
							>
							<span
								class="font-mono text-sm font-semibold text-white"
								data-i18n-en={destination.duration}
								data-i18n-id={destination.duration_id || destination.duration}
								>{destination.duration}</span
							>
						</div>
						<div class="hidden h-9 w-px bg-white/10 sm:block"></div>
						<div class="space-y-0.5">
							<span
								class="block font-mono text-[9px] tracking-widest text-white/45 uppercase"
								data-i18n-en="Group Size"
								data-i18n-id="Jumlah Peserta">Group Size</span
							>
							<span
								class="font-mono text-sm font-semibold text-white"
								data-i18n-en={destination.groupSize}
								data-i18n-id={destination.groupSize_id || destination.groupSize}
								>{destination.groupSize}</span
							>
						</div>
						<div class="hidden h-9 w-px bg-white/10 sm:block"></div>
						<div class="space-y-0.5">
							<span
								class="block font-mono text-[9px] tracking-widest text-white/45 uppercase"
								data-i18n-en="Starting From"
								data-i18n-id="Mulai Dari">Starting From</span
							>
							<span class="text-gold font-mono text-base font-extrabold">
								{destination.price}
								<span
									class="text-[11px] font-normal text-white/50"
									data-i18n-key="perPerson">/ person</span
								>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Main Package Detail Content Spread -->
	<div
		class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-12 px-[5%] py-16 lg:grid-cols-12"
	>
		<!-- Left Main Content Column (8 Columns) -->
		<div class="space-y-12 lg:col-span-8">
			<!-- Overview Section -->
			<section class="story-scroll-item space-y-4">
				<span
					class="font-mono text-xs font-bold tracking-widest text-[#0D9488] uppercase"
					data-i18n-key="packageOverview"
				>
					Package Overview
				</span>
				<h2
					class="font-heading text-2xl font-extrabold text-white uppercase sm:text-3xl"
					data-i18n-key="packageOverview"
				>
					About The Journey
				</h2>
				<p
					data-i18n-en={destination.overview}
					data-i18n-id={destination.overview_id || destination.overview}
					class="font-sans text-base leading-relaxed font-light text-white/80"
				>
					{destination.overview}
				</p>
			</section>

			<!-- Luxury Hotel & Sanctuary Partner Specs Section -->
			{
				destination.hotelName && (
					<section class="border-gold/40 story-scroll-item space-y-5 rounded-lg border bg-[#142030] p-6 shadow-xl sm:p-8">
						<div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-4">
							<div class="space-y-1">
								<span
									class="text-gold block font-mono text-[10px] font-bold tracking-widest uppercase"
									data-i18n-en="✦ Exclusive Luxury Accommodation Partner"
									data-i18n-id="✦ Partner Hotel & Resor Mewah Eksklusif"
								>
									✦ Exclusive Luxury Accommodation Partner
								</span>
								<h3
									data-i18n-en={destination.hotelName}
									data-i18n-id={
										destination.hotelName_id || destination.hotelName
									}
									class="font-serif text-xl font-bold text-white sm:text-2xl"
								>
									{destination.hotelName}
								</h3>
							</div>
							<span
								data-i18n-en={destination.hotelTier}
								data-i18n-id={destination.hotelTier_id || destination.hotelTier}
								class="border border-teal-400/40 bg-slate-950/60 px-3 py-1 font-mono text-xs font-bold text-teal-400"
							>
								{destination.hotelTier}
							</span>
						</div>

						<div class="space-y-2">
							<span
								class="block font-mono text-[10px] font-bold tracking-widest text-white/50 uppercase"
								data-i18n-en="Hotel Location & Setting"
								data-i18n-id="Lokasi & Suasana Resor"
							>
								Hotel Location & Setting
							</span>
							<p class="flex items-center gap-2 font-sans text-sm text-white/90">
								<span>📍</span>
								<span
									data-i18n-en={
										destination.hotelLocation || destination.country
									}
									data-i18n-id={
										destination.hotelLocation || destination.country
									}
								>
									{destination.hotelLocation || destination.country}
								</span>
							</p>
						</div>

						{destination.hotelAmenities &&
							destination.hotelAmenities.length > 0 && (
								<div class="space-y-3 border-t border-white/10 pt-3">
									<span
										class="block font-mono text-[10px] font-bold tracking-widest text-teal-400 uppercase"
										data-i18n-en="Included VIP Guest Amenities & Features"
										data-i18n-id="Fasilitas Mewah & Layanan VIP"
									>
										Included VIP Guest Amenities & Features
									</span>
									<div class="grid grid-cols-1 gap-3 font-sans text-xs text-slate-200 sm:grid-cols-2">
										{destination.hotelAmenities.map((am, amIdx) => {
											const am_id =
												destination.hotelAmenities_id?.[amIdx] || am;
											return (
												<div class="flex items-center gap-2.5 rounded border border-white/10 bg-slate-950/60 p-2.5">
													<span class="text-gold font-bold">✓</span>
													<span data-i18n-en={am} data-i18n-id={am_id}>
														{am}
													</span>
												</div>
											);
										})}
									</div>
								</div>
							)}
					</section>
				)
			}

			<!-- Photo Gallery Carousel & Lightbox Zoom Trigger Section -->
			<section
				class="story-scroll-item space-y-4 border-t border-white/10 pt-10"
			>
				<div class="flex items-center justify-between">
					<div>
						<h2
							class="font-mono text-xs font-bold tracking-widest text-[#0D9488] uppercase"
							data-i18n-en="Visual Gallery"
							data-i18n-id="Galeri Foto Destinasi"
						>
							Visual Gallery
						</h2>
					</div>
				</div>

				<!-- Main Preview Image Container -->
				<div
					id="open-lightbox-trigger"
					class="glass-card group relative aspect-video w-full cursor-pointer overflow-hidden rounded-lg border border-white/20"
				>
					<Image
						id="main-gallery-preview"
						src={galleryImages[0]}
						alt={`${destination.title} Gallery`}
						widths={[480, 768, 1024]}
						sizes="(min-width: 1024px) 720px, 100vw"
						quality={80}
						class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
					/>
					<div
						class="absolute inset-0 flex items-center justify-center bg-slate-950/30 opacity-0 transition-opacity group-hover:opacity-100"
					>
						<span
							class="text-gold border-gold/40 rounded-full border bg-slate-900/90 px-4 py-2 font-mono text-xs font-bold tracking-wider shadow-xl"
							data-i18n-en="🔍 Click to Zoom Fullscreen"
							data-i18n-id="🔍 Klik untuk Memperbesar Layar Penuh"
						>
							🔍 Click to Zoom Fullscreen
						</span>
					</div>
				</div>

				<!-- Thumbnails Navigation Bar -->
				<ul class="grid list-none grid-cols-4 gap-3 pt-2">
					{
						galleryImages.map((img, idx) => (
							<li>
								<button
									type="button"
									data-gallery-idx={idx}
									data-gallery-preview={galleryPreviews[idx].src}
									data-gallery-full={galleryFull[idx].src}
									class={`gallery-thumb-btn relative aspect-16/10 cursor-pointer overflow-hidden rounded border-2 transition-all ${
										idx === 0 ?
											"border-gold scale-[1.02]"
										:	"border-white/10 opacity-70 hover:opacity-100"
									}`}
								>
									<Image
										src={img}
										alt={`Gallery photo ${idx + 1}`}
										widths={[240, 480, 720]}
										sizes="140px"
										quality={30}
										class="h-full w-full object-cover"
									/>
								</button>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Highlights Grid Section -->
			<section
				class="story-scroll-item space-y-6 border-t border-white/10 pt-10"
			>
				<span
					class="font-mono text-xs font-bold tracking-widest text-[#0D9488] uppercase"
					data-i18n-key="experienceHighlights"
				>
					Experience Highlights
				</span>
				<h2
					class="font-heading text-2xl font-extrabold text-white uppercase"
					data-i18n-en="Tour Package Signature Features"
					data-i18n-id="Keunggulan Utama Paket Wisata"
				>
					Tour Package Signature Features
				</h2>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					{
						destination.highlights?.map((item, idx) => {
							const item_id = destination.highlights_id?.[idx] || item;
							return (
								<div class="glass-card flex items-start gap-3 rounded-lg border border-white/15 p-4">
									<span class="bg-gold/20 text-gold mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold">
										✓
									</span>
									<span
										data-i18n-en={item}
										data-i18n-id={item_id}
										class="font-sans text-sm leading-snug font-medium text-white/90"
									>
										{item}
									</span>
								</div>
							);
						})
					}
				</div>
			</section>

			<!-- Day-by-Day Itinerary Schedule Section -->
			<section
				id="itinerary"
				class="story-scroll-item space-y-6 border-t border-white/10 pt-10"
			>
				<span
					class="font-mono text-xs font-bold tracking-widest text-[#0D9488] uppercase"
					data-i18n-key="dayByDaySchedule"
				>
					Day-by-Day Schedule
				</span>
				<h2
					class="font-heading text-2xl font-extrabold text-white uppercase"
					data-i18n-en="Curated Itinerary Timeline"
					data-i18n-id="Jadwal Perjalanan Rinci"
				>
					Curated Itinerary Timeline
				</h2>

				<div class="space-y-4">
					{
						destination.itinerary?.map((dayItem, idx) => (
							<div class="glass-card space-y-2 rounded-lg border border-white/15 p-6">
								<div class="flex items-center justify-between">
									<span
										data-i18n-en={dayItem.day}
										data-i18n-id={dayItem.day_id || dayItem.day}
										class="text-gold border-gold/30 rounded border bg-slate-900 px-3 py-1 font-mono text-xs font-bold tracking-widest uppercase"
									>
										{dayItem.day}
									</span>
									<span
										data-i18n-en={`Day 0${idx + 1}`}
										data-i18n-id={`Hari 0${idx + 1}`}
										class="font-mono text-xs text-white/40"
									>
										Day 0{idx + 1}
									</span>
								</div>
								<h3
									data-i18n-en={dayItem.title}
									data-i18n-id={dayItem.title_id || dayItem.title}
									class="font-heading pt-1 text-lg font-bold text-white"
								>
									{dayItem.title}
								</h3>
								<p
									data-i18n-en={dayItem.description}
									data-i18n-id={dayItem.description_id || dayItem.description}
									class="font-sans text-sm leading-relaxed font-light text-white/70"
								>
									{dayItem.description}
								</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- Inclusions & Exclusions Breakdown Section -->
			<section
				class="story-scroll-item space-y-6 border-t border-white/10 pt-10"
			>
				<h2
					class="font-heading text-2xl font-extrabold text-white uppercase"
					data-i18n-key="whatsIncluded"
				>
					What's Included & Excluded
				</h2>

				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
					<!-- Inclusions -->
					<div
						class="glass-card space-y-4 rounded-lg border border-emerald-500/20 p-6"
					>
						<h3
							class="font-heading flex items-center gap-2 text-sm font-bold tracking-wider text-emerald-400 uppercase"
							data-i18n-key="inclusions"
						>
							<span class="h-2 w-2 rounded-full bg-emerald-400"></span>
							Package Inclusions
						</h3>
						<ul class="space-y-2.5 font-sans text-xs text-white/80">
							{
								(destination as any).included?.map(
									(inc: string, idx: number) => {
										const inc_id =
											(destination as any).included_id?.[idx] || inc;
										return (
											<li class="flex items-start gap-2">
												<span class="font-bold text-emerald-400">✓</span>
												<span data-i18n-en={inc} data-i18n-id={inc_id}>
													{inc}
												</span>
											</li>
										);
									},
								)
							}
						</ul>
					</div>

					<!-- Exclusions -->
					<div
						class="glass-card space-y-4 rounded-lg border border-rose-500/20 p-6"
					>
						<h3
							class="font-heading flex items-center gap-2 text-sm font-bold tracking-wider text-rose-400 uppercase"
							data-i18n-key="exclusions"
						>
							<span class="h-2 w-2 rounded-full bg-rose-400"></span>
							Package Exclusions
						</h3>
						<ul class="space-y-2.5 font-sans text-xs text-white/80">
							{
								(destination as any).excluded?.map(
									(exc: string, idx: number) => {
										const exc_id =
											(destination as any).excluded_id?.[idx] || exc;
										return (
											<li class="flex items-start gap-2">
												<span class="font-bold text-rose-400">✕</span>
												<span data-i18n-en={exc} data-i18n-id={exc_id}>
													{exc}
												</span>
											</li>
										);
									},
								)
							}
						</ul>
					</div>
				</div>
			</section>
		</div>

		<!-- Right Sticky Booking / WhatsApp CTA Sidebar (4 Columns) -->
		<aside class="space-y-6 lg:sticky lg:top-28 lg:col-span-4">
			<div
				class="glass-card border-gold/30 story-scroll-item space-y-6 rounded-lg border bg-slate-900/90 p-6 shadow-2xl shadow-black/80"
			>
				<div class="space-y-1 border-b border-white/10 pb-4">
					<span
						class="text-gold font-mono text-[10px] font-bold tracking-widest uppercase"
						data-i18n-key="investmentPerPerson">Package Investment</span
					>
					<div class="flex items-baseline justify-between">
						<span class="font-heading text-3xl font-black text-white"
							>{destination.price}</span
						>
						<span
							class="font-sans text-xs text-white/50"
							data-i18n-key="perPerson">/ per person</span
						>
					</div>
				</div>

				<div class="space-y-3 font-sans text-xs text-white/80">
					<div class="flex justify-between border-b border-white/10 py-2">
						<span
							class="text-white/50"
							data-i18n-en="Duration"
							data-i18n-id="Durasi">Duration</span
						>
						<span
							class="font-semibold text-white"
							data-i18n-en={destination.duration}
							data-i18n-id={destination.duration_id || destination.duration}
							>{destination.duration}</span
						>
					</div>
					<div class="flex justify-between border-b border-white/10 py-2">
						<span
							class="text-white/50"
							data-i18n-en="Group Size"
							data-i18n-id="Jumlah Peserta">Group Size</span
						>
						<span
							class="font-semibold text-white"
							data-i18n-en={destination.groupSize}
							data-i18n-id={destination.groupSize_id || destination.groupSize}
							>{destination.groupSize}</span
						>
					</div>
					<div class="flex justify-between border-b border-white/10 py-2">
						<span
							class="text-white/50"
							data-i18n-en="Country"
							data-i18n-id="Negara">Country</span
						>
						<span
							class="font-semibold text-white"
							data-i18n-en={destination.country}
							data-i18n-id={destination.country_id || destination.country}
							>{destination.country}</span
						>
					</div>
				</div>

				<div class="space-y-3 pt-2">
					<!-- Download Itinerary PDF Button -->
					<button
