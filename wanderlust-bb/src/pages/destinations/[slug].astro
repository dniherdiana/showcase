		<button
			id="close-lightbox-btn"
			type="button"
			class="absolute top-6 right-6 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-lg font-bold text-white transition-colors hover:bg-white/20"
			aria-label="Close Lightbox"
		>
			✕
		</button>

		<!-- Prev / Next Navigation Buttons -->
		<button
			id="prev-lightbox-btn"
			type="button"
			class="text-gold absolute left-4 z-10 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/10 text-xl font-bold transition-colors hover:bg-white/20 sm:left-8"
			aria-label="Previous Photo"
		>
			‹
		</button>
		<button
			id="next-lightbox-btn"
			type="button"
			class="text-gold absolute right-4 z-10 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full bg-white/10 text-xl font-bold transition-colors hover:bg-white/20 sm:right-8"
			aria-label="Next Photo"
		>
			›
		</button>

		<!-- Fullscreen Zoomed Image Container -->
		<div
			class="relative max-h-[85vh] max-w-5xl overflow-hidden rounded-lg border border-white/20 shadow-2xl"
		>
			<img
				id="lightbox-zoomed-img"
				alt="Zoomed Destination Gallery"
				class="h-full max-h-[85vh] w-full object-contain"
			/>
		</div>
	</div>

	<!-- Related Tour Packages Section -->
	<section
		class="mx-auto max-w-7xl space-y-8 border-t border-white/10 px-[5%] py-16"
	>
		<div class="flex items-center justify-between">
			<h2
				class="font-heading text-2xl font-extrabold text-white uppercase"
				data-i18n-key="similarPackages"
			>
				Similar Luxury Packages
			</h2>
			<a
				href="/destinations"
				data-i18n-key="viewAllPackages"
				class="text-gold font-mono text-xs uppercase hover:underline"
				>View All Packages →</a
			>
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{relatedDestinations.map((dest) => <DestinationCard {...dest} />)}
		</div>
	</section>

	<BookingBanner />
</Layout>

<style>
	.hero-kenburns {
		animation: hero-kenburns 24s ease-out forwards;
		will-change: transform;
	}

	@keyframes hero-kenburns {
		from {
			transform: scale(1.02);
		}
		to {
			transform: scale(1.12);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-kenburns {
			animation: none;
		}
	}
</style>

<script>
	function initGalleryLightbox() {
		const mainPreview = document.getElementById(
			"main-gallery-preview",
		) as HTMLImageElement | null;
		const openTrigger = document.getElementById("open-lightbox-trigger");
		const thumbBtns = document.querySelectorAll(".gallery-thumb-btn");

		const lightboxModal = document.getElementById("gallery-lightbox-modal");
		const lightboxImg = document.getElementById(
			"lightbox-zoomed-img",
		) as HTMLImageElement | null;
		const closeBtn = document.getElementById("close-lightbox-btn");
		const prevBtn = document.getElementById("prev-lightbox-btn");
		const nextBtn = document.getElementById("next-lightbox-btn");

		if (!thumbBtns.length) return;

		let currentIndex = 0;
		const sources = Array.from(thumbBtns).map(
			(btn) => btn.getAttribute("data-gallery-preview") || "",
		);
		const fullSources = Array.from(thumbBtns).map(
			(btn) => btn.getAttribute("data-gallery-full") || "",
		);

		function updateActiveImage(idx: number) {
			if (idx < 0) idx = sources.length - 1;
			if (idx >= sources.length) idx = 0;
			currentIndex = idx;

			const newSrc = sources[currentIndex];
			const newFullSrc = fullSources[currentIndex];
			if (mainPreview && newSrc) {
				mainPreview.src = newSrc;
				mainPreview.removeAttribute("srcset");
				mainPreview.removeAttribute("sizes");
			}
			if (lightboxImg && newFullSrc) lightboxImg.src = newFullSrc;

			thumbBtns.forEach((btn, i) => {
				if (i === currentIndex) {
					btn.classList.remove("border-white/10", "opacity-70");
					btn.classList.add("border-gold", "scale-[1.02]");
				} else {
					btn.classList.remove("border-gold", "scale-[1.02]");
					btn.classList.add("border-white/10", "opacity-70");
				}
			});
		}

		thumbBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const idx = parseInt(btn.getAttribute("data-gallery-idx") || "0", 10);
				updateActiveImage(idx);
			});
		});

		function openLightbox() {
			if (!lightboxModal) return;
			// Load the full-res image only when the lightbox is actually opened,
			// keeping the 100+ KiB download off the initial page load.
			if (lightboxImg && fullSources[currentIndex]) {
				lightboxImg.src = fullSources[currentIndex];
			}
			lightboxModal.classList.remove("opacity-0", "pointer-events-none");
			document.body.style.overflow = "hidden";
		}

		function closeLightbox() {
			if (!lightboxModal) return;
			lightboxModal.classList.add("opacity-0", "pointer-events-none");
			document.body.style.overflow = "";
		}

		openTrigger?.addEventListener("click", openLightbox);
		closeBtn?.addEventListener("click", closeLightbox);

		prevBtn?.addEventListener("click", () =>
			updateActiveImage(currentIndex - 1),
		);
		nextBtn?.addEventListener("click", () =>
			updateActiveImage(currentIndex + 1),
		);

		lightboxModal?.addEventListener("click", (e) => {
			if (e.target === lightboxModal) closeLightbox();
		});

		window.addEventListener("keydown", (e) => {
			if (!lightboxModal || lightboxModal.classList.contains("opacity-0"))
				return;
			if (e.key === "Escape") closeLightbox();
			if (e.key === "ArrowLeft") updateActiveImage(currentIndex - 1);
			if (e.key === "ArrowRight") updateActiveImage(currentIndex + 1);
		});

		// PDF Export Trigger
		const pdfBtn = document.getElementById("download-itinerary-pdf-btn");
		pdfBtn?.addEventListener("click", () => {
			window.print();
		});
	}

	document.addEventListener("DOMContentLoaded", initGalleryLightbox);
	document.addEventListener("astro:page-load", initGalleryLightbox);
</script>
