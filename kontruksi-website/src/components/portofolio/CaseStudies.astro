---
import { Image } from 'astro:assets';
import { MapPin } from 'lucide-astro';
import { portofolioContent } from '../../data/portofolio.js';

const caseStudies = portofolioContent.caseStudies;
---

<section class="py-20 lg:py-28 bg-theme-bg border-b border-theme-border">
  <div class="editorial-container space-y-16">
    <div class="max-w-2xl space-y-2">
      <h2 class="text-3xl font-serif text-theme-primary font-normal">Studi Kasus Proyek Utama</h2>
      <p class="text-theme-secondary text-sm">Analisis tantangan teknis dan solusi struktur baja yang diterapkan.</p>
    </div>

    {caseStudies.map((c) => (
      <article class="surface-card p-8 sm:p-12 rounded-sm border-theme-border space-y-8">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-theme-border pb-6">
          <div>
            <span class="text-xs text-theme-accent font-semibold uppercase tracking-wider">{c.client}</span>
            <h3 class="text-2xl sm:text-3xl font-serif text-theme-primary font-normal mt-1">{c.project}</h3>
            <div class="flex items-center gap-2 text-xs text-theme-secondary mt-2">
              <MapPin class="w-3.5 h-3.5 text-theme-accent" />
              <span>{c.location}</span>
            </div>
          </div>

          <div class="text-xs text-theme-primary bg-theme-bg p-3 rounded-sm border border-theme-border max-w-md">
            <strong class="text-theme-secondary">Lingkup Proyek:</strong> {c.scope}
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 space-y-6">
            <div>
              <h4 class="text-xs font-semibold text-theme-accent uppercase tracking-wider mb-2">Tantangan Proyek (Challenge)</h4>
              <p class="text-theme-secondary text-sm sm:text-base leading-relaxed">{c.challenge}</p>
            </div>

            <div>
              <h4 class="text-xs font-semibold text-theme-accent uppercase tracking-wider mb-2">Pendekatan Arsitektur (Approach)</h4>
              <p class="text-theme-secondary text-sm sm:text-base leading-relaxed">{c.approach}</p>
            </div>

            <div class="p-4 rounded-sm bg-theme-bg border border-theme-border space-y-1">
              <h4 class="text-xs font-semibold text-theme-success uppercase tracking-wider">Hasil Riil (Outcome)</h4>
              <p class="text-theme-secondary text-sm leading-relaxed">{c.outcome}</p>
            </div>

            <blockquote class="p-4 border-l-2 border-theme-accent text-sm italic text-theme-secondary">
              {c.quote}
            </blockquote>
          </div>

          <div class="lg:col-span-5">
            <Image
              src={c.image}
              alt={c.project}
              width="1200"
              height="900"
              class="w-full aspect-4/3 object-cover rounded-sm border border-theme-border"
              loading="lazy"
            />
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
