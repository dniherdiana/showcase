---
import { Calendar, Clock, MapPin, CheckCircle2, ShieldCheck, FileText, Wrench, Calculator } from 'lucide-astro';
---

<section id="booking" class="py-24 lg:py-32 bg-theme-bg border-b border-theme-border">
  <div class="editorial-container">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Copy -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-theme-surface border border-theme-border text-theme-accent text-xs font-semibold tracking-wider">
          <Calendar class="w-4 h-4" />
          <span>Jadwalkan Konsultasi Gratis</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-theme-primary font-normal leading-tight">
          Jadwalkan Sesi Konsultasi & Survei Konstruksi
        </h2>

        <p class="text-theme-secondary text-base leading-relaxed">
          Pilih tipe sesi konsultasi konstruksi yang paling sesuai dengan kebutuhan proyek pabrik atau gudang Anda. Tim insinyur Moving Co. siap mendampingi baik secara langsung di lapangan (*On-Site*) maupun secara *Online*.
        </p>

        <div class="space-y-4 pt-2">
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-sm bg-theme-accent-bg border border-theme-accent/30 text-theme-accent flex items-center justify-center shrink-0">
              <CheckCircle2 class="w-4 h-4" />
            </div>
            <div>
              <div class="text-sm font-bold text-theme-primary">Survei Lapangan & Topografi Lahan</div>
              <div class="text-xs text-theme-secondary">Analisis kondisi tanah & kelayakan sirkulasi alat berat</div>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-sm bg-theme-accent-bg border border-theme-accent/30 text-theme-accent flex items-center justify-center shrink-0">
              <CheckCircle2 class="w-4 h-4" />
            </div>
            <div>
              <div class="text-sm font-bold text-theme-primary">Estimasi Anggaran Transparan (RAB)</div>
              <div class="text-xs text-theme-secondary">Diskusi rincian tonase baja WF SNI & jadwal kerja</div>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-sm bg-theme-accent-bg border border-theme-accent/30 text-theme-accent flex items-center justify-center shrink-0">
              <CheckCircle2 class="w-4 h-4" />
            </div>
            <div>
              <div class="text-sm font-bold text-theme-primary">Bebas Biaya & Tanpa Keterikatan</div>
              <div class="text-xs text-theme-secondary">Sesi konsultasi pertama 100% bebas biaya</div>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-sm bg-theme-surface border border-theme-border flex items-center gap-3">
          <ShieldCheck class="w-7 h-7 text-theme-success shrink-0" />
          <div class="text-xs text-theme-secondary">
            <strong class="text-theme-primary">Jaminan Kerahasiaan Data:</strong> Rencana desain pabrik & informasi bisnis Anda terlindungi dengan standar integritas penuh.
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Booking Widget Card -->
      <div class="lg:col-span-7">
        <div class="surface-card p-6 sm:p-8 rounded-sm space-y-6">
          <div class="flex items-center justify-between border-b border-theme-border pb-4">
            <h3 class="text-xl font-serif text-theme-primary font-normal flex items-center gap-2">
              <Clock class="w-5 h-5 text-theme-accent" />
              <span>Formulir Reservasi Jadwal</span>
            </h3>
            <span class="text-xs font-semibold text-theme-accent bg-theme-accent-bg px-3 py-1 rounded-sm border border-theme-accent/30">
              Survei & Diskusi
            </span>
          </div>

          <form id="booking-widget-form" onsubmit="return false;" class="space-y-6">
            
            <!-- Tipe Sesi Konsultasi * (Multi-Option Grid) -->
            <div>
              <label class="form-label mb-3">Tipe Sesi Konsultasi Konstruksi *</label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="booking-session-options">
                
                <!-- Option 1: On-Site Survey -->
                <label class="booking-session-card cursor-pointer border border-theme-accent bg-theme-accent-bg/40 rounded-sm p-4 flex flex-col justify-between transition-all select-none">
                  <input type="radio" name="booking_mode" value="Survei Lokasi & Topografi Lahan (On-Site)" checked class="hidden" />
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-theme-accent uppercase tracking-wider">On-Site Lapangan</span>
                      <MapPin class="w-4 h-4 text-theme-accent" />
                    </div>
                    <div class="text-sm font-bold text-theme-primary">Survei Lokasi (On-Site)</div>
                    <p class="text-xs text-theme-secondary">Inspeksi fisik tanah, batas lahan, & akses truk kontainer.</p>
                  </div>
                </label>

                <!-- Option 2: Online Blueprint -->
                <label class="booking-session-card cursor-pointer border border-theme-border bg-theme-bg rounded-sm p-4 flex flex-col justify-between hover:border-theme-border-hover transition-all select-none">
                  <input type="radio" name="booking_mode" value="Diskusi Blueprint & Gambar CAD (Online)" class="hidden" />
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-theme-accent uppercase tracking-wider">Online / Video Call</span>
                      <FileText class="w-4 h-4 text-theme-accent" />
                    </div>
                    <div class="text-sm font-bold text-theme-primary">Diskusi Blueprint Online</div>
                    <p class="text-xs text-theme-secondary">Review cetak biru CAD 2D/3D & zoning alur produksi.</p>
                  </div>
                </label>

                <!-- Option 3: Structural Audit -->
                <label class="booking-session-card cursor-pointer border border-theme-border bg-theme-bg rounded-sm p-4 flex flex-col justify-between hover:border-theme-border-hover transition-all select-none">
                  <input type="radio" name="booking_mode" value="Audit Struktur & Kelayakan Pabrik Eksisting" class="hidden" />
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-theme-accent uppercase tracking-wider">Audit Teknis</span>
                      <Wrench class="w-4 h-4 text-theme-accent" />
                    </div>
                    <div class="text-sm font-bold text-theme-primary">Audit Struktur Pabrik Lama</div>
                    <p class="text-xs text-theme-secondary">Inspeksi rangka WF & analisis beban crane tambahan.</p>
                  </div>
                </label>

                <!-- Option 4: RAB Engineering Value -->
                <label class="booking-session-card cursor-pointer border border-theme-border bg-theme-bg rounded-sm p-4 flex flex-col justify-between hover:border-theme-border-hover transition-all select-none">
                  <input type="radio" name="booking_mode" value="Konsultasi RAB & Engineering Value (VE)" class="hidden" />
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-theme-accent uppercase tracking-wider">Engineering Cost</span>
                      <Calculator class="w-4 h-4 text-theme-accent" />
                    </div>
                    <div class="text-sm font-bold text-theme-primary">Konsultasi RAB & Tonase</div>
                    <p class="text-xs text-theme-secondary">Pembahasan detail tonase baja & penguncian harga RAB.</p>
                  </div>
                </label>

                <!-- Option 5: Guarantee & Maintenance Plan -->
                <label class="booking-session-card cursor-pointer border border-theme-border bg-theme-bg rounded-sm p-4 flex flex-col justify-between hover:border-theme-border-hover transition-all select-none sm:col-span-2">
                  <input type="radio" name="booking_mode" value="Diskusi Garansi & Perencanaan Maintenance 12 Bulan" class="hidden" />
                  <div class="space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-theme-success uppercase tracking-wider">Purna Jual & Maintenance</span>
                      <ShieldCheck class="w-4 h-4 text-theme-success" />
                    </div>
                    <div class="text-sm font-bold text-theme-primary">Diskusi Garansi & Maintenance Berkala</div>
                    <p class="text-xs text-theme-secondary">Perencanaan inspeksi teknis 3 bulanan & garansi kebocoran atap 12 bulan.</p>
                  </div>
                </label>

              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="form-label" for="booking-date">Pilih Tanggal *</label>
                <input type="date" id="booking-date" required class="form-input" />
                <p class="text-xs text-theme-accent mt-1 hidden" id="booking-date-err">Mohon pilih tanggal yang valid.</p>
              </div>

              <div>
                <label class="form-label" for="booking-time">Pilih Jam *</label>
                <select id="booking-time" class="form-input">
                  <option value="09:00 WIB">09:00 WIB (Pagi)</option>
                  <option value="11:00 WIB">11:00 WIB (Siang)</option>
                  <option value="14:00 WIB">14:00 WIB (Siang)</option>
                  <option value="16:00 WIB">16:00 WIB (Sore)</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="form-label" for="booking-name">Nama Pemilik Bisnis / Klien *</label>
                <input type="text" id="booking-name" required placeholder="Nama Anda" class="form-input" />
                <p class="text-xs text-theme-accent mt-1 hidden" id="booking-name-err">Mohon lengkapi Nama Anda.</p>
              </div>
              <div>
                <label class="form-label" for="booking-phone">Nomor WhatsApp Aktif *</label>
                <input type="tel" id="booking-phone" required placeholder="0812xxxxxxxx" class="form-input" />
                <p class="text-xs text-theme-accent mt-1 hidden" id="booking-phone-err">Mohon masukkan nomor WhatsApp yang valid.</p>
              </div>
            </div>

            <div>
              <label class="form-label" for="booking-location">Lokasi / Alamat Lahan Pabrik *</label>
              <input type="text" id="booking-location" required placeholder="Contoh: Kawasan Industri Delta Silicon, Cikarang" class="form-input" />
              <p class="text-xs text-theme-accent mt-1 hidden" id="booking-location-err">Mohon isi Alamat / Lokasi Lahan.</p>
            </div>

            <button 
              type="button" 
              id="btn-submit-booking"
              class="btn-primary w-full py-4 text-base font-bold mt-4"
            >
              <Calendar class="w-5 h-5" />
              <span>Konfirmasi & Simpan Jadwal Sesi</span>
            </button>

            <div id="booking-success-alert" class="hidden p-4 rounded-sm bg-theme-success-bg border border-theme-success/40 text-theme-success text-sm font-medium">
              ✓ Permintaan jadwal berhasil dibuat! Tim teknis Moving Co. akan mengonfirmasi tanggal & waktu kunjungan melalui WhatsApp.
            </div>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const dateInput = document.getElementById('booking-date') as HTMLInputElement;
  if (dateInput) {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    dateInput.min = tomorrow.toISOString().split('T')[0];
    dateInput.value = tomorrow.toISOString().split('T')[0];
  }

  // Interactive Selection Cards logic
  document.querySelectorAll('.booking-session-card').forEach(card => {
    card.addEventListener('click', () => {
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
      if (!radio) return;

      radio.checked = true;

      document.querySelectorAll('.booking-session-card').forEach(sibling => {
        sibling.classList.remove('border-theme-accent', 'bg-theme-accent-bg/40');
        sibling.classList.add('border-theme-border', 'bg-theme-bg');
      });

      card.classList.remove('border-theme-border', 'bg-theme-bg');
      card.classList.add('border-theme-accent', 'bg-theme-accent-bg/40');
    });
  });

  const btnBooking = document.getElementById('btn-submit-booking');
  if (btnBooking) {
    btnBooking.addEventListener('click', () => {
      const mode = (document.querySelector('input[name="booking_mode"]:checked') as HTMLInputElement)?.value || 'Survei Lokasi';
      const dateEl = (document.getElementById('booking-date') as HTMLInputElement);
      const timeEl = (document.getElementById('booking-time') as HTMLSelectElement);
      const nameEl = (document.getElementById('booking-name') as HTMLInputElement);
      const phoneEl = (document.getElementById('booking-phone') as HTMLInputElement);
      const locEl = (document.getElementById('booking-location') as HTMLInputElement);

      const dateErr = document.getElementById('booking-date-err');
      const nameErr = document.getElementById('booking-name-err');
      const phoneErr = document.getElementById('booking-phone-err');
      const locErr = document.getElementById('booking-location-err');

      let hasErr = false;
      if (!dateEl?.value) { if (dateErr) dateErr.classList.remove('hidden'); hasErr = true; } else { if (dateErr) dateErr.classList.add('hidden'); }
      if (!nameEl?.value) { if (nameErr) nameErr.classList.remove('hidden'); hasErr = true; } else { if (nameErr) nameErr.classList.add('hidden'); }
      if (!phoneEl?.value) { if (phoneErr) phoneErr.classList.remove('hidden'); hasErr = true; } else { if (phoneErr) phoneErr.classList.add('hidden'); }
      if (!locEl?.value) { if (locErr) locErr.classList.remove('hidden'); hasErr = true; } else { if (locErr) locErr.classList.add('hidden'); }

      if (hasErr) return;

      const text = `Halo Moving Co., Saya ${nameEl.value} mengajukan reservasi Sesi Konsultasi:\n` +
        `- Tipe Sesi: ${mode}\n` +
        `- Tanggal: ${dateEl.value}\n` +
        `- Waktu: ${timeEl.value}\n` +
        `- Lokasi Lahan: ${locEl.value}\n` +
        `- No. WhatsApp: ${phoneEl.value}\n` +
        `Mohon konfirmasi ketersediaan jadwal tim insinyur. Terima kasih.`;

      const waUrl = `https://wa.me/6281234567890?text=${encodeURIComponent(text)}`;

      const alertEl = document.getElementById('booking-success-alert');
      if (alertEl) alertEl.classList.remove('hidden');

      setTimeout(() => {
        window.open(waUrl, '_blank');
      }, 1000);
    });
  }
</script>
