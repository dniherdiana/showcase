---
import { HardHat, Building2, Layers, Ruler, ShieldCheck, ArrowRight, Calculator } from 'lucide-astro';
import { layananContent } from '../../data/layanan.js';

const { hero } = layananContent;

const iconMap: Record<string, any> = {
  Building2,
  Layers,
  Ruler,
  ShieldCheck
};

const categoryTargetMap: Record<string, string> = {
  'Pabrik Manufaktur': 'manufaktur',
  'Gudang Logistik': 'logistik',
  'Hanggar Workshop': 'workshop',
  'Garansi 12 Bulan': 'maintenance'
};
---

<section class="relative pt-24 pb-20 lg:pt-32 lg:pb-28 bg-theme-bg border-b border-theme-border overflow-hidden">
  <div class="editorial-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left Column: Copy & CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-sm bg-theme-surface border border-theme-border text-theme-accent text-xs font-semibold tracking-wider">
          <HardHat class="w-4 h-4 shrink-0" />
          <span>{hero.preheader}</span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif text-theme-primary font-normal leading-tight tracking-tight">
          {hero.title}
        </h1>

        <p class="text-base sm:text-lg text-theme-secondary font-normal leading-[1.7] max-w-2xl">
          {hero.subheading}
        </p>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a href="/kontak" class="btn-primary">
            <span>Mulai Konsultasi Spesialisasi</span>
            <ArrowRight class="w-5 h-5" />
          </a>

          <a href="/kalkulator" class="btn-secondary">
            <Calculator class="w-5 h-5 text-theme-accent" />
            <span>Hitung Simulasi Pabrik Anda</span>
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="pt-6 border-t border-theme-border grid grid-cols-3 gap-4 text-xs text-theme-secondary">
          <div>
            <div class="text-2xl font-serif text-theme-primary font-normal">100%</div>
            <div class="text-[11px] text-theme-secondary mt-0.5">RAB Dikunci Tanpa Addendum</div>
          </div>
          <div>
            <div class="text-2xl font-serif text-theme-accent font-normal">12 Bln</div>
            <div class="text-[11px] text-theme-secondary mt-0.5">Garansi Maintenance Gratis</div>
          </div>
          <div>
            <div class="text-2xl font-serif text-theme-primary font-normal">SNI</div>
            <div class="text-[11px] text-theme-secondary mt-0.5">Baja WF / H-Beam Resmi</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Quick-Navigator Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="text-xs font-semibold text-theme-accent uppercase tracking-wider mb-2 flex items-center justify-between">
          <span>Pilih Kategori Kebutuhan Anda:</span>
          <span class="text-[11px] text-theme-secondary font-normal">Klik untuk lompat langsung ↓</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="hero-category-nav">
          {hero.highlights.map((h, i) => {
            const IconComp = i === 0 ? Building2 : i === 1 ? Layers : i === 2 ? Ruler : ShieldCheck;
            const filterTarget = categoryTargetMap[h.title] || 'all';
            return (
              <button
                type="button"
                data-filter-target={filterTarget}
                class="hero-nav-card text-left p-4 rounded-sm surface-card surface-card-hover border-theme-border flex flex-col justify-between space-y-2 cursor-pointer transition-all select-none focus:outline-none"
              >
                <div class="flex items-center justify-between">
                  <div class="w-8 h-8 rounded-sm bg-theme-accent-bg border border-theme-accent/30 text-theme-accent flex items-center justify-center">
                    <IconComp class="w-4 h-4" />
                  </div>
                  <span class="text-xs text-theme-accent opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                </div>
                <div>
                  <div class="text-sm font-serif text-theme-primary font-medium">{h.title}</div>
                  <div class="text-[11px] text-theme-secondary mt-0.5">{h.desc}</div>
                </div>
              </button>
            );
          })}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#hero-category-nav .hero-nav-card').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-filter-target');
      const targetSection = document.getElementById('layanan');

      if (targetSection) {
        targetSection.scrollIntoView({ behavior: 'smooth' });
      }

      if (target) {
        setTimeout(() => {
          const tabBtn = document.querySelector(`#service-tabs .service-tab-btn[data-filter="${target}"]`) as HTMLButtonElement;
          if (tabBtn) tabBtn.click();
        }, 400);
      }
    });
  });
</script>
