---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AboutHero from '../components/tentang-kami/AboutHero.astro';
import AboutStory from '../components/tentang-kami/AboutStory.astro';
import AboutPrinciples from '../components/tentang-kami/AboutPrinciples.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site.js';
---

<Layout 
  title={`Filosofi & Cerita | ${siteConfig.name} Arsitektur & Konstruksi Baja`}
  description="Filosofi pendirian Moving Co. — Prinsip integritas, transparansi biaya, dan komitmen garansi purna jual dalam pembangunan pabrik industri."
  canonicalPath="/tentang-kami"
>
  <Navbar />
  <main class="pt-20" id="main-content">
    <AboutHero />
    <AboutStory />
    <AboutPrinciples />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
