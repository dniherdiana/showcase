---
import Layout from '../layouts/Layout.astro';
import HeroServices from '../components/services/HeroServices.astro';
import CommercialDivisions from '../components/services/CommercialDivisions.astro';
import DeliverablesLedger from '../components/services/DeliverablesLedger.astro';
import MaterialAuditSection from '../components/services/MaterialAuditSection.astro';
import ClosingCta from '../components/common/ClosingCta.astro';
import { layananData } from '../data/layanan.data.js';
import { siteIdentity } from '../data/site.data.js';

const title = `Layanan Arsitektur & Interior Komersial | ${siteIdentity.brandName}`;
const description = 'Ruang lingkup terukur untuk F&B, ritel, kantor kreatif, dan feasibility study lahan di Jakarta, Bandung, dan Bali dengan set DED 80+ lembar.';
---

<Layout title={title} description={description} currentPath="/layanan">
  <HeroServices />
  <CommercialDivisions />
  <DeliverablesLedger />
  <MaterialAuditSection />
  <ClosingCta
    headline={layananData.closingCta.headline}
    subhead={layananData.closingCta.subhead}
    buttonText={layananData.closingCta.buttonText}
    href={layananData.closingCta.href}
  />
</Layout>
