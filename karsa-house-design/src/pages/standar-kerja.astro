---
import Layout from '../layouts/Layout.astro';
import HeroStandarKerja from '../components/standarKerja/HeroStandarKerja.astro';
import WorkPhases from '../components/standarKerja/WorkPhases.astro';
import DeviationGuarantee from '../components/standarKerja/DeviationGuarantee.astro';
import ClosingCta from '../components/common/ClosingCta.astro';
import { standarKerjaData } from '../data/standarKerja.data.js';
import { siteIdentity } from '../data/site.data.js';

const title = `Standar Kerja & Protokol Konstruksi | ${siteIdentity.brandName}`;
const description = 'Lima tahapan operasional arsitektur komersial dari audit tapak, DED 80+ lembar, BoQ presisi, hingga supervisi mingguan Lead Architect.';
---

<Layout title={title} description={description} currentPath="/standar-kerja">
  <HeroStandarKerja />
  <WorkPhases />
  <DeviationGuarantee />
  <ClosingCta
    headline={standarKerjaData.closingCta.headline}
    subhead={standarKerjaData.closingCta.subhead}
    buttonText={standarKerjaData.closingCta.buttonText}
    href={standarKerjaData.closingCta.href}
  />
</Layout>
