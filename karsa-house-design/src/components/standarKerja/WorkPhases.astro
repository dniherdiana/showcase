---
import { Image } from 'astro:assets';
import { standarKerjaData } from '../../data/standarKerja.data.js';

import feasibilityImg from '../../images/feasibility-study.jpg';
import studioKolaboraImg from '../../images/studio-kolabora.jpg';
import dedImg from '../../images/ded-blueprints.jpg';
import materialImg from '../../images/material-samples.jpg';
import inspectionImg from '../../images/architect-inspection.jpg';

const imageMap: Record<string, ImageMetadata> = {
  feasibility: feasibilityImg,
  studioKolabora: studioKolaboraImg,
  dedBlueprints: dedImg,
  materialSamples: materialImg,
  architectInspection: inspectionImg,
};

const { phases } = standarKerjaData;
---

<section id="tahapan" class="w-full py-16 lg:py-24 bg-surface-ground">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    {phases.map((phase, idx) => {
      const isEven = idx % 2 === 1;
      const photo = imageMap[phase.imageKey];

      return (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Image Column -->
          <div class:list={[
            'lg:col-span-6',
            isEven ? 'lg:order-2' : 'lg:order-1'
          ]}>
            <div class="relative">
              <div class="absolute -inset-2 bg-surface-panel sketch-border -rotate-1 -z-10"></div>
              <div class="sketch-border bg-surface-card p-3 shadow-sketch hover:shadow-floating transition-all duration-300">
                <div class="overflow-hidden rounded-sm aspect-[16/10] bg-surface-panel">
                  {photo && (
                    <Image
                      src={photo}
                      alt={phase.title}
                      class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    />
                  )}
                </div>
                <div class="mt-3 px-2 py-1 flex items-center justify-between font-mono text-xs text-ink-muted border-t border-border-sketch">
                  <span class="text-ink-primary font-semibold">Deliverable Output:</span>
                  <span class="text-brand-accent truncate max-w-xs">{phase.output.split(',')[0]}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Content Column -->
          <div class:list={[
            'lg:col-span-6 space-y-4',
            isEven ? 'lg:order-1' : 'lg:order-2'
          ]}>
            <span class="font-display text-5xl font-bold text-brand-accent leading-none">
              {phase.number}
            </span>

            <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-ink-primary leading-tight">
              {phase.title}
            </h2>

            <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
              {phase.description}
            </p>

            <div class="p-3.5 bg-surface-panel border-l-3 border-brand-accent rounded-r-lg">
              <span class="font-mono text-[11px] uppercase tracking-wider text-brand-accent block font-bold">
                Dokumen Hasil Akhir:
              </span>
              <p class="text-xs text-ink-primary font-medium mt-1">
                {phase.output}
              </p>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>
