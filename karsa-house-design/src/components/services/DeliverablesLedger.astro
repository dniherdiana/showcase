---
import { layananData } from '../../data/layanan.data.js';

const { deliverablesStandard } = layananData;
---

<section id="deliverables" class="w-full py-16 lg:py-24 bg-surface-panel border-t border-border-sketch">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-primary leading-tight">
        {deliverablesStandard.headline}
      </h2>
    </div>

    <!-- Technical Ledger List with Open Hairline Rules -->
    <div class="divide-y divide-border-sketch border-y border-border-sketch">
      {deliverablesStandard.items.map((item) => (
        <div class="py-6 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
          <div class="md:col-span-2">
            <span class="inline-block px-3 py-1 bg-surface-card border border-border-sketch font-mono text-xs font-bold text-brand-accent rounded-md">
              {item.code}
            </span>
          </div>
          <div class="md:col-span-4">
            <h3 class="text-base sm:text-lg font-bold text-ink-primary">
              {item.title}
            </h3>
          </div>
          <div class="md:col-span-6">
            <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
