---
import { Image } from 'astro:assets';
import { layananData } from '../../data/layanan.data.js';
import materialImg from '../../images/material-samples.jpg';

const { materialAudit } = layananData;
---

<section class="w-full py-16 lg:py-24 bg-surface-ground">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left: Material Board Photo (Col 1-6) -->
      <div class="lg:col-span-6">
        <div class="relative">
          <div class="absolute -inset-2 bg-surface-panel sketch-border rotate-2 -z-10"></div>
          <div class="sketch-border bg-surface-card p-3 shadow-floating -rotate-1 transition-transform hover:rotate-0 duration-300">
            <div class="overflow-hidden rounded-sm aspect-[4/3] bg-surface-panel">
              <Image
                src={materialImg}
                alt="Audit Sampel Material Lokal Terverifikasi: Kayu Ulin, Andesit Padalarang, Paras Ubud"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
            <div class="mt-3 px-2 py-1 flex items-center justify-between font-mono text-xs text-ink-muted border-t border-border-sketch">
              <span class="text-ink-primary font-semibold">Material Board & Supply Chain Audit</span>
              <span class="text-brand-accent">100% Pasar Lokal</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Material Breakdown (Col 7-12) -->
      <div class="lg:col-span-6 space-y-6">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-primary leading-tight">
          {materialAudit.headline}
        </h2>

        <p class="text-base text-ink-muted leading-relaxed">
          {materialAudit.subhead}
        </p>

        <div class="space-y-4 pt-2">
          {materialAudit.materials.map((mat) => (
            <div class="p-4 bg-surface-panel sketch-border transition-colors hover:bg-surface-card">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-ink-primary font-mono">
                  {mat.name}
                </h3>
                <span class="text-[11px] font-mono text-brand-accent bg-surface-ground px-2 py-0.5 rounded border border-border-sketch">
                  {mat.source}
                </span>
              </div>
              <p class="mt-2 text-xs text-ink-muted leading-relaxed">
                {mat.application}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
