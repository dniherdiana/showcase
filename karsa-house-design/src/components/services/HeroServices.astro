---
import { Image } from 'astro:assets';
import { layananData } from '../../data/layanan.data.js';
import dedImg from '../../images/ded-blueprints.jpg';

const { hero } = layananData;
---

<section class="relative w-full py-12 lg:py-20 overflow-hidden architect-grid-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left: Rotated Blueprint & DED Showcase Photo (Col 1-6) -->
      <div class="lg:col-span-6">
        <div class="relative">
          <div class="absolute -inset-2 bg-surface-panel sketch-border rotate-2 -z-10"></div>
          <div class="sketch-border bg-surface-card p-3 shadow-floating -rotate-1.5 transition-transform hover:rotate-0 duration-300">
            <div class="overflow-hidden rounded-sm aspect-[4/3] bg-surface-panel">
              <Image
                src={dedImg}
                alt="Dokumen Gambar Kerja Detail DED 80 Lembar dan Sampel Material Lokal Atelier Karsa"
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="eager"
              />
            </div>
            <div class="mt-3 px-2 py-1 flex items-center justify-between font-mono text-xs text-ink-muted border-t border-border-sketch">
              <span class="text-ink-primary font-semibold">Standard Set DED 80-120 Halaman A3</span>
              <span class="text-brand-accent">Arsitektur + MEP + BoQ</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Typography & Scope Index (Col 7-12) -->
      <div class="lg:col-span-6 space-y-6">
        <!-- Single H1 per page, NO EYEBROW -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink-primary leading-[1.1]">
          Ruang Lingkup Arsitektur Komersial dan <span class="text-brand-accent underline decoration-wavy decoration-brand-accent/40">{hero.headlineAccent}</span>.
        </h1>

        <p class="text-base sm:text-lg text-ink-muted leading-relaxed font-normal">
          {hero.subhead}
        </p>

        <!-- Division Jump Pills -->
        <div class="grid grid-cols-2 gap-2 pt-2 text-xs font-mono">
          <a href="#fnb" class="p-2 bg-surface-panel border border-border-sketch rounded-lg hover:border-brand-accent transition-colors flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
            <span>01. F&B, Kafe & Bar</span>
          </a>
          <a href="#retail" class="p-2 bg-surface-panel border border-border-sketch rounded-lg hover:border-brand-accent transition-colors flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
            <span>02. Ritel & Flagship</span>
          </a>
          <a href="#office" class="p-2 bg-surface-panel border border-border-sketch rounded-lg hover:border-brand-accent transition-colors flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
            <span>03. Kantor Kreatif</span>
          </a>
          <a href="#feasibility" class="p-2 bg-surface-panel border border-border-sketch rounded-lg hover:border-brand-accent transition-colors flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
            <span>04. Feasibility Study</span>
          </a>
        </div>

        <!-- Action Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href={hero.ctaPrimary.href}
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold uppercase tracking-wider text-white bg-brand-accent hover:bg-brand-accent-hover rounded-control transition-all shadow-md text-center"
          >
            {hero.ctaPrimary.label}
          </a>
          <a
            href={hero.ctaSecondary.href}
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold tracking-wide text-ink-primary border-1.5 border-ink-primary hover:bg-surface-panel rounded-control transition-all text-center"
          >
            {hero.ctaSecondary.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
