---
import { homeData } from '../../data/home.data.js';

const { metrics } = homeData;
---

<section class="w-full bg-surface-panel border-y border-border-sketch py-10 lg:py-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x lg:divide-border-sketch">
      {metrics.map((metric) => (
        <div class="flex flex-col lg:px-6 first:pl-0 last:pr-0">
          <span class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-brand-accent leading-none">
            {metric.number}
          </span>
          <span class="mt-2 text-sm font-semibold text-ink-primary">
            {metric.label}
          </span>
          <p class="mt-1 text-xs text-ink-muted leading-relaxed">
            {metric.context}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
