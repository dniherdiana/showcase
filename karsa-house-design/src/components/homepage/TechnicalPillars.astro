---
import { homeData } from '../../data/home.data.js';

const { pillars } = homeData;
---

<section class="w-full py-16 lg:py-24 bg-surface-ground">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12 lg:mb-16">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-primary leading-tight">
        {pillars.headline}
      </h2>
    </div>

    <!-- 3 Open Columns with Hairline Dividers (Anti Card Fatigue) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 md:divide-x md:divide-border-sketch border-y border-border-sketch py-8 lg:py-12">
      {pillars.items.map((pillar) => (
        <div class="flex flex-col md:px-8 first:pl-0 last:pr-0 space-y-4">
          <div class="flex items-center gap-3">
            <span class="font-display text-4xl lg:text-5xl font-bold text-brand-accent">
              {pillar.number}
            </span>
            <div class="h-px flex-1 bg-border-sketch"></div>
          </div>

          <h3 class="text-lg font-bold text-ink-primary leading-snug">
            {pillar.title}
          </h3>

          <p class="text-sm text-ink-muted leading-relaxed">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
