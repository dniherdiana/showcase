---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';
import { siteIdentity } from '../data/site.data.js';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = `${siteIdentity.brandName} | Arsitektur Komersial Presisi & Desain Interior Ritel`,
  description = 'Studio arsitektur komersial terintegrasi untuk ruang F&B, ritel, dan kantor di Jakarta, Bandung, dan Bali. Gambar Kerja Detail (DED) lengkap dan garansi deviasi RAB maksimal 5%.',
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="bg-surface-ground text-ink-primary font-body flex flex-col min-h-screen">
    <Navbar currentPath={currentPath} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
