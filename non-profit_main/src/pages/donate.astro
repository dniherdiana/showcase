---
import Layout from '../layouts/Layout.astro';
import DonationCalculator from '../components/svelte/DonationCalculator.svelte';
import FaqAccordion from '../components/svelte/FaqAccordion.svelte';
import ClientDataTag from '../components/ClientDataTag.astro';
---

<Layout 
  title="Donate Now | Yayasan Bumi Bersama - 96% Direct Program Impact"
  description="Make a direct, tax-deductible contribution to native watershed reforestation, solar rural learning pods, and clean water springs in 145 partner villages."
>

  <!-- 1. FOCUSED ALLOCATION HERO -->
  <section class="bg-paper pt-12 pb-16 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 bg-emerald-100 border border-emerald-300 text-emerald-900 px-3.5 py-1 rounded-full text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-700 animate-pulse"></span>
          <span>96% Direct Program Fund Ratio</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 leading-tight">
          Every Gift Nurtures <span class="font-serif italic font-normal text-emerald-800">A Village Ecosystem.</span>
        </h1>

        <p class="text-base text-stone-600 leading-relaxed">
          Your donation goes directly into native tree seedlings, clean water gravity pipes, and solar school equipment. We publish audited financial receipts for every program cycle.
        </p>
      </div>

    </div>
  </section>

  <!-- 2. DONATION CALCULATOR & PAYMENT CHANNELS -->
  <section id="donate-form-section" class="py-16 bg-stone-100 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Side: Interactive Calculator -->
        <div class="lg:col-span-7">
          <DonationCalculator client:visible />
        </div>

        <!-- Right Side: Official Payment Details & Bank Transfer Information -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white rounded-2xl p-6 border border-stone-200 shadow-sm space-y-4">
            <h3 class="text-lg font-bold text-stone-900">Direct Bank Transfer Channels</h3>
            <p class="text-xs text-stone-600">You can also donate directly via bank transfer or international wire to our audited non-profit accounts:</p>

            <div class="space-y-3 pt-2">
              <div class="p-3 bg-stone-50 rounded-xl border border-stone-200 text-xs">
                <span class="font-bold text-stone-900 block">Bank Mandiri (IDR Account)</span>
                <ClientDataTag text="Nomor Rekening Mandiri Yayasan Bumi Bersama" />
              </div>

              <div class="p-3 bg-stone-50 rounded-xl border border-stone-200 text-xs">
                <span class="font-bold text-stone-900 block">Bank BCA (IDR Account)</span>
                <ClientDataTag text="Nomor Rekening BCA Yayasan Bumi Bersama" />
              </div>

              <div class="p-3 bg-stone-50 rounded-xl border border-stone-200 text-xs">
                <span class="font-bold text-stone-900 block">SWIFT / International USD Wire</span>
                <ClientDataTag text="SWIFT Code & Account Details USD" />
              </div>
            </div>

            <div class="pt-2 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-500">
              <span>Receipt Confirmation:</span>
              <a href="/contact" class="text-emerald-800 underline font-bold">Send Transfer Confirmation →</a>
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="bg-emerald-950 text-emerald-100 p-6 rounded-2xl border border-emerald-800/80 space-y-3 text-xs">
            <h4 class="font-bold text-amber-300 uppercase tracking-wider text-xs">Donor Protection Guarantee</h4>
            <ul class="space-y-2">
              <li class="flex items-center gap-2">
                <span class="text-amber-400">✓</span>
                <span>Tax-deductible non-profit foundation receipt issued immediately.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-amber-400">✓</span>
                <span>Annual CPA audited financial statements publicly accessible.</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-amber-400">✓</span>
                <span>Cancel monthly contributions anytime with 1-click email request.</span>
              </li>
            </ul>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- 3. DONOR FAQ -->
  <section class="py-20 bg-paper border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs uppercase font-mono tracking-wider font-semibold text-emerald-800 block mb-1">Donor Information</span>
        <h2 class="text-3xl font-bold text-stone-900">Donation & Tax FAQs</h2>
      </div>

      <FaqAccordion client:visible />
    </div>
  </section>

</Layout>
