---
import Layout from '../layouts/Layout.astro';
import BeforeAfterSlider from '../components/svelte/BeforeAfterSlider.svelte';
import ClientDataTag from '../components/ClientDataTag.astro';

const stories = [
  {
    id: "story-1",
    title: "How Pak Wayan Restored 15 Hectares of Deforested Slope With Bamboo Agroforestry",
    village: "Desa Sambangan, Central Highlands",
    category: "Environment & Agroforestry",
    quote: "When the land dries out, community spirit dies. When the trees return, hope flows back like clean spring water.",
    person: "Pak Wayan Karta (Age 54, Farmer & Bamboo Guild Leader)",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop",
    impactText: "Planted 15,000 bamboo & endemic dipterocarp saplings, preventing landslide threats across 3 hamlets."
  },
  {
    id: "story-2",
    title: "Ibu Siti's Solar School Pod: Bringing Digital Eco-Literacy to Remote Coastal Youth",
    village: "Desa Teluk Hijau, Southern Coast",
    category: "Education & Solar Innovation",
    quote: "Our children used to walk 8 kilometers through mud just to access electricity for schoolwork. Now our learning pod runs completely on sunshine.",
    person: "Ibu Siti Aminah (Age 42, Elementary Teacher)",
    image: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=800&auto=format&fit=crop",
    impactText: "Built solar-powered learning pod benefiting 140 elementary students with digital stewardship books."
  },
  {
    id: "story-3",
    title: "Youth Mangrove Guardians: 45,000 Coastal Saplings Rooted by Local Teenagers",
    village: "Desa Mangunharjo Estuary",
    category: "Coastal Ecosystem",
    quote: "We don't need outsiders to save our tidal flats. Give us saplings, tools, and respect, and we will protect this shore for life.",
    person: "Bagus & The Coastal Youth Alliance",
    image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?q=80&w=800&auto=format&fit=crop",
    impactText: "Protected 12km of coastline from ocean surge while establishing native crab nursery habitats."
  }
];
---

<Layout 
  title="Impact Stories | Yayasan Bumi Bersama - Documentary Case Studies"
  description="Read real documentary stories of rural villagers, indigenous elders, and youth who restored their native ecosystems and built resilient community livelihoods."
>

  <!-- 1. DRAMATIC EDITORIAL DOCUMENTARY HERO -->
  <section class="relative bg-stone-950 text-white py-24 overflow-hidden border-b border-stone-800">
    <div class="absolute inset-0 opacity-40">
      <img 
        src="https://images.unsplash.com/photo-1516627145497-ae6968895b74?q=80&w=1200&auto=format&fit=crop" 
        alt="Smiling children holding native plant saplings"
        class="w-full h-full object-cover"
      />
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center gap-2 bg-amber-400/90 text-stone-950 px-3.5 py-1 rounded-full text-xs font-bold font-mono">
        <span>Documentary Field Archive</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold max-w-3xl leading-tight">
        Real Voices. <span class="font-serif italic font-normal text-amber-300">Measurable Transformation.</span>
      </h1>

      <p class="text-stone-300 text-base sm:text-lg max-w-2xl leading-relaxed">
        Behind every tree planted and solar panel installed is a human story of dignity, resilience, and community self-determination. Here are the accounts of those leading change on the ground.
      </p>
    </div>
  </section>

  <!-- 2. IN-DEPTH DOCUMENTARY CASE STUDIES -->
  <section class="py-20 bg-paper border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      {stories.map((story, idx) => (
        <article id={story.id} class={`grid grid-cols-1 lg:grid-cols-12 gap-12 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          <div class="lg:col-span-5 zoom-img-container rounded-3xl overflow-hidden shadow-xl border border-stone-200 bg-white">
            <img src={story.image} alt={story.title} class="w-full h-[420px] object-cover" />
          </div>

          <div class="lg:col-span-7 space-y-5">
            <div class="flex items-center gap-3 text-xs">
              <span class="bg-emerald-100 text-emerald-900 font-bold px-3 py-1 rounded-full">{story.category}</span>
              <span class="text-stone-500 font-mono">📍 {story.village}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-stone-900 leading-snug">
              {story.title}
            </h2>

            <blockquote class="p-5 bg-stone-100 border-l-4 border-emerald-800 rounded-r-2xl italic font-serif text-lg text-stone-800">
              "{story.quote}"
            </blockquote>

            <div class="space-y-2 pt-2">
              <span class="text-xs font-bold text-stone-900 block">— {story.person}</span>
              <p class="text-xs text-stone-600 bg-emerald-50/80 p-3 rounded-xl border border-emerald-200 font-medium">
                🎯 <strong>Verified Field Impact:</strong> {story.impactText}
              </p>
            </div>

            <div class="pt-2">
              <a href="/donate" class="inline-flex items-center gap-2 text-xs font-bold text-emerald-800 hover:underline">
                <span>Support Similar Community Projects</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </article>
      ))}

    </div>
  </section>

  <!-- 3. LARGE EDITORIAL PULL-QUOTE COMPONENT -->
  <section class="py-20 bg-forest text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-amber-300 font-serif italic text-6xl block leading-none">“</span>
      <p class="font-serif italic text-2xl sm:text-4xl leading-snug text-stone-100">
        Nature does not belong to charity organizations. It belongs to the rural families who sleep under its canopy. Our duty is simply to provide the seed funding and get out of their way.
      </p>
      <div class="pt-4 text-xs font-mono text-amber-300">
        — Declaration of Indigenous Land Rights & Community Forestry (2012–2026 Charter)
      </div>
    </div>
  </section>

  <!-- 4. BEFORE & AFTER ECOSYSTEM RESTORATION LOG -->
  <section class="py-20 bg-paper border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase font-mono tracking-wider font-semibold text-emerald-800 block mb-1">Visual Archive</span>
        <h2 class="text-3xl font-bold text-stone-900">Highland Watershed Restoration Case</h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <BeforeAfterSlider 
          client:visible
          beforeImage="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=800&auto=format&fit=crop"
          afterImage="https://images.unsplash.com/photo-1448375240586-882707db888b?q=80&w=800&auto=format&fit=crop"
          beforeTitle="Deforested Mountain Ridge (2016)"
          afterTitle="Mature Closed-Canopy Rainforest (2025)"
          location="Desa Bedugul Buffer Zone"
        />
      </div>
    </div>
  </section>

</Layout>
