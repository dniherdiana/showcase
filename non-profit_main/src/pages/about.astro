---
import Layout from '../layouts/Layout.astro';
import ClientDataTag from '../components/ClientDataTag.astro';

const milestones = [
  {
    year: "2012",
    title: "Foundation Established in Highland Village",
    description: "Founded by a group of environmental scientists and local village elders who refused to let their native watershed erode from commercial deforestation.",
    photo: "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?q=80&w=800&auto=format&fit=crop"
  },
  {
    year: "2016",
    title: "First 50 Partner Villages Milestone",
    description: "Expanded our community-led agroforestry model to 50 highland villages, establishing local women's seedling cooperatives.",
    photo: "https://images.unsplash.com/photo-1511497584788-876761c119ef?q=80&w=800&auto=format&fit=crop"
  },
  {
    year: "2020",
    title: "Mobile Solar Literacy Pods Launched",
    description: "Introduced off-grid solar learning stations to ensure remote village children maintained education during climate emergencies.",
    photo: "https://images.unsplash.com/photo-1509100194014-d49809396dad?q=80&w=1000&auto=format&fit=crop"
  },
  {
    year: "2026",
    title: "145 Villages & 18,000+ Beneficiaries",
    description: "Now operating 5 integrated programs across 145 partner communities with an unbroken 96% direct program funds allocation record.",
    photo: "https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?q=80&w=1200&auto=format&fit=crop"
  }
];

const teamMembers = [
  {
    name: "Dr. Maya Lin",
    role: "Co-Founder & Executive Director",
    bio: "Tropical forest ecologist with 18 years of field research in community-managed indigenous watersheds.",
    photo: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=600&auto=format&fit=crop"
  },
  {
    name: "Bapak Made Suarta",
    role: "Head of Community Governance",
    bio: "Highland village elder and customary leader overseeing 45 indigenous forest management agreements.",
    photo: "https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=600&auto=format&fit=crop"
  },
  {
    name: "Rina Kusumastuti, M.Ed",
    role: "Director of Rural Education",
    bio: "Pioneered off-grid solar learning pod curricula tailored for remote agricultural communities.",
    photo: "https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=600&auto=format&fit=crop"
  }
];
---

<Layout 
  title="About Us | Yayasan Bumi Bersama - Founded 2012"
  description="Learn about Yayasan Bumi Bersama's 14-year history of community-led environmental conservation, rural education, and complete financial transparency."
>

  <!-- 1. ASYMMETRIC STORYTELLING HERO -->
  <section class="bg-paper pt-12 pb-20 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 bg-stone-200 text-stone-800 px-3.5 py-1.5 rounded-full text-xs font-semibold">
            <span>Our Roots & Governance • Established 2012</span>
          </div>

          <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 leading-tight">
            We Don't Manage Forests <span class="font-serif italic font-normal text-emerald-800">From Air-Conditioned Offices.</span>
          </h1>

          <p class="text-base sm:text-lg text-stone-600 leading-relaxed">
            Yayasan Bumi Bersama was founded on a simple truth: environmental conservation fails whenever it treats rural villagers as passive onlookers. True ecological resilience occurs only when local communities own, govern, and benefit directly from their surrounding natural resources.
          </p>

          <div class="p-6 bg-white rounded-2xl border border-stone-200 shadow-sm space-y-2">
            <h3 class="text-sm font-bold text-stone-900 uppercase tracking-wider">Our Fundamental Core Philosophy</h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Every tree seedling planted is nurtured by village elders. Every solar school pod built is maintained by local youth. 96% of all incoming donations fund physical field execution.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="zoom-img-container rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <img 
              src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?q=80&w=1200&auto=format&fit=crop" 
              alt="Founders working with villagers in the field"
              class="w-full h-[460px] object-cover"
            />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. HISTORICAL MILESTONES TIMELINE (2012 - 2026) -->
  <section class="py-20 bg-stone-100 border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-mono tracking-wider font-semibold text-emerald-800 block mb-1">14-Year Documentary Log</span>
        <h2 class="text-3xl font-bold text-stone-900">Our Journey of Community Growth</h2>
      </div>

      <div class="space-y-12">
        {milestones.map((m, idx) => (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <div class="lg:col-span-5 zoom-img-container rounded-2xl overflow-hidden shadow-md border border-stone-200 bg-white">
              <img src={m.photo} alt={m.title} class="w-full h-64 object-cover" />
            </div>

            <div class="lg:col-span-7 space-y-3">
              <span class="text-3xl font-serif font-bold text-emerald-800 bg-emerald-100 px-4 py-1 rounded-xl inline-block">
                {m.year}
              </span>
              <h3 class="text-2xl font-bold text-stone-900">{m.title}</h3>
              <p class="text-sm text-stone-600 leading-relaxed max-w-xl">
                {m.description}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. TEAM & COMMUNITY FIELD LEADERS -->
  <section class="py-20 bg-paper border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs uppercase font-mono tracking-wider font-semibold text-terracotta">Field Operations</span>
          <h2 class="text-3xl font-bold text-stone-900 mt-1">Our Leadership & Community Elders</h2>
        </div>
        <p class="text-xs text-stone-500 max-w-md">
          Guided by seasoned environmental scientists, educators, and indigenous village representatives working side-by-side.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-sm hover:shadow-lg transition-all group">
            <div class="h-64 zoom-img-container bg-stone-100">
              <img 
                src={member.photo} 
                alt={member.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-stone-900">{member.name}</h3>
              <span class="text-xs font-semibold text-emerald-800 block mt-0.5 mb-3">{member.role}</span>
              <p class="text-xs text-stone-600 leading-relaxed">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. FINANCIAL TRANSPARENCY & PUBLIC REPORTS DOWNLOAD -->
  <section id="transparency" class="py-20 bg-stone-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs uppercase font-mono tracking-wider font-semibold text-amber-400 bg-amber-950/80 px-3 py-1 rounded-full border border-amber-800/60">
            Uncompromising Accountability
          </span>

          <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
            Radical Financial Transparency. Published Every Single Year.
          </h2>

          <p class="text-sm text-stone-300 leading-relaxed">
            We publish complete, unedited audited financial statements every December. Every dollar donated is logged with matching field receipts for native saplings, school supplies, and clean water infrastructure.
          </p>

          <div class="p-6 bg-stone-950 rounded-2xl border border-stone-800 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="text-stone-400">Direct Program Implementation:</span>
              <span class="font-mono font-bold text-emerald-400 text-base">96%</span>
            </div>
            <div class="w-full bg-stone-800 h-2 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full w-[96%]"></div>
            </div>
            <div class="flex items-center justify-between text-[11px] text-stone-500 pt-1">
              <span>Admin & Statutory Compliance: 4%</span>
              <span>Audited by Independent CPA</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-4">
          <h3 class="text-lg font-bold text-white mb-4">Download Public Annual Reports (PDF)</h3>

          <div class="bg-stone-800 p-5 rounded-2xl border border-stone-700 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-amber-400 uppercase font-mono">2025 Annual Impact & Financial Report</span>
              <p class="text-xs text-stone-300 mt-1">Full breakdown of 145 village programs & audited balance sheet</p>
              <div class="mt-2">
                <ClientDataTag text="Link Download PDF Laporan Tahun 2025" />
              </div>
            </div>
            <span class="text-2xl">📥</span>
          </div>

          <div class="bg-stone-800 p-5 rounded-2xl border border-stone-700 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-amber-400 uppercase font-mono">2024 Annual Impact & Financial Report</span>
              <p class="text-xs text-stone-300 mt-1">Audit of 120 partner village programs & solar school launches</p>
              <div class="mt-2">
                <ClientDataTag text="Link Download PDF Laporan Tahun 2024" />
              </div>
            </div>
            <span class="text-2xl">📥</span>
          </div>

          <div class="bg-stone-800 p-5 rounded-2xl border border-stone-700 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-amber-400 uppercase font-mono">2023 Annual Impact & Financial Report</span>
              <p class="text-xs text-stone-300 mt-1">Audit of native watershed reforestation & clean water spring builds</p>
              <div class="mt-2">
                <ClientDataTag text="Link Download PDF Laporan Tahun 2023" />
              </div>
            </div>
            <span class="text-2xl">📥</span>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
