---
const pathname = new URL(Astro.request.url).pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/programs", label: "Programs" },
  { href: "/impact-stories", label: "Impact Stories" },
  { href: "/get-involved", label: "Get Involved" },
  { href: "/news", label: "News" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-[#f7f6f0]/90 backdrop-blur-md border-b border-stone-200/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-emerald-800 text-amber-300 flex items-center justify-center font-serif text-xl font-bold group-hover:scale-105 transition-transform shadow-sm">
          🌱
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-lg text-stone-900 tracking-tight leading-none font-sans">
            Yayasan Bumi Bersama
          </span>
          <span class="text-[11px] text-stone-500 font-medium tracking-wider uppercase mt-1">
            Environment & Rural Empowerment
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 bg-stone-200/50 p-1.5 rounded-full border border-stone-300/60">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-full text-xs font-semibold transition-all ${
                isActive
                  ? "bg-emerald-800 text-white shadow-xs"
                  : "text-stone-700 hover:text-stone-900 hover:bg-stone-200/80"
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Action Button -->
      <div class="flex items-center gap-3">
        <a
          href="/donate"
          class="bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-bold px-5 py-3 rounded-full transition-all shadow-md hover:shadow-emerald-900/20 flex items-center gap-2"
        >
          <span>Donate Now</span>
          <span class="text-amber-300">💚</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle Navigation Menu"
          class="lg:hidden p-2 rounded-xl text-stone-700 hover:bg-stone-200 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#f7f6f0] border-b border-stone-200 px-4 pt-2 pb-6 space-y-2">
    {navLinks.map((link) => {
      const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-sm font-semibold transition-colors ${
            isActive
              ? "bg-emerald-800 text-white"
              : "text-stone-800 hover:bg-stone-200"
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <a
      href="/donate"
      class="block text-center bg-emerald-800 text-white font-bold py-3.5 px-4 rounded-xl text-sm mt-4 shadow-sm"
    >
      Donate Now
    </a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
