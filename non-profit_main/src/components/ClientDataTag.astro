---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 bg-amber-100 border border-dashed border-amber-600 text-amber-900 px-2.5 py-1 rounded font-mono text-xs font-bold tracking-tight shadow-xs my-1">
  <span class="w-2 h-2 rounded-full bg-amber-600 animate-ping"></span>
  <span>[PERLU DATA CLIENT: {text}]</span>
</span>
