---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/beranda/Hero.astro";
import ProofRow from "../components/beranda/ProofRow.astro";
import AboutFeature from "../components/beranda/AboutFeature.astro";
import MasterplanGallery from "../components/beranda/MasterplanGallery.astro";
import UnitPricing from "../components/beranda/UnitPricing.astro";
import Testimonials from "../components/beranda/Testimonials.astro";
import KprCalculator from "../components/beranda/KprCalculator.astro";
import LeadForm from "../components/beranda/LeadForm.astro";
import CtaBand from "../components/shared/CtaBand.astro";
import { unitTypes } from "../data/beranda/unitPricing.js";
import { getImage } from "astro:assets";
import hero from "@assets/images/hero.jpg";

const heroWebp = await getImage({
	src: hero,
	format: "webp",
	quality: 70,
	width: 896,
});

const parsePrice = (price: string) => Number(price.replace(/\D/g, ""));

const heroImageURL = new URL(
	heroWebp.src,
	Astro.site ?? "https://grandsamudraresidence.co.id",
).href;

const unitOffers = unitTypes.map((unit) => ({
	"@type": "Offer",
	name: unit.name,
	url: `https://grandsamudraresidence.co.id/properti/#${unit.id}`,
	price: String(parsePrice(unit.price)),
	priceCurrency: "IDR",
	availability: "https://schema.org/InStock",
	itemOffered: {
		"@type": "Product",
		name: unit.name,
		description: unit.features.join(", "),
	},
}));

const structuredData = {
	"@type": "Product",
	name: "Grand Samudra Cluster",
	description:
		"Cluster perumahan modern dengan pilihan tipe Type 54, Type 72, dan Type 90 lengkap dengan skema KPR fleksibel.",
	image: heroImageURL,
	brand: { "@type": "Brand", name: "Grand Samudra Residence" },
	offers: {
		"@type": "AggregateOffer",
		lowPrice: String(parsePrice("Rp 780.000.000")),
		highPrice: String(parsePrice("Rp 1.620.000.000")),
		priceCurrency: "IDR",
		offerCount: String(unitTypes.length),
		offers: unitOffers,
	},
};
---

<Layout structuredData={structuredData}>
	<main class="relative z-10">
		<Hero />
		<ProofRow />
		<AboutFeature />
		<MasterplanGallery />
		<UnitPricing />
		<Testimonials />
		<KprCalculator />
		<LeadForm />
		<CtaBand />

		<!-- Floating Sticky WhatsApp Consultation Button (Safe Area Inset Compliant) -->
		<div class="fixed bottom-6 right-6 z-40 mb-[env(safe-area-inset-bottom)]">
			<a
				href="https://wa.me/6281234567890?text=Halo%20Tim%20Marketing%20Grand%20Samudra,%20saya%20ingin%20tanya%20mengenai%20ketersediaan%20unit%20dan%20jadwal%20survei"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Konsultasi via WhatsApp Marketing Analyst"
				class="flex items-center gap-3 bg-canvas-subtle/95 hover:bg-canvas-hover text-slate-100 border border-amber-400/40 p-3 pr-5 rounded-full shadow-2xl group transition-all duration-300 hover:scale-105 min-h-11"
			>
				<div
					class="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center text-slate-950 shadow-md shrink-0"
				>
					<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
						<path
							d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
						></path>
					</svg>
				</div>
				<div class="text-left hidden sm:block">
					<span class="block text-[11px] font-semibold text-amber-300"
						>Tanya Tim Marketing</span
					>
					<span class="block text-[10px] text-slate-300 font-normal"
						>Respon cepat & Konsultasi KPR</span
					>
				</div>
			</a>
		</div>
	</main>
</Layout>
