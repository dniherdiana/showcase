---
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/kontak/ContactHero.astro';
import ContactInfoCards from '../components/kontak/ContactInfoCards.astro';
import ContactFormSection from '../components/kontak/ContactFormSection.astro';
import ContactMapSection from '../components/kontak/ContactMapSection.astro';
import ContactFaqAccordion from '../components/kontak/ContactFaqAccordion.astro';
import { faqContent } from '../data/kontak/contactFaqAccordion.js';
import { getImage } from 'astro:assets';
import living from '@assets/images/living.jpg';

const livingWebp = await getImage({
	src: living,
	format: 'webp',
	quality: 80,
	width: 1200,
});

const heroImageURL = new URL(livingWebp.src, Astro.site ?? 'https://grandsamudraresidence.co.id').href;

const structuredData = [
	{
		'@type': 'LocalBusiness',
		name: 'Grand Samudra Marketing Gallery',
		image: heroImageURL,
		url: 'https://grandsamudraresidence.co.id/kontak/',
		telephone: '+6281234567890',
		email: 'info@grandsamudrafamily.id',
		address: {
			'@type': 'PostalAddress',
			streetAddress: 'Jl. Boulevard Samudra Residence No. 1',
			addressLocality: 'Bandung Selatan',
			postalCode: '40288',
			addressCountry: 'ID',
		},
		openingHoursSpecification: [
			{
				'@type': 'OpeningHoursSpecification',
				dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
				opens: '08:00',
				closes: '17:30',
			},
			{
				'@type': 'OpeningHoursSpecification',
				dayOfWeek: ['Saturday', 'Sunday'],
				opens: '08:00',
				closes: '18:00',
			},
		],
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqContent.items.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
];

const canonicalURL = 'https://grandsamudraresidence.co.id/kontak/';
---

<Layout
  title="Hubungi & Kunjungi Kami — PT Grand Samudra Residence"
  description="Jadwalkan private viewing ke Marketing Gallery Grand Samudra Residence, konsultasikan skema KPR bergaransi, dan temukan peta lokasi kawasan terpadu kami."
  canonicalURL={canonicalURL}
  structuredData={structuredData}
>
  <main class="relative z-10">
    <ContactHero />
    <ContactInfoCards />
    <ContactFormSection />
    <ContactMapSection />
    <ContactFaqAccordion />
  </main>

  <!-- Floating Sticky WhatsApp Consultation Button -->
  <div class="fixed bottom-6 right-6 z-40 mb-[env(safe-area-inset-bottom)]">
    <a
      href="https://wa.me/6281234567890?text=Halo%20Tim%20Grand%20Samudra,%20saya%20ingin%20jadwalkan%20survei%20ke%20Marketing%20Gallery"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Konsultasi Kunjungan via WhatsApp"
      class="flex items-center gap-3 bg-canvas-subtle/95 hover:bg-canvas-hover text-slate-100 border border-amber-400/40 p-3 pr-5 rounded-full shadow-2xl group transition-all duration-300 hover:scale-105 min-h-11"
    >
      <div class="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center text-slate-950 shadow-md shrink-0">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
      </div>
      <div class="text-left hidden sm:block">
        <span class="block text-[11px] font-semibold text-amber-300">Respon Cepat Marketing</span>
        <span class="block text-[10px] text-slate-300 font-normal">Buka 08.00 - 17.30 WIB</span>
      </div>
    </a>
  </div>
</Layout>
