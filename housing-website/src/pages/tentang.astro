---
import Layout from "../layouts/Layout.astro";
import DeveloperHero from "../components/tentang/DeveloperHero.astro";
import DeveloperStory from "../components/tentang/DeveloperStory.astro";
import DeveloperValues from "../components/tentang/DeveloperValues.astro";
import DeveloperTimeline from "../components/tentang/DeveloperTimeline.astro";
import DeveloperStats from "../components/tentang/DeveloperStats.astro";
import CtaBand from "../components/shared/CtaBand.astro";

const structuredData = {
	"@type": "Organization",
	name: "PT Grand Samudra Residence",
	legalName: "PT Grand Samudra Residence",
	url: "https://grandsamudraresidence.co.id/tentang/",
	description:
		"Pengembang kawasan hunian terpadu dengan standar rekayasa hidrologi bebas banjir dan legalitas 100% SHM pecah sebelum pemasaran.",
	email: "info@grandsamudrafamily.id",
	telephone: "+6281234567890",
	foundingDate: "2022",
	founder: { "@type": "Person", name: "Grand Samudra Development" },
	address: {
		"@type": "PostalAddress",
		streetAddress: "Jl. Boulevard Samudra Residence No. 1",
		addressLocality: "Bandung Selatan",
		addressCountry: "ID",
	},
};

const structuredDataList = [
	structuredData,
	{
		"@type": "WebSite",
		name: "Grand Samudra Residence",
		url: "https://grandsamudraresidence.co.id/",
		inLanguage: "id-ID",
	},
];
---

<Layout
	title="Tentang Developer — PT Grand Samudra Residence"
	description="Mengenal PT Grand Samudra Residence, pengembang kawasan hunian terpadu dengan standar rekayasa hidrologi bebas banjir dan legalitas 100% SHM pecah sebelum pemasaran."
	structuredData={structuredDataList}
>
	<main class="relative z-10">
		<DeveloperHero />
		<DeveloperStory />
		<DeveloperValues />
		<DeveloperTimeline />
		<DeveloperStats />
		<CtaBand />
	</main>

	<!-- Floating Sticky WhatsApp Consultation Button -->
	<div class="fixed bottom-6 right-6 z-40 mb-[env(safe-area-inset-bottom)]">
		<a
			href="https://wa.me/6281234567890?text=Halo%20Tim%20Grand%20Samudra,%20saya%20ingin%20tanya%20mengenai%20profil%20developer%20dan%20legalitas%20proyek"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Konsultasi Developer via WhatsApp"
			class="flex items-center gap-3 bg-canvas-subtle/95 hover:bg-canvas-hover text-slate-100 border border-amber-400/40 p-3 pr-5 rounded-full shadow-2xl group transition-all duration-300 hover:scale-105 min-h-11"
		>
			<div
				class="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center text-slate-950 shadow-md shrink-0"
			>
				<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
					<path
						d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
					></path>
				</svg>
			</div>
			<div class="text-left hidden sm:block">
				<span class="block text-[11px] font-semibold text-amber-300"
					>Tanya Tim Legal & Proyek</span
				>
				<span class="block text-[10px] text-slate-300 font-normal"
					>Transparansi Legalitas 100%</span
				>
			</div>
		</a>
	</div>
</Layout>
