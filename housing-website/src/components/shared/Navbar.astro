---
import {
	brand,
	navLinks,
	mobileNavLinks,
	whatsappMarketing,
} from "../../data/shared/navbar.js";

const pathname = Astro.url.pathname;
const normalizedPath =
	pathname.endsWith("/") && pathname.length > 1 ?
		pathname.slice(0, -1)
	:	pathname;

const isLinkActive = (linkHref: string) => {
	const normalizedHref =
		linkHref.endsWith("/") && linkHref.length > 1 ?
			linkHref.slice(0, -1)
		:	linkHref;
	if (normalizedHref === "" || normalizedHref === "/") {
		return normalizedPath === "" || normalizedPath === "/";
	}
	return normalizedPath.startsWith(normalizedHref);
};
---

<header
	class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-canvas-default/90 backdrop-blur-sm border-b border-slate-800/60"
>
	<div
		class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between"
	>
		<a
			href={brand.href}
			class="group flex items-center gap-3 focus-visible:outline-amber-400"
		>
			<div
				class="w-10 h-10 rounded-sm bg-linear-to-tr from-amber-600 to-amber-300 flex items-center justify-center text-slate-950 font-serif font-medium text-xl tracking-tighter shadow-lg shadow-amber-500/10"
			>
				{brand.initial}
			</div>
			<div>
				<span
					class="font-serif text-xl tracking-wide font-medium text-slate-100 group-hover:text-amber-300 transition-colors"
				>
					{brand.name}
				</span>
				<span
					class="block text-[10px] tracking-widest uppercase text-slate-400 font-sans font-normal"
				>
					{brand.tagline}
				</span>
			</div>
		</a>

		<!-- Desktop Navigation Menu -->
		<nav
			aria-label="Navigasi Utama"
			class="hidden md:flex items-center gap-2 text-xs font-medium"
		>
			{
				navLinks.map((link) => {
					const active = isLinkActive(link.href);
					return (
						<a
							href={link.href}
							class={`relative group inline-flex items-center px-4 py-2 text-xs font-semibold tracking-wide transition-all duration-300 rounded-full ${
								active ?
									"text-amber-300 bg-amber-500/10 border border-amber-400/40 shadow-[0_0_20px_rgba(251,191,36,0.18)]"
								:	"text-slate-300 hover:text-slate-100 hover:bg-slate-800/50 border border-transparent"
							}`}
						>
							<span>{link.label}</span>

							{/* Active Bottom Glowing Line for Desktop */}
							{active && (
								<span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-8 h-0.5 bg-linear-to-r from-amber-400/20 via-amber-400 to-amber-400/20 rounded-full shadow-[0_0_10px_rgba(251,191,36,0.9)]" />
							)}
						</a>
					);
				})
			}
		</nav>

		<div class="flex items-center gap-4">
			<a
				href={whatsappMarketing.url}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden sm:inline-flex items-center gap-2 px-5 py-3 text-xs font-semibold tracking-wide text-slate-950 bg-linear-to-r from-amber-300 via-amber-400 to-amber-200 hover:from-amber-200 hover:to-amber-300 rounded-sm transition-all duration-300 shadow-md shadow-amber-500/20 active:scale-95 min-h-11"
			>
				<svg
					class="w-4 h-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
					></path>
				</svg>
				<span>{whatsappMarketing.label}</span>
			</a>

			<button
				type="button"
				id="mobile-menu-trigger"
				aria-label="Buka Menu Navigasi Mobile"
				aria-expanded="false"
				aria-controls="mobile-nav-drawer"
				class="md:hidden flex items-center justify-center w-11 h-11 text-slate-200 hover:text-amber-300 border border-slate-800 rounded-sm bg-slate-900/80 active:bg-slate-800"
			>
				<svg
					class="w-6 h-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					id="hamburger-icon"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg
					class="w-6 h-6 hidden"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					id="close-icon"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer -->
	<div
		id="mobile-nav-drawer"
		class="hidden md:hidden fixed inset-x-0 top-20 bg-canvas-default/98 border-b border-slate-800 shadow-2xl p-6 space-y-4 animate-in slide-in-from-top duration-300"
	>
		<nav class="flex flex-col space-y-2 font-medium text-sm text-slate-200">
			{
				mobileNavLinks.map((link) => {
					const active = isLinkActive(link.href);
					return (
						<a
							href={link.href}
							class={`mobile-link py-3 px-4 transition-all duration-200 ${
								active ?
									"border-b-2 border-amber-400 bg-amber-500/10 text-amber-300 font-semibold"
								:	"border-b border-slate-800/60 text-slate-300 hover:text-white hover:border-slate-700 hover:bg-slate-900/60"
							}`}
						>
							{link.label}
						</a>
					);
				})
			}
		</nav>
		<div class="pt-4 border-t border-slate-800 flex flex-col gap-3">
			<a
				href={whatsappMarketing.url}
				target="_blank"
				class="w-full text-center py-3.5 px-4 text-xs font-semibold text-slate-950 bg-linear-to-r from-amber-300 to-amber-200 rounded-sm shadow-md"
			>
				{whatsappMarketing.mobileLabel}
			</a>
		</div>
	</div>
</header>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const trigger = document.getElementById("mobile-menu-trigger");
		const drawer = document.getElementById("mobile-nav-drawer");
		const hamburgerIcon = document.getElementById("hamburger-icon");
		const closeIcon = document.getElementById("close-icon");
		const mobileLinks = document.querySelectorAll(".mobile-link");

		if (trigger && drawer) {
			trigger.addEventListener("click", () => {
				const isExpanded = trigger.getAttribute("aria-expanded") === "true";
				trigger.setAttribute("aria-expanded", (!isExpanded).toString());

				drawer.classList.toggle("hidden");
				hamburgerIcon?.classList.toggle("hidden");
				closeIcon?.classList.toggle("hidden");
			});

			mobileLinks.forEach((link) => {
				link.addEventListener("click", () => {
					drawer.classList.add("hidden");
					trigger.setAttribute("aria-expanded", "false");
					hamburgerIcon?.classList.remove("hidden");
					closeIcon?.classList.add("hidden");
				});
			});
		}
	});
</script>
