---
import { leadFormContent } from "../../data/beranda/leadForm.js";
---

<section
	id="contact"
	class="py-24 bg-canvas-night border-t border-slate-800 relative"
>
	<div class="max-w-7xl mx-auto px-6 lg:px-12">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			<div data-reveal="left" class="lg:col-span-5 space-y-6">
				<div
					class="inline-flex items-center gap-2 text-xs font-mono text-amber-300 bg-amber-500/10 px-3 py-1 rounded-sm border border-amber-500/20"
				>
					<span>{leadFormContent.badge}</span>
				</div>
				<h2
					class="font-serif text-3xl sm:text-4xl font-normal text-slate-50 leading-[1.18] tracking-tight"
				>
					{leadFormContent.headline}
				</h2>
				<p
					class="text-slate-200 font-normal text-sm sm:text-base leading-relaxed"
				>
					{leadFormContent.subtext}
				</p>

				<div class="space-y-3 pt-2 text-xs text-slate-300 font-normal">
					{
						leadFormContent.guarantees.map((g) => (
							<div class="flex items-center gap-3">
								<span class="w-2 h-2 rounded-full bg-emerald-400" />
								<span>{g}</span>
							</div>
						))
					}
				</div>
			</div>

			<div
				data-reveal="right"
				class="lg:col-span-7 bg-canvas-raised border border-slate-800 p-8 sm:p-10 rounded-sm shadow-2xl space-y-6"
			>
				<form id="inline-lead-form" class="space-y-5">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
						<div class="space-y-2">
							<label
								for="lead-name"
								class="block text-xs font-semibold text-slate-200"
								>Nama Lengkap</label
							>
							<input
								type="text"
								id="lead-name"
								required
								placeholder="Contoh: Hendra Wijaya"
								class="w-full px-4 py-3 bg-slate-900 border border-slate-700 focus:border-amber-400 rounded-sm text-sm text-slate-100 placeholder:text-slate-500 focus-visible:outline-amber-400 min-h-11"
							/>
						</div>

						<div class="space-y-2">
							<label
								for="lead-phone"
								class="block text-xs font-semibold text-slate-200"
								>Nomor Telepon / WhatsApp</label
							>
							<input
								type="tel"
								id="lead-phone"
								required
								placeholder="0812-XXXX-XXXX"
								class="w-full px-4 py-3 bg-slate-900 border border-slate-700 focus:border-amber-400 rounded-sm text-sm text-slate-100 placeholder:text-slate-500 focus-visible:outline-amber-400 min-h-11"
							/>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
						<div class="space-y-2">
							<label
								for="lead-email"
								class="block text-xs font-semibold text-slate-200"
								>Alamat Email (Opsional)</label
							>
							<input
								type="email"
								id="lead-email"
								placeholder="nama@email.com"
								class="w-full px-4 py-3 bg-slate-900 border border-slate-700 focus:border-amber-400 rounded-sm text-sm text-slate-100 placeholder:text-slate-500 focus-visible:outline-amber-400 min-h-11"
							/>
						</div>

						<div class="space-y-2">
							<label
								for="lead-unit"
								class="block text-xs font-semibold text-slate-200"
								>Minat Tipe Unit</label
							>
							<select
								id="lead-unit"
								class="w-full px-4 py-3 bg-slate-900 border border-slate-700 focus:border-amber-400 rounded-sm text-sm text-slate-100 focus-visible:outline-amber-400 min-h-11"
							>
								{
									leadFormContent.unitOptions.map((opt) => (
										<option value={opt.value}>{opt.label}</option>
									))
								}
							</select>
						</div>
					</div>

					<div class="space-y-2">
						<label
							for="lead-date"
							class="block text-xs font-semibold text-slate-200"
							>Rencana Tanggal Kunjungan / Telepon</label
						>
						<input
							type="date"
							id="lead-date"
							class="w-full px-4 py-3 bg-slate-900 border border-slate-700 focus:border-amber-400 rounded-sm text-sm text-slate-100 focus-visible:outline-amber-400 min-h-11"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-4 px-6 text-xs font-semibold tracking-wide text-slate-950 bg-linear-to-r from-amber-300 via-amber-400 to-amber-200 hover:from-amber-200 hover:to-amber-300 rounded-sm transition-all shadow-lg shadow-amber-500/15 min-h-11"
					>
						Kirim Permintaan Konsultasi & Jadwal Visit
					</button>
				</form>
			</div>
		</div>
	</div>
</section>

<script>
	document
		.getElementById("inline-lead-form")
		?.addEventListener("submit", (e) => {
			e.preventDefault();
			alert(
				"Terima kasih. Tim Marketing Analyst kami akan menghubungi Anda dalam 1x24 jam.",
			);
		});
</script>
