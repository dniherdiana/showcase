---
import { Image } from "astro:assets";
import hero from "@assets/images/hero.jpg";
import { heroContent } from "../../data/beranda/hero.js";
---

<section
	id="hero-section"
	class="relative min-h-screen pt-28 pb-20 flex items-center overflow-hidden"
>
	<div class="max-w-7xl mx-auto px-6 lg:px-12 w-full">
		<div
			class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-stretch"
		>
			<!-- Left: Content -->
			<div
				class="lg:col-span-7 flex flex-col justify-between space-y-8 z-10 hero-rv-home"
			>
				<div class="space-y-6">
					<h1
						id="hero-headline"
						class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal leading-[1.14] tracking-tight text-slate-50 hyphens-auto"
					>
						{heroContent.headline}
					</h1>

					<p
						id="hero-subtext"
						class="text-base sm:text-lg text-slate-200 font-normal leading-relaxed max-w-2xl"
					>
						{heroContent.subtext}
					</p>
				</div>

				<div class="space-y-6 pt-2">
					<div
						class="pt-4 border-t border-slate-800/80 flex flex-wrap gap-x-8 gap-y-3 text-xs sm:text-sm text-slate-300 font-normal"
					>
						{
							heroContent.differentiators.map((d) => (
								<div class="flex items-center gap-2">
									<span class="w-1.5 h-1.5 rounded-full bg-amber-400" />
									<span>{d}</span>
								</div>
							))
						}
					</div>

					<div
						class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4"
					>
						<a
							href={heroContent.primaryCta.href}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex justify-center items-center gap-3 px-7 py-4 text-xs sm:text-sm font-semibold tracking-wide text-slate-950 bg-linear-to-r from-amber-300 via-amber-400 to-amber-200 hover:from-amber-200 hover:to-amber-300 rounded-sm transition-all duration-300 shadow-lg shadow-amber-500/15 group active:scale-[0.98] min-h-11"
						>
							<span>{heroContent.primaryCta.label}</span>
							<svg
								class="w-4 h-4 group-hover:translate-x-1 transition-transform"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
							</svg>
						</a>

						<a
							href={heroContent.secondaryCta.href}
							class="inline-flex justify-center items-center gap-2 px-6 py-4 text-xs sm:text-sm font-medium text-slate-200 hover:text-white border border-slate-700/80 hover:border-slate-500 rounded-sm transition-colors duration-300 min-h-11"
						>
							<span>{heroContent.secondaryCta.label}</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Right: Image -->
			<div
				class="lg:col-span-5 relative mt-6 lg:mt-0 h-full flex flex-col hero-rv-home-img"
			>
				<div
					id="hero-image-wrapper"
					class="relative rounded-sm overflow-hidden border border-slate-800 shadow-2xl bg-slate-900 group h-full min-h-105 lg:min-h-full flex flex-col justify-end"
				>
					<Image
						src={hero}
						alt="Fasad Perumahan Cluster Modern Grand Samudra"
						fetchpriority="high"
						loading="eager"
						widths={[480, 640, 800]}
						sizes="(min-width:1024px) 40vw, 100vw"
						quality={40}
						class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
					/>

					<div
						class="absolute inset-0 bg-linear-to-t from-canvas-default/95 via-canvas-default/30 to-transparent"
					>
					</div>

					<div
						class="relative z-20 m-4 sm:m-5 bg-canvas-subtle/10 p-4 sm:p-5 rounded-sm border border-amber-400/30 shadow-2xl space-y-2"
					>
						<div class="flex items-center justify-between text-xs">
							<span
								class="font-semibold text-amber-300 uppercase tracking-wider font-mono"
								>{heroContent.promoCard.badge}</span
							>
							<span
								class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20"
								>{heroContent.promoCard.unitsLeft}</span
							>
						</div>
						<p class="text-xs text-slate-200 font-normal leading-relaxed">
							{heroContent.promoCard.text}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
