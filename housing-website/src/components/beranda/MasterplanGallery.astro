---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import park from "@assets/images/park.jpg";
import living from "@assets/images/living.jpg";
import { masterplanContent } from "../../data/beranda/masterplanGallery.js";

const featureImages: Record<string, ImageMetadata> = { park, living };

const amenityIcons: Record<string, string> = {
	"01": '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
	"02": '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
	"03": '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
	"04": '<path d="M8 19h8"/><path d="M8 19a4 4 0 0 1-1.42-7.78 5 5 0 0 1 9.84-1.46A3.5 3.5 0 0 1 16 19H8z"/>',
};
---

<section
	class="py-28 bg-canvas-midnight border-t border-slate-800/80 relative overflow-hidden"
>
	<div class="absolute inset-0 bg-ambient-glow-right pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10 space-y-16">
		<div
			data-reveal="left"
			class="flex flex-col md:flex-row md:items-end justify-between gap-8 border-b border-slate-800/80 pb-10"
		>
			<div class="max-w-2xl space-y-3">
				<span
					class="text-xs font-mono text-amber-300 uppercase tracking-widest font-semibold"
				>
					<span class="border h-3 border-l bg-amber-400 justify-center mr-2"
					></span>
					{masterplanContent.sectionTag}
				</span>
				<h2
					class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-slate-50 leading-[1.18] tracking-tight"
				>
					{masterplanContent.headline}
				</h2>
			</div>
			<p class="text-sm text-slate-300 max-w-md font-normal leading-relaxed">
				{masterplanContent.subtext}
			</p>
		</div>

		<div
			data-reveal="fade"
			class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-slate-800/60 border border-slate-800/60 rounded-sm overflow-hidden"
		>
			{
				masterplanContent.highlightStats.map((stat) => (
					<div class="bg-canvas-midnight px-6 py-7 text-center space-y-1">
						<span class="block font-serif text-3xl sm:text-4xl text-amber-300 font-normal">
							{stat.value}
						</span>
						<span class="block text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider font-mono">
							{stat.label}
						</span>
					</div>
				))
			}
		</div>

		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">
			{
				masterplanContent.features.map((feature, i) => (
					<div
						data-reveal={i === 0 ? "zoom" : "fade"}
						class={`relative ${i === 0 ? "md:col-span-7" : "md:col-span-5"} group rounded-sm overflow-hidden border border-slate-800 bg-slate-950 shadow-2xl min-h-95 sm:min-h-115`}
					>
						<div class="absolute inset-0">
							<Image
								src={featureImages[feature.image]}
								alt={feature.alt}
								loading="lazy"
								format="webp"
								quality={80}
								class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
							/>
						</div>
						<div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/40 to-transparent" />
						<div class="absolute inset-x-0 bottom-0 p-6 sm:p-7 flex flex-col justify-end space-y-4">
							<div class="space-y-1">
								<span class="text-xs font-mono text-amber-300 uppercase tracking-wider font-semibold">
									{feature.badge}
								</span>
								<h3 class="font-serif text-2xl text-slate-50 font-medium">
									{feature.title}
								</h3>
								<p class="text-xs text-slate-300 font-normal max-w-lg leading-relaxed">
									{feature.description}
								</p>
							</div>
							<div class="grid grid-cols-3 gap-2 pt-3 border-t border-slate-700/60">
								{feature.stats.map((stat) => (
									<div class="bg-slate-900/60 border border-slate-700/60 rounded-sm px-2.5 py-2 text-center">
										<span class="block text-amber-300 font-mono text-sm font-semibold">
											{stat.value}
										</span>
										<span class="block text-[10px] text-slate-400 leading-tight">
											{stat.label}
										</span>
									</div>
								))}
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="pt-2">
			<div
				class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8"
			>
				<h3
					class="font-serif text-2xl sm:text-3xl text-slate-100 font-normal leading-snug max-w-xl"
				>
					Fasilitas yang menunjang kenyamanan dan keamanan keluarga Anda.
				</h3>
				<span
					class="text-xs font-mono text-slate-400 uppercase tracking-widest"
				>
					Infrastruktur &amp; Fasilitas Komunitas
				</span>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{
					masterplanContent.amenities.map((a, i) => (
						<div
							data-reveal="zoom"
							class="group bg-canvas-default/80 border border-slate-800 hover:border-amber-400/40 rounded-sm p-6 transition-colors duration-300 flex flex-col gap-4"
						>
							<div class="flex items-center gap-3">
								<span class="w-9 h-9 rounded-sm bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-300 shrink-0">
									<svg
										class="w-4.5 h-4.5 shrink-0"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
										set:html={amenityIcons[a.number] ?? ""}
									/>
								</span>
								<div class="min-w-0">
									<span class="block font-semibold text-slate-100 text-sm leading-tight">
										{a.title}
									</span>
									<span class="block text-[11px] text-amber-300/80 font-mono uppercase tracking-wide">
										{a.subtitle}
									</span>
								</div>
							</div>
							<p class="text-xs text-slate-300 font-normal leading-relaxed">
								{a.description}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
