---
import { comparisonData } from "../../data/properti/typeComparisonMatrix.js";
---

<section class="py-24 bg-canvas-ink border-t border-slate-800/80 relative">
	<div class="max-w-7xl mx-auto px-6 lg:px-12 space-y-12">
		<div class="max-w-3xl space-y-4">
			<div
				data-reveal="fade"
				class="inline-flex items-center gap-2 text-xs font-mono text-amber-300 bg-amber-500/10 px-3 py-1 rounded-sm border border-amber-500/20"
			>
				<span>{comparisonData.badge}</span>
			</div>
			<h2
				data-reveal="fade"
				class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-slate-50 leading-[1.18] tracking-tight"
			>
				{comparisonData.headline}
			</h2>
			<p
				data-reveal="fade"
				class="text-slate-200 font-normal text-base leading-relaxed"
			>
				{comparisonData.subtext}
			</p>
		</div>

		<div
			data-reveal="zoom"
			class="overflow-x-auto border border-slate-800 rounded-sm bg-canvas-raised shadow-2xl"
		>
			<table
				class="w-full text-left text-xs sm:text-sm text-slate-200 border-collapse"
			>
				<thead>
					<tr
						class="border-b border-slate-800 bg-canvas-elevated text-amber-300 font-mono uppercase tracking-wider text-xs"
					>
						{
							comparisonData.columns.map((col, i) => (
								<th
									class={`p-5 font-semibold ${i > 0 ? "text-center border-l border-slate-800" : ""} ${col.featured ? "bg-amber-500/10 text-amber-300" : ""}`}
								>
									{col.label}
								</th>
							))
						}
					</tr>
				</thead>

				<tbody class="divide-y divide-slate-800/80 font-normal">
					{
						comparisonData.rows.map((row) => (
							<tr class="hover:bg-slate-900/40">
								<td class="p-5 font-semibold text-slate-100">{row.label}</td>
								{row.values.map((val, i) => (
									<td
										class={`p-5 text-center border-l border-slate-800 ${i === row.featuredIndex ? "bg-amber-500/5 font-semibold text-amber-300" : "text-slate-300"}`}
									>
										{val}
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>
