---
import { propertyHeroContent } from "../../data/properti/propertyHero.js";
---

<section class="relative pt-36 pb-16 border-b border-slate-800/80">
	<div class="max-w-7xl mx-auto px-6 lg:px-12 w-full">
		<div class="max-w-3xl space-y-6 hero-rv-property">
			<div
				class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-md bg-amber-500/10 border border-amber-500/20 text-xs font-mono text-amber-300"
			>
				<span>{propertyHeroContent.badge}</span>
			</div>

			<h1
				class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.14] tracking-tight text-slate-50 hyphens-auto"
			>
				{propertyHeroContent.headline}
			</h1>

			<p
				class="text-base sm:text-lg text-slate-200 font-normal leading-relaxed"
			>
				{propertyHeroContent.subtext}
			</p>

			<div
				class="pt-4 border-t border-slate-800/80 flex flex-wrap gap-x-8 gap-y-3 text-xs sm:text-sm text-slate-300 font-normal"
			>
				{
					propertyHeroContent.highlights.map((h) => (
						<div class="flex items-center gap-2">
							<span class="w-1.5 h-1.5 rounded-full bg-amber-400" />
							<span>{h}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
