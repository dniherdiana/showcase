---
import { Image } from "astro:assets";
import living from "@assets/images/living.jpg";
import { contactHeroContent } from "../../data/kontak/contactHero.js";
---

<section
	class="relative pt-36 pb-24 bg-canvas-default overflow-hidden border-b border-slate-800/80"
>
	<div
		class="absolute inset-0 bg-[linear-gradient(to_right,color-mix(in_srgb,var(--color-canvas-elevated)_8%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_srgb,var(--color-canvas-elevated)_8%,transparent)_1px,transparent_1px)] bg-size-[4rem_4rem] pointer-events-none"
	>
	</div>

	<div
		class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-162.5 h-95 bg-linear-to-tr from-amber-500/10 via-amber-600/5 to-transparent rounded-full blur-3xl pointer-events-none"
	>
	</div>

	<div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
			<div class="lg:col-span-7 space-y-8 hero-rv-contact">
				<div class="space-y-6">
					<div
						class="flex items-center gap-3 text-xs font-mono text-amber-400/90 tracking-widest uppercase"
					>
						<span class="border h-3 border-l bg-amber-400 justify-center"
						></span>
						<span>{contactHeroContent.status}</span>
						<span class="text-slate-500">•</span>
						<span>{contactHeroContent.hours}</span>
					</div>

					<h1
						class="font-serif text-4xl sm:text-5xl lg:text-6xl text-slate-50 font-normal tracking-tight leading-[1.12]"
					>
						{contactHeroContent.headline}
					</h1>

					<p
						class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal"
					>
						{contactHeroContent.subtext}
					</p>
				</div>

				<div
					class="flex flex-wrap items-center gap-4 pt-4 border-t border-slate-800/80"
				>
					<a
						href={contactHeroContent.waCta.href}
						target="_blank"
						rel="noopener noreferrer"
						class="px-6 py-3.5 bg-linear-to-r from-amber-300 via-amber-400 to-amber-200 hover:from-amber-200 hover:to-amber-300 text-slate-950 text-xs font-semibold tracking-wide rounded-sm shadow-lg shadow-amber-500/10 transition-all duration-300 min-h-11 flex items-center gap-2"
					>
						<span>{contactHeroContent.waCta.label}</span>
						<span
							class="font-mono text-[10px] bg-slate-950/20 px-1.5 py-0.5 rounded"
							>{contactHeroContent.waCta.tag}</span
						>
					</a>

					<a
						href={contactHeroContent.secondaryCta.href}
						class="px-6 py-3.5 bg-slate-900 border border-slate-700 hover:border-amber-400/60 text-slate-200 hover:text-white text-xs font-semibold rounded-sm transition-all min-h-11 flex items-center"
					>
						{contactHeroContent.secondaryCta.label}
					</a>
				</div>
			</div>

			<div class="lg:col-span-5 relative hero-rv-contact-img">
				<div
					class="relative rounded-sm overflow-hidden border border-slate-800 bg-slate-950 shadow-2xl group h-95"
				>
					<div class="w-full h-full">
						<Image
							src={living}
							alt="Suasana Marketing Gallery Grand Samudra"
							widths={[480, 768, 1024]}
							sizes="(min-width: 1024px) 42vw, 100vw"
							quality={60}
							format="webp"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="h-full w-full object-cover brightness-95 transition-transform duration-700 group-hover:scale-105"
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
