---
import { faqContent } from "../../data/kontak/contactFaqAccordion.js";
---

<section
	class="py-24 bg-canvas-default relative border-b border-slate-900 overflow-hidden"
>
	<div class="max-w-5xl mx-auto px-6 lg:px-12 space-y-16">
		<div data-reveal="fade" class="text-center space-y-3">
			<span
				class="text-xs font-mono text-amber-300 uppercase tracking-widest block"
				>{faqContent.tag}</span
			>
			<h2 class="font-serif text-3xl sm:text-4xl text-slate-50 font-normal">
				{faqContent.headline}
			</h2>
			<p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
				{faqContent.subtext}
			</p>
		</div>

		<div class="flex flex-wrap items-center justify-center gap-3">
			{
				faqContent.categories.map((cat, i) => (
					<button
						type="button"
						data-faq-cat={cat.value}
						class={`faq-cat-btn px-4 py-2 rounded-sm border text-xs font-mono font-semibold transition-all min-h-11 ${i === 0 ? "border-amber-400/80 bg-amber-500/10 text-amber-300" : "border-slate-800 bg-slate-900/60 text-slate-400 hover:text-slate-200"}`}
					>
						{cat.label}
					</button>
				))
			}
		</div>

		<div class="space-y-4" id="faq-accordion">
			{
				faqContent.items.map((item, i) => (
					<div
						data-reveal
						data-category={item.category}
						class="faq-item border border-slate-800 rounded-sm bg-canvas-raised overflow-hidden transition-colors hover:border-slate-700"
					>
						<button
							type="button"
							class="faq-trigger w-full p-6 text-left flex items-center justify-between gap-4 focus:outline-none min-h-11"
							aria-expanded="false"
							aria-controls={`faq-content-${i + 1}`}
						>
							<span class="font-serif text-lg sm:text-xl text-slate-100 font-medium">
								{item.question}
							</span>
							<span class="faq-icon text-amber-300 font-mono text-2xl transition-transform duration-300 shrink-0">
								+
							</span>
						</button>
						<div
							id={`faq-content-${i + 1}`}
							class="faq-content hidden px-6 pb-6 pt-2 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-slate-800/60"
						>
							<p>{item.answer}</p>
						</div>
					</div>
				))
			}
		</div>

		<div
			class="p-6 bg-canvas-panel rounded-sm border border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4"
		>
			<div class="text-xs text-slate-300">
				<span class="font-serif text-base text-slate-100 font-medium block"
					>{faqContent.footer.title}</span
				>
				<span>{faqContent.footer.subtitle}</span>
			</div>
			<a
				href={faqContent.footer.wa}
				target="_blank"
				class="px-5 py-2.5 bg-linear-to-r from-amber-300 to-amber-200 text-slate-950 text-xs font-semibold rounded-sm shadow-md whitespace-nowrap"
			>
				{faqContent.footer.cta}
			</a>
		</div>
	</div>
</section>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const triggers = document.querySelectorAll(".faq-trigger");
		const catBtns = document.querySelectorAll(".faq-cat-btn");
		const faqItems = document.querySelectorAll(".faq-item");

		triggers.forEach((trigger) => {
			trigger.addEventListener("click", () => {
				const isExpanded = trigger.getAttribute("aria-expanded") === "true";
				const targetId = trigger.getAttribute("aria-controls");
				const content = targetId ? document.getElementById(targetId) : null;
				const icon = trigger.querySelector(".faq-icon");

				if (!isExpanded) {
					trigger.setAttribute("aria-expanded", "true");
					content?.classList.remove("hidden");
					content?.classList.add("block");
					if (icon) icon.textContent = "−";
				} else {
					trigger.setAttribute("aria-expanded", "false");
					content?.classList.remove("block");
					content?.classList.add("hidden");
					if (icon) icon.textContent = "+";
				}
			});
		});

		catBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const cat = btn.getAttribute("data-faq-cat");

				catBtns.forEach((b) => {
					b.classList.remove(
						"border-amber-400/80",
						"bg-amber-500/10",
						"text-amber-300",
					);
					b.classList.add(
						"border-slate-800",
						"bg-slate-900/60",
						"text-slate-400",
					);
				});

				btn.classList.remove(
					"border-slate-800",
					"bg-slate-900/60",
					"text-slate-400",
				);
				btn.classList.add(
					"border-amber-400/80",
					"bg-amber-500/10",
					"text-amber-300",
				);

				faqItems.forEach((item) => {
					const itemCat = item.getAttribute("data-category");
					if (cat === "all" || cat === itemCat) {
						item.classList.remove("hidden");
						item.classList.add("block");
					} else {
						item.classList.remove("block");
						item.classList.add("hidden");
					}
				});
			});
		});
	});
</script>
