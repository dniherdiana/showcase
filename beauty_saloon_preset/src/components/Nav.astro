---
import { brand, nav, proof } from '../data/site.js';
import Icon from './Icon.astro';
import Marquee from './Marquee.astro';

const ticket = [
	'Rating 4.9/5 dari 15.000+ pelanggan',
	'Booking online 24/7',
	'50+ treatment tersedia',
	'Terapis bersertifikasi',
	'Protokol kebersihan rumah sakit',
	'⭐ Booking Sekarang → Gratis konsultasi',
];
---

<header class="relative z-50">
	{/* Announcement ribbon */}
	<div class="bg-ink text-cream">
		<Marquee
			items={ticket}
			class="py-2 font-sans text-[0.68rem] font-bold uppercase tracking-[0.18em]"
		/>
	</div>

	{/* Masthead */}
	<div
		class:list={[
			'sticky top-0 z-40 border-b-2 border-ink bg-cream/90 backdrop-blur-md transition-all duration-300',
		]}
	>
		<nav aria-label="Navigasi utama" class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-5 py-3 lg:px-10">
			<a href="/" class="group relative z-50 flex items-center gap-2" aria-label={`${brand.name} — Beranda`}>
				<span class="grid h-10 w-10 place-items-center rounded-full border-2 border-ink bg-pink font-display text-lg font-black text-cream shadow-[var(--shadow-sticker)] transition-transform duration-300 group-hover:rotate-12">
					N
				</span>
				<span class="leading-none">
					<span class="block font-display text-lg font-black tracking-tight text-ink">
						Nama <span class="text-pink">Beauty</span>
					</span>
					<span class="block text-[0.6rem] font-bold uppercase tracking-[0.3em] text-ink-3">Salon & Aesthetic Care</span>
				</span>
			</a>

			<div class="hidden items-center gap-5 xl:flex">
				{
					nav.map((l) => (
						<a
							href={l.href}
							class:list={[
								'group relative py-1 font-sans text-[0.72rem] font-bold uppercase tracking-[0.12em] text-ink',
								Astro.url.pathname === l.href ? 'text-pink' : 'hover:text-pink-deep',
							]}
						>
							{l.label}
							<span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-left scale-x-0 bg-pink transition-transform duration-300 group-hover:scale-x-100"></span>
						</a>
					))
				}
			</div>

			<div class="flex items-center gap-3">
				<a
					href={`https://wa.me/${brand.whatsapp}`}
					target="_blank"
					rel="noreferrer"
					class="btn btn--violet hidden sm:inline-flex"
				>
					<Icon name="calendar" class="h-4 w-4" />
					Booking
				</a>
				<button
					id="nav-toggle"
					class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink bg-lime shadow-[var(--shadow-sticker)] transition-transform hover:-rotate-6 xl:hidden"
					aria-label="Buka menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<Icon name="menu" class="h-5 w-5" />
				</button>
			</div>
		</nav>
	</div>

	{/* Mobile overlay menu */}
	<div
		id="mobile-menu"
		class="fixed inset-0 z-40 hidden translate-x-full flex-col bg-violet text-cream transition-transform duration-500 [transition-timing-function:var(--ease-snappy)]"
	>
		<div class="flex items-center justify-between px-5 pt-4">
			<span class="font-display text-lg font-black uppercase tracking-widest">Menu</span>
			<button
				id="nav-close"
				class="grid h-11 w-11 place-items-center rounded-full border-2 border-cream/40"
				aria-label="Tutup menu"
			>
				<Icon name="x" class="h-5 w-5" />
			</button>
		</div>
		<nav aria-label="Navigasi mobile" class="mt-6 flex flex-1 flex-col gap-1 overflow-y-auto px-5 pb-8">
			{
				nav.map((l, i) => (
					<a
						href={l.href}
						class="group flex items-baseline gap-4 border-b border-cream/15 py-3"
						style={`transition-delay:${i * 30}ms`}
					>
						<span class="font-display text-[0.65rem] font-black italic text-lime">0{i + 1}</span>
						<span class="font-display text-2xl font-black text-cream transition-transform group-hover:translate-x-2 group-hover:text-lime">
							{l.label}
						</span>
					</a>
				))
			}
			<div class="mt-8 flex flex-col gap-3">
				<a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noreferrer" class="btn btn--lime">
					<Icon name="calendar" class="h-4 w-4" /> Booking Sekarang
				</a>
				<a href="/kontak" class="btn btn--ghost !text-cream !border-cream">Hubungi Kami</a>
			</div>
		</nav>
		<div class="px-5 pb-6">
			<div class="flex flex-wrap gap-2">
				{
					proof.slice(0, 3).map((p) => (
						<span class="sticker sticker--lime" style="--tilt:-2deg">
							{p.value} {p.label}
						</span>
					))
				}
			</div>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle')!;
	const close = document.getElementById('nav-close')!;
	const menu = document.getElementById('mobile-menu')!;
	const body = document.body;

	function openMenu() {
		menu.classList.remove('hidden');
		requestAnimationFrame(() => {
			menu.classList.remove('translate-x-full');
			menu.classList.add('translate-x-0');
		});
		body.style.overflow = 'hidden';
		toggle.setAttribute('aria-expanded', 'true');
	}
	function closeMenu() {
		menu.classList.remove('translate-x-0');
		menu.classList.add('translate-x-full');
		body.style.overflow = '';
		toggle.setAttribute('aria-expanded', 'false');
		setTimeout(() => menu.classList.add('hidden'), 500);
	}
	toggle.addEventListener('click', openMenu);
	close.addEventListener('click', closeMenu);
	menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeMenu();
	});
</script>
