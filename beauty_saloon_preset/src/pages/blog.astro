---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import { IMG, blog } from '../data/site.js';

const cats = ['Semua', 'Skincare', 'Tips', 'Hair', 'Mindset'];
const [feature, ...rest] = blog;
const grid = rest.slice(0, 3);
const list = rest.slice(3);
---

<Layout
	title="Blog"
	description="Majalah kecantikan Nama Beauty Salon — tips, ritual, dan riset yang bisa langsung kamu praktikkan."
	ogImage={IMG.blog1}
>
	<!-- ============ HERO — magazine masthead ============ -->
	<section class="relative overflow-hidden border-b-4 border-ink bg-cream pb-14 pt-14 lg:pb-20 lg:pt-20">
		<span class="pointer-events-none absolute -top-4 right-6 select-none font-display text-[26vw] font-black leading-none text-pink-soft lg:text-[16rem]" aria-hidden="true">MAG</span>
		<div class="relative mx-auto max-w-[1400px] px-5 lg:px-10">
			<Reveal>
				<p class="font-sans text-[0.7rem] font-bold uppercase tracking-[0.35em] text-pink">Majalah Nama — Edisi Rutin</p>
				<h1 class="mt-4 font-display text-6xl font-black leading-[0.9] tracking-tight text-ink sm:text-8xl">
					Glow <span class="italic text-pink">Notes</span>
				</h1>
			</Reveal>
			<Reveal delay={100}>
				<p class="mt-6 max-w-xl font-sans text-base leading-relaxed text-ink/70">
					Catatan harian tim kami tentang kulit, rambut, dan seni memberi waktu untuk diri sendiri.
					Ditulis terapis, bukan ditulis mesin.
				</p>
			</Reveal>
			<Reveal delay={180}>
				<div class="mt-7 flex flex-wrap gap-2">
					{
						cats.map((c, i) => (
							<span class="sticker {i === 0 ? 'sticker--ink' : 'sticker--cream'}" style={`--tilt:${(i % 2 === 0 ? -1 : 1)}deg`}>{c}</span>
						))
					}
				</div>
			</Reveal>
		</div>
	</section>

	<!-- ============ FEATURED ARTICLE — big split ============ -->
	<section class="relative z-10 -mt-10 pb-16 lg:pb-24">
		<div class="mx-auto max-w-[1400px] px-5 lg:px-10">
			<a
				href="#"
				class="group grid overflow-hidden rounded-[var(--radius-blob)] border-2 border-ink bg-cream shadow-[var(--shadow-sticker)] lg:grid-cols-2"
				data-reveal="scale"
			>
				<div class="relative overflow-hidden">
					<img src={IMG[feature.img]} alt={feature.title} loading="lazy" class="aspect-[16/10] h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 lg:aspect-auto" />
					<span class="sticker sticker--pink absolute left-5 top-5" style="--tilt:-2deg">Artikel Pilihan</span>
				</div>
				<div class="flex flex-col justify-center p-8 sm:p-12">
					<p class="flex flex-wrap items-center gap-3 font-sans text-[0.65rem] font-bold uppercase tracking-widest text-ink/50">
						<span class="rounded-full bg-violet-soft px-3 py-1 text-violet-deep">{feature.cat}</span>
						<span>{feature.date}</span>
						<span class="flex items-center gap-1"><Icon name="clock" class="h-3 w-3" /> {feature.read}</span>
					</p>
					<h2 class="mt-5 font-display text-3xl font-black leading-[1.05] transition-colors group-hover:text-pink sm:text-5xl">
						{feature.title}
					</h2>
					<p class="mt-4 font-sans text-base leading-relaxed text-ink/70">{feature.excerpt}</p>
					<span class="pill-link mt-6 w-fit">Baca artikel <Icon name="arrow-right" /></span>
				</div>
			</a>
		</div>
	</section>

	<!-- ============ GRID — varied sizes ============ -->
	<section class="border-t-2 border-ink bg-cream-2 py-16 lg:py-24">
		<div class="mx-auto max-w-[1400px] px-5 lg:px-10">
			<Reveal>
				<div class="mb-10 flex items-center gap-4">
					<span class="h-4 w-4 rounded-full bg-pink animate-wiggle"></span>
					<h2 class="font-display text-4xl font-black sm:text-5xl">Terbaru <span class="italic text-violet">dari tim kami</span></h2>
				</div>
			</Reveal>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					grid.map((a, i) => (
						<article class:list={['card-raise group overflow-hidden rounded-[var(--radius-blob)] border-2 border-ink bg-cream shadow-[var(--shadow-sticker)]', i === 0 ? 'sm:col-span-2 lg:col-span-1' : '']} data-reveal style={`--reveal-delay:${i * 90}ms`}>
							<div class="overflow-hidden">
								<img src={IMG[a.img]} alt={a.title} loading="lazy" class:list={[i === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]', 'w-full object-cover transition-transform duration-700 group-hover:scale-105']} />
							</div>
							<div class="p-6">
								<p class="flex flex-wrap gap-3 font-sans text-[0.65rem] font-bold uppercase tracking-widest text-ink/50">
									<span class="rounded-full bg-violet-soft px-3 py-1 text-violet-deep">{a.cat}</span>
									<span>{a.date}</span>
								</p>
								<h3 class="mt-3 font-display text-xl font-black leading-snug transition-colors group-hover:text-pink">{a.title}</h3>
								<p class="mt-2 font-sans text-sm leading-relaxed text-ink/70">{a.excerpt}</p>
								<span class="pill-link mt-4 inline-flex w-fit">Baca · {a.read} <Icon name="arrow-right" /></span>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============ EDITORIAL LIST — pull-quote style ============ -->
	<section class="bg-ink py-16 text-cream lg:py-20">
		<div class="mx-auto max-w-[1200px] px-5 lg:px-10">
			<Reveal>
				<blockquote class="mb-12 text-center font-display text-2xl font-medium italic leading-snug text-cream/85 sm:text-4xl">
					“Kami tidak menulis untuk menjual — kami menulis untuk <span class="text-lime">membantu kamu</span>
					memahami tubuhmu sendiri.” <span class="mt-3 block font-sans text-xs font-bold uppercase tracking-widest text-cream/40 not-italic">Redaksi Glow Notes</span>
				</blockquote>
			</Reveal>

			<div class="rule-list">
				{
					list.map((a, i) => (
						<li data-reveal style={`--reveal-delay:${i * 80}ms`}>
							<span class="mag-number text-4xl text-pink">{String(i + 1).padStart(2, '0')}</span>
							<div class="flex-1">
								<p class="flex flex-wrap gap-3 font-sans text-[0.65rem] font-bold uppercase tracking-widest text-cream/50">
									<span class="text-lime">{a.cat}</span>
									<span>{a.date}</span>
								</p>
								<h3 class="mt-1 font-display text-xl font-black text-cream transition-colors hover:text-pink sm:text-2xl">{a.title}</h3>
							</div>
							<a href="#" class="hidden h-11 w-11 shrink-0 place-items-center rounded-full border-2 border-cream/30 transition-all hover:border-lime hover:bg-lime hover:text-ink sm:grid" aria-label={`Baca: ${a.title}`}>
								<Icon name="arrow-up-right" class="h-5 w-5" />
							</a>
						</li>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============ NEWSLETTER ============ -->
	<section class="bg-lime py-16 lg:py-20">
		<div class="mx-auto grid max-w-[1400px] items-center gap-10 px-5 lg:grid-cols-12 lg:px-10">
			<div class="lg:col-span-5">
				<Reveal>
					<span class="sticker sticker--pink" style="--tilt:-2deg"><Icon name="gift" class="h-3.5 w-3.5" /> Newsletter</span>
					<h2 class="mt-6 font-display text-4xl font-black leading-[1.02] text-ink sm:text-5xl">
						Satu email <span class="italic text-pink">menarik</span> setiap pekan.
					</h2>
				</Reveal>
			</div>
			<div class="lg:col-span-7">
				<Reveal delay={100}>
					<form id="newsletter-form" class="flex flex-col gap-3 sm:flex-row">
						<input
							id="newsletter-email"
							type="email"
							required
							placeholder="Alamat email kamu…"
							class="flex-1 rounded-full border-2 border-ink bg-cream px-6 py-4 font-sans text-sm outline-none focus:shadow-[var(--shadow-sticker)]"
							aria-label="Alamat email untuk newsletter"
						/>
						<button type="submit" class="btn btn--ink shrink-0">Langganan <Icon name="arrow-right" class="h-5 w-5" /></button>
						<p id="newsletter-ok" class="hidden basis-full font-sans text-xs font-bold text-ink/70">Terima kasih sudah bergabung! Cek inbox kamu.</p>
					</form>
					<p class="mt-3 font-sans text-xs text-ink/60">Tanpa spam. Berhenti kapan saja dengan satu klik.</p>
				</Reveal>
			</div>
		</div>
	</section>

	<!-- ============ CTA ============ -->
	<section class="relative overflow-hidden py-20">
		<div class="mx-auto max-w-4xl px-5 text-center lg:px-10">
			<Reveal>
				<span class="sticker sticker--violet mx-auto" style="--tilt:1deg"><Icon name="sparkles" class="h-3.5 w-3.5" /> Baca, lalu buktikan</span>
				<h2 class="mt-7 font-display text-4xl font-black leading-[1.02] sm:text-6xl">
					Artikel hanyalah <span class="italic text-pink">cerita</span>. Hasilnya ada di treatment.
				</h2>
				<div class="mt-8 flex flex-wrap justify-center gap-4">
					<a href="/treatment" class="btn btn--violet">Lihat Treatment <Icon name="arrow-right" class="h-5 w-5" /></a>
					<a href="/kontak" class="btn btn--ghost">Booking Konsultasi</a>
				</div>
			</Reveal>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		form?.reset();
		document.getElementById('newsletter-ok')?.classList.remove('hidden');
	});
</script>
