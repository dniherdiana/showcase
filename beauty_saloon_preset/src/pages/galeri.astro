---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import GalleryFilter from '../components/svelte/GalleryFilter.svelte';
import { IMG, gallery, brand } from '../data/site.js';

const collage = [
	{ img: IMG.galCollage1, alt: 'Aplikasi makeup dengan kuas oleh terapis' },
	{ img: IMG.galCollage2, alt: 'Klien tersenyum setelah sesi perawatan' },
	{ img: IMG.galCollage3, alt: 'Potret klien dengan kilau alami' },
];
---

<Layout
	title="Galeri"
	description="Momen-momen di dalam Nama Beauty Salon — ritual, detail, dan suasana hangat ruang kami."
	ogImage={IMG.gal2}
>
	<!-- ============ HERO — minimal, visual-dominant ============ -->
	<section class="relative overflow-hidden pb-16 pt-14 lg:pb-24 lg:pt-20">
		<div class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-violet/20 blur-3xl"></div>
		<div class="pointer-events-none absolute -right-24 top-0 h-80 w-80 rounded-full bg-pink/20 blur-3xl"></div>

		<div class="relative mx-auto max-w-[1400px] px-5 lg:px-10">
			<Reveal>
				<h1 class="text-center font-display text-[18vw] font-black leading-[0.85] tracking-tight text-ink sm:text-[10rem]">
					<span class="outline-text">GA</span>L<span class="italic text-pink">E</span><span class="outline-text outline-text--pink">RI</span>
				</h1>
			</Reveal>

			<div class="mt-6 grid items-center gap-10 lg:grid-cols-12">
				<div class="lg:col-span-4">
					<Reveal delay={80}>
						<p class="font-sans text-sm leading-relaxed text-ink/70">
							Kami percaya ruang dan ritual yang baik layak diabadikan. Ini sekilas momen
							dari dalam {brand.name} — biarkan gambarnya yang bercerita.
						</p>
					</Reveal>
				</div>
				<div class="grid grid-cols-3 gap-3 lg:col-span-8">
					{
						collage.map((c, i) => (
							<div class="overflow-hidden rounded-2xl border-2 border-ink shadow-[var(--shadow-sticker)]" style={`--tilt:${i === 0 ? 2 : i === 2 ? -2 : 0}deg`} data-reveal="scale" data-reveal-delay={i * 120}>
								<img src={c.img} alt={c.alt} loading="lazy" class:list={[i === 1 ? 'aspect-[3/4]' : 'aspect-square', 'w-full object-cover']} />
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- ============ MASONRY GALLERY (Svelte island) ============ -->
	<section class="bg-ink py-16 lg:py-24">
		<div class="mx-auto max-w-[1400px] px-5 lg:px-10">
			<div class="mb-10 flex flex-col items-center text-center">
				<Reveal>
					<span class="sticker sticker--lime" style="--tilt:-2deg">Pilih kategori</span>
				</Reveal>
			</div>
			<GalleryFilter items={gallery.map((g) => ({ img: IMG[g.img], cat: g.cat, caption: g.caption }))} client:visible />
		</div>
	</section>

	<!-- ============ BEHIND THE SCENES horizontal strip ============ -->
	<section class="bg-lime py-14">
		<Reveal>
			<h2 class="mb-8 flex items-center gap-3 px-5 font-display text-3xl font-black sm:px-10 sm:text-4xl">
				<Icon name="sparkles" class="h-7 w-7 text-pink" /> Di balik layar, <span class="italic">setiap hari</span>
			</h2>
		</Reveal>
		<div class="flex gap-4 overflow-x-auto px-5 pb-4 sm:px-10 [scrollbar-width:thin]">
			{
				[IMG.galStrip1, IMG.galStrip2, IMG.galStrip3].map((src, i) => (
					<div class="group relative w-64 shrink-0 overflow-hidden rounded-2xl border-2 border-ink shadow-[var(--shadow-sticker)]" data-reveal style={`--reveal-delay:${i * 80}ms`}>
						<img src={src} alt="Momen di balik layar Nama Beauty Salon" loading="lazy" class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
						<span class="absolute left-3 top-3 rounded-full bg-cream px-3 py-1 font-sans text-[0.6rem] font-bold uppercase tracking-widest border-2 border-ink">
							#{String(i + 1).padStart(2, '0')}
						</span>
					</div>
				))
			}
			<div class="grid w-64 shrink-0 place-items-center rounded-2xl border-2 border-dashed border-ink/50 bg-ink text-cream">
				<div class="px-6 text-center">
					<Icon name="instagram" class="mx-auto h-8 w-8 text-pink" />
					<p class="mt-3 font-display text-lg font-black">Ikuti kami di {brand.instagram}</p>
					<a href="#" class="pill-link mt-2 !border-lime">Follow</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ CTA ============ -->
	<section class="relative overflow-hidden bg-cream py-20">
		<span class="outline-text pointer-events-none absolute right-4 top-4 select-none font-display text-[7rem] font-black opacity-10" aria-hidden="true">FRAME</span>
		<div class="relative mx-auto max-w-4xl px-5 text-center lg:px-10">
			<Reveal>
					<span class="sticker sticker--violet mx-auto" style="--tilt:1deg"><Icon name="camera" class="h-3.5 w-3.5" /></span>
				<h2 class="mt-6 font-display text-4xl font-black leading-[1.02] sm:text-6xl">
					Foto berikutnya yang <span class="italic text-pink">dipajang</span> di sini? Bisa jadi hasil ritualmu.
				</h2>
				<div class="mt-8 flex flex-wrap justify-center gap-4">
					<a href="/kontak" class="btn btn--pink">Booking Treatment <Icon name="arrow-right" class="h-5 w-5" /></a>
					<a href="/promo" class="btn btn--ghost">Lihat Promo</a>
				</div>
			</Reveal>
		</div>
	</section>
</Layout>
