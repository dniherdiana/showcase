---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import ContactForm from '../components/svelte/ContactForm.svelte';
import { IMG, brand, hours, treatments } from '../data/site.js';
---

<Layout
	title="Kontak"
	description="Booking konsultasi, tanya treatment, atau kunjungi Nama Beauty Salon di Jakarta. Kami balas dalam 15 menit di jam operasional."
	ogImage={IMG.boutique}
>
	<!-- ============ HERO — calm, focused, minimal ============ -->
	<section class="relative overflow-hidden bg-cream-2 pb-14 pt-14 lg:pb-20 lg:pt-20">
		<div class="pointer-events-none absolute -right-24 top-0 h-64 w-64 rounded-full bg-pink/15 blur-3xl"></div>
		<div class="relative mx-auto max-w-[1200px] px-5 lg:px-10">
			<Reveal>
				<span class="sticker sticker--violet" style="--tilt:-1deg">Kami siap mendengar</span>
				<h1 class="mt-6 max-w-2xl font-display text-5xl font-black leading-[0.95] sm:text-7xl">
					Mulai percakapan, <span class="italic text-pink">sederhana</span> saja.
				</h1>
			</Reveal>
			<Reveal delay={120}>
				<p class="mt-6 max-w-lg font-sans text-base leading-relaxed text-ink/70">
					Isi formulir singkat di bawah, atau langsung sapa kami via WhatsApp. Konsultasi
					pertama selalu gratis — tidak ada paksaan untuk booking.
				</p>
			</Reveal>
		</div>
	</section>

	<!-- ============ FORM + INFO ============ -->
	<section class="relative z-10 -mt-8 pb-16 lg:pb-24">
		<div class="mx-auto grid max-w-[1200px] gap-10 px-5 lg:grid-cols-12 lg:px-10">
			<div class="lg:col-span-7">
				<div class="rounded-[var(--radius-blob)] border-2 border-ink bg-cream p-6 shadow-[var(--shadow-float)] sm:p-10" data-reveal="left">
					<h2 class="font-display text-2xl font-black sm:text-3xl">Form booking konsultasi</h2>
					<p class="mt-1 mb-7 font-sans text-sm text-ink/60">Respons kami kurang dari 15 menit di jam operasional.</p>
					<ContactForm treatments={treatments.map((t) => ({ name: t.name }))} client:load />
				</div>
			</div>

			<div class="space-y-6 lg:col-span-5">
				<Reveal>
					<div class="rounded-[var(--radius-blob)] border-2 border-ink bg-ink p-7 text-cream">
						<h3 class="flex items-center gap-3 font-display text-xl font-black">
							<Icon name="whatsapp" class="h-6 w-6 text-lime" /> Respon tercepat via WhatsApp
						</h3>
						<p class="mt-3 font-sans text-sm leading-relaxed text-cream/70">
							Chat untuk booking, tanya treatment, atau kirim foto kondisi kulit untuk pra-konsultasi.
						</p>
						<a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noreferrer" class="btn btn--lime mt-5 w-full">
							Chat {brand.phone}
						</a>
					</div>
				</Reveal>

				<Reveal delay={80}>
					<div class="rounded-[var(--radius-blob)] border-2 border-ink bg-cream p-7">
						<h3 class="flex items-center gap-3 font-display text-xl font-black">
							<Icon name="clock" class="h-6 w-6 text-pink" /> Jam operasional
						</h3>
						<ul class="mt-4 space-y-2">
							{
								hours.map((h) => (
									<li class="flex items-center justify-between border-b border-dashed border-ink/15 pb-2 font-sans text-sm">
										<span>{h.day}</span>
										<span class="font-bold text-violet-deep">{h.time}</span>
									</li>
								))
							}
						</ul>
						<p class="mt-4 rounded-xl bg-lime px-4 py-2 font-sans text-xs font-bold text-ink">
							Tips: sore hari kerja (14.00–17.00) adalah slot paling longgar.
						</p>
					</div>
				</Reveal>

				<Reveal delay={160}>
					<div class="rounded-[var(--radius-blob)] border-2 border-ink bg-cream p-7">
						<h3 class="flex items-center gap-3 font-display text-xl font-black">
							<Icon name="map-pin" class="h-6 w-6 text-violet" /> Lokasi kami
						</h3>
						<p class="mt-3 font-sans text-sm leading-relaxed text-ink/75">
							{brand.address}
							<br />
							<span class="text-ink/50">(Dekat stasiun MRT & halte Transjakarta)</span>
						</p>
						<a href="https://www.google.com/maps/search/?api=1&query={brand.mapQuery}" target="_blank" rel="noreferrer" class="btn btn--violet mt-4 w-full">
							<Icon name="map-pin" class="h-4 w-4" /> Buka di Google Maps
						</a>
						<p class="mt-3 font-sans text-xs text-ink/50">
							Email: <b class="text-ink">{brand.email}</b>
							<span class="mt-1 block">Instagram: <b class="text-ink">{brand.instagram}</b></span>
						</p>
					</div>
				</Reveal>
			</div>
		</div>
	</section>

	<!-- ============ MAP EMBED ============ -->
	<section class="pb-20 lg:pb-28">
		<div class="mx-auto max-w-[1200px] px-5 lg:px-10">
			<Reveal>
				<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
					<h2 class="font-display text-3xl font-black sm:text-4xl">
						Temukan kami di <span class="italic text-pink">peta</span>
					</h2>
					<span class="sticker sticker--lime" style="--tilt:-2deg"><Icon name="map-pin" class="h-3.5 w-3.5" /> Parkir luas tersedia</span>
				</div>
			</Reveal>
			<Reveal delay={80}>
				<div class="overflow-hidden rounded-[var(--radius-blob)] border-2 border-ink shadow-[var(--shadow-sticker)]">
					<iframe
						title="Lokasi Nama Beauty Salon di Google Maps"
						src="https://www.google.com/maps?q=Jakarta%20Selatan%20Blok%20M&output=embed"
						class="h-[26rem] w-full grayscale-[0.2] contrast-[1.05]"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
				</div>
			</Reveal>
		</div>
	</section>

	<!-- ============ QUICK ACTIONS ============ -->
	<section class="bg-violet py-16 text-cream">
		<div class="mx-auto max-w-[1200px] px-5 lg:px-10">
			<Reveal>
				<h2 class="mb-8 font-display text-3xl font-black sm:text-4xl">Atau lakukan ini <span class="italic text-lime">langsung</span></h2>
			</Reveal>
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{
					[
						{ icon: 'calendar', t: 'Booking treatment', d: 'Pilih waktu & treatment favoritmu sekarang.', href: '/treatment' },
						{ icon: 'gift', t: 'Lihat promo aktif', d: 'Jangan lewatkan diskon bulan ini.', href: '/promo' },
						{ icon: 'map-pin', t: 'Petunjuk arah', d: 'Maps langsung menuju pintu kami.', href: 'https://www.google.com/maps/search/?api=1&query={brand.mapQuery}' },
						{ icon: 'instagram', t: 'Lihat feed kami', d: 'Ritual & hasil asli di Instagram.', href: '#' },
					].map((a, i) => (
						<a href={a.href} target={a.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="card-raise rounded-2xl border-2 border-cream/25 bg-cream/5 p-6" data-reveal style={`--reveal-delay:${i * 80}ms`}>
							<span class="grid h-11 w-11 place-items-center rounded-full border-2 border-ink bg-lime text-ink">
								<Icon name={a.icon} class="h-5 w-5" />
							</span>
							<h3 class="mt-4 font-display text-lg font-black">{a.t}</h3>
							<p class="mt-1 font-sans text-sm text-cream/70">{a.d}</p>
							<span class="pill-link mt-3 !text-cream !border-lime">Buka <Icon name="arrow-up-right" class="h-3.5 w-3.5" /></span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============ FAQ TEASER ============ -->
	<section class="py-16 lg:py-20">
		<div class="mx-auto max-w-3xl px-5 text-center lg:px-10">
			<Reveal>
				<Icon name="quote" class="mx-auto h-10 w-10 text-pink" />
				<h2 class="mt-4 font-display text-3xl font-black sm:text-4xl">
					Masih ada pertanyaan sebelum datang?
				</h2>
				<p class="mt-3 font-sans text-sm text-ink/60">
					Kami kumpulkan jawaban untuk pertanyaan paling sering ditanyakan pelanggan.
				</p>
				<a href="/faq" class="btn btn--violet mt-7">Baca FAQ <Icon name="arrow-right" class="h-5 w-5" /></a>
			</Reveal>
		</div>
	</section>
</Layout>
