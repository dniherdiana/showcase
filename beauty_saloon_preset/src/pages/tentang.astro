---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import Placeholder from '../components/Placeholder.astro';
import { IMG, team, timeline } from '../data/site.js';
---

<Layout
	title="Tentang Kami"
	description="Kisah di balik Nama Beauty Salon — dari satu kursi di 2015 menjadi rumah ritual kecantikan bagi 15.000+ pelanggan."
	ogImage={IMG.founder}
>
	<!-- ============ HERO — narrative, "di balik layar", dark warm ============ -->
	<section class="relative overflow-hidden bg-ink pb-20 pt-14 text-cream lg:pb-28 lg:pt-20">
		<div class="pointer-events-none absolute -left-32 top-20 h-96 w-96 rounded-full bg-violet/30 blur-3xl"></div>
		<div class="pointer-events-none absolute -right-24 bottom-10 h-80 w-80 rounded-full bg-pink/25 blur-3xl"></div>

		<div class="relative mx-auto grid max-w-[1400px] items-center gap-14 px-5 lg:grid-cols-12 lg:px-10">
			<div class="lg:col-span-7">
				<Reveal>
					<span class="sticker sticker--lime" style="--tilt:-2deg">Cerita kami, sejak 2015</span>
					<h1 class="mt-7 font-display text-[2.6rem] font-black leading-[0.98] sm:text-6xl">
						Bermula dari satu kursi, <br />
						<span class="italic text-pink">tumbuh jadi</span> rumah ritual.
					</h1>
				</Reveal>
				<Reveal delay={120}>
					<div class="mt-8 max-w-2xl space-y-5 font-sans text-base leading-relaxed text-cream/75 sm:text-lg">
						<p class="drop-cap">
							Kami percaya kecantikan bukan perlombaan dengan orang lain — melainkan cara
							kamu memperlakukan dirimu sendiri. Keyakinan sederhana inilah yang kami bawa
							ketika Nama Beauty Salon dibuka: sebuah ruang kecil dengan satu kursi dan satu
							terapis yang yakin perawatan harus terasa personal.
						</p>
						<p>
							Sepuluh tahun kemudian, prinsip itu tidak berubah — hanya ruangnya yang lebih
							hangat, timnya lebih besar, dan standarnya lebih tinggi. Terapis profesional,
							produk premium, dan protokol kebersihan setingkat rumah sakit menjadi fondasi
							dari setiap ritual yang kami rancang.
						</p>
					</div>
				</Reveal>
				<Reveal delay={220}>
					<div class="mt-9 flex flex-wrap gap-4">
						<a href="/kontak" class="btn btn--pink">Kunjungi Kami <Icon name="arrow-right" class="h-5 w-5" /></a>
						<a href="/galeri" class="btn btn--ghost !text-cream !border-cream">Lihat Ruang Kami</a>
					</div>
				</Reveal>
			</div>

			<div class="relative lg:col-span-5" data-reveal="right">
				<span class="outline-text outline-text--cream pointer-events-none absolute -top-8 left-4 select-none font-display text-7xl font-black opacity-20" aria-hidden="true">2015</span>
				<div class="img-frame mx-auto max-w-md rotate-2 overflow-hidden rounded-[var(--radius-blob)]">
					<img src={IMG.founder} alt="Pendiri Nama Beauty Salon dengan senyum hangat" class="aspect-[4/5] w-full object-cover" />
				</div>
				<figure class="card-raise absolute -bottom-8 -left-4 max-w-xs rotate-[-3deg] rounded-2xl border-2 border-ink bg-cream p-5 text-ink shadow-[var(--shadow-sticker)] sm:-left-8">
					<Icon name="quote" class="h-6 w-6 text-pink" />
					<blockquote class="mt-2 font-display text-base font-bold leading-snug italic">
						“Kami tidak menjual treatment. Kami merawat orang — sisanya, biar hasil yang bicara.”
					</blockquote>
					<figcaption class="mt-3 font-sans text-[0.65rem] font-bold uppercase tracking-widest text-ink/60">Pendiri, Nama Beauty Salon</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- ============ TIMELINE ============ -->
	<section class="relative overflow-hidden py-20 lg:py-28">
		<span class="outline-text pointer-events-none absolute left-1/2 top-6 -translate-x-1/2 select-none font-display text-[8rem] font-black opacity-10 lg:text-[11rem]" aria-hidden="true">KISAH</span>
		<div class="relative mx-auto max-w-[1200px] px-5 lg:px-10">
			<Reveal>
				<div class="mb-16 text-center">
					<span class="sticker sticker--violet mx-auto" style="--tilt:-1deg"><Icon name="clock" class="h-3.5 w-3.5" /> Perjalanan</span>
					<h2 class="mt-6 font-display text-4xl font-black sm:text-6xl">
						10 tahun, <span class="italic text-pink">satu</span> janji.
					</h2>
				</div>
			</Reveal>

			<ol class="relative">
				<span class="absolute left-5 top-2 bottom-2 w-1 rounded-full bg-ink sm:left-1/2 sm:-translate-x-1/2" aria-hidden="true"></span>
				{
					timeline.map((t, i) => (
						<li class="relative mb-12 pl-16 sm:w-1/2 sm:pl-0 sm:pr-16" class:list={[i % 2 === 1 ? 'sm:ml-auto sm:pl-16 sm:pr-0' : 'sm:text-right']}>
							<span
								class="sticker absolute left-0 top-0 sm:left-auto"
								class:list={[i % 2 === 1 ? 'sm:-left-10' : 'sm:-right-10']}
								style="--tilt:-2deg"
							>
								{t.year}
							</span>
							<div class="card-raise rounded-[var(--radius-blob)] border-2 border-ink bg-cream-2 p-6 shadow-[var(--shadow-sticker)]" data-reveal="left" style={i % 2 === 1 ? '--reveal-delay:120ms' : '--reveal-delay:0ms'}>
								{i % 2 === 0 && (
									<img src={IMG[`timeline${i + 1}`]} alt={t.title} loading="lazy" class="mb-4 aspect-[16/9] w-full rounded-xl border-2 border-ink object-cover" />
								)}
								<h3 class="font-display text-xl font-black">{t.title}</h3>
								<p class="mt-2 font-sans text-sm leading-relaxed text-ink/70">{t.desc}</p>
								{i % 2 === 1 && (
									<img src={IMG[`timeline${i + 1}`]} alt={t.title} loading="lazy" class="mt-4 aspect-[16/9] w-full rounded-xl border-2 border-ink object-cover" />
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ============ VALUES — split ============ -->
	<section class="bg-cream-2 py-20 lg:py-28">
		<div class="mx-auto grid max-w-[1400px] items-center gap-14 px-5 lg:grid-cols-2 lg:px-10">
			<div class="relative order-2 lg:order-1" data-reveal="left">
				<div class="img-frame rotate-[-2deg] overflow-hidden rounded-[var(--radius-blob)]">
					<img src={IMG.valuesLamp} alt="Peralatan perawatan profesional dengan lampu terapi" loading="lazy" class="aspect-[4/3] w-full object-cover" />
				</div>
				<div class="img-frame absolute -bottom-10 -right-4 w-48 rotate-3 overflow-hidden rounded-2xl sm:-right-10 sm:w-60">
					<img src={IMG.storyTowel} alt="Handuk bersih dan lilin aromaterapi" loading="lazy" class="aspect-square w-full object-cover" />
				</div>
			</div>
			<div class="order-1 lg:order-2">
				<Reveal>
					<span class="sticker sticker--pink" style="--tilt:1deg">Di balik layar</span>
					<h2 class="mt-6 font-display text-4xl font-black leading-[1.05] sm:text-5xl">
						Nilai yang kami <span class="italic text-violet">jaga</span> setiap hari.
					</h2>
					<div class="mt-8 space-y-5">
						{
							[
								{ icon: 'heart', title: 'Personal, bukan paket', desc: 'Setiap klien punya riwayat, preferensi, dan tujuan sendiri. Terapis kami mencatat semuanya sebelum kamu tiba.' },
								{ icon: 'shield', title: 'Kebersihan tanpa kompromi', desc: 'Sterilisasi autoclave di depan klien adalah standar minimum kami — bukan nilai jual tambahan.' },
								{ icon: 'users', title: 'Terapis diperlakukan seperti keluarga', desc: 'Kesejahteraan 25+ terapis kami adalah fondasi kualitas perawatan yang kamu terima.' },
								{ icon: 'leaf', title: 'Produk yang kami yakini', desc: 'Kami hanya memakai produk premium yang sudah kami uji di kulit kami sendiri.' },
							].map((v, i) => (
								<div class="flex items-start gap-4" data-reveal style={`--reveal-delay:${i * 90}ms`}>
									<span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-ink bg-lime shadow-[var(--shadow-sticker)]">
										<Icon name={v.icon} class="h-5 w-5" />
									</span>
									<div>
										<h3 class="font-display text-lg font-black">{v.title}</h3>
										<p class="mt-1 font-sans text-sm leading-relaxed text-ink/70">{v.desc}</p>
									</div>
								</div>
							))
						}
					</div>
				</Reveal>
			</div>
		</div>
	</section>

	<!-- ============ STATS — diagonal lime band ============ -->
	<section class="relative bg-lime py-16">
		<div class="diagonal-stripes absolute inset-x-0 top-0 h-4"></div>
		<div class="mx-auto max-w-[1400px] px-5 lg:px-10">
			<div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-5">
				{
					[
						{ v: '10+', l: 'Tahun perjalanan' },
						{ v: '25+', l: 'Terapis profesional' },
						{ v: '15.000+', l: 'Pelanggan puas' },
						{ v: '50+', l: 'Jenis treatment' },
						{ v: '4.9/5', l: 'Rating pelanggan' },
					].map((s, i) => (
						<div class="relative" data-reveal style={`--reveal-delay:${i * 70}ms`}>
							<span class="mag-number block text-5xl text-ink lg:text-6xl">{s.v}</span>
							<span class="mt-2 block font-sans text-[0.7rem] font-bold uppercase tracking-widest text-ink/70">{s.l}</span>
							{i < 4 && (
								<span class="absolute -right-3 top-0 hidden h-full w-1 -rotate-6 bg-ink/20 lg:block"></span>
							)}
						</div>
					))
				}
			</div>
		</div>
		<div class="zigzag absolute inset-x-0 bottom-0"></div>
	</section>

	<!-- ============ TEAM ============ -->
	<section class="py-20 lg:py-28">
		<div class="mx-auto max-w-[1400px] px-5 lg:px-10">
			<div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-7">
					<Reveal>
						<span class="sticker sticker--violet" style="--tilt:-1deg"><Icon name="users" class="h-3.5 w-3.5" /> Tim kami</span>
						<h2 class="mt-6 font-display text-4xl font-black leading-[1.02] sm:text-5xl">
							Di balik setiap ritual, <span class="italic text-pink">ada tangan</span> yang teliti.
						</h2>
					</Reveal>
				</div>
				<div class="lg:col-span-5">
					<Reveal delay={100}>
						<p class="font-sans text-base leading-relaxed text-ink/70">
							25+ terapis dengan pelatihan berkelanjutan setiap bulan — karena keahlian,
							sama seperti kulit, harus terus dirawat.
						</p>
					</Reveal>
				</div>
			</div>

			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					team.map((m, i) => (
						<article class="card-raise group" data-reveal style={`--reveal-delay:${i * 90}ms`}>
							<div class="img-frame overflow-hidden rounded-[var(--radius-blob)]">
								<img src={IMG[m.img]} alt={`${m.name} — ${m.role}`} loading="lazy" class="aspect-[3/4] w-full object-cover" />
								<div class="absolute inset-x-0 bottom-0 translate-y-full bg-ink/85 p-4 backdrop-blur-sm transition-transform duration-300 group-hover:translate-y-0">
									<p class="font-sans text-xs leading-relaxed text-cream/80">
										<i class="font-display not-italic text-lime">{m.name}</i> — spesialis
										terlatih dengan pembinaan bulanan tim kami.
									</p>
								</div>
							</div>
							<div class="mt-4 flex items-start justify-between gap-2">
								<div>
									<h3 class="font-display text-lg font-black">{m.name}</h3>
									<p class="font-sans text-[0.7rem] font-bold uppercase tracking-widest text-pink">{m.role}</p>
								</div>
								<Placeholder inline label="Sertifikasi" />
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============ PULL QUOTE ============ -->
	<section class="bg-violet py-20 text-cream">
		<div class="mx-auto max-w-5xl px-5 text-center lg:px-10">
			<Reveal>
				<Icon name="quote" class="mx-auto h-12 w-12 text-lime" />
				<blockquote class="mt-6 font-display text-3xl font-medium italic leading-tight sm:text-5xl">
					“Luxury bukan soal harga. Luxury adalah saat kamu <span class="text-lime">dianggap</span> —
					waktumu dihargai, preferensimu diingat, dan kenyamananmu dijaga.”
				</blockquote>
			</Reveal>
		</div>
	</section>

	<!-- ============ CTA ============ -->
	<section class="relative overflow-hidden bg-cream py-20 lg:py-28">
		<div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-pink/20 blur-3xl"></div>
		<div class="relative mx-auto max-w-4xl px-5 text-center lg:px-10">
			<Reveal>
				<span class="sticker sticker--lime mx-auto" style="--tilt:-2deg"><Icon name="heart" class="h-3.5 w-3.5" /> Mari bertemu</span>
				<h2 class="mt-7 font-display text-4xl font-black leading-[1.02] sm:text-6xl">
					Kenalan dulu — <span class="italic text-pink">konsultasi gratis</span> untuk kunjungan pertamamu.
				</h2>
				<div class="mt-9 flex flex-wrap justify-center gap-4">
					<a href="/kontak" class="btn btn--violet">Booking Konsultasi <Icon name="arrow-right" class="h-5 w-5" /></a>
					<a href="/layanan" class="btn btn--ghost">Jelajahi Layanan</a>
				</div>
			</Reveal>
		</div>
	</section>
</Layout>
