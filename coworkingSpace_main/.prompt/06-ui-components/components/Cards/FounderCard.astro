---
// ============================================================================
//  FounderCard.astro — Leadership Brand Philosophy (Magazine Editorial)
//  Tailwind CSS v4 template. No installation needed — copy into your Astro
//  project (src/components/) and import on a page.
//
//  Usage:
//    import FounderCard from "../components/FounderCard.astro";
//    <FounderCard />
//    <FounderCard name="..." credentials={[{ value: "15+", label: "Tahun" }]} />
//
//  Note: ensure your page uses Tailwind v4 (`@import "tailwindcss";`
//  in src/styles/global.css). The editorial font below expects Playfair
//  Display; fall back gracefully if you don't load it.
// ============================================================================

interface Credential {
  value: string;
  label: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  quote?: string;
  image?: string;
  imageAlt?: string;
  name?: string;
  role?: string;
  credentials?: Credential[];
  paragraphs?: string[];
}

const {
  id = "kepemimpinan",
  eyebrow = "Leadership & Philosophy",
  heading = "DIKELOLA OLEH PRAKTISI HOSPITALITY BERPENGALAMAN",
  quote = "Bagi kami, mengelola perjalanan Anda bukan sekadar mengantar rombongan dari satu titik ke titik lain, melainkan memastikan setiap individu merasa dihormati, dilindungi, dan diayomi sepanjang perjalanan mereka.",
  image = "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80",
  imageAlt = "Budi Santoso - Founder & Managing Director Kencana Voyage",
  name = "Budi Santoso",
  role = "Pendiri & Managing Director",
  credentials = [
    { value: "15+", label: "Tahun Hospitality" },
    { value: "TDUP", label: "Izin Resmi Pariwisata" },
    { value: "ASITA", label: "Anggota Aktif" },
  ],
  paragraphs = [
    "Didirikan oleh <strong>Budi Santoso</strong>, seorang veteran industri penerbangan dan praktisi hospitality selama lebih dari 15 tahun, Kencana Voyage dibangun atas pemahaman mendalam mengenai standar pelayanan aviasi internasional. Pengalaman melayani berbagai profil penumpang lintas negara membentuk fondasi kepemimpinan yang menekankan ketenangan dalam penanganan krisis, kerapian logistik, dan kepedulian yang tulus.",
    "Prinsip <strong>\"Empathy in Service\"</strong> diinternalisasikan ke dalam seluruh jajaran Tour Manager dan staf operasional kami. Kami percaya bahwa perjalanan korporasi yang sukses berakar dari rasa aman dan penghargaan mendalam terhadap setiap peserta.",
  ],
} = Astro.props;
---

<section id={id} class="relative bg-[#0B111E] px-6 py-[7.5rem] text-white sm:px-8 lg:px-12">
  <div class="mx-auto w-full max-w-[1280px]">
    <div class="mx-auto max-w-[900px]">
      <!-- Magazine wrap: media floats top-left, text flows around & below -->
      <figure
        class="float-left mb-7 mr-11 w-[42%] max-lg:mr-8 max-lg:w-[48%] max-md:mb-9 max-md:float-none max-md:mr-0 max-md:w-full"
      >
        <div class="relative overflow-hidden border border-white/10">
          <img
            src={image}
            alt={imageAlt}
            loading="lazy"
            class="h-[460px] w-full object-cover object-[center_18%] grayscale-[0.2] contrast-[1.1]"
          />
          <div class="absolute inset-x-0 bottom-0 border-t border-white/10 bg-[#060911]/90 px-6 py-5 backdrop-blur">
            <div class="text-xl font-bold tracking-[-0.02em]">{name}</div>
            <div class="mt-0.5 text-[13px] uppercase tracking-[0.1em] text-cyan-400">{role}</div>
          </div>
        </div>

        <div class="grid grid-cols-3 border-x border-b border-white/10">
          {
            credentials.map((c, i) => (
              <div
                class:list={[
                  "flex flex-col gap-1.5 p-5",
                  i < credentials.length - 1 && "border-r border-white/10",
                ]}
              >
                <strong class="text-xl font-extrabold tracking-[-0.02em] text-amber-400">{c.value}</strong>
                <span class="text-[11px] font-semibold uppercase leading-[1.4] tracking-[0.08em] text-slate-400">{c.label}</span>
              </div>
            ))
          }
        </div>
      </figure>

      <!-- Flowing text: fills right of image, then continues below -->
      <p class="mb-5 inline-flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.18em] text-amber-400">
        <span class="h-px w-6 bg-current"></span>
        {eyebrow}
      </p>
      <h2 class="mb-8 text-[clamp(2rem,3.8vw,3rem)] font-bold leading-[1.15] tracking-[-0.02em]">
        {heading}
      </h2>

      <blockquote
        class="mb-8 border-l-[3px] border-amber-500 pl-8 font-['Playfair_Display',Georgia,serif] text-[clamp(1.4rem,2.2vw,1.85rem)] leading-[1.5]"
      >
        "{quote}"
      </blockquote>

      <div class="text-[15px] leading-[1.8] text-slate-400">
        {
          paragraphs.map((p, i) => (
            <p set:html={p} class:list={[i < paragraphs.length - 1 && "mb-5"]} />
          ))
        }
      </div>
    </div>
  </div>
</section>
