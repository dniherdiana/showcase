---
import { globalData } from '../../data/global.data.js';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0B0F19]/80 backdrop-blur-md border-b border-[#38BDF8]/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-[6px] bg-[#111827] border border-[#38BDF8]/30 flex items-center justify-center text-[#38BDF8] font-mono font-bold text-lg group-hover:border-[#38BDF8] group-hover:shadow-[0_0_12px_rgba(56,189,248,0.25)] transition-all">
        A
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-base font-bold text-[#F3F4F6] tracking-tight group-hover:text-[#38BDF8] transition-colors">
          ALUNÊ
        </span>
        <span class="font-mono text-[10px] text-[#9CA3AF] tracking-widest uppercase">
          ESTETIKA MEDIS
        </span>
      </div>
    </a>

    <!-- Zero-JS CSS Checkbox Toggle Engine -->
    <input type="checkbox" id="nav-menu-toggle" class="peer hidden" aria-label="Toggle Navigation Menu" />

    <!-- Hamburger Icon for Mobile -->
    <label 
      for="nav-menu-toggle" 
      class="md:hidden p-2 rounded-[6px] bg-[#111827] border border-[#38BDF8]/20 text-[#F3F4F6] cursor-pointer hover:border-[#38BDF8]/50 transition-colors flex flex-col gap-1.5 justify-center items-center w-10 h-10 select-none"
    >
      <span class="w-5 h-[2px] bg-[#38BDF8] transition-all"></span>
      <span class="w-5 h-[2px] bg-[#F3F4F6] transition-all"></span>
      <span class="w-5 h-[2px] bg-[#38BDF8] transition-all"></span>
    </label>

    <!-- Navigation Links & WhatsApp CTA -->
    <nav class="peer-checked:flex hidden md:flex flex-col md:flex-row items-center gap-6 absolute md:relative top-20 md:top-0 left-0 right-0 md:w-auto bg-[#0B0F19]/95 md:bg-transparent border-b md:border-b-0 border-[#38BDF8]/15 p-6 md:p-0 shadow-2xl md:shadow-none transition-all">
      <ul class="flex flex-col md:flex-row items-center gap-6 w-full md:w-auto font-mono text-xs tracking-wider">
        {globalData.navigation.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li class="w-full md:w-auto text-center">
              <a 
                href={item.href}
                class={`block py-2 md:py-0 px-3 rounded-[4px] transition-all ${
                  isActive 
                    ? 'text-[#38BDF8] font-semibold bg-[#38BDF8]/10 border border-[#38BDF8]/25' 
                    : 'text-[#9CA3AF] hover:text-[#F3F4F6] hover:bg-[#111827]'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="tech-divider w-full md:hidden my-2"></div>

      <!-- Direct WhatsApp Action CTA -->
      <a 
        href={globalData.contact.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-[6px] bg-[#38BDF8] hover:bg-[#0EA5E9] text-[#0B0F19] font-mono font-bold text-xs tracking-wider transition-all hover:scale-[1.02] active:scale-[0.98] shadow-[0_0_15px_rgba(56,189,248,0.25)]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WhatsApp Dokter</span>
      </a>
    </nav>
  </div>
</header>
