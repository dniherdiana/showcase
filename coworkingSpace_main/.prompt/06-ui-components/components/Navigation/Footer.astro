---
const currentYear = new Date().getFullYear();
---

<footer class="relative bg-surface-void texture-grid overflow-hidden">
  <!-- Ambient glow -->
  <div class="glow-primary -top-40 -left-40 opacity-30"></div>

  <!-- Watermark -->
  <div class="watermark -bottom-20 right-0 select-none">ALURFLOW</div>

  <!-- Upper Footer -->
  <div class="relative z-[var(--z-base)] px-6 md:px-12 lg:px-16 pt-[var(--spacing-section)] pb-16">
    <!-- Grid: 80/20 asymmetric -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-16 lg:gap-24">

      <!-- Left: Large CTA Block -->
      <div data-reveal>
        <span class="meta-tag mb-6 block">
          <span data-lang="id">Mulai Sekarang</span>
          <span data-lang="en">Get Started</span>
        </span>
        <h2 class="font-display font-bold text-[clamp(2rem,5vw,4rem)] leading-[0.95] tracking-tight max-w-2xl mb-8">
          <span data-lang="id">Siap mengoptimalkan rantai pasok perusahaan Anda?</span>
          <span data-lang="en">Ready to optimize your enterprise supply chain?</span>
        </h2>
        <a href="/contact" class="btn-primary">
          <span data-lang="id">Jadwalkan Demo Enterprise</span>
          <span data-lang="en">Schedule Enterprise Demo</span>
          <span class="arrow">→</span>
        </a>
      </div>

      <!-- Right: Contact Info -->
      <div data-reveal="stagger-2" class="flex flex-col gap-8 min-w-[220px]">
        <div>
          <span class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-text-tertiary block mb-3">
            <span data-lang="id">Kantor Pusat</span>
            <span data-lang="en">Headquarters</span>
          </span>
          <p class="text-sm text-text-secondary leading-relaxed">
            Treasury Tower Lt. 21<br />
            Kawasan SCBD<br />
            Jakarta Selatan, DKI Jakarta 12190
          </p>
        </div>
        <div>
          <span class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-text-tertiary block mb-3">
            <span data-lang="id">Kontak Langsung</span>
            <span data-lang="en">Direct Contact</span>
          </span>
          <a href="mailto:enterprise@alurflow.com" class="text-sm text-text-secondary hover:text-brand-primary transition-colors duration-300 block">enterprise@alurflow.com</a>
          <span class="text-sm text-text-tertiary block mt-1">+62-21-5555-8888</span>
        </div>
        <div>
          <span class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-text-tertiary block mb-3">
            <span data-lang="id">Jam Operasional</span>
            <span data-lang="en">Business Hours</span>
          </span>
          <p class="text-sm text-text-secondary">
            <span data-lang="id">Senin – Jumat</span>
            <span data-lang="en">Monday – Friday</span>
            <br />08.30 – 17.30 WIB
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="mx-6 md:mx-12 lg:mx-16 h-px bg-line-hard"></div>

  <!-- Lower Footer -->
  <div class="relative z-[var(--z-base)] px-6 md:px-12 lg:px-16 py-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-6 h-6 bg-brand-primary flex items-center justify-center">
        <span class="text-white font-mono text-[0.5rem] font-bold">AF</span>
      </div>
      <span class="font-mono text-[0.65rem] text-text-tertiary tracking-[0.1em]">© {currentYear} AlurFlow Solutions</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="/solutions" class="font-mono text-[0.6rem] tracking-[0.12em] uppercase text-text-tertiary hover:text-text-secondary transition-colors duration-300">
        <span data-lang="id">Solusi</span>
        <span data-lang="en">Solutions</span>
      </a>
      <a href="/about" class="font-mono text-[0.6rem] tracking-[0.12em] uppercase text-text-tertiary hover:text-text-secondary transition-colors duration-300">
        <span data-lang="id">Perusahaan</span>
        <span data-lang="en">Company</span>
      </a>
      <a href="/contact" class="font-mono text-[0.6rem] tracking-[0.12em] uppercase text-text-tertiary hover:text-text-secondary transition-colors duration-300">
        <span data-lang="id">Kontak</span>
        <span data-lang="en">Contact</span>
      </a>
    </div>
  </div>
</footer>
