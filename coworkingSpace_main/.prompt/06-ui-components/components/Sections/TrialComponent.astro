---
/**
 * TrialComponent.astro
 * Master Template: 3-Day Free Pass Activation & First-Timer Onboarding
 * 
 * Standalone & Self-Contained Template Component
 * Menggabungkan seluruh data, form interaktif, alur orientasi, dan FAQ accordion ke dalam 1 file mandiri.
 */

export interface TrialStepItem {
  icon: 'qrcode' | 'scanface' | 'smile' | 'shield';
  title: string;
  description: string;
}

export interface TrialFaqItem {
  question: string;
  answer: string;
}

export interface TrialDataProps {
  hero?: {
    badge?: string;
    headline?: string;
    subheadline?: string;
    benefits?: string[];
  };
  branches?: Array<{ id: string; name: string; area: string }>;
  timeSlots?: Array<{ id: string; label: string }>;
  steps?: {
    headline?: string;
    subheadline?: string;
    items?: TrialStepItem[];
  };
  trustStats?: Array<{ label: string; value: string }>;
  faqs?: {
    headline?: string;
    subheadline?: string;
    items?: TrialFaqItem[];
  };
}

export interface Props {
  data?: TrialDataProps;
  showSteps?: boolean;
  showFaqs?: boolean;
  showTrustBar?: boolean;
}

const defaultData: TrialDataProps = {
  hero: {
    badge: "100% Akses Penuh Bebas Biaya",
    headline: "Aktivasi 3-Day Free Pass Kamu",
    subheadline: "Coba seluruh fasilitas latihan, kamar mandi air panas, dan fitur aplikasi selama 3 hari berturut-turut tanpa biaya pendaftaran sepeser pun.",
    benefits: [
      "Bebas Akses Seluruh Cabang 24 Jam Penuh",
      "Gratis 1 Sesi Orientasi Pengenalan Alat Bersama Coach",
      "Fasilitas Rain Shower Air Panas, Handuk Bersih, & Loker Keyless",
      "0 Biaya Registrasi & Tanpa Kewajiban Langganan Lanjutan"
    ]
  },
  branches: [
    { id: "senopati", name: "Senopati Central Hub", area: "Jakarta Selatan" },
    { id: "bsd", name: "BSD Technoplex Hub", area: "Tangerang Selatan" },
    { id: "dharmawangsa", name: "Dharmawangsa Sanctuary", area: "Jakarta Selatan" }
  ],
  timeSlots: [
    { id: "pagi", label: "Pagi (06:00 – 11:00)" },
    { id: "siang", label: "Siang (11:00 – 16:00)" },
    { id: "sore", label: "Sore / Malam (16:00 – 22:00)" },
    { id: "malam", label: "Larut Malam / 24 Jam" }
  ],
  trustStats: [
    { value: "4.9/5", label: "Rating Google (500+ Ulasan)" },
    { value: "78%", label: "Tingkat Retensi Member >6 Bulan" },
    { value: "Rp0", label: "Biaya Registrasi & Pembatalan" }
  ],
  steps: {
    headline: "Apa yang Terjadi Setelah Mengisi Formulir?",
    subheadline: "Kami menghilangkan segala bentuk kecemasan pengunjung pertama dengan alur kedatangan yang santai, mandiri, dan transparan.",
    items: [
      {
        icon: "qrcode",
        title: "Kamu Menerima QR Pass Digital di WhatsApp",
        description: "Kode pass unik langsung terkirim secara otomatis. Tidak perlu menunggu telepon verifikasi yang mengganggu aktivitasmu."
      },
      {
        icon: "scanface",
        title: "Datang Kapan Saja & Scan di Turnstile Pintu Masuk",
        description: "Bebas memilih waktu kunjungan sesuai rutinitasmu. Cukup pindai kode QR digital di pintu masuk untuk memulai latihan mandiri."
      },
      {
        icon: "smile",
        title: "Staf Memberi Orientasi Singkat Tanpa Jualan",
        description: "Tim kami akan menyapa ramah, menunjukkan fasilitas dan loker, serta menjawab pertanyaan latihanmu tanpa tawaran sales yang memaksa."
      }
    ]
  },
  faqs: {
    headline: "Pertanyaan Umum Pengunjung Pertama",
    subheadline: "Segala hal praktis yang perlu kamu ketahui sebelum datang ke hub kami.",
    items: [
      {
        question: "Apa saja perlengkapan yang perlu saya bawa saat kunjungan pertama?",
        answer: "Cukup bawa pakaian olahraga yang nyaman, sepatu olahraga bersol bersih, dan botol minum. Handuk bersih, loker pintar, shower air panas, sabun alami, dan dispenser air minum sudah kami sediakan gratis."
      },
      {
        question: "Apakah ada kewajiban membeli paket membership setelah 3 hari masa uji coba berakhir?",
        answer: "Sama sekali tidak ada. Jika setelah 3 hari kamu merasa fasilitas kami belum cocok untuk kebutuhanmu, akses QR pass akan nonaktif otomatis tanpa ada tagihan lanjutan atau penagihan sales via telepon."
      },
      {
        question: "Apakah saya boleh mengikuti kelas grup komunitas saat masa 3-Day Free Pass?",
        answer: "Tentu saja! Kamu berhak mengikuti 1 sesi kelas grup gratis (Hyrox Conditioning, Functional Core, Power Lifting Basic, atau Yoga Mobility) selama kuota per sesi masih tersedia."
      },
      {
        question: "Apakah saya bisa datang bersama teman?",
        answer: "Bisa. Mintalah temanmu untuk mengisi formulir 3-Day Free Pass secara mandiri agar masing-masing memiliki QR Pass akses digital tersendiri."
      }
    ]
  }
};

const {
  data = defaultData,
  showSteps = true,
  showFaqs = true,
  showTrustBar = true
} = Astro.props;

const heroData = { ...defaultData.hero, ...data?.hero };
const branches = data?.branches || defaultData.branches;
const timeSlots = data?.timeSlots || defaultData.timeSlots;
const trustStats = data?.trustStats || defaultData.trustStats;
const stepsData = { ...defaultData.steps, ...data?.steps };
const faqsData = { ...defaultData.faqs, ...data?.faqs };
---

<div class="trial-master-template text-[#F7F8F8] bg-[#08090A] selection:bg-[#5E6AD2]/30 selection:text-white">
  <!-- Section 1: Hero & Interactive Pass Activation Form -->
  <section class="pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-white/[0.08] bg-[#08090A]" id="trial-form-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left 6 cols: Value Proposition, Reassurance, & Guarantees -->
        <div class="lg:col-span-6 space-y-6">
          {heroData.badge && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded text-xs font-mono bg-[#27A644]/15 text-[#27A644] border border-[#27A644]/30">
              <span class="w-2 h-2 rounded-full bg-[#27A644]"></span>
              {heroData.badge}
            </span>
          )}

          <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-[#F7F8F8] leading-tight">
            {heroData.headline}
          </h1>

          <p class="text-base text-[#8A8F98] leading-relaxed">
            {heroData.subheadline}
          </p>

          <!-- Reassurance Checklist -->
          {heroData.benefits && heroData.benefits.length > 0 && (
            <div class="pt-4 space-y-3.5 border-t border-white/[0.08] text-xs text-[#8A8F98]">
              {heroData.benefits.map((benefit) => (
                <div class="flex items-center gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#27A644] shrink-0"></span>
                  <span class="text-[#F7F8F8] font-medium">{benefit}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Trust Proof Quick Bar (Inline) -->
          {showTrustBar && trustStats && (
            <div class="pt-6 grid grid-cols-3 gap-4 border-t border-white/[0.08]">
              {trustStats.map((stat) => (
                <div>
                  <div class="text-lg sm:text-xl font-bold font-mono text-[#F7F8F8]">{stat.value}</div>
                  <div class="text-[11px] text-[#8A8F98] leading-snug mt-0.5">{stat.label}</div>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Right 6 cols: Interactive Instant Pass Activation Form -->
        <div class="lg:col-span-6">
          <div class="rounded-xl border border-white/[0.12] bg-[#0A0B0D] p-6 sm:p-8 shadow-2xl relative" id="pass-container">
            
            <!-- FORM STATE -->
            <form id="trial-activation-form" class="space-y-4">
              <div>
                <label for="trial-fullname" class="block text-xs font-mono uppercase text-[#8A8F98] tracking-wider mb-1.5">
                  Nama Lengkap
                </label>
                <input
                  type="text"
                  id="trial-fullname"
                  name="fullName"
                  required
                  placeholder="Contoh: Rian Pratama"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-[#0F1011] border border-white/[0.08] text-sm text-[#F7F8F8] placeholder-[#62666D] focus:border-[#5E6AD2] focus:ring-1 focus:ring-[#5E6AD2] outline-hidden transition-colors"
                />
              </div>

              <div>
                <label for="trial-whatsapp" class="block text-xs font-mono uppercase text-[#8A8F98] tracking-wider mb-1.5">
                  Nomor WhatsApp (Untuk Pengiriman QR Pass)
                </label>
                <input
                  type="tel"
                  id="trial-whatsapp"
                  name="whatsapp"
                  required
                  placeholder="Contoh: 081234567890"
                  class="w-full px-3.5 py-2.5 rounded-lg bg-[#0F1011] border border-white/[0.08] text-sm text-[#F7F8F8] placeholder-[#62666D] focus:border-[#5E6AD2] focus:ring-1 focus:ring-[#5E6AD2] outline-hidden transition-colors"
                />
                <span class="text-[11px] text-[#62666D] mt-1 block">Kami tidak akan mengirim spam promosi atau sales push.</span>
              </div>

              <div>
                <label class="block text-xs font-mono uppercase text-[#8A8F98] tracking-wider mb-1.5">
                  Pilih Hub Cabang Terdekat
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="branch-selector-group">
                  {branches.map((b, idx) => (
                    <button
                      type="button"
                      data-branch-id={b.id}
                      data-branch-name={b.name}
                      class={`branch-btn text-left p-3 rounded-lg border transition-all ${
                        idx === 0
                          ? 'bg-[#5E6AD2]/15 border-[#5E6AD2] text-[#F7F8F8] active-branch'
                          : 'bg-[#0F1011] border-white/[0.08] text-[#8A8F98] hover:border-white/[0.15]'
                      }`}
                    >
                      <div class="text-xs font-medium text-[#F7F8F8]">{b.name}</div>
                      <div class="text-[10px] text-[#8A8F98]">{b.area}</div>
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label class="block text-xs font-mono uppercase text-[#8A8F98] tracking-wider mb-1.5">
                  Rencana Jam Kunjungan Pertama
                </label>
                <div class="grid grid-cols-2 gap-2" id="timeslot-selector-group">
                  {timeSlots.map((slot, idx) => (
                    <button
                      type="button"
                      data-slot-id={slot.id}
                      class={`timeslot-btn text-left p-2.5 rounded-lg border text-xs transition-all ${
                        idx === 2
                          ? 'bg-[#5E6AD2]/15 border-[#5E6AD2] text-[#F7F8F8] active-timeslot'
                          : 'bg-[#0F1011] border-white/[0.08] text-[#8A8F98] hover:border-white/[0.15]'
                      }`}
                    >
                      {slot.label}
                    </button>
                  ))}
                </div>
              </div>

              <div class="pt-3">
                <button
                  type="submit"
                  class="w-full py-3 px-4 rounded-lg bg-[#5E6AD2] hover:bg-[#7170FF] text-[#F7F8F8] text-sm font-medium transition-colors border border-[#7170FF]/30 shadow-md flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Kirimkan QR Akses Free Pass via WhatsApp</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
                <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-[11px] text-[#62666D] mt-3 text-center">
                  <span>✓ 100% Gratis Rp0</span>
                  <span>✓ Tanpa Kartu Kredit</span>
                  <span>✓ Tanpa Tagihan Otomatis</span>
                </div>
              </div>
            </form>

            <!-- SUCCESS PASS CARD STATE (Hidden initially) -->
            <div id="trial-success-card" class="hidden border border-[#5E6AD2]/40 bg-[#0F1011] rounded-xl p-6 sm:p-8 space-y-6 text-center">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-[#27A644]/15 text-[#27A644] border border-[#27A644]/30">
                <span class="w-2 h-2 rounded-full bg-[#27A644]"></span>
                3-DAY FREE PASS AKTIF
              </div>

              <div>
                <h4 class="text-xl font-bold text-[#F7F8F8]">QR Pass Siap Digunakan</h4>
                <p class="text-xs text-[#8A8F98] mt-1">
                  Salinan digital telah disiapkan untuk WhatsApp <span id="pass-card-phone" class="text-[#F7F8F8] font-mono font-medium"></span>
                </p>
              </div>

              <!-- Digital QR Visual -->
              <div class="max-w-xs mx-auto p-5 rounded-lg bg-[#191A1B] border border-white/[0.1] space-y-4">
                <div class="flex justify-between items-center text-[10px] font-mono text-[#8A8F98] border-b border-white/[0.08] pb-2">
                  <span>KINETIK ACCESS</span>
                  <span class="text-[#27A644]">VERIFIED</span>
                </div>

                <div class="w-36 h-36 mx-auto bg-white p-2.5 rounded-lg flex items-center justify-center shadow-inner">
                  <div class="w-full h-full border-2 border-dashed border-black flex flex-col items-center justify-center text-[9px] font-mono text-black leading-tight text-center">
                    <span id="pass-card-code" class="font-bold text-xs">KTK-849201</span>
                    <span class="mt-1">SCAN AT TURNSTILE</span>
                  </div>
                </div>

                <div class="text-left space-y-1 text-xs pt-1">
                  <div class="text-[11px] text-[#8A8F98]">Member: <span id="pass-card-name" class="text-[#F7F8F8] font-medium"></span></div>
                  <div class="text-[11px] text-[#8A8F98]">Lokasi: <span id="pass-card-branch" class="text-[#F7F8F8] font-medium"></span></div>
                  <div class="text-[11px] text-[#8A8F98]">Masa Berlaku: <span class="text-[#27A644] font-medium">3 Hari Sejak Scan Pertama</span></div>
                </div>
              </div>

              <div class="space-y-2 max-w-sm mx-auto">
                <a
                  id="pass-wa-link"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-4 rounded-lg bg-[#27A644] hover:bg-[#2EB84D] text-white text-xs font-medium transition-colors flex items-center justify-center gap-2"
                >
                  <span>Konfirmasi / Tanya Coach via WhatsApp</span>
                </a>

                <button
                  type="button"
                  id="reset-pass-btn"
                  class="text-xs text-[#8A8F98] hover:text-[#F7F8F8] transition-colors py-1 cursor-pointer"
                >
                  Daftarkan Pass untuk Orang Lain
                </button>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section 2: Onboarding Steps (Eliminating First-Timer Intimidation) -->
  {showSteps && stepsData && stepsData.items && (
    <section class="py-20 lg:py-28 border-b border-white/[0.08] bg-[#0A0B0D]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16">
          <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[#F7F8F8]">
            {stepsData.headline}
          </h2>
          <p class="mt-4 text-sm sm:text-base text-[#8A8F98]">
            {stepsData.subheadline}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-white/[0.08]">
          {stepsData.items.map((st, idx) => (
            <div class={`pt-8 md:pt-0 ${idx !== 0 ? 'md:pl-8' : ''} space-y-3`}>
              <div class="w-10 h-10 rounded-lg bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-[#5E6AD2]">
                {st.icon === 'qrcode' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect width="5" height="5" x="3" y="3" rx="1" stroke-width="2" />
                    <rect width="5" height="5" x="16" y="3" rx="1" stroke-width="2" />
                    <rect width="5" height="5" x="3" y="16" rx="1" stroke-width="2" />
                    <path stroke-width="2" d="M21 16h-3a2 2 0 0 0-2 2v3m0-5v.01m5 4.99v.01M12 7v3m-3-1.5h6M7 12h3m-1.5-3v6" />
                  </svg>
                )}
                {st.icon === 'scanface' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M9 10h.01M15 10h.01M9.5 15a3.5 3.5 0 0 0 5 0" />
                  </svg>
                )}
                {st.icon === 'smile' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="2" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01" />
                  </svg>
                )}
                {st.icon === 'shield' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
              </div>
              <h3 class="text-base font-semibold text-[#F7F8F8] tracking-tight">{st.title}</h3>
              <p class="text-xs sm:text-sm text-[#8A8F98] leading-relaxed">{st.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Section 3: Built-in Native Accessible FAQ Disclosure Accordion -->
  {showFaqs && faqsData && faqsData.items && (
    <section class="py-20 lg:py-28 bg-[#08090A]" id="trial-faqs">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-semibold tracking-tight text-[#F7F8F8]">
            {faqsData.headline}
          </h2>
          <p class="mt-3 text-xs sm:text-sm text-[#8A8F98]">
            {faqsData.subheadline}
          </p>
        </div>

        <div class="divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {faqsData.items.map((faq) => (
            <details class="group py-5 transition-all">
              <summary class="flex items-center justify-between gap-4 text-left cursor-pointer list-none select-none">
                <span class="text-sm sm:text-base font-medium text-[#F7F8F8] group-hover:text-[#5E6AD2] transition-colors">
                  {faq.question}
                </span>
                <span class="p-1 rounded-md bg-white/[0.04] border border-white/[0.08] text-[#8A8F98] group-hover:text-[#F7F8F8] group-open:rotate-180 group-open:bg-white/[0.08] shrink-0 transition-transform duration-200">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pr-8 text-xs sm:text-sm text-[#8A8F98] leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</div>

<!-- Embedded Client Script for Self-Contained Interactive Free Pass Form & State Management -->
<script is:inline>
  (function () {
    function initTrialComponent() {
      const form = document.getElementById('trial-activation-form');
      const successCard = document.getElementById('trial-success-card');
      const resetBtn = document.getElementById('reset-pass-btn');
      const branchBtns = document.querySelectorAll('.branch-btn');
      const timeslotBtns = document.querySelectorAll('.timeslot-btn');

      if (!form || !successCard) return;

      let selectedBranchName = branchBtns[0]?.getAttribute('data-branch-name') || 'Senopati Central Hub';

      // Branch selector toggles
      branchBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          branchBtns.forEach((b) => {
            b.classList.remove('bg-[#5E6AD2]/15', 'border-[#5E6AD2]', 'text-[#F7F8F8]', 'active-branch');
            b.classList.add('bg-[#0F1011]', 'border-white/[0.08]', 'text-[#8A8F98]');
          });
          btn.classList.add('bg-[#5E6AD2]/15', 'border-[#5E6AD2]', 'text-[#F7F8F8]', 'active-branch');
          btn.classList.remove('bg-[#0F1011]', 'border-white/[0.08]', 'text-[#8A8F98]');
          selectedBranchName = btn.getAttribute('data-branch-name') || selectedBranchName;
        });
      });

      // Timeslot selector toggles
      timeslotBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          timeslotBtns.forEach((b) => {
            b.classList.remove('bg-[#5E6AD2]/15', 'border-[#5E6AD2]', 'text-[#F7F8F8]', 'active-timeslot');
            b.classList.add('bg-[#0F1011]', 'border-white/[0.08]', 'text-[#8A8F98]');
          });
          btn.classList.add('bg-[#5E6AD2]/15', 'border-[#5E6AD2]', 'text-[#F7F8F8]', 'active-timeslot');
          btn.classList.remove('bg-[#0F1011]', 'border-white/[0.08]', 'text-[#8A8F98]');
        });
      });

      // Submit handler
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fullNameInput = document.getElementById('trial-fullname');
        const whatsappInput = document.getElementById('trial-whatsapp');

        const fullName = fullNameInput ? fullNameInput.value.trim() : '';
        const whatsapp = whatsappInput ? whatsappInput.value.trim() : '';

        if (!fullName || !whatsapp) return;

        const passCode = 'KTK-' + Math.floor(100000 + Math.random() * 900000);

        // Update card info
        const phoneEl = document.getElementById('pass-card-phone');
        const codeEl = document.getElementById('pass-card-code');
        const nameEl = document.getElementById('pass-card-name');
        const branchEl = document.getElementById('pass-card-branch');
        const waLink = document.getElementById('pass-wa-link');

        if (phoneEl) phoneEl.textContent = whatsapp;
        if (codeEl) codeEl.textContent = passCode;
        if (nameEl) nameEl.textContent = fullName;
        if (branchEl) branchEl.textContent = selectedBranchName;

        if (waLink) {
          const msg = encodeURIComponent(
            `Halo KINETIK, saya sudah mengaktifkan Free Pass dengan kode ${passCode} atas nama ${fullName} untuk cabang ${selectedBranchName}.`
          );
          waLink.href = `https://wa.me/6281234567890?text=${msg}`;
        }

        form.classList.add('hidden');
        successCard.classList.remove('hidden');
      });

      // Reset handler
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          successCard.classList.add('hidden');
          form.classList.remove('hidden');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrialComponent);
    } else {
      initTrialComponent();
    }
  })();
</script>
