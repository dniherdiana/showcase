---
import Container from '../base/Container.astro';
import SectionHeader from '../base/SectionHeader.astro';
import Button from '../base/Button.astro';
import { Image } from 'astro:assets';
import { images } from '../../images/images';
import { Home, Store, Globe, Check, ArrowUpRight } from 'lucide-astro';

const iconMap = {
  Home,
  Store,
  Globe,
};

const layananServicesData = {
  title: 'Tiga spektrum perancangan sesuai tipologi kebutuhan.',
  lede: 'Setiap kategori layanan disesuaikan dengan tantangan spesifik: kenyamanan harian untuk hunian, alur operasional untuk bisnis, dan efisiensi koordinasi untuk luar kota.',
  meta: 'Kategori Layanan Utama',
  services: [
    {
      id: 'residensial',
      icon: 'Home',
      title: 'Arsitektur & Interior Residensial',
      target: 'Hunian Pertama, Rumah Tumbuh, Renovasi Total',
      image: 'project-residensial-sleman.jpg',
      rate: 'Mulai Rp 175.000 - 250.000 / m²',
      description:
        'Perancangan rumah tinggal yang berpusat pada kesehatan penghuni: pencahayaan alami tanpa silau, ventilasi silang penurun panas, dan tata ruang privat yang menenangkan.',
      scope: [
        'Analisis tapak, iklim mikro, dan zonasi kebisingan',
        'Denah arsitektur 2D, tampak, dan potongan struktural',
        'Visualisasi 3D interior & eksterior resolusi tinggi',
        'Buku DED lengkap arsitektur, MEP (listrik & pipa), dan struktur',
        'Pendampingan pemilihan material lokal & supervisi berkala',
      ],
    },
    {
      id: 'komersial',
      icon: 'Store',
      title: 'Desain Spasial Komersial Butik',
      target: 'Kafe, Kedai Kopi, Klinik Estetika, Retail, Studio',
      image: 'sonder-senopati.jpg',
      rate: 'Mulai Rp 225.000 - 320.000 / m²',
      description:
        'Membangun identitas ruang usaha yang fotogenik otentik dan memiliki alur sirkulasi operasional staf serta pelanggan yang sangat efisien.',
      scope: [
        'Studi alur kerja staf (service flow) dan zona interaksi pengunjung',
        'Desain fasad ikonik berbasis material lokal ramah iklim',
        'Detail furnitur built-in kustom (bar counter, etalase, seating)',
        'Perhitungan titik pencahayaan dan akustik ruang',
        'RAB estimasi biaya konstruksi terperinci untuk bisnis plan',
      ],
    },
    {
      id: 'remote',
      icon: 'Globe',
      title: 'Studi Konsep Lahan Jarak Jauh (Remote)',
      target: 'Klien Luar Kota, Vila Luar Daerah, Investor Lahan',
      image: 'feasibility-study.jpg',
      rate: 'Mulai Rp 120.000 - 180.000 / m²',
      description:
        'Layanan perancangan konseptual penuh tanpa membebani klien dengan biaya perjalanan survei tinggi di tahap awal. Cukup kirimkan data sertifikat, kontur, dan foto tapak.',
      scope: [
        'Studi kelayakan potensi lahan via analisis GIS dan kontur satelit',
        'Konsep zonasi masterplan dan pembagian massa bangunan',
        'Paket gambar skematik 2D dan 3D render konseptual',
        'Sesi konsultasi intensif via Zoom/Google Meet terjadwal',
        'Rekomendasi spesifikasi material lokal di sekitar area proyek',
      ],
    },
  ],
};
---

<section class="py-20 sm:py-28 border-b border-border bg-surface/30">
  <Container>
    <SectionHeader
      title={layananServicesData.title}
      lede={layananServicesData.lede}
      align="split"
      meta={layananServicesData.meta}
    />

    <div class="space-y-12">
      {layananServicesData.services.map((svc) => {
        const IconComponent = iconMap[svc.icon as keyof typeof iconMap] || Home;
        const imgAsset = svc.image ? images[svc.image.toLowerCase()] : null;
        return (
          <div id={svc.id} class="bg-bg p-8 sm:p-12 rounded-xl border border-border">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              <!-- Service Info (5 cols) -->
              <div class="lg:col-span-5 flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <div class="p-2.5 rounded-lg bg-surface border border-border text-accent">
                      <IconComponent class="w-5 h-5" />
                    </div>
                    <span class="font-mono text-xs uppercase tracking-wider text-muted font-semibold">
                      {svc.target}
                    </span>
                  </div>

                  <h3 class="font-display text-2xl sm:text-3xl font-bold text-ink mb-4">
                    {svc.title}
                  </h3>

                  <p class="font-body text-sm text-muted leading-relaxed mb-6">
                    {svc.description}
                  </p>
                </div>

                <!-- Service Image Preview -->
                {imgAsset && (
                  <div class="relative rounded-lg overflow-hidden border border-border bg-surface aspect-16/10 mb-6">
                    <Image
                      src={imgAsset}
                      alt={svc.title}
                      class="w-full h-full object-cover"
                      widths={[400, 600]}
                      sizes="(max-width: 1024px) 100vw, 400px"
                    />
                  </div>
                )}

                <div class="pt-4 border-t border-border-subtle">
                  <span class="font-mono text-xs text-muted block mb-1">Kisaran Biaya Perancangan:</span>
                  <div class="font-display text-lg font-bold text-accent">
                    {svc.rate}
                  </div>
                </div>
              </div>

              <!-- Scope Deliverables (7 cols) -->
              <div class="lg:col-span-7 bg-surface p-6 sm:p-8 rounded-lg border border-border">
                <h4 class="font-mono text-xs uppercase tracking-wider text-ink font-semibold mb-4 pb-2 border-b border-border">
                  Keluaran Dokumen & Cakupan Kerja
                </h4>
                <ul class="space-y-3 font-body text-xs text-muted mb-8">
                  {svc.scope.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <Check class="w-4 h-4 text-accent shrink-0 mt-0.5" />
                      <span class="text-ink">{item}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                  <span class="font-mono text-[11px] text-muted">Standar IAI & PBG</span>
                  <Button
                    href={`https://wa.me/6281234567890?text=Halo%20Studio%20Ambang%2C%20saya%20tertarik%20dengan%20layanan%20${encodeURIComponent(svc.title)}.`}
                    variant="primary"
                    size="sm"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Konsultasikan Layanan Ini</span>
                    <ArrowUpRight class="w-3.5 h-3.5" />
                  </Button>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</section>