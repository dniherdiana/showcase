    perks_id: ["Sewa Kapal Phinisi Privat", "Penyelaman Kapal Selam 1.000m", "Barbekyu Pantai Pulau Tak Berpenghuni"],
    recommended_en: "Raja Ampat • Maldives Deep Sea",
    recommended_id: "Raja Ampat • Maldives Deep Sea",
    actionHref: "/destinations/superyacht-island-hopping-raja-ampat",
  },
  {
    id: "wilderness",
    badge_en: "Wilderness & Air Safaris",
    badge_id: "Alam Liar & Safari Udara Afrika",
    title_en: "Dawn Balloons & Stargazing Domes",
    title_id: "Balon Udara Fajar & Bintang Gurun",
