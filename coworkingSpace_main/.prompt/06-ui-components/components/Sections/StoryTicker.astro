---
import { Image } from "astro:assets";
import { images } from "../assets/images/index.js";

interface TravelStyle {
  id: string;
  badge_en: string;
  badge_id: string;
  title_en: string;
  title_id: string;
  subtitle_en: string;
  subtitle_id: string;
  desc_en: string;
  desc_id: string;
  image: ImageMetadata;
  perks_en: string[];
  perks_id: string[];
  recommended_en: string;
  recommended_id: string;
  actionHref: string;
}

const travelStyles: TravelStyle[] = [
  {
    id: "coastal",
    badge_en: "Coastal & Island Retreats",
    badge_id: "Pantai & Pulau Tersembunyi",
    title_en: "Tranquil Oceans & Private Villas",
    title_id: "Ketenangan Pesisir & Vila Privat Tebing",
    subtitle_en: "Peaceful coastal stays overlooking crystal-clear waters away from tourist crowds.",
    subtitle_id: "Penginapan damai tepi pantai memandang laut jernih jauh dari keramaian turis.",
    desc_en: "Stay in cliffside boutique villas in Positano or cave suites in Oia. Enjoy private Riva speedboat charters to Capri and quiet lemon grove wine tastings.",
    desc_id: "Menginap di vila boutique tepi tebing Positano atau suite gua Oia. Nikmati sewa speedboat kayu privat ke Capri dan cicip anggur di kebun lemon yang tenang.",
    image: images.amalfi,
    perks_en: ["100% Private Boat Charters", "Cliffside Balcony Stays", "Private Sommelier Dinners"],
    perks_id: ["Sewa Kapal Privat 100%", "Vila Balkon Tebing Laut", "Makan Malam Sommelier"],
    recommended_en: "Amalfi Coast • Santorini • Capri",
    recommended_id: "Amalfi Coast • Santorini • Capri",
    actionHref: "/destinations/amalfi-coast-sanctuary",
  },
  {
    id: "alpine",
    badge_en: "High Alpine & Snow Chalets",
    badge_id: "Pegunungan & Chalet Salju",
    title_en: "Glacier Flight & Fireside Comfort",
    title_id: "Helikopter Gletser & Chalet Perapian",
    subtitle_en: "Cozy mountain chalets, high alpine views, and private glacier landings.",
    subtitle_id: "Chalet kayu hangat di pegunungan, pemandangan gletser, dan helikopter privat.",
    desc_en: "Retreat to Zermatt in alpine luxury. Fly by private Eurocopter over frozen glaciers for sommelier wine tastings before relaxing in your chalet hot tub.",
    desc_id: "Bersantai di Zermatt dengan penginapan pegunungan privat. Terbang dengan helikopter di atas gletser es dan bersantai di kolam air hangat chalet kayu Anda.",
    image: images.swissAlps,
    perks_en: ["Private Helicopter Flights", "Personal Chef & Sauna", "Gornergrat VIP Passes"],
    perks_id: ["Terbang Helikopter Privat", "Koki Pribadi & Sauna", "Tiket Kereta VIP Gornergrat"],
    recommended_en: "Swiss Matterhorn • Zermatt • Julian Alps",
    recommended_id: "Swiss Matterhorn • Zermatt • Julian Alps",
    actionHref: "/destinations/swiss-matterhorn-chalet",
  },
  {
    id: "yachting",
    badge_en: "Yachting & Deep Sea Diving",
    badge_id: "Pelayaran Kapal Phinisi & Laut Dalam",
    title_en: "Private Phinisi & Submarine Expeditions",
    title_id: "Jelajah Phinisi & Eksplorasi Kapal Selam",
    subtitle_en: "Navigate untouched coral islands with full crew, divemasters, and private chefs.",
    subtitle_id: "Jelajahi gugusan pulau karang alami bersama kru kapal, instruktur selam, & koki pribadi.",
    desc_en: "Charter traditional wooden Phinisi superyachts through Raja Ampat's Wayag lagoons or dive 1,000 meters into deep Maldives trenches in private Triton submersibles.",
    desc_id: "Sewa kapal Phinisi kayu tradisional mengelilingi laguna Wayag Raja Ampat atau menyelam 1.000 meter di palung laut Maldives dengan kapal selam privat.",
    image: images.rajaAmpat,
