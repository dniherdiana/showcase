<section
	class="bg-[var(--color-navy)] text-[var(--color-offwhite)] py-32 relative overflow-hidden border-t border-[var(--color-orange)]/20"
>
	<div class="max-w-7xl mx-auto px-8 md:px-16">
		<!-- Header — 70% width -->
		<div class="w-full lg:w-[70%] mb-16" data-reveal>
			<div class="section-meta mb-4">
				<span style="color: var(--color-orange);"
					>[PHYSICAL ASSETS &amp; INFRASTRUCTURE]</span
				>
			</div>
			<h2
				class="font-sans font-bold text-4xl md:text-5xl lg:text-6xl tracking-tight leading-tight mb-6"
			>
				Fasilitas Distribusi dan Armada Operasional Lapangan
			</h2>
			<p
				class="font-sans text-[var(--color-steel)] text-[0.95rem] leading-[1.75] max-w-xl"
			>
				Dokumentasi fasilitas loading dock, area cold storage, dan jajaran
				armada wingbox di Hub Utama Jakarta (Cikarang) dan Distribution Center
				Surabaya (Rungkut Industri).
			</p>
		</div>

		<!-- Masonry grid -->
		<div
			class="columns-1 md:columns-2 lg:columns-3 gap-4"
			data-reveal
			data-delay="150"
		>
			<!-- Photo 1: Loading bay (tall) -->
			<div class="relative group overflow-hidden mb-4 break-inside-avoid">
				<img
					src="https://images.unsplash.com/photo-1565891741441-64926e441838?w=600&q=82&auto=format&fit=crop"
					alt="Loading Dock Area"
					class="w-full h-auto block transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 01] LOADING DOCKS &amp; BAY — HUB CIKARANG
					</span>
				</div>
			</div>

			<!-- Photo 2: Fleet lineup (wide) -->
			<div class="relative group overflow-hidden mb-4 break-inside-avoid">
				<img
					src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?w=700&q=82&auto=format&fit=crop"
					alt="Heavy Fleet Lineup"
					class="w-full h-auto block transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 02] HEAVY-DUTY FLEET LINEUP — ACTIVE UNITS
					</span>
				</div>
			</div>

			<!-- Photo 3: Cold storage (square) -->
			<div
				class="relative group overflow-hidden mb-4 break-inside-avoid aspect-square"
			>
				<img
					src="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=600&q=82&auto=format&fit=crop"
					alt="Cold Storage Facility"
					class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 03] COLD-CHAIN STORAGE — TEMP CONTROL ROOM
					</span>
				</div>
			</div>

			<!-- Photo 4: Warehouse interior (tall) -->
			<div class="relative group overflow-hidden mb-4 break-inside-avoid">
				<img
					src="https://images.unsplash.com/photo-1473445730015-841f29a9490b?w=600&q=82&auto=format&fit=crop"
					alt="Warehouse Interior"
					class="w-full h-auto block transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 04] DISTRIBUTION CENTER — RACKING SYSTEM
					</span>
				</div>
			</div>

			<!-- Photo 5: Maintenance facility (wide) -->
			<div class="relative group overflow-hidden mb-4 break-inside-avoid">
				<img
					src="https://images.unsplash.com/photo-1543335929-07e7b6e56c6b?w=700&q=82&auto=format&fit=crop"
					alt="Fleet Maintenance Facility"
					class="w-full h-auto block transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 05] FLEET MAINTENANCE FACILITY — PREVENTIVE CARE
					</span>
				</div>
			</div>

			<!-- Photo 6: Operations control (square) -->
			<div
				class="relative group overflow-hidden mb-4 break-inside-avoid aspect-square"
			>
				<img
					src="https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=600&q=82&auto=format&fit=crop"
					alt="Fleet Telematics Control Room"
					class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
					style="filter: grayscale(60%) contrast(1.15) brightness(0.75);"
					loading="lazy"
				/>
				<div
					class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5"
					style="background: linear-gradient(to top, rgba(10,15,30,0.9) 0%, transparent 60%);"
				>
					<span
						class="font-mono text-[0.6rem] tracking-[0.2em] uppercase text-[var(--color-orange)]"
					>
						[PHOTO 06] FLEET TELEMATICS HUB — GPS DISPATCH CENTER
					</span>
				</div>
			</div>
		</div>
	</div>
</section>
