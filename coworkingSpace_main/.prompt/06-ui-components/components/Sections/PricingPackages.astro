---
---

<section id="paket" class="py-24 md:py-32 relative" aria-label="Pilihan Skema Paket">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="font-serif-editorial text-3xl sm:text-4xl lg:text-5xl text-[#1C2520] font-normal leading-tight mb-4">
        Tiga Pilihan Paket yang Paling Sering Dipilih & <span class="italic text-[#C86D51] font-semibold">Dokumen Lengkap Semua</span>
      </h2>
      <p class="text-base text-[#5A6660] font-sans-body">
        Mau trip keluarga kecil, outing kantor ratusan orang, atau jalan-jalan ke luar negeri—pilih yang paling cocok, sisanya kami urus.
      </p>
    </div>

    <!-- Pricing Package Row -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-stretch">
      
      <!-- Card 1: Family & Private Trip Escape -->
      <div class="lg:col-span-4 bg-white rounded-2xl p-8 border border-[#1C2520]/15 shadow-sm flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-[#C86D51]">Family & Private</span>
            <span class="text-xs font-semibold text-[#6B7674]">2–15 Pax</span>
          </div>

          <h3 class="font-serif-editorial text-2xl text-[#1C2520] font-semibold mb-2">
            Private Family Vacation
          </h3>
          <p class="text-xs text-[#5A6660] mb-6 leading-relaxed font-sans-body">
            Dibuat khusus buat rombongan keluarga—dari kakek-nenek sampai cucu—dengan tempo santai tanpa dikejar waktu.
          </p>

          <div class="mb-8 pb-6 border-b border-[#1C2520]/10">
            <span class="text-xs text-[#6B7674] block mb-1">Mulai dari</span>
            <div class="flex items-baseline gap-1">
              <span class="text-sm font-semibold text-[#1C2520]">Rp</span>
              <span class="font-serif-editorial text-4xl font-bold text-[#1C2520]">2.850.000</span>
              <span class="text-xs text-[#5A6660]">/ pax</span>
            </div>
            <span class="text-[11px] text-[#2C5E4E] font-semibold mt-1 block">✓ Semua sudah termasuk, nggak ada biaya tambahan</span>
          </div>

          <ul class="space-y-3 text-xs text-[#1C2520] font-medium mb-8">
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Transportasi Private (HiAce/Innova Zenix)
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Hotel Bintang 4 Pilihan (Termasuk Sarapan)
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Jadwal Santai, Ramah Balita & Lansia
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Driver Sabar + Guide yang Tahu Medan
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Kwitansi Personal & Dokumentasi Foto
            </li>
          </ul>
        </div>

        <div>
          <button 
            type="button"
            data-modal-target="proposal-modal"
            data-product-name="Private Family Vacation"
            class="open-proposal-modal w-full bg-[#FAF7F2] hover:bg-[#2C5E4E] text-[#1C2520] hover:text-white border border-[#1C2520]/20 hover:border-transparent text-xs font-semibold py-3.5 rounded-xl transition-all cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-[#2C5E4E]"
          >
            Konsultasi Family Trip
          </button>

          <!-- [CV2 Fix: Detail anchor link] -->
          <a href="/paket-wisata#katalog-lengkap" class="text-[11px] text-[#2C5E4E] hover:underline text-center block mt-3 font-semibold">
            Lihat semua paket family →
          </a>
        </div>
      </div>

      <!-- Card 2: FEATURED / RECOMMENDED -->
      <div class="lg:col-span-5 bg-[#15221E] text-white rounded-3xl p-10 lg:p-12 shadow-2xl border-2 border-[#C86D51] relative lg:-translate-y-4 flex flex-col justify-between z-10">
        
        <!-- Elevated Badge Tag -->
        <div class="absolute -top-4 right-8 bg-[#C86D51] text-white text-[11px] font-bold tracking-widest uppercase px-4 py-1.5 rounded-full shadow-lg">
          Paling Banyak Dipilih HRD & Procurement
        </div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-widest text-[#EFE6D8]">Corporate & Outing</span>
            <span class="text-xs font-semibold text-[#83918A]">20–500+ Pax</span>
          </div>

          <h3 class="font-serif-editorial text-3xl sm:text-4xl text-white font-semibold mb-3">
            Company Gathering & MICE
          </h3>
          <p class="text-sm text-[#EFE6D8]/80 mb-8 leading-relaxed font-sans-body">
            Satu paket lengkap buat outing kantor: gala dinner, outbound, rundown rapi, sampai e-Faktur dan termin pembayaran—nggak perlu pusing cari vendor terpisah.
          </p>

          <div class="mb-8 pb-6 border-b border-white/15">
            <span class="text-xs text-[#83918A] block mb-1">Perkiraan Biaya per Orang</span>
            <div class="flex items-baseline gap-2">
              <span class="text-base font-semibold text-[#EFE6D8]">Rp</span>
              <span class="font-serif-editorial text-5xl font-bold text-white">1.950.000</span>
              <span class="text-xs text-[#EFE6D8]/70">/ orang (bisa disesuaikan)</span>
            </div>
            <div class="mt-2 flex items-center gap-2 text-xs text-[#C86D51] font-semibold">
              <span>⚡ Quotation & contoh e-Faktur bisa dikirim kurang dari 3 jam</span>
            </div>
          </div>

          <!-- Feature List -->
          <div class="space-y-3.5 text-xs font-medium text-[#EFE6D8] mb-10">
            <div class="flex items-start gap-2.5">
              <span class="text-[#C86D51] font-bold text-sm" aria-hidden="true">✓</span>
              <span><strong>Dokumen Beres:</strong> Quotation, Invoice, Kwitansi, e-Faktur, NPWP & Rooming List</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-[#C86D51] font-bold text-sm" aria-hidden="true">✓</span>
              <span><strong>Bayar Bertahap:</strong> Bisa DP dulu, sisanya menyesuaikan jadwal finance kantor</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-[#C86D51] font-bold text-sm" aria-hidden="true">✓</span>
              <span><strong>Tim Seru:</strong> Facilitator outbound, sound system, MC & hiburan Gala Dinner</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-[#C86D51] font-bold text-sm" aria-hidden="true">✓</span>
              <span><strong>Armada Terbaru:</strong> Bus Pariwisata HDD/SHD keluaran baru, izin Kemenhub resmi</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="text-[#C86D51] font-bold text-sm" aria-hidden="true">✓</span>
              <span><strong>Siap Darurat:</strong> Ada pendamping medis & asuransi perjalanan</span>
            </div>
          </div>
        </div>

        <div>
          <button 
            type="button"
            data-modal-target="proposal-modal"
            data-product-name="Company Gathering & MICE"
            class="open-proposal-modal w-full bg-[#C86D51] hover:bg-[#B55B40] text-white text-sm font-semibold py-4 rounded-xl shadow-xl hover:shadow-2xl transition-all cursor-pointer text-center flex items-center justify-center gap-2 group focus:outline-none focus:ring-2 focus:ring-[#C86D51]"
          >
            <span>Minta Proposal & Sample Faktur Pajak</span>
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
          </button>

          <!-- [CV2 Fix: Detail anchor link] -->
          <a href="/#legal-admin" class="text-[11px] text-[#EFE6D8]/80 hover:text-white hover:underline text-center block mt-3 font-semibold">
            Lihat detail skema pembayaran & e-Faktur →
          </a>
        </div>
      </div>

      <!-- Card 3: Exclusive International -->
      <div class="lg:col-span-3 bg-white rounded-2xl p-8 border border-[#1C2520]/15 shadow-sm flex flex-col justify-between h-full">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-[#2C5E4E]">Manca Negara</span>
            <span class="text-xs font-semibold text-[#6B7674]">Custom Pax</span>
          </div>

          <h3 class="font-serif-editorial text-2xl text-[#1C2520] font-semibold mb-2">
            Overseas & Executive Trip
          </h3>
          <p class="text-xs text-[#5A6660] mb-6 leading-relaxed font-sans-body">
            Jepang, Korea, Turkey, Eropa dengan pendampingan tour leader & asistensi pengurusan visa.
          </p>

          <div class="mb-8 pb-6 border-b border-[#1C2520]/10">
            <span class="text-xs text-[#6B7674] block mb-1">Mulai dari</span>
            <div class="flex items-baseline gap-1">
              <span class="text-sm font-semibold text-[#1C2520]">Rp</span>
              <span class="font-serif-editorial text-4xl font-bold text-[#1C2520]">12.500.000</span>
            </div>
            <span class="text-[11px] text-[#2C5E4E] font-semibold mt-1 block">✓ Asistensi Visa + Insurance</span>
          </div>

          <!-- [U2 Fix: Added 2 missing bullet points for trust] -->
          <ul class="space-y-3 text-xs text-[#1C2520] font-medium mb-8">
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Tour Leader lisensi resmi
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Pengurusan Visa terpandu
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Tiket Flight International PP
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Hotel Bintang 4 Pusat Kota
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Asistensi Visa + Checklist Dokumen
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#2C5E4E] font-bold" aria-hidden="true">✓</span> Asuransi Perjalanan Internasional Included
            </li>
          </ul>
        </div>

        <div>
          <button 
            type="button"
            data-modal-target="proposal-modal"
            data-product-name="Overseas & Executive Trip"
            class="open-proposal-modal w-full bg-[#FAF7F2] hover:bg-[#2C5E4E] text-[#1C2520] hover:text-white border border-[#1C2520]/20 hover:border-transparent text-xs font-semibold py-3.5 rounded-xl transition-all cursor-pointer text-center focus:outline-none focus:ring-2 focus:ring-[#2C5E4E]"
          >
            Konsultasi Trip Internasional
          </button>

          <!-- [CV2 Fix: Detail anchor link] -->
          <a href="/paket-wisata#katalog-lengkap" class="text-[11px] text-[#2C5E4E] hover:underline text-center block mt-3 font-semibold">
            Lihat katalog paket internasional →
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
