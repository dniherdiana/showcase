---
// ============================================================================
//  Hero.astro — Strategic Positioning Hero (Anti-Slop Cinematic Full Bleed)
//  Tailwind CSS v4 template. No installation needed — copy into your Astro
//  project (src/components/) and import on a page.
//
//  Usage:
//    import Hero from "../components/Hero.astro";
//    <Hero />
//    <Hero bgImage="..." title="..." primaryCta={{ label: "Mulai", href: "#" }} />
//
//  Note: ensure your page uses Tailwind v4 (`@import "tailwindcss";`
//  in src/styles/global.css) and that `astro.config.mjs` points to it.
// ============================================================================

interface CTA {
  label: string;
  href: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  secondaryText?: string;
  bgImage?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
  note?: string;
}

const {
  id = "hero",
  eyebrow = "Executive Travel Architecture",
  title = "ARSITEKTUR PERJALANAN KORPORASI & WISATA PREMIUM TANPA RISIKO",
  description = "Kencana Voyage menghadirkan standar baru dalam pengelolaan insentif bisnis, outing enterprise, dan perjalanan kustom kelas dunia. Kami mengeliminasi seluruh ketidakpastian operasional melalui jaminan transparansi anggaran 100%, itinerary yang disusun secara manusiawi tanpa kelelahan berlebih, serta pengayoman berstandar aviasi internasional di setiap destinasi.",
  secondaryText = "Setiap agenda perjalanan dirancang sebagai investasi hubungan strategis yang memperkuat kohesi tim dan menghargai nilai waktu para eksekutif Anda. Melalui jaminan tanpa hidden cost dan komitmen zero forced shopping, kami memastikan seluruh fokus energi organisasi Anda tercurah sepenuhnya pada pencapaian tujuan bisnis dan penciptaan momen berharga tanpa friksi logistik di lapangan.",
  bgImage = "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=2400&q=85",
  primaryCta = { label: "Konsultasi Agenda Enterprise", href: "#rfp-form" },
  secondaryCta = { label: "Unduh Company Profile", href: "#profile" },
  note = "Respon proposal dalam maks. 2x24 jam kerja",
} = Astro.props;
---

<section
  id={id}
  class="relative isolate flex min-h-svh items-center overflow-hidden bg-[#060911] px-6 py-24 sm:px-8 lg:px-12"
>
  <!-- Full-bleed background layer -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <img
      src={bgImage}
      alt=""
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[center_22%] saturate-105 contrast-[1.03] brightness-[0.92]"
    />
    <!-- Readable overlay: left-weighted legibility, open toward the right -->
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(6,9,17,0.95)_0%,rgba(6,9,17,0.84)_40%,rgba(6,9,17,0.5)_74%,rgba(6,9,17,0.28)_100%),linear-gradient(0deg,rgba(6,9,17,0.92)_0%,rgba(6,9,17,0.16)_34%,rgba(6,9,17,0.34)_100%),rgba(6,9,17,0.3)]"
    ></div>
    <!-- Bottom fade into next section -->
    <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-[#060911] to-transparent"></div>
  </div>

  <!-- Accent color grade -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_30%,rgba(0,229,255,0.1)_0%,transparent_55%),radial-gradient(circle_at_50%_100%,rgba(79,70,229,0.14)_0%,transparent_60%)]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-[1280px]">
    <div class="grid items-center gap-12 lg:grid-cols-[3fr_1fr] lg:gap-16">
      <!-- Left: text content (3/4) -->
      <div class="max-w-[860px]">
        <p class="mb-5 inline-flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.18em] text-cyan-400">
          <span class="h-px w-6 bg-current"></span>
          {eyebrow}
        </p>
        <h1
          class="mb-7 bg-gradient-to-br from-white to-cyan-400 bg-clip-text text-[clamp(2.5rem,5.5vw,4.25rem)] font-extrabold leading-[1.15] tracking-[-0.02em] text-transparent"
        >
          {title}
        </h1>
        <p class="mb-6 max-w-[680px] text-[clamp(1.05rem,1.4vw,1.25rem)] font-light leading-[1.8] text-slate-400">
          {description}
        </p>
        <p class="mb-0 max-w-[720px] border-l-2 border-cyan-400 pl-5 text-[15px] leading-[1.7] text-slate-300">
          {secondaryText}
        </p>
      </div>

      <!-- Right: CTA rail (1/4) -->
      <aside class="flex flex-col gap-4 border-l border-white/10 pl-10" aria-label="Primary actions">
        <span class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-cyan-400">
          {primaryCta.label.split(" ").slice(0, 2).join(" ")}
        </span>
        <a
          href={primaryCta.href}
          class="inline-flex w-full items-center justify-start gap-2.5 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.04em] text-[#040914] transition-transform duration-300 hover:-translate-y-0.5 bg-cyan-400 shadow-[0_4px_20px_rgba(0,229,255,0.2)] hover:shadow-[0_8px_30px_rgba(0,229,255,0.4)]"
        >
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex w-full items-center justify-start gap-2.5 border border-white/25 bg-white/5 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.04em] text-slate-100 backdrop-blur transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-400 hover:text-cyan-400"
        >
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          {secondaryCta.label}
        </a>
        <span class="mt-1.5 pl-1 text-[13px] leading-[1.6] text-slate-500">{note}</span>
      </aside>
    </div>
  </div>
</section>

<style>
  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1.02);
    }
  }
  img {
    transform: scale(1.02);
    animation: hero-zoom 18s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
