---
import { komunitasManagerData } from './KomunitasManager.data.js';
---

<section class="py-20 md:py-28 bg-bg-base">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-5 order-2 lg:order-1">
      <div class="rotate-[-2deg] border-[1.5px] border-border-indie bg-white p-3 shadow-indie rounded-blob">
        <img
          src={komunitasManagerData.image}
          alt={komunitasManagerData.imageAlt}
          class="w-full aspect-4/5 object-cover rounded-blob"
          loading="lazy"
        />
      </div>
    </div>

    <div class="lg:col-span-7 order-1 lg:order-2">
      <h2 class="font-caveat text-3xl md:text-5xl font-bold text-text-primary leading-tight">
        {komunitasManagerData.headline}
      </h2>

      <p class="font-dmsans text-sm md:text-base text-text-secondary mt-6 leading-relaxed">
        {komunitasManagerData.body}
      </p>

      <div class="mt-8">
        <a
          href={komunitasManagerData.cta.href}
          class="btn-thunk inline-flex items-center justify-center bg-accent text-white font-dmsans font-bold text-sm h-12 px-8 rounded-full shadow-indie hover:bg-accent-hover"
        >
          {komunitasManagerData.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>
