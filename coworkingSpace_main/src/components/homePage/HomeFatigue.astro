---
import { homeFatigueData } from './HomeFatigue.data.js';
---

<section class="py-20 md:py-24 bg-bg-surface border-b border-border-indie">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-5 order-2 lg:order-1">
      <div class="rotate-[1.5deg] border-[1.5px] border-border-indie bg-white p-3 shadow-indie rounded-blob">
        <img
          src={homeFatigueData.image}
          alt={homeFatigueData.imageAlt}
          class="w-full aspect-4/3 md:aspect-square object-cover rounded-blob"
          loading="lazy"
        />
      </div>
    </div>

    <div class="lg:col-span-7 order-1 lg:order-2">
      <h2 class="font-caveat text-3xl md:text-5xl font-bold text-text-primary leading-tight">
        {homeFatigueData.headline}
      </h2>
      
      <div class="mt-6 font-dmsans text-sm md:text-base text-text-secondary leading-relaxed space-y-4">
        {homeFatigueData.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <div class="mt-8">
        <a
          href={homeFatigueData.cta.href}
          class="btn-thunk inline-flex items-center justify-center border-[1.5px] border-text-primary h-12 px-7 rounded-full font-dmsans font-bold text-sm text-text-primary hover:bg-black/5"
        >
          {homeFatigueData.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>
