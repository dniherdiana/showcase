---
import { homeCommunityData } from './HomeCommunity.data.js';
---

<section class="py-20 md:py-28 bg-bg-surface">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <h2 class="font-caveat text-3xl md:text-5xl font-bold text-text-primary leading-tight">
          {homeCommunityData.headline}
        </h2>
        
        <p class="font-dmsans text-sm md:text-base text-text-secondary mt-6 leading-relaxed">
          {homeCommunityData.body}
        </p>

        <div class="mt-8">
          <a
            href={homeCommunityData.cta.href}
            class="btn-thunk inline-flex items-center justify-center bg-accent text-white font-dmsans font-bold text-sm h-12 px-8 rounded-full shadow-indie hover:bg-accent-hover"
          >
            {homeCommunityData.cta.label}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        {homeCommunityData.images.map((img) => (
          <div class={`${img.rotation} border-[1.5px] border-border-indie bg-white p-2.5 shadow-indie rounded-blob`}>
            <img
              src={img.src}
              alt={img.alt}
              class="w-full aspect-4/5 object-cover rounded-blob"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
