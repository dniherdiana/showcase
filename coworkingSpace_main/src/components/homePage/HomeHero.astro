---
import { homeHeroData } from './HomeHero.data.js';
---

<section class="py-20 md:py-28 bg-bg-base overflow-hidden relative border-b border-border-indie">
  <div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center">
    <h1 class="font-caveat text-4xl md:text-6xl font-bold text-text-primary leading-tight relative">
      {homeHeroData.headline}
      <svg class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-48 md:w-72 h-3 text-accent" viewBox="0 0 100 10" preserveAspectRatio="none">
        <path d="M0,5 Q50,0 100,8" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
      </svg>
    </h1>

    <p class="font-dmsans text-base md:text-lg text-text-primary font-medium mt-8 max-w-2xl leading-relaxed">
      {homeHeroData.lede}
    </p>

    <p class="font-dmsans text-sm md:text-base text-text-secondary mt-4 max-w-2xl leading-relaxed">
      {homeHeroData.body}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={homeHeroData.ctaPrimary.href}
        class="btn-thunk bg-accent text-white font-dmsans font-bold text-sm h-12 px-8 rounded-full shadow-indie hover:bg-accent-hover flex items-center justify-center"
      >
        {homeHeroData.ctaPrimary.label}
      </a>
      <a
        href={homeHeroData.ctaSecondary.href}
        class="btn-thunk bg-transparent text-text-primary border-[1.5px] border-text-primary font-dmsans font-bold text-sm h-12 px-8 rounded-full hover:bg-black/5 flex items-center justify-center"
      >
        {homeHeroData.ctaSecondary.label}
      </a>
    </div>

    <!-- Dominant Visual Anchor: Rotated Paper Style Frame -->
    <div class="mt-14 w-full max-w-4xl rotate-[-1.5deg] border-[1.5px] border-border-indie p-3 bg-white shadow-indie rounded-blob">
      <img
        src={homeHeroData.image}
        alt={homeHeroData.imageAlt}
        class="w-full h-auto aspect-video md:aspect-16/10 object-cover rounded-blob"
        loading="eager"
      />
    </div>
  </div>
</section>
