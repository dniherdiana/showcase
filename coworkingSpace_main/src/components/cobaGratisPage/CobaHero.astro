---
import { cobaHeroData } from './CobaHero.data.js';
import ConciergeBooking from '../islands/ConciergeBooking.svelte';
---

<section class="py-20 md:py-28 bg-bg-base border-b border-border-indie">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-7">
      <h1 class="font-caveat text-4xl md:text-6xl font-bold text-text-primary leading-tight">
        {cobaHeroData.headline}
      </h1>

      <p class="font-dmsans text-base md:text-lg text-text-primary font-medium mt-6 leading-relaxed">
        {cobaHeroData.lede}
      </p>

      <p class="font-dmsans text-sm md:text-base text-text-secondary mt-4 leading-relaxed">
        {cobaHeroData.body}
      </p>

      <div class="mt-8 p-6 bg-bg-surface border-[1.5px] border-border-indie rounded-blob">
        <h3 class="font-dmsans text-sm font-bold text-text-primary uppercase tracking-wider">
          Fasilitas Gratis Yang Langsung Anda Dapatkan:
        </h3>
        <ul class="mt-3 space-y-2 font-dmsans text-xs md:text-sm text-text-secondary">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Akses bebas meja kerja fleksibel selama 1 hari penuh (08:00 sampai 21:00 WIB)
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Koneksi internet serat optik 100 Mbps simetris tanpa kuota
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Seduhan kopi espresso manual dan aneka teh herbal sepuasnya
          </li>
        </ul>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="rotate-[1deg]">
        <ConciergeBooking client:visible />
      </div>
    </div>
  </div>
</section>
