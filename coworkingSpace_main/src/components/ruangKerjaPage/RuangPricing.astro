---
import { ruangPricingData } from './RuangPricing.data.js';
import PricingCalculator from '../islands/PricingCalculator.svelte';
import { Clock, Sparkles, MonitorPlay, Check } from 'lucide-astro';

const icons = {
  Clock,
  Sparkles,
  MonitorPlay
};
---

<section id="pricing-island" class="py-20 md:py-28 bg-bg-surface border-b border-border-indie">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-caveat text-3xl md:text-5xl font-bold text-text-primary leading-tight">
        {ruangPricingData.headline}
      </h2>
      <p class="font-dmsans text-sm md:text-base text-text-secondary mt-4 leading-relaxed">
        {ruangPricingData.lede}
      </p>
    </div>

    <!-- Pricing Cards Blob -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
      {ruangPricingData.tiers.map((tier, index) => {
        const IconComponent = icons[tier.icon as keyof typeof icons] || Sparkles;
        const rotationClass = index === 0 ? 'rotate-[-1deg]' : index === 1 ? 'rotate-[1deg]' : 'rotate-[-1.5deg]';
        return (
          <article class={`bg-white p-8 rounded-blob border-[1.5px] border-border-indie shadow-indie flex flex-col justify-between ${rotationClass} hover:rotate-0 transition-transform`}>
            <div>
              <div class="flex items-center justify-between">
                <h3 class="font-dmsans text-xl font-bold text-text-primary">
                  {tier.name}
                </h3>
                <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center text-accent">
                  <IconComponent class="w-4 h-4" />
                </div>
              </div>

              <div class="mt-4 flex items-baseline gap-1">
                <span class="font-caveat text-4xl font-bold text-accent">{tier.price}</span>
                <span class="font-dmsans text-xs text-text-secondary">/{tier.period}</span>
              </div>

              <p class="font-dmsans text-xs text-text-secondary mt-3 leading-relaxed">
                {tier.description}
              </p>

              <div class="mt-6 pt-6 border-t border-border-indie/60 space-y-2.5">
                {tier.features.map((feature) => (
                  <div class="flex items-start gap-2 text-xs font-dmsans text-text-primary">
                    <Check class="w-4 h-4 text-accent shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-4">
              <a
                href="/coba-gratis"
                class="btn-thunk block w-full text-center py-2.5 px-4 rounded-full font-dmsans font-bold text-xs border-[1.5px] border-text-primary hover:bg-black/5"
              >
                Pilih Paket Ini
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Interactive Island Calculator -->
    <div class="mt-16">
      <div class="max-w-xl mb-6">
        <h3 class="font-caveat text-2xl md:text-3xl font-bold text-text-primary">
          Kalkulator Simulasi Kebutuhan Tim
        </h3>
        <p class="font-dmsans text-xs md:text-sm text-text-secondary mt-1">
          Sesuaikan jumlah anggota tim dan kebutuhan fasilitas untuk mendapatkan gambaran investasi riil.
        </p>
      </div>
      <PricingCalculator client:visible />
    </div>
  </div>
</section>
