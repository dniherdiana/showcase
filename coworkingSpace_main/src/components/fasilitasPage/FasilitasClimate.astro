---
import { fasilitasClimateData } from './FasilitasClimate.data.js';
---

<section class="py-20 md:py-24 bg-bg-base border-b border-border-indie">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-5 order-2 lg:order-1">
      <div class="rotate-[1.5deg] border-[1.5px] border-border-indie bg-white p-3 shadow-indie rounded-blob">
        <img
          src={fasilitasClimateData.image}
          alt={fasilitasClimateData.imageAlt}
          class="w-full aspect-4/3 object-cover rounded-blob"
          loading="lazy"
        />
      </div>
    </div>

    <div class="lg:col-span-7 order-1 lg:order-2">
      <h2 class="font-caveat text-3xl md:text-5xl font-bold text-text-primary leading-tight">
        {fasilitasClimateData.headline}
      </h2>
      <p class="font-dmsans text-sm md:text-base text-text-secondary mt-6 leading-relaxed">
        {fasilitasClimateData.body}
      </p>
    </div>
  </div>
</section>
