---
import { navbarData } from './Navbar.data.js';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[#FFFDF9]/90 backdrop-blur-md border-b border-[rgba(28,25,23,0.1)]">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Navigasi Utama">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-blob bg-accent text-white flex items-center justify-center font-bold font-caveat text-xl group-hover:rotate-6 transition-transform">
        R
      </div>
      <div class="flex flex-col">
        <span class="font-caveat font-bold text-2xl text-text-primary leading-tight">
          {navbarData.brandName}
        </span>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navbarData.navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`font-dmsans text-sm font-medium transition-colors relative py-1 ${
              isActive
                ? 'text-accent font-semibold'
                : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {link.label}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-accent rounded-full" />
            )}
          </a>
        );
      })}
    </div>

    <!-- Mobile Nav Anchor -->
    <div class="flex md:hidden items-center gap-4">
      <a href="/ruang-kerja" class="font-dmsans text-xs font-semibold text-text-primary px-3 py-1.5 rounded-full border border-border-indie">
        Menu Ruang
      </a>
    </div>
  </nav>
</header>
