---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'Layanan', href: '/services' },
  { name: 'Tentang Kami', href: '/about' },
  { name: 'Kontak', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
}
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between bg-dark-surface/90 backdrop-blur-2xl px-6 py-4 border-2 border-white/10 shadow-2xl">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-accent-orange text-dark-bg font-mono font-extrabold text-2xl flex items-center justify-center transform transition-transform group-hover:rotate-6">
        E
      </div>
      <div class="flex flex-col">
        <span class="font-display text-xl font-extrabold tracking-tighter text-text-main group-hover:text-accent-orange transition-colors">
          ELEVATE
        </span>
        <span class="text-[10px] font-mono tracking-widest text-text-muted uppercase">
          // EVENT ORGANIZER
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-sm">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-4 py-2 transition-all font-bold ${
              active 
                ? 'text-dark-bg bg-accent-orange' 
                : 'text-text-muted hover:text-white hover:bg-white/5'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-4">
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent-lime text-dark-bg font-mono font-bold text-xs hover:bg-white transition-all shadow-lg"
      >
        <span>JADWALKAN MEETING</span>
        <span class="text-sm">→</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      aria-label="Toggle Navigation Menu"
      class="md:hidden w-10 h-10 flex items-center justify-center text-text-main hover:text-accent-orange focus:outline-none"
    >
      <svg id="icon-menu" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

  </div>

  <!-- Mobile Overlay Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-[88px] bg-dark-bg/95 backdrop-blur-2xl z-40 hidden flex-col p-6 border-t-2 border-white/10 md:hidden transition-all duration-300"
  >
    <div class="flex flex-col gap-4 my-auto font-mono">
      <span class="text-xs text-text-muted uppercase tracking-widest mb-2">// NAVIGASI UTAMA</span>
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-5 py-4 text-2xl font-bold transition-all ${
              active 
                ? 'bg-accent-orange text-dark-bg' 
                : 'text-text-main hover:bg-white/5 hover:text-accent-orange'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <div class="pt-6 border-t border-white/10 flex flex-col gap-3 font-mono">
      <a
        href="/contact"
        class="w-full py-4 bg-accent-lime text-dark-bg font-bold text-center text-lg hover:bg-white transition-all"
      >
        JADWALKAN MEETING →
      </a>
      <div class="flex items-center justify-between text-xs text-text-muted pt-2">
        <span>EST. 2015 • JAKARTA</span>
        <span>RATING 4.9 / 5.0</span>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (menuBtn && mobileMenu && iconMenu && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
      }
    });
  }
</script>
