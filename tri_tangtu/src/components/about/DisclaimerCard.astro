---
const { disclaimerTitle, referenceDisclaimer } = Astro.props;
---

<article class="flex flex-col justify-center mt-10">
	<div class="topography">
		<div class="flex items-center gap-3 m-8 lg:m-10">
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
				<polygon points="5,0 10,5 5,10 0,5" fill="#D4874E" opacity=".35"
				></polygon>
				<polygon points="5,2.5 7.5,5 5,7.5 2.5,5" fill="#1C1410"></polygon>
			</svg>
			<div class="flex-1 h-px bg-linear-to-l from-border to-transparent"></div>
		</div>

		<h2
			class="text-text text-base lg:text-lg italic leading-relaxed px-8 lg:px-15"
		>
			<span
				class="text-primary uppercase text-[10px] tracking-widest block mb-2"
				>{disclaimerTitle}</span
			>
			{referenceDisclaimer}
		</h2>

		<div class="flex items-center gap-3 m-8 lg:m-10">
			<div class="flex-1 h-px bg-linear-to-r from-border to-transparent"></div>
			<svg width="10" height="10" viewBox="0 0 10 10" fill="none">
				<polygon points="5,0 10,5 5,10 0,5" fill="#D4874E" opacity=".35"
				></polygon>
				<polygon points="5,2.5 7.5,5 5,7.5 2.5,5" fill="#1C1410"></polygon>
			</svg>
		</div>
	</div>
</article>
