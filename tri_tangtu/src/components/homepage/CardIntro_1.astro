---
import { Image } from "astro:assets";
const { src } = Astro.props;

const { intro_1 } = Astro.props;
---

<section class="mx-auto h-auto w-full">
	<div class="bg-surface flex flex-col lg:flex-row">
		<figure
			class="h-auto w-full lg:w-1/2 pb-5 lg:pb-0 relative overflow-hidden"
		>
			<Image
				src={src}
				alt="Gunung Padang, Cianjur - Jawa Barat"
				widths={[360, 720]}
				sizes="(max-width: 768px) 100vw, 364px"
				format="webp"
				quality={85}
				loading="lazy"
				fetchpriority="low"
				class="h-full md:h-96 w-full object-cover transition-transform duration-500 hover:scale-102"
			/>
			<div
				class="absolute bottom-6 lg:bottom-7 xl:bottom-1 left-1 z-10 flex items-center gap-1 text-heading/80 bg-text-dark/70 p-1"
			>
				<div class="w-1 h-1 rounded-full bg-current opacity-60"></div>

				<h2
					class="uppercase text-[8px] lg:text-[10px] tracking-wider lg:tracking-widest font-light"
				>
					Gunung Padang, Cianjur - West Java
				</h2>
			</div>
		</figure>

		<div
			class="relative flex w-full flex-col justify-center overflow-hidden p-8 lg:w-1/2"
		>
			<!-- Top Ornament -->
			<div class="flex items-center gap-2 opacity-50">
				<div class="h-px w-5 bg-border"></div>
				<div class="h-1.5 w-1 bg-primary"></div>
				<div class="h-px w-5 bg-border"></div>
				<div class="h-1.5 w-1 bg-success"></div>
				<div class="h-px w-5 bg-border"></div>
				<div class="h-1.5 w-1 bg-info"></div>
				<div class="h-px flex-1 bg-border"></div>
			</div>

			<p class="text-base leading-loose text-text/80 lg:text-lg py-15">
				{intro_1}
			</p>

			<!-- Botom Ornament -->
			<div class="flex items-center gap-2 opacity-50">
				<div class="h-px flex-1 lg:w-80 bg-border"></div>
				<div class="h-1.5 w-1 bg-primary"></div>
				<div class="h-px w-5 bg-border"></div>
				<div class="h-1.5 w-1 bg-success"></div>
				<div class="h-px w-5 bg-border"></div>
				<div class="h-1.5 w-1 bg-info"></div>
				<div class="h-px w-5 bg-border"></div>
			</div>
		</div>
	</div>
</section>
